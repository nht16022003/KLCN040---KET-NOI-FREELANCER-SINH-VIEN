@model MOCK.Models.ViewModels.ContractDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết Hợp đồng #{Model.Contract.MaHD}";
    var totalAmount = (decimal)(Model.Contract.Sotienkyquy ?? 0);
    var platformFee = totalAmount * 0.05m;
    var netFreelancer = totalAmount - platformFee;

    var statusBadgeClass = Model.Contract.TrangThai switch
    {
        "DaHoanThanh" or "HoanThanh" => "bg-success-subtle text-success border border-success-subtle",
        "DangThucHien" => "bg-primary-subtle text-primary border border-primary-subtle",
        "DaHuy" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning border border-warning-subtle"
    };

    var statusText = Model.Contract.TrangThai switch
    {
        "DaHoanThanh" or "HoanThanh" => "Đã Hoàn Thành & Nghiệm Thu",
        "DangThucHien" => "Đang Thực Hiện",
        "DaHuy" => "Đã Hủy Bỏ",
        _ => Model.Contract.TrangThai
    };
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Breadcrumb & Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/QuanLyHopDong" class="text-decoration-none text-muted">Quản lý Hợp đồng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">HĐ: #@Model.Contract.MaHD</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>Hồ sơ Hợp đồng Dịch vụ: #@Model.Contract.MaHD
            </h3>
            <p class="text-muted small mb-0">Giám sát pháp lý, tài chính ký quỹ và tiến độ giữa Nhà tuyển dụng và Freelancer Sinh viên.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="/Admin/QuanLyHopDong" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Danh sách hợp đồng
            </a>
            <a href="/Admin/QuanLyGiaoDich" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-safe me-1"></i> Kiểm tra Escrow
            </a>
            <a href="/Admin/XuLyTranhChap" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-shield-slash me-1"></i> Tranh chấp liên quan
            </a>
        </div>
    </div>

    <!-- Top Banner Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge @statusBadgeClass px-3 py-1 rounded-pill fw-bold">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @statusText
                    </span>
                    <span class="badge bg-light text-secondary border">Hình thức: @(Model.Contract.Hinhthuclamviec ?? "Remote")</span>
                    <span class="badge bg-light text-secondary border">Mã HĐ: #@Model.Contract.MaHD</span>
                </div>
                <h4 class="fw-bold text-dark mb-2">@Model.Job.Tieude</h4>
                <div class="d-flex flex-wrap gap-4 text-muted small">
                    <div><i class="bi bi-calendar-event me-1 text-primary"></i>Ngày bắt đầu: <strong>@((Model.Contract.NgayBatDau ?? DateTime.Now).ToString("dd/MM/yyyy"))</strong></div>
                    <div><i class="bi bi-calendar-check me-1 text-success"></i>Hạn hoàn thành: <strong>@((Model.Contract.NgayKetThuc ?? DateTime.Now.AddDays(14)).ToString("dd/MM/yyyy"))</strong></div>
                    <div><i class="bi bi-briefcase me-1 text-info"></i>Mã tin tuyển dụng: <strong>#@Model.Contract.MaJob</strong></div>
                </div>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="p-3 bg-light rounded-4 border text-lg-end text-start">
                    <span class="text-muted small fw-semibold text-uppercase d-block">Tổng Giá Trị Hợp Đồng</span>
                    <h3 class="fw-bold text-primary mb-1">@totalAmount.ToString("N0") <small class="fs-6">VNĐ</small></h3>
                    <div class="badge bg-success bg-opacity-10 text-success border border-success-subtle">
                        <i class="bi bi-shield-check me-1"></i> Đã bảo chứng Ký quỹ Escrow 100%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Bên A: Nhà tuyển dụng -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-building text-primary me-2"></i>Bên Thuê (Nhà Tuyển Dụng)
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">Bên A</span>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                        <i class="bi bi-building fs-3 text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">@(Model.Employer.Tencongty ?? Model.EmployerUser.HotenUser)</h6>
                        <div class="text-muted small mb-1"><i class="bi bi-person me-1"></i>Đại diện: @Model.EmployerUser.HotenUser</div>
                        <div class="text-muted small"><i class="bi bi-envelope me-1"></i>Email: @Model.EmployerUser.EmailUser</div>
                    </div>
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Số điện thoại liên hệ:</span>
                        <strong class="text-dark">@(Model.EmployerUser.SdtUser ?? "028 3838 3838")</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Mã Nhà tuyển dụng:</span>
                        <strong class="text-dark">#@Model.Employer.MaNhaTuyenDung (User ID: @Model.EmployerUser.MaUser)</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Địa chỉ công ty:</span>
                        <strong class="text-dark">@(Model.Employer.Diachi ?? "TP. Hồ Chí Minh")</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Lĩnh vực / Website:</span>
                        <strong class="text-primary">@(Model.Employer.Link ?? Model.Employer.Linhvuc ?? "Công nghệ thông tin")</strong>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Bên B: Freelancer Sinh viên -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-mortarboard text-success me-2"></i>Bên Nhận Việc (Freelancer Sinh Viên)
                    </h5>
                    <span class="badge bg-success-subtle text-success">Bên B</span>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.Freelancer.Avatar) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" : Model.Freelancer.Avatar)"
                         alt="@Model.FreelancerUser.HotenUser" class="rounded-circle border flex-shrink-0" style="width: 52px; height: 52px; object-fit: cover;" />
                    <div>
                        <h6 class="fw-bold text-dark mb-1">@Model.FreelancerUser.HotenUser</h6>
                        <div class="text-muted small mb-1"><i class="bi bi-building me-1"></i>Trường: @(!string.IsNullOrEmpty(Model.Freelancer.TenTruong) ? Model.Freelancer.TenTruong : "Đại học Bách Khoa")</div>
                        <div class="text-muted small"><i class="bi bi-envelope me-1"></i>Email: @Model.FreelancerUser.EmailUser</div>
                    </div>
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Số điện thoại:</span>
                        <strong class="text-dark">@(Model.FreelancerUser.SdtUser ?? "0901234567")</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Mã Freelancer Student:</span>
                        <strong class="text-dark">#@Model.Freelancer.MaFreelancerStudents (User ID: @Model.FreelancerUser.MaUser)</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Chuyên ngành đào tạo:</span>
                        <strong class="text-dark">@(Model.Freelancer.ChuyenNganh?.TenChuyenNganh ?? "Công nghệ Phần mềm")</strong>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between text-muted">
                        <span>Trạng thái Minh chứng SV:</span>
                        <strong class="text-success"><i class="bi bi-patch-check-fill me-1"></i> Đã xác minh Thẻ Sinh viên</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Financial Breakdown & Job Details -->
    <div class="row g-4 mb-4">
        <!-- Chi tiết phân bổ tài chính -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-cash-coin text-warning me-2"></i>Bảng Phân Bổ Tài Chính & Ký Quỹ
                </h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle small mb-3">
                        <tbody>
                            <tr>
                                <td class="text-muted">Tổng giá trị hợp đồng (Bên A nạp):</td>
                                <td class="text-end fw-bold text-dark">@totalAmount.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Phí hoa hồng sàn thu (5%):</td>
                                <td class="text-end fw-bold text-danger">-@platformFee.ToString("N0") VNĐ</td>
                            </tr>
                            <tr class="table-light">
                                <td class="fw-bold text-success">Số tiền thực nhận của Sinh viên:</td>
                                <td class="text-end fw-bold text-success fs-6">@netFreelancer.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Trạng thái Ký quỹ sàn (KyQuy):</td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success">Đã Ký Quỹ Đầy Đủ</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-info py-2 px-3 small rounded-3 mb-0 border-0">
                    <i class="bi bi-info-circle-fill me-1"></i> Khoản tiền được giữ an toàn tại tài khoản Escrow sàn. Tiền chỉ được giải ngân cho Sinh viên khi Bên A xác nhận nghiệm thu hoặc khi hết thời hạn nghiệm thu tự động.
                </div>
            </div>
        </div>

        <!-- Chi tiết công việc & Yêu cầu kỹ năng -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-file-earmark-code text-info me-2"></i>Nội Dung & Yêu Cầu Công Việc (JobPost)
                </h5>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Mô tả công việc:</label>
                    <div class="p-3 bg-light rounded-3 text-dark small" style="line-height: 1.6;">
                        @(string.IsNullOrEmpty(Model.Job.Mota) ? "Thực hiện dự án theo các tiêu chí kỹ thuật đã thỏa thuận trong bài đăng tuyển dụng." : Model.Job.Mota)
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Kỹ năng chuyên môn:</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Job.Kynangyeucau))
                            {
                                foreach (var skill in Model.Job.Kynangyeucau.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">@skill.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">C#</span>
                                <span class="badge bg-light text-dark border">ASP.NET Core</span>
                                <span class="badge bg-light text-dark border">SQL Server</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Thời hạn thực hiện:</label>
                        <div class="small fw-semibold text-dark">
                            <i class="bi bi-clock-history me-1 text-muted"></i>@((Model.Contract.NgayBatDau ?? DateTime.Now).ToString("dd/MM/yyyy")) - @((Model.Contract.NgayKetThuc ?? DateTime.Now.AddDays(14)).ToString("dd/MM/yyyy"))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Điều khoản pháp lý tiêu chuẩn -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-journal-text text-secondary me-2"></i>Điều Khoản Thỏa Thuận Pháp Lý & Bảo Mật
        </h5>
        <div class="p-3 bg-light rounded-3 font-monospace small text-dark" style="max-height: 250px; overflow-y: auto; white-space: pre-line; line-height: 1.6;">
1. BÊN A (Nhà tuyển dụng) cam kết ký quỹ đủ 100% giá trị hợp đồng (@totalAmount.ToString("N0") VNĐ) vào tài khoản bảo chứng sàn trước khi BÊN B bắt đầu công việc.
2. BÊN B (Freelancer Sinh viên) cam kết hoàn thành đúng tiến độ, đảm bảo chất lượng kỹ thuật, không sao chép trái phép mã nguồn hay tài liệu của bên thứ ba.
3. BẢO MẬT THÔNG TIN: Hai bên cam kết bảo mật tuyệt đối các dữ liệu, tài liệu nội bộ, mã nguồn được trao đổi trong quá trình thực hiện dự án.
4. NGHIỆM THU & GIẢI NGÂN: Khi BÊN B nộp sản phẩm hoàn chỉnh, BÊN A có 3 ngày làm việc để kiểm tra và xác nhận nghiệm thu. Sau thời gian trên nếu không có phản hồi hoặc yêu cầu chỉnh sửa hợp lệ, hệ thống sẽ tự động giải ngân cho BÊN B.
5. XỬ LÝ TRANH CHẤP: Trong trường hợp phát sinh tranh chấp hoặc bất đồng, hai bên có quyền tạo yêu cầu Tranh chấp (AD-UC-07) để Ban Quản trị Sàn phân xử dựa trên nhật ký trao đổi và sản phẩm bàn giao thực tế.
        </div>
    </div>
</div>
