@model MOCK.Models.ViewModels.AdminUserManagementViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng (AD-UC-01.01)";
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">AD-UC-01.01: Quản lý Người dùng</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản lý Tài khoản & Hồ sơ Người dùng
            </h3>
            <p class="text-muted small mb-0">Tra cứu, phân loại, kiểm tra số dư ví và quản lý trạng thái tài khoản sinh viên và nhà tuyển dụng.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="/Admin/XuLyTaiKhoan" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-person-slash me-1"></i> Xử lý Khóa/Mở TK
            </a>
            <a href="/Admin/DieuChinhSoDu" class="btn btn-outline-warning btn-sm rounded-pill px-3 text-dark">
                <i class="bi bi-sliders2-vertical me-1"></i> Điều chỉnh số dư
            </a>
        </div>
    </div>

    <!-- Filter & Statistics Bar -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <form method="get" asp-action="DanhSachNguoiDung" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted">Tìm kiếm theo tên / email / SĐT</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 bg-light" placeholder="Nhập tên, email hoặc tài khoản..." />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted">Loại người dùng</label>
                <select name="role" class="form-select bg-light">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="2" selected="@(Model.SelectedRole == 2)">Freelancer Sinh viên (Role 2)</option>
                    <option value="1" selected="@(Model.SelectedRole == 1)">Nhà tuyển dụng (Role 1)</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted">Trạng thái tài khoản</label>
                <select name="status" class="form-select bg-light">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="ACTIVE" selected="@(Model.SelectedStatus == "ACTIVE")">Đang hoạt động (ACTIVE)</option>
                    <option value="LOCKED" selected="@(Model.SelectedStatus == "LOCKED")">Đã khóa (LOCKED)</option>
                    <option value="PENDING" selected="@(Model.SelectedStatus == "PENDING")">Chờ xác minh (PENDING)</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100 rounded-3">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                <a href="/Admin/DanhSachNguoiDung" class="btn btn-light border rounded-3" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>

        <hr class="my-3 text-muted opacity-25" />

        <div class="d-flex flex-wrap gap-4 text-muted small">
            <div><strong>Tổng số:</strong> <span class="badge bg-secondary">@Model.TongSoNguoiDung</span></div>
            <div><strong>Sinh viên:</strong> <span class="badge bg-success bg-opacity-10 text-success border border-success">@Model.SoSinhVien</span></div>
            <div><strong>Nhà tuyển dụng:</strong> <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">@Model.SoNhaTuyenDung</span></div>
            <div><strong>Bị khóa:</strong> <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">@Model.SoBiKhoa</span></div>
        </div>
    </div>

    <!-- User Table List -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>ID</th>
                        <th>Họ tên & Tài khoản</th>
                        <th>Vai trò</th>
                        <th>Thông tin liên hệ</th>
                        <th>Đơn vị / ĐH</th>
                        <th>Số dư ví</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy tài khoản người dùng nào khớp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="fw-bold text-dark small">#@u.MaUser</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(u.Avatar ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80")" class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" alt="@u.HotenUser" />
                                        <div>
                                            <div class="fw-bold text-dark small">@u.HotenUser</div>
                                            <div class="text-muted small">@@@u.TenTaiKhoanUser</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (u.MaRole == 2)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
                                            <i class="bi bi-mortarboard-fill me-1"></i> Sinh viên
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 small">
                                            <i class="bi bi-building me-1"></i> Tuyển dụng
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@u.EmailUser</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@(u.SdtUser ?? "Chưa có")</div>
                                </td>
                                <td>
                                    <span class="small text-dark">@(u.ThongTinPhu ?? "N/A")</span>
                                    @if (u.DaXacMinhMinhChung)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info ms-1" title="Đã xác minh thẻ SV"><i class="bi bi-patch-check-fill"></i> Verified</span>
                                    }
                                </td>
                                <td class="fw-bold text-dark small">
                                    @u.SoDuVi.ToString("N0") đ
                                </td>
                                <td>
                                    @if (u.Status == "ACTIVE")
                                    {
                                        <span class="badge bg-success small">Hoạt động</span>
                                    }
                                    else if (u.Status == "LOCKED")
                                    {
                                        <span class="badge bg-danger small">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark small">Chờ duyệt</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/XuLyTaiKhoan?maUser=@u.MaUser" class="btn btn-outline-secondary" title="Khóa/Mở tài khoản">
                                            <i class="bi bi-gear-fill"></i>
                                        </a>
                                        <a href="/Admin/DieuChinhSoDu?maWallet=@u.MaUser" class="btn btn-outline-secondary" title="Điều chỉnh ví">
                                            <i class="bi bi-wallet2"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
