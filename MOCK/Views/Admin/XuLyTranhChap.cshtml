@model MOCK.Models.ViewModels.AdminDisputeResolutionViewModel
@{
    ViewData["Title"] = "Xử lý Tranh chấp Hợp đồng (AD-UC-07.01)";
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">AD-UC-07.01: Xử lý Tranh chấp</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-slash text-danger me-2"></i>Trọng tài Phân xử & Giải quyết Tranh chấp
            </h3>
            <p class="text-muted small mb-0">Thẩm định chứng cứ, ban hành phán quyết trọng tài và điều tiết giải ngân tiền ký quỹ tranh chấp (bảng TranhChap, BangChungTranhChap).</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/QuanLyGiaoDich" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-safe me-1"></i> Quản lý Escrow
            </a>
            <a href="/Admin/XuLyHoTro" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-headset me-1"></i> Hỗ trợ ticket
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Alert -->
    <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between p-3">
        <div class="d-flex align-items-center gap-3">
            <div class="fs-2 text-warning"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <h6 class="fw-bold text-dark mb-1">Hiện có @Model.SoTranhChapDangCho vụ việc tranh chấp cần Admin thẩm định</h6>
                <p class="small text-muted mb-0">Vui lòng kiểm tra kỹ lưỡng các file bằng chứng, điều khoản hợp đồng trước khi ra quyết định phân chia tiền ký quỹ.</p>
            </div>
        </div>
    </div>

    <!-- Dispute List Cards -->
    <div class="row g-4">
        @if (!Model.TranhChaps.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center text-muted">
                    <i class="bi bi-shield-check text-success fs-1 mb-2"></i>
                    <h5>Không có tranh chấp nào phát sinh trên hệ thống</h5>
                    <p class="small mb-0">Mọi hợp đồng và giao dịch đều đang diễn ra thuận lợi.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var tc in Model.TranhChaps)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3 pb-2 border-bottom">
                            <div>
                                <span class="badge @(tc.TrangThai == "ChoXuLy" ? "bg-danger" : "bg-success") me-2">@tc.TrangThai</span>
                                <span class="fw-bold text-dark fs-6">Tranh chấp #@tc.MaTranhChap &bull; Hợp đồng: @tc.MaHD (@tc.TenCongViec)</span>
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>Ngày tạo: @tc.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-light rounded-3 h-100">
                                    <div class="small text-muted fw-semibold mb-1">BÊN KHIẾU NẠI & BỊ KHIẾU NẠI</div>
                                    <div class="small mb-1">
                                        <strong>Nguyên đơn:</strong> <span class="text-danger fw-bold">@tc.NguoiKhieuNai</span> (@tc.RoleNguoiKhieuNai)
                                    </div>
                                    <div class="small mb-2">
                                        <strong>Bị đơn:</strong> <span class="text-dark fw-bold">@tc.NguoiBiKhieuNai</span>
                                    </div>
                                    <div class="small text-muted fw-semibold mb-1">SỐ TIỀN TRANH CHẤP (KÝ QUỸ)</div>
                                    <div class="fs-5 fw-bold text-primary">@tc.SoTienTranhChap.ToString("N0") VNĐ</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-light rounded-3 h-100">
                                    <div class="small text-muted fw-semibold mb-1">LÝ DO & NỘI DUNG KHIẾU NẠI</div>
                                    <p class="small text-dark mb-2">@tc.LyDo</p>

                                    <div class="small text-muted fw-semibold mb-1">BẰNG CHỨNG ĐÍNH KÈM (@tc.BangChungs.Count)</div>
                                    @if (!tc.BangChungs.Any())
                                    {
                                        <div class="small text-muted">Không có bằng chứng đính kèm</div>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var bc in tc.BangChungs)
                                            {
                                                <li class="mb-1">
                                                    <i class="bi bi-paperclip text-primary me-1"></i>
                                                    <a href="@bc.DuongDanFile" target="_blank" class="text-decoration-none">@bc.MoTa</a>
                                                    <span class="text-muted">(@bc.LoaiBangChung)</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="p-3 border rounded-3 h-100 @(tc.TrangThai == "ChoXuLy" ? "bg-white" : "bg-light")">
                                    @if (tc.TrangThai == "ChoXuLy")
                                    {
                                        <h6 class="fw-bold text-danger mb-2"><i class="bi bi-hammer me-1"></i>Ban hành Phán quyết</h6>
                                        <form method="post" asp-action="PhanXuTranhChap">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maTranhChap" value="@tc.MaTranhChap" />

                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold text-muted mb-0">Hoàn tiền cho NTD (VNĐ)</label>
                                                <input type="number" name="hoanTienCus" value="@(tc.SoTienTranhChap / 2)" class="form-control form-control-sm" step="1000" min="0" max="@tc.SoTienTranhChap" required />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold text-muted mb-0">Thanh toán cho Freelancer (VNĐ)</label>
                                                <input type="number" name="traFRL" value="@(tc.SoTienTranhChap / 2)" class="form-control form-control-sm" step="1000" min="0" max="@tc.SoTienTranhChap" required />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold text-muted mb-0">Nội dung phán quyết <span class="text-danger">*</span></label>
                                                <textarea name="ketQua" class="form-control form-control-sm" rows="2" required placeholder="Ghi rõ cơ sở phán xử và giải ngân..."></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-sm btn-danger w-100 rounded-pill fw-semibold" onclick="return confirm('Bạn có chắc chắn muốn thi hành phán quyết này? Tiền ký quỹ sẽ được chia lập tức!');">
                                                <i class="bi bi-check-lg me-1"></i> Thi hành Phán quyết
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i>Đã giải quyết tranh chấp</h6>
                                        <div class="small text-muted mb-1">Kết quả phán quyết:</div>
                                        <div class="small text-dark p-2 bg-white rounded border mb-2">
                                            @(tc.KetQuaPhanXu ?? "Đã hòa giải thành công và phân bổ tiền ký quỹ.")
                                        </div>
                                        <span class="badge bg-success small"><i class="bi bi-lock-fill me-1"></i>Vụ việc đã đóng</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
