@model MOCK.Models.ViewModels.JobEditViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa bài đăng {Model.MaJob}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .job-edit-wrapper {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 30px 0 60px;
    }

    .job-edit-card {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .form-section-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 12px;
        border-bottom: 1px solid #F1F5F9;
    }

    .suggest-skill-pill {
        background: #EEF6F1;
        color: #1C5F37;
        border: 1px solid #D2E7DC;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        cursor: pointer;
        display: inline-block;
        margin-right: 6px;
        margin-bottom: 6px;
        transition: all 0.2s;
    }

    .suggest-skill-pill:hover {
        background: #1C5F37;
        color: #FFFFFF;
    }

    .btn-submit-save {
        background-color: #1B5E36;
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 12px 36px;
        border-radius: 30px;
        border: none;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(27, 94, 54, 0.25);
    }

    .btn-submit-save:hover {
        background-color: #14492A;
        transform: translateY(-1px);
    }

    .btn-cancel-post {
        background-color: #FFFFFF;
        border: 1px solid #D0D7DE;
        color: #475569;
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 30px;
        transition: all 0.2s;
    }

    .btn-cancel-post:hover {
        background-color: #F8FAFC;
        border-color: #94A3B8;
        color: #0F172A;
    }

    .status-badge-custom {
        font-size: 0.85rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 20px;
    }
</style>

<div class="job-edit-wrapper">
    <div class="container">
        
        <!-- BREADCRUMB & HEADER -->
        <div class="mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Employer" asp-action="ManageJobs" class="text-decoration-none text-muted">Quản lý bài đăng</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MaJob" class="text-decoration-none text-muted">@Model.MaJob</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Chỉnh sửa tin</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Chỉnh sửa bài đăng tuyển dụng</h2>
                    <p class="text-muted small mb-0">Mã bài đăng: <strong class="text-dark">@Model.MaJob</strong> | Ngày đăng: @Model.Thoigiandangtuyen.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="status-badge-custom @(Model.Status == "DangTuyen" ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                        Trạng thái: @Model.Status
                    </span>
                    <a asp-action="Details" asp-route-id="@Model.MaJob" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">
                        <i class="bi bi-eye me-1"></i>Xem bài đăng
                    </a>
                </div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-4 p-3 mb-4">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaJob" />
            <input type="hidden" asp-for="MaNhaTuyenDung" />
            <input type="hidden" asp-for="Thoigiandangtuyen" />
            <input type="hidden" asp-for="PhiDangBai" />

            <div class="row g-4">
                
                <!-- MAIN FORM (LEFT) -->
                <div class="col-12 col-lg-8">
                    <div class="job-edit-card mb-4">
                        
                        <!-- SECTION 1: CÔNG VIỆC -->
                        <div class="form-section-title">
                            <i class="bi bi-pencil-square text-success fs-5"></i>
                            Thông tin chính của bài đăng
                        </div>

                        <div class="mb-4">
                            <label asp-for="Tieude" class="form-label fw-semibold text-dark small mb-1">
                                Tiêu đề công việc <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Tieude" class="form-control form-control-lg rounded-3 fs-6" placeholder="VD: Thiết kế banner quảng cáo Facebook cho chiến dịch mùa hè" />
                            <span asp-validation-for="Tieude" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text text-muted small">Tiêu đề rõ ràng giúp thu hút ứng viên sinh viên phù hợp nhất.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Mota" class="form-label fw-semibold text-dark small mb-1">
                                Mô tả chi tiết yêu cầu & sản phẩm bàn giao <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Mota" class="form-control rounded-3" rows="7" placeholder="Mô tả cụ thể khối lượng công việc, yêu cầu kỹ thuật, tài liệu cung cấp và sản phẩm cuối cùng cần bàn giao..."></textarea>
                            <span asp-validation-for="Mota" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Kynangyeucau" class="form-label fw-semibold text-dark small mb-1">
                                Kỹ năng yêu cầu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Kynangyeucau" id="skillsInput" class="form-control rounded-3" placeholder="VD: Figma, Adobe Photoshop, HTML, CSS, C#..." />
                            <span asp-validation-for="Kynangyeucau" class="text-danger small mt-1 d-block"></span>
                            
                            <div class="mt-2">
                                <span class="text-muted small me-2">Gợi ý kỹ năng nhanh:</span>
                                <span class="suggest-skill-pill" onclick="addSkill('Figma')">+ Figma</span>
                                <span class="suggest-skill-pill" onclick="addSkill('Photoshop')">+ Photoshop</span>
                                <span class="suggest-skill-pill" onclick="addSkill('ASP.NET Core')">+ ASP.NET Core</span>
                                <span class="suggest-skill-pill" onclick="addSkill('ReactJS')">+ ReactJS</span>
                                <span class="suggest-skill-pill" onclick="addSkill('SQL Server')">+ SQL Server</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FileDinhKem" class="form-label fw-semibold text-dark small mb-1">
                                Đường dẫn tệp đính kèm mô tả / tài liệu tham khảo
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted rounded-start-3"><i class="bi bi-paperclip"></i></span>
                                <input asp-for="FileDinhKem" class="form-control rounded-end-3" placeholder="https://drive.google.com/... hoặc link tài liệu brief" />
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SIDEBAR SETTINGS (RIGHT) -->
                <div class="col-12 col-lg-4">
                    
                    <!-- BUDGET & TIMELINE CARD -->
                    <div class="job-edit-card mb-4">
                        <div class="form-section-title">
                            <i class="bi bi-sliders text-success fs-5"></i>
                            Ngân sách & Thiết lập
                        </div>

                        <div class="mb-3">
                            <label asp-for="Thulao" class="form-label fw-semibold text-dark small mb-1">
                                Thù lao ngân sách (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Thulao" type="number" step="50000" class="form-control form-control-lg rounded-start-3 fs-6" placeholder="1,500,000" />
                                <span class="input-group-text bg-light fw-bold text-muted rounded-end-3">VNĐ</span>
                            </div>
                            <span asp-validation-for="Thulao" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Thoigiandukienhoanthanh" class="form-label fw-semibold text-dark small mb-1">
                                Hạn hoàn thành dự kiến <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Thoigiandukienhoanthanh" class="form-control rounded-3" placeholder="VD: 2026-10-15 hoặc 10 ngày" />
                            <span asp-validation-for="Thoigiandukienhoanthanh" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Soluongtuyen" class="form-label fw-semibold text-dark small mb-1">
                                Số lượng sinh viên tuyển <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Soluongtuyen" type="number" min="1" max="20" class="form-control rounded-3" />
                            <span asp-validation-for="Soluongtuyen" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold text-dark small mb-1">
                                Trạng thái bài đăng
                            </label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="DangTuyen">Đang tuyển (Công khai nhận hồ sơ)</option>
                                <option value="DangThucHien">Đang thực hiện (Đã ký hợp đồng)</option>
                                <option value="DaHoanThanh">Đã hoàn thành</option>
                                <option value="DaHuy">Đã đóng / Tạm dừng</option>
                            </select>
                        </div>
                    </div>

                    <!-- SUBMIT ACTIONS CARD -->
                    <div class="job-edit-card">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-submit-save">
                                <i class="bi bi-check2-circle me-2"></i>Lưu thay đổi bài đăng
                            </button>
                            <a asp-controller="Employer" asp-action="ManageJobs" class="btn btn-cancel-post text-center text-decoration-none">
                                Hủy bỏ & Quay lại
                            </a>
                        </div>
                    </div>

                </div>

            </div>
        </form>

    </div>
</div>

<script>
    function addSkill(skillName) {
        var input = document.getElementById('skillsInput');
        if (!input) return;
        var current = input.value.trim();
        if (current.length === 0) {
            input.value = skillName;
        } else {
            var parts = current.split(',').map(s => s.trim());
            if (!parts.includes(skillName)) {
                input.value = current + ', ' + skillName;
            }
        }
    }
</script>
