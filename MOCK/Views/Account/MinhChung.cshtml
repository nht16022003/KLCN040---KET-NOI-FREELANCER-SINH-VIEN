@model MOCK.Models.ViewModels.MinhChungViewModel
@{
    ViewData["Title"] = "Xác minh minh chứng sinh viên";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var status = Model.MinhChung?.TrangThaiGuiMinhChung ?? "Chưa nộp";
}

<style>
    .verification-page-wrapper {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 30px 0 60px;
    }

    /* ONBOARDING STEPPER */
    .onboarding-stepper {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 18px;
        padding: 20px 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        position: relative;
    }

    .step-number {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .step-done .step-number {
        background: #E8F5EC;
        color: #1B5E36;
    }

    .step-active .step-number {
        background: #1B5E36;
        color: #FFFFFF;
        box-shadow: 0 0 0 4px rgba(27, 94, 54, 0.15);
    }

    .step-pending .step-number {
        background: #F1F5F9;
        color: #94A3B8;
    }

    .step-label-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0F172A;
        line-height: 1.2;
    }

    .step-label-sub {
        font-size: 0.75rem;
        color: #64748B;
    }

    /* STATUS BANNER */
    .status-banner-card {
        border-radius: 18px;
        padding: 22px 26px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .status-banner-verified {
        background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
        border: 1.5px solid #A7F3D0;
        color: #065F46;
    }

    .status-banner-pending {
        background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
        border: 1.5px solid #BFDBFE;
        color: #1E40AF;
    }

    .status-banner-rejected {
        background: linear-gradient(135deg, #FFF1F2 0%, #FFE4E6 100%);
        border: 1.5px solid #FECDD3;
        color: #9F1239;
    }

    .status-banner-unsubmitted {
        background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
        border: 1.5px solid #FDE68A;
        color: #92400E;
    }

    /* MAIN FORM CARD */
    .form-card {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F1F5F9;
    }

    .form-card-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 2px;
    }

    /* UPLOAD DROPZONE */
    .upload-dropzone {
        border: 2px dashed #CBD5E1;
        border-radius: 16px;
        background: #FAFDFB;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }

    .upload-dropzone:hover {
        border-color: #1B5E36;
        background: #F0F7F2;
    }

    .upload-icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #E8F4EC;
        color: #1B5E36;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 14px;
    }

    /* SAMPLE PREVIEW CARD */
    .doc-preview-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .doc-thumb {
        width: 65px;
        height: 65px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid #CBD5E1;
    }

    .btn-submit-verify {
        background-color: #1B5E36;
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 12px 36px;
        border-radius: 30px;
        border: none;
        box-shadow: 0 4px 14px rgba(27, 94, 54, 0.25);
        transition: all 0.2s;
    }

    .btn-submit-verify:hover {
        background-color: #14492A;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(27, 94, 54, 0.35);
    }

    .guideline-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
        font-size: 0.88rem;
        color: #475569;
    }
</style>

<div class="verification-page-wrapper">
    <div class="container-fluid px-lg-5">
        
        <!-- ==================== 1. ONBOARDING STEPPER ==================== -->
        @if (Model.IsFirstTimeAfterRegister || status == "Chưa nộp")
        {
            <div class="onboarding-stepper">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-4">
                        <div class="step-item step-done">
                            <div class="step-number"><i class="bi bi-check-lg"></i></div>
                            <div>
                                <div class="step-label-title">1. Đăng ký tài khoản</div>
                                <div class="step-label-sub text-success">Đã hoàn thành</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="step-item step-active">
                            <div class="step-number">2</div>
                            <div>
                                <div class="step-label-title">2. Nộp minh chứng sinh viên</div>
                                <div class="step-label-sub text-primary">Đang thực hiện</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="step-item step-pending">
                            <div class="step-number">3</div>
                            <div>
                                <div class="step-label-title">3. Bắt đầu nhận việc</div>
                                <div class="step-label-sub">Tự do ứng tuyển & nhận thù lao</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ==================== 2. STATUS ALERT BANNER ==================== -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                    <div>
                        <strong>Gửi thành công!</strong> @Model.SuccessMessage
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (status == "Đã xác minh")
        {
            <div class="status-banner-card status-banner-verified">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Tài khoản sinh viên đã được xác minh chính thức</h5>
                        <p class="mb-0 small opacity-90">
                            Xác minh ngày @(Model.MinhChung?.NgayXacMinh?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy")) bởi Ban Quản Trị Freelancer Students. Hồ sơ của bạn đã có huy hiệu tích xanh uy tín.
                        </p>
                    </div>
                </div>
                <span class="badge bg-success px-3 py-2 rounded-pill fs-7">
                    <i class="bi bi-shield-check me-1"></i> Sinh viên hợp lệ
                </span>
            </div>
        }
        else if (status == "Đang gửi")
        {
            <div class="status-banner-card status-banner-pending">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Hồ sơ minh chứng đang chờ quản trị viên phê duyệt</h5>
                        <p class="mb-0 small opacity-90">
                            Thời gian nộp: @(Model.MinhChung?.NgayNop.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm")). Hệ thống sẽ thông báo kết quả xác minh trong vòng 24 giờ làm việc.
                        </p>
                    </div>
                </div>
                <span class="badge bg-primary px-3 py-2 rounded-pill fs-7">
                    <i class="bi bi-clock-history me-1"></i> Đang chờ duyệt
                </span>
            </div>
        }
        else if (status == "Đã từ chối")
        {
            <div class="status-banner-card status-banner-rejected">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Hồ sơ minh chứng chưa được duyệt</h5>
                        <p class="mb-0 small opacity-90">
                            <strong>Lý do từ chối:</strong> @(Model.MinhChung?.LydoTuChoi ?? "Hình ảnh thẻ sinh viên bị mờ, không rõ thời hạn hoặc thông tin không khớp."). Vui lòng tải lại minh chứng mới bên dưới.
                        </p>
                    </div>
                </div>
                <span class="badge bg-danger px-3 py-2 rounded-pill fs-7">
                    <i class="bi bi-exclamation-triangle me-1"></i> Cần nộp lại
                </span>
            </div>
        }
        else
        {
            <div class="status-banner-card status-banner-unsubmitted">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Vui lòng nộp minh chứng sinh viên để kích hoạt tài khoản</h5>
                        <p class="mb-0 small opacity-90">
                            Xác minh sinh viên giúp tăng độ tin cậy với Nhà tuyển dụng và mở khóa tính năng nhận thù lao dự án an toàn.
                        </p>
                    </div>
                </div>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-7">
                    <i class="bi bi-card-checklist me-1"></i> Chưa nộp minh chứng
                </span>
            </div>
        }

        <!-- ==================== 3. MAIN FORM GRID ==================== -->
        <form asp-controller="Account" asp-action="MinhChung" method="post" id="minhChungForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="User.MaUser" value="@Model.User.MaUser" />
            <input type="hidden" asp-for="FileMinhChungUrl" id="fileMinhChungInput" value="@(string.IsNullOrEmpty(Model.FileMinhChungUrl) ? "uploads/minhchung/user_the_sv.jpg" : Model.FileMinhChungUrl)" />

            <div class="row g-4">
                
                <!-- CỘT TRÁI (7 COLS): TẢI LÊN MINH CHỨNG & THÔNG TIN HỌC THUẬT -->
                <div class="col-12 col-lg-7">
                    
                    <!-- Form Card 1: Tải lên minh chứng -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <i class="bi bi-file-earmark-person-fill text-success fs-3"></i>
                            <div>
                                <h4 class="form-card-title">1. Tài liệu minh chứng sinh viên</h4>
                                <p class="text-muted small mb-0">Cung cấp hình ảnh thẻ sinh viên hoặc giấy tờ liên quan (bảng `MinhChungFreelancerStudent`)</p>
                            </div>
                        </div>

                        <!-- Loại minh chứng -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">Loại tài liệu minh chứng <span class="text-danger">*</span></label>
                            <select asp-for="SelectedLoaiMinhChung" class="form-select rounded-3">
                                <option value="Thẻ sinh viên">Thẻ sinh viên (Mặt trước có ảnh & niên khóa)</option>
                                <option value="Giấy xác nhận sinh viên">Giấy xác nhận sinh viên của nhà trường (Có mộc đỏ)</option>
                                <option value="Bảng điểm / Cổng thông tin đào tạo">Ảnh chụp cổng thông tin sinh viên / Bảng điểm</option>
                            </select>
                        </div>

                        <!-- Khu vực kéo thả / Upload -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">Hình ảnh / Tệp minh chứng <span class="text-danger">*</span></label>
                            
                            <div class="upload-dropzone" onclick="document.getElementById('hiddenFileInput').click()">
                                <input type="file" id="hiddenFileInput" style="display: none;" accept="image/*,.pdf" onchange="handleFileSelect(this)" />
                                <div class="upload-icon-circle">
                                    <i class="bi bi-cloud-arrow-up-fill"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Nhấp để tải lên hoặc kéo thả tệp vào đây</h6>
                                <p class="text-muted small mb-2">Hỗ trợ định dạng: JPG, PNG, PDF (Tối đa 10MB)</p>
                                <span class="badge bg-light text-success border px-3 py-1">Chọn ảnh từ máy tính</span>
                            </div>
                        </div>

                        <!-- Preview file đã tải -->
                        <div class="doc-preview-box mb-3" id="docPreviewContainer">
                            <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=200&q=80" 
                                 alt="Thẻ sinh viên" class="doc-thumb" id="docPreviewImg" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark small" id="docPreviewName">
                                    @(Model.MinhChung?.LoaiMinhChung ?? "the_sinh_vien_2026.jpg")
                                </div>
                                <div class="text-muted" style="font-size: 0.76rem;">
                                    Đã tải lên • Dung lượng: 1.4 MB • <span class="text-success fw-semibold">Sẵn sàng gửi duyệt</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="document.getElementById('hiddenFileInput').click()">
                                Thay đổi
                            </button>
                        </div>

                    </div>

                    <!-- Form Card 2: Thông tin trường & Chuyên ngành -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <i class="bi bi-mortarboard-fill text-success fs-3"></i>
                            <div>
                                <h4 class="form-card-title">2. Thông tin học tập & Chuyên ngành</h4>
                                <p class="text-muted small mb-0">Khớp với hồ sơ đào tạo trên thẻ sinh viên (bảng `FreelancerStudent`)</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Tên trường -->
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-bold text-dark small">Trường Đại học / Cao đẳng <span class="text-danger">*</span></label>
                                <input asp-for="TenTruong" class="form-control rounded-3" placeholder="Ví dụ: Đại học Công nghệ Thông tin - ĐHQG TP.HCM" required />
                                <span asp-validation-for="TenTruong" class="text-danger small"></span>
                            </div>

                            <!-- Mã trường -->
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold text-dark small">Mã trường</label>
                                <input asp-for="MaTruong" class="form-control rounded-3" placeholder="Ví dụ: UIT01" />
                            </div>

                            <!-- Chuyên ngành đào tạo -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Chuyên ngành đào tạo <span class="text-danger">*</span></label>
                                <select asp-for="MaChuyenNganh" class="form-select rounded-3">
                                    @foreach (var cn in Model.ChuyenNganhs)
                                    {
                                        <option value="@cn.MaChuyenNganh" selected="@(Model.MaChuyenNganh == cn.MaChuyenNganh)">
                                            @cn.TenChuyenNganh (@cn.MaChuyenNganh)
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Năm thứ mấy -->
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold text-dark small">Sinh viên năm thứ</label>
                                <select asp-for="NamThu" class="form-select rounded-3">
                                    <option value="1">Năm 1</option>
                                    <option value="2">Năm 2</option>
                                    <option value="3">Năm 3</option>
                                    <option value="4">Năm 4</option>
                                    <option value="5">Năm 5 / Khác</option>
                                </select>
                            </div>

                            <!-- Niên khóa -->
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold text-dark small">Niên khóa</label>
                                <input asp-for="NienKhoa" class="form-control rounded-3" placeholder="2023-2027" />
                            </div>

                            <!-- Điểm GPA -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Điểm tích lũy (GPA thang 4.0)</label>
                                <input asp-for="GPA" type="number" step="0.01" max="4.0" min="0" class="form-control rounded-3" placeholder="3.45" />
                            </div>

                            <!-- Địa điểm cơ sở đào tạo -->
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold text-dark small">Địa điểm trường / Cơ sở</label>
                                <input asp-for="DiaDiemTruong" class="form-control rounded-3" placeholder="Thủ Đức, TP.HCM" />
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                            <a href="/Home/Index" class="btn btn-outline-secondary rounded-pill px-4">
                                Để sau / Về trang chủ
                            </a>
                            <button type="submit" class="btn-submit-verify">
                                <i class="bi bi-send-check me-2"></i> Gửi hồ sơ minh chứng
                            </button>
                        </div>

                    </div>

                </div>

                <!-- CỘT PHẢI (5 COLS): QUY CHUẨN XÁC MINH & HỖ TRỢ -->
                <div class="col-12 col-lg-5">
                    
                    <!-- Card Hướng dẫn tiêu chuẩn minh chứng -->
                    <div class="form-card">
                        <h5 class="fw-bold text-dark mb-3">
                            <i class="bi bi-shield-lock-fill text-success me-2"></i>Tiêu chuẩn minh chứng hợp lệ
                        </h5>

                        <div class="guideline-item">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div>
                                <strong>Ảnh chụp nguyên bản:</strong> Ảnh chụp trực tiếp 4 góc rõ ràng, không bị mờ nhòe, lóa sáng hoặc mất góc.
                            </div>
                        </div>

                        <div class="guideline-item">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div>
                                <strong>Còn thời hạn sử dụng:</strong> Thẻ sinh viên hoặc giấy xác nhận phải thể hiện rõ niên khóa và hạn giá trị còn hiệu lực.
                            </div>
                        </div>

                        <div class="guideline-item">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div>
                                <strong>Khớp họ tên đăng ký:</strong> Họ và tên trên thẻ sinh viên (<code>@Model.User.HotenUser</code>) phải khớp hoàn toàn với tên tài khoản.
                            </div>
                        </div>

                        <div class="guideline-item">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <div>
                                <strong>Bảo mật thông tin:</strong> Freelancer Students cam kết bảo mật 100% dữ liệu cá nhân theo Luật An toàn thông tin.
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 mt-3 border">
                            <div class="small text-secondary">
                                <i class="bi bi-patch-question-fill text-primary me-1"></i>
                                Cần hỗ trợ gấp về thủ tục xác minh? Liên hệ hotline Ban hỗ trợ sinh viên: <strong>0901 234 567</strong> hoặc email <strong>support@freelancerstudent.edu.vn</strong>.
                            </div>
                        </div>
                    </div>

                    <!-- Card Demo Switcher để Test nhanh trạng thái -->
                    <div class="form-card border-success-subtle bg-light">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-sliders text-success me-2"></i>Bộ chuyển đổi xem nhanh dữ liệu mẫu:
                        </h6>
                        <p class="text-muted small mb-3">Thử nghiệm xem trang Minh chứng theo từng trạng thái sinh viên trong MockData:</p>
                        
                        <div class="d-grid gap-2">
                            <a href="/Account/MinhChung?userId=1" class="btn btn-sm @(Model.User.MaUser == 1 ? "btn-success" : "btn-outline-success") rounded-pill text-start px-3">
                                <strong>User 1: Nguyễn Văn An</strong> — <span class="badge bg-light text-success border">Đã xác minh</span>
                            </a>
                            <a href="/Account/MinhChung?userId=2" class="btn btn-sm @(Model.User.MaUser == 2 ? "btn-success" : "btn-outline-success") rounded-pill text-start px-3">
                                <strong>User 2: Trần Thị Bích</strong> — <span class="badge bg-light text-success border">Đã xác minh</span>
                            </a>
                            <a href="/Account/MinhChung?userId=3" class="btn btn-sm @(Model.User.MaUser == 3 ? "btn-success" : "btn-outline-success") rounded-pill text-start px-3">
                                <strong>User 3: Lê Hoàng Long</strong> — <span class="badge bg-light text-primary border">Đang gửi duyệt</span>
                            </a>
                            <a href="/Account/MinhChung?isNew=true" class="btn btn-sm @(Model.IsFirstTimeAfterRegister ? "btn-success" : "btn-outline-secondary") rounded-pill text-start px-3">
                                <strong>Tài khoản mới đăng ký</strong> — <span class="badge bg-light text-dark border">Chưa nộp (Onboarding)</span>
                            </a>
                        </div>
                    </div>

                </div>

            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                document.getElementById('docPreviewName').textContent = file.name;
                
                const reader = new FileReader();
                reader.onload = function (e) {
                    if (file.type.startsWith('image/')) {
                        document.getElementById('docPreviewImg').src = e.target.result;
                    }
                };
                reader.readAsDataURL(file);

                // Cập nhật đường dẫn file ẩn
                document.getElementById('fileMinhChungInput').value = 'uploads/minhchung/' + file.name;
                alert('Đã chọn tệp: ' + file.name + '. Hãy nhấn "Gửi hồ sơ minh chứng" để hoàn tất!');
            }
        }
    </script>
}
