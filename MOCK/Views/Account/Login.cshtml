@model MOCK.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-main-container">
    <div class="container">
        <div class="row align-items-center g-5">
            
            <!-- LEFT COLUMN: BRAND & VALUE PROPOSITIONS -->
            <div class="col-12 col-lg-6 pe-lg-4">
                <!-- Big Hero Title -->
                <h1 class="hero-title-main">
                    FREELANCER<br />
                    <span class="hero-title-outlined">FOR</span> STUDENTS
                </h1>
                <p class="hero-subtitle">Kết nối sinh viên tài năng với cơ hội thực tế</p>

                <!-- 3 Feature Points -->
                <div class="features-list mt-4">
                    <!-- Feature 1 -->
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="feature-title">Cơ hội thực tế</div>
                            <div class="feature-desc">Tìm công việc phù hợp, phát triển kỹ năng</div>
                        </div>
                    </div>

                    <!-- Feature 2 -->
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                        <div>
                            <div class="feature-title">Thu nhập linh hoạt</div>
                            <div class="feature-desc">Làm chủ thời gian, tăng thu nhập</div>
                        </div>
                    </div>

                    <!-- Feature 3 -->
                    <div class="feature-item">
                        <div class="feature-icon-box">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <div class="feature-title">Xây dựng tương lai</div>
                            <div class="feature-desc">Tạo portfolio, tích lũy kinh nghiệm</div>
                        </div>
                    </div>
                </div>

                <!-- Banner Illustration & Hand-drawn text -->
                <div class="hero-illustration-box d-none d-md-block">
                    <div class="doodle-badge">
                        Small Skills<br />Big Opportunities 👑
                    </div>
                    <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=700&q=80"
                         alt="Freelancer Students" class="hero-student-img" />
                </div>
            </div>

            <!-- RIGHT COLUMN: LOGIN CARD -->
            <div class="col-12 col-lg-6 ps-lg-4">
                <div class="login-card-container mx-auto" style="max-width: 480px;">
                    <h2 class="login-card-title">Chào mừng trở lại!</h2>
                    <p class="login-card-subtitle">Đăng nhập để tiếp tục hành trình của bạn</p>

                    <!-- Social Login -->
                    <button type="button" class="btn-social">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4"
                                  d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z" />
                            <path fill="#34A853"
                                  d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z" />
                            <path fill="#FBBC05"
                                  d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.15z" />
                            <path fill="#EA4335"
                                  d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z" />
                        </svg>
                        Tiếp tục với Google
                    </button>

                    <button type="button" class="btn-social">
                        <svg width="18" height="18" fill="#1877F2" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                        Tiếp tục với Facebook
                    </button>

                    <!-- Divider -->
                    <div class="auth-divider">
                        <span>Hoặc đăng nhập với tài khoản</span>
                    </div>

                    <!-- Validation Alerts -->
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                    }

                    <!-- Login Form -->
                    <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <!-- Email / Username -->
                        <div class="mb-3">
                            <label asp-for="UsernameOrEmail" class="form-label-auth"></label>
                            <div class="input-group-auth">
                                <i class="bi bi-envelope input-icon-left"></i>
                                <input asp-for="UsernameOrEmail" class="form-control-auth"
                                       placeholder="Nhập email hoặc tên đăng nhập" autocomplete="username" />
                            </div>
                            <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-n2 d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label-auth"></label>
                            <div class="input-group-auth">
                                <i class="bi bi-lock input-icon-left"></i>
                                <input asp-for="Password" type="password" class="form-control-auth pe-5"
                                       placeholder="Nhập mật khẩu" id="passwordInput"
                                       autocomplete="current-password" />
                                <button type="button" class="input-icon-right" id="togglePasswordBtn"
                                        title="Hiện/ẩn mật khẩu">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-n2 d-block"></span>
                        </div>

                        <!-- Remember & Forgot Password -->
                        <div class="auth-options-row">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input form-check-input-green"
                                       type="checkbox" id="rememberMeCheck">
                                <label class="form-check-label text-secondary small user-select-none"
                                       for="rememberMeCheck">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                            <a asp-action="ForgotPassword" class="link-forgot">Quên mật khẩu?</a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-submit-auth">
                            Đăng nhập
                        </button>

                        <!-- Demo Quick Fill Buttons -->
                        <div class="quick-fill-section">
                            <div class="text-muted small fw-bold mb-2">
                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Đăng nhập nhanh dữ liệu mẫu:
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-outline-success quick-fill-btn"
                                        data-user="an_freelancer" data-pass="hash_pass_123">
                                    Sinh viên 1 (An)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success quick-fill-btn"
                                        data-user="bich_designer" data-pass="hash_pass_456">
                                    Sinh viên 2 (Bích)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary quick-fill-btn"
                                        data-user="employer_abc" data-pass="hash_pass_abc">
                                    Nhà tuyển dụng ABC
                                </button>
                            </div>
                        </div>

                        <!-- Register link -->
                        <div class="auth-footer-text">
                            Chưa có tài khoản? <a href="#">Đăng ký ngay</a>
                        </div>

                        <!-- Admin link -->
                        <div class="admin-login-box">
                            Dành cho quản trị viên?<br />
                            <a href="javascript:void(0)" id="quickAdminBtn">Đăng nhập tài khoản Admin</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Hiện / ẩn mật khẩu
            const togglePasswordBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("passwordInput");
            const togglePasswordIcon = document.getElementById("togglePasswordIcon");

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener("click", function () {
                    const isPassword = passwordInput.type === "password";
                    passwordInput.type = isPassword ? "text" : "password";
                    togglePasswordIcon.classList.toggle("bi-eye", !isPassword);
                    togglePasswordIcon.classList.toggle("bi-eye-slash", isPassword);
                });
            }

            // Quick fill demo buttons
            const quickFillBtns = document.querySelectorAll(".quick-fill-btn");
            const usernameInput = document.querySelector('input[name="UsernameOrEmail"]');

            quickFillBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    const user = this.getAttribute("data-user");
                    const pass = this.getAttribute("data-pass");
                    if (usernameInput) usernameInput.value = user;
                    if (passwordInput) passwordInput.value = pass;
                });
            });

            // Quick fill admin
            const quickAdminBtn = document.getElementById("quickAdminBtn");
            if (quickAdminBtn) {
                quickAdminBtn.addEventListener("click", function () {
                    if (usernameInput) usernameInput.value = "admin_sys";
                    if (passwordInput) passwordInput.value = "hash_pass_admin";
                });
            }
        });
    </script>
}
