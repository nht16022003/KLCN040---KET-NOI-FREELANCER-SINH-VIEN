@model MOCK.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Quản lý thông tin cá nhân & Thiết lập bảo mật";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.IsEditMode;
    string activeTab = Model.ActiveTab ?? "profile";
}

<style>
    :root {
        --profile-green: #3B6E53;
        --profile-green-dark: #234E39;
        --profile-green-light: #EBF4F0;
        --profile-green-hover: #2F5A43;
    }

    .profile-page-bg {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 36px 0 60px;
    }

    .profile-header-card {
        background: linear-gradient(135deg, #FFFFFF 0%, #F4F8F5 100%);
        border: 1px solid #E3ECE6;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 8px 24px rgba(59, 110, 83, 0.05);
        position: relative;
        overflow: hidden;
    }

    .profile-header-card::after {
        content: '';
        position: absolute;
        top: -40px;
        right: -40px;
        width: 160px;
        height: 160px;
        background: radial-gradient(circle, rgba(59, 110, 83, 0.08) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .avatar-wrapper {
        position: relative;
        width: 105px;
        height: 105px;
        border-radius: 50%;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        border: 4px solid #FFFFFF;
        overflow: hidden;
        flex-shrink: 0;
    }

    .avatar-img-main {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-upload-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(15, 23, 42, 0.65);
        padding: 4px 0;
        text-align: center;
        color: #FFFFFF;
        font-size: 0.72rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .avatar-upload-overlay:hover {
        background: rgba(35, 78, 57, 0.9);
    }

    .badge-role-tag {
        background-color: var(--profile-green-light);
        color: var(--profile-green-dark);
        font-weight: 700;
        font-size: 0.8rem;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-verify-verified {
        background-color: #DEF7EC;
        color: #03543F;
        border: 1px solid #BCF0DA;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-verify-pending {
        background-color: #FEF08A;
        color: #713F12;
        border: 1px solid #FDE047;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-verify-unverified {
        background-color: #F1F5F9;
        color: #64748B;
        border: 1px solid #E2E8F0;
        font-weight: 600;
        font-size: 0.82rem;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Custom Nav Tabs */
    .profile-nav-pills {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 16px;
        padding: 8px;
        display: flex;
        gap: 8px;
    }

    .profile-nav-pills .nav-link {
        color: #475569;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .profile-nav-pills .nav-link.active {
        background-color: var(--profile-green);
        color: #FFFFFF !important;
        box-shadow: 0 4px 12px rgba(59, 110, 83, 0.25);
    }

    .profile-nav-pills .nav-link:hover:not(.active) {
        background-color: #F8FAF9;
        color: var(--profile-green-dark);
    }

    .profile-content-card {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

    .info-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: #64748B;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .info-value-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 12px 16px;
        font-weight: 600;
        font-size: 0.95rem;
        color: #1E293B;
        min-height: 48px;
        display: flex;
        align-items: center;
    }

    .btn-edit-mode {
        background-color: var(--profile-green);
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 0.92rem;
        padding: 10px 24px;
        border-radius: 30px;
        border: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(59, 110, 83, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-edit-mode:hover {
        background-color: var(--profile-green-dark);
        transform: translateY(-1px);
    }

    .btn-save-profile {
        background-color: var(--profile-green);
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 10px 28px;
        border-radius: 30px;
        border: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(59, 110, 83, 0.25);
    }

    .btn-save-profile:hover {
        background-color: var(--profile-green-dark);
        transform: translateY(-1px);
    }

    .btn-cancel-edit {
        background-color: #F1F5F9;
        color: #475569 !important;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 10px 24px;
        border-radius: 30px;
        border: 1px solid #CBD5E1;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-cancel-edit:hover {
        background-color: #E2E8F0;
        color: #1E293B !important;
    }

    .password-rules-box {
        background-color: #F8FAF9;
        border: 1px dashed #CBD5E1;
        border-radius: 14px;
        padding: 18px 20px;
    }

    .password-rule-item {
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .input-password-group {
        position: relative;
    }

    .btn-toggle-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #94A3B8;
        cursor: pointer;
        padding: 4px;
    }

    .btn-toggle-eye:hover {
        color: #475569;
    }
</style>

<div class="profile-page-bg">
    <div class="container">
        
        <!-- THÔNG BÁO HỆ THỐNG -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-medium">@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-medium">@Model.ErrorMessage</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- PHẦN 1: HEADER THÔNG TIN NGƯỜI DÙNG TỔNG QUAN -->
        <div class="profile-header-card mb-4">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
                
                <div class="d-flex flex-column flex-md-row align-items-center gap-4 text-center text-md-start">
                    <!-- Avatar -->
                    <div class="avatar-wrapper">
                        <img id="avatarPreviewHeader" src="~/@Model.AvatarUrl" alt="@Model.HotenUser" class="avatar-img-main" />
                    </div>

                    <!-- Tên & Tag -->
                    <div>
                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                            <h3 class="fw-bold text-dark mb-0">@Model.HotenUser</h3>
                            <span class="badge-role-tag">
                                <i class="bi bi-person-badge"></i> @Model.RoleTitle
                            </span>
                        </div>

                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3 text-muted small">
                            <span><i class="bi bi-envelope me-1"></i> @Model.EmailUser</span>
                            <span>•</span>
                            <span><i class="bi bi-calendar-check me-1"></i> Tham gia từ: @Model.NgayTao.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Trạng thái xác thực hồ sơ -->
                <div class="text-center text-md-end">
                    <div class="small text-muted mb-1 fw-semibold">Trạng thái xác thực:</div>
                    @if (Model.TrangThaiXacThuc.Contains("Đã xác thực"))
                    {
                        <span class="badge-verify-verified">
                            <i class="bi bi-patch-check-fill text-success"></i> @Model.TrangThaiXacThuc
                        </span>
                    }
                    else if (Model.TrangThaiXacThuc.Contains("chờ"))
                    {
                        <span class="badge-verify-pending">
                            <i class="bi bi-hourglass-split text-warning"></i> @Model.TrangThaiXacThuc
                        </span>
                    }
                    else
                    {
                        <span class="badge-verify-unverified">
                            <i class="bi bi-shield-x text-secondary"></i> @Model.TrangThaiXacThuc
                        </span>
                    }
                </div>

            </div>
        </div>

        <!-- PHẦN 2: TABS ĐIỀU HƯỚNG CHÍNH -->
        <ul class="nav profile-nav-pills mb-4" id="profileTab" role="tablist">
            <li class="nav-item flex-fill text-center" role="presentation">
                <button class="nav-link w-100 justify-content-center @(activeTab == "profile" ? "active" : "")"
                        id="tab-profile-btn" data-bs-toggle="pill" data-bs-target="#tab-profile" type="button" role="tab">
                    <i class="bi bi-person-circle fs-5"></i> 1. Thông tin cá nhân
                </button>
            </li>
            <li class="nav-item flex-fill text-center" role="presentation">
                <button class="nav-link w-100 justify-content-center @(activeTab == "security" ? "active" : "")"
                        id="tab-security-btn" data-bs-toggle="pill" data-bs-target="#tab-security" type="button" role="tab">
                    <i class="bi bi-shield-lock-fill fs-5"></i> 2. Thiết lập bảo mật & Thay đổi mật khẩu
                </button>
            </li>
        </ul>

        <!-- PHẦN 3: NỘI DUNG TỪNG TAB -->
        <div class="tab-content" id="profileTabContent">
            
            <!-- ========================================== -->
            <!-- TAB 1: QUẢN LÝ THÔNG TIN CÁ NHÂN           -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(activeTab == "profile" ? "show active" : "")" id="tab-profile" role="tabpanel">
                <div class="profile-content-card">

                    @if (!isEdit)
                    {
                        <!-- ================= LUỒNG XEM THÔNG TIN CÁ NHÂN (CUS-UC-01.03) ================= -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center pb-3 mb-4 border-bottom gap-3">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">
                                    <i class="bi bi-person-lines-fill text-success me-2"></i>Chi tiết thông tin cá nhân
                                </h4>
                                <p class="text-muted small mb-0">Xem và quản lý các thông tin cá nhân tài khoản của bạn.</p>
                            </div>

                            <a href="/Account/Profile?tab=profile&edit=true" class="btn-edit-mode">
                                <i class="bi bi-pencil-square"></i> Chỉnh sửa thông tin
                            </a>
                        </div>

                        <div class="row g-4">
                            <!-- Họ và tên -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-person"></i> Họ và tên</div>
                                <div class="info-value-box">@Model.HotenUser</div>
                            </div>

                            <!-- Tên đăng nhập -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-at"></i> Tên tài khoản (Username)</div>
                                <div class="info-value-box">@@@Model.TenTaiKhoanUser</div>
                            </div>

                            <!-- Email -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-envelope"></i> Địa chỉ Email</div>
                                <div class="info-value-box d-flex justify-content-between align-items-center">
                                    <span>@Model.EmailUser</span>
                                    <span class="badge bg-light text-success border"><i class="bi bi-lock-fill me-1"></i>Bảo mật</span>
                                </div>
                            </div>

                            <!-- Số điện thoại -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-telephone"></i> Số điện thoại liên hệ</div>
                                <div class="info-value-box">
                                    @if (!string.IsNullOrEmpty(Model.SdtUser))
                                    {
                                        <span>@Model.SdtUser</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa cập nhật số điện thoại</span>
                                    }
                                </div>
                            </div>

                            <!-- Ngày tạo tài khoản -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-calendar-event"></i> Ngày tạo tài khoản</div>
                                <div class="info-value-box">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            <!-- Trạng thái xác thực hồ sơ -->
                            <div class="col-12 col-md-6">
                                <div class="info-label"><i class="bi bi-patch-check"></i> Trạng thái hồ sơ</div>
                                <div class="info-value-box">
                                    @Model.TrangThaiXacThuc
                                </div>
                            </div>
                        </div>

                        <!-- Gợi ý bổ sung nếu chưa xác thực -->
                        @if (Model.User.MaRole == 1 && Model.TrangThaiXacThuc.Contains("Chưa"))
                        {
                            <div class="mt-4 p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-info-circle-fill text-primary fs-3"></i>
                                    <div>
                                        <div class="fw-bold text-dark small">Hồ sơ sinh viên chưa được xác minh</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">Hãy gửi thẻ sinh viên để nhận huy hiệu xác thực và tăng độ uy tín với nhà tuyển dụng.</div>
                                    </div>
                                </div>
                                <a href="/Account/MinhChung" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                    Nộp minh chứng ngay
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- ================= LUỒNG CẬP NHẬT THÔNG TIN CÁ NHÂN (CUS-UC-01.04) ================= -->
                        <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">
                                    <i class="bi bi-pencil-fill text-success me-2"></i>Chỉnh sửa thông tin cá nhân
                                </h4>
                                <p class="text-muted small mb-0">Cập nhật họ và tên, số điện thoại hoặc thay đổi ảnh đại diện mới.</p>
                            </div>
                        </div>

                        <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <!-- 1. Cập nhật Ảnh đại diện -->
                            <div class="mb-4 p-3 bg-light rounded-4 border">
                                <label class="form-label fw-bold text-dark small mb-2">
                                    <i class="bi bi-image text-success me-1"></i> Thay đổi ảnh đại diện mới (EXC 2: Kiểm tra định dạng ảnh)
                                </label>
                                <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                                    <div class="avatar-wrapper">
                                        <img id="avatarFormPreview" src="~/@Model.AvatarUrl" alt="Avatar preview" class="avatar-img-main" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <input asp-for="AvatarUpload" type="file" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" id="avatarFileInput" />
                                        <div class="text-muted mt-2" style="font-size: 0.78rem;">
                                            <i class="bi bi-info-circle me-1"></i>Hỗ trợ định dạng: <strong>.jpg, .jpeg, .png, .webp</strong>. Kích thước tối đa: <strong>5MB</strong>.
                                        </div>
                                        <span asp-validation-for="AvatarUpload" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-4 mb-4">
                                <!-- Họ và tên -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Họ và tên <span class="text-danger">*</span></label>
                                    <input asp-for="EditHotenUser" class="form-control rounded-3 py-2" placeholder="Nhập họ và tên đầy đủ" required />
                                    <span asp-validation-for="EditHotenUser" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Số điện thoại (EXC 1) -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Số điện thoại <span class="text-danger">*</span></label>
                                    <input asp-for="EditSdtUser" class="form-control rounded-3 py-2" placeholder="Ví dụ: 0901234567" required />
                                    <span asp-validation-for="EditSdtUser" class="text-danger small mt-1 d-block"></span>
                                    <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">(Bắt đầu bằng đầu số 03, 05, 07, 08, 09 và gồm 10 chữ số)</span>
                                </div>

                                <!-- Email (Chỉ đọc) -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-muted small">Địa chỉ Email (Không thể thay đổi)</label>
                                    <input type="text" class="form-control rounded-3 py-2 bg-light text-muted" value="@Model.EmailUser" readonly disabled />
                                </div>

                                <!-- Tên tài khoản (Chỉ đọc) -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-muted small">Tên đăng nhập (Username)</label>
                                    <input type="text" class="form-control rounded-3 py-2 bg-light text-muted" value="@@@Model.TenTaiKhoanUser" readonly disabled />
                                </div>
                            </div>

                            <!-- Nút Thao Tác (ALT 1: Nút Hủy) -->
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a href="/Account/Profile?tab=profile&edit=false" class="btn-cancel-edit">
                                    <i class="bi bi-x-circle"></i> Hủy bỏ (ALT 1)
                                </a>

                                <button type="submit" class="btn-save-profile">
                                    <i class="bi bi-check2-circle me-1"></i> Lưu chỉnh sửa
                                </button>
                            </div>

                        </form>
                    }

                </div>
            </div>

            <!-- ========================================== -->
            <!-- TAB 2: THIẾT LẬP BẢO MẬT & ĐỔI MẬT KHẨU     -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(activeTab == "security" ? "show active" : "")" id="tab-security" role="tabpanel">
                <div class="profile-content-card">
                    
                    <div class="pb-3 mb-4 border-bottom">
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-key-fill text-success me-2"></i>Thay đổi mật khẩu tài khoản
                        </h4>
                        <p class="text-muted small mb-0">Chủ động đổi mật khẩu định kỳ để nâng cao tính an toàn và bảo mật cho tài khoản.</p>
                    </div>

                    <div class="row g-4">
                        
                        <!-- Cột Trái: Form Đổi mật khẩu (CUS-UC-01.05) -->
                        <div class="col-12 col-lg-7">
                            <form asp-controller="Account" asp-action="ChangePassword" method="post">
                                @Html.AntiForgeryToken()

                                <!-- Mật khẩu hiện tại (EXC 1) -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark small">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                                    <div class="input-password-group">
                                        <input asp-for="ChangePasswordModel.CurrentPassword" type="password" id="currentPassInput"
                                               class="form-control rounded-3 py-2 pe-5" placeholder="Nhập mật khẩu đang dùng" required />
                                        <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('currentPassInput', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ChangePasswordModel.CurrentPassword" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Mật khẩu mới (EXC 3) -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark small">Mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-password-group">
                                        <input asp-for="ChangePasswordModel.NewPassword" type="password" id="newPassInput"
                                               class="form-control rounded-3 py-2 pe-5" placeholder="Tối thiểu 8 ký tự gồm chữ và số" required />
                                        <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('newPassInput', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ChangePasswordModel.NewPassword" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Xác nhận mật khẩu mới (EXC 2) -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-password-group">
                                        <input asp-for="ChangePasswordModel.ConfirmPassword" type="password" id="confirmPassInput"
                                               class="form-control rounded-3 py-2 pe-5" placeholder="Nhập lại mật khẩu mới" required />
                                        <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('confirmPassInput', this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ChangePasswordModel.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="pt-2">
                                    <button type="submit" class="btn-save-profile w-100 py-3">
                                        <i class="bi bi-shield-check me-1"></i> Xác nhận thay đổi mật khẩu
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Cột Phải: Hướng dẫn chuẩn mật khẩu & Lưu ý đăng xuất -->
                        <div class="col-12 col-lg-5">
                            
                            <div class="password-rules-box mb-4">
                                <h6 class="fw-bold text-dark mb-3">
                                    <i class="bi bi-shield-lock text-success me-2"></i>Quy chuẩn mật khẩu an toàn
                                </h6>
                                <div class="password-rule-item">
                                    <i class="bi bi-check-circle-fill text-success"></i> Tối thiểu <strong>8 ký tự</strong>.
                                </div>
                                <div class="password-rule-item">
                                    <i class="bi bi-check-circle-fill text-success"></i> Chứa cả <strong>chữ cái (a-z, A-Z)</strong> và <strong>chữ số (0-9)</strong>.
                                </div>
                                <div class="password-rule-item">
                                    <i class="bi bi-check-circle-fill text-success"></i> Mật khẩu xác nhận phải trùng khớp 100%.
                                </div>
                            </div>

                            <div class="alert alert-warning border-0 rounded-4 p-3 mb-0" style="background-color: #FEF9C3; color: #854D0E;">
                                <div class="d-flex gap-3">
                                    <i class="bi bi-exclamation-circle-fill fs-4 flex-shrink-0"></i>
                                    <div class="small">
                                        <strong>Lưu ý bảo mật quan trọng:</strong><br />
                                        Sau khi đổi mật khẩu thành công, hệ thống sẽ <strong>tự động đăng xuất</strong> tài khoản của bạn trên tất cả phiên để đảm bảo an toàn. Bạn sẽ cần đăng nhập lại với mật khẩu mới.
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Preview ảnh đại diện khi chọn file mới
        const avatarInput = document.getElementById('avatarFileInput');
        if (avatarInput) {
            avatarInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const preview = document.getElementById('avatarFormPreview');
                        if (preview) {
                            preview.src = event.target.result;
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Toggle ẩn / hiện mật khẩu
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye-vue', 'bi-eye');
                icon.classList.remove('bi-eye-slash');
            }
        }
    </script>
}
