@model MOCK.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-main-container {
        background: linear-gradient(135deg, #F8FAF9 0%, #EFF6F2 100%);
        min-height: calc(100vh - 140px);
        padding: 50px 0 80px;
        display: flex;
        align-items: center;
    }

    .forgot-card {
        background: #FFFFFF;
        border-radius: 24px;
        border: 1px solid #E5ECE7;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
        padding: 40px;
        position: relative;
        overflow: hidden;
    }

    .forgot-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #3B6E53 0%, #10B981 100%);
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 28px;
    }

    .step-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        background: #F1F5F9;
        color: #64748B;
        transition: all 0.3s;
    }

    .step-dot.active {
        background: #3B6E53;
        color: #FFFFFF;
        box-shadow: 0 0 0 4px rgba(59, 110, 83, 0.15);
    }

    .step-dot.completed {
        background: #10B981;
        color: #FFFFFF;
    }

    .step-line {
        height: 2px;
        width: 40px;
        background: #E2E8F0;
    }

    .step-line.active {
        background: #3B6E53;
    }

    .form-control-custom {
        height: 50px;
        border-radius: 12px;
        border: 1px solid #D0D7DE;
        padding: 10px 16px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

    .form-control-custom:focus {
        border-color: #3B6E53;
        box-shadow: 0 0 0 3px rgba(59, 110, 83, 0.12);
    }

    .btn-auth-primary {
        background: #3B6E53;
        color: #FFFFFF;
        font-weight: 700;
        font-size: 1rem;
        padding: 13px;
        border-radius: 12px;
        border: none;
        width: 100%;
        transition: all 0.2s;
    }

    .btn-auth-primary:hover {
        background: #2A523E;
        color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 110, 83, 0.25);
    }

    .icon-box-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #EBF4F0;
        color: #3B6E53;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 16px;
    }
</style>

<div class="auth-main-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">

                <div class="forgot-card">
                    <!-- Step Progress Indicator -->
                    <div class="step-indicator">
                        <div class="step-dot @(Model.Step >= 1 ? (Model.Step == 1 ? "active" : "completed") : "")">
                            @(Model.Step > 1 ? "✓" : "1")
                        </div>
                        <div class="step-line @(Model.Step >= 2 ? "active" : "")"></div>
                        <div class="step-dot @(Model.Step >= 2 ? (Model.Step == 2 ? "active" : "completed") : "")">
                            @(Model.Step > 2 ? "✓" : "2")
                        </div>
                        <div class="step-line @(Model.Step >= 3 ? "active" : "")"></div>
                        <div class="step-dot @(Model.Step == 3 ? "completed" : "")">
                            @(Model.Step == 3 ? "✓" : "3")
                        </div>
                    </div>

                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info border-0 shadow-sm rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
                            <i class="bi bi-info-circle-fill fs-6 text-info"></i>
                            <div>@TempData["InfoMessage"]</div>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-3 py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
                            <i class="bi bi-check-circle-fill fs-6 text-success"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2 px-3 mb-4 small">
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    @if (Model.Step == 1)
                    {
                        <!-- STEP 1: ENTER EMAIL / USERNAME -->
                        <div class="text-center mb-4">
                            <div class="icon-box-circle">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <h3 class="fw-bold text-dark mb-1">Quên mật khẩu?</h3>
                            <p class="text-muted small mb-0">
                                Nhập Email hoặc Tên tài khoản liên kết với tài khoản của bạn để nhận mã xác thực đặt lại mật khẩu.
                            </p>
                        </div>

                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Step" value="1" />

                            <div class="mb-4">
                                <label asp-for="EmailOrUsername" class="form-label fw-semibold text-dark small mb-1">
                                    Email hoặc Tên tài khoản <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 12px 0 0 12px; border-color: #D0D7DE;">
                                        <i class="bi bi-envelope-at"></i>
                                    </span>
                                    <input asp-for="EmailOrUsername" class="form-control form-control-custom border-start-0" style="border-radius: 0 12px 12px 0;" placeholder="VD: an.nguyen@student.edu.vn hoặc hr@abc-tech.com" />
                                </div>
                                <span asp-validation-for="EmailOrUsername" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <button type="submit" class="btn btn-auth-primary mb-3">
                                <i class="bi bi-arrow-right-circle me-2"></i>Tiếp tục nhận mã OTP
                            </button>

                            <div class="text-center">
                                <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-muted fw-semibold">
                                    <i class="bi bi-arrow-left me-1"></i>Quay lại trang Đăng nhập
                                </a>
                            </div>
                        </form>
                    }
                    else if (Model.Step == 2)
                    {
                        <!-- STEP 2: OTP & NEW PASSWORD -->
                        <div class="text-center mb-4">
                            <div class="icon-box-circle">
                                <i class="bi bi-key"></i>
                            </div>
                            <h3 class="fw-bold text-dark mb-1">Đặt lại mật khẩu</h3>
                            <p class="text-muted small mb-0">
                                Tài khoản: <strong class="text-dark">@Model.EmailOrUsername</strong> (@Model.UserRoleName)
                            </p>
                        </div>

                        <form asp-action="ResetPassword" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="EmailOrUsername" />
                            <input type="hidden" asp-for="UserRoleName" />
                            <input type="hidden" asp-for="Step" value="2" />

                            <div class="mb-3">
                                <label asp-for="OtpCode" class="form-label fw-semibold text-dark small mb-1">
                                    Mã xác thực OTP <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 12px 0 0 12px; border-color: #D0D7DE;">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <input asp-for="OtpCode" class="form-control form-control-custom border-start-0" style="border-radius: 0 12px 12px 0; letter-spacing: 2px; font-weight: 700;" placeholder="Nhập 6 số (Demo: 888666)" maxlength="6" />
                                </div>
                                <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label fw-semibold text-dark small mb-1">
                                    Mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 12px 0 0 12px; border-color: #D0D7DE;">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="NewPassword" type="password" class="form-control form-control-custom border-start-0" style="border-radius: 0 12px 12px 0;" placeholder="Tối thiểu 6 ký tự" />
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small mb-1">
                                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 12px 0 0 12px; border-color: #D0D7DE;">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-custom border-start-0" style="border-radius: 0 12px 12px 0;" placeholder="Nhập lại mật khẩu mới" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <button type="submit" class="btn btn-auth-primary mb-3">
                                <i class="bi bi-check2-circle me-2"></i>Lưu mật khẩu mới
                            </button>

                            <div class="text-center">
                                <a asp-action="ForgotPassword" class="text-decoration-none small text-muted">
                                    <i class="bi bi-arrow-left me-1"></i>Nhập lại Email khác
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <!-- STEP 3: SUCCESS -->
                        <div class="text-center py-3">
                            <div class="icon-box-circle bg-success-subtle text-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <h3 class="fw-bold text-dark mb-2">Đổi mật khẩu thành công!</h3>
                            <p class="text-muted small mb-4">
                                Mật khẩu của tài khoản <strong class="text-dark">@Model.EmailOrUsername</strong> đã được cập nhật thành công. Hãy sử dụng mật khẩu mới để đăng nhập hệ thống.
                            </p>

                            <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary mb-2">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập ngay
                            </a>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>
</div>
