@model MOCK.Models.ViewModels.TranhChapDetailViewModel
@{
    ViewData["Title"] = "Chi tiết vụ tranh chấp - #TC_" + Model.TranhChap.MaTranhChap.ToString("D4");
}

<div class="container py-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.88rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="TranhChap" asp-action="Index" class="text-decoration-none text-muted">Tranh chấp</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">#TC_@Model.TranhChap.MaTranhChap.ToString("D4")</li>
        </ol>
    </nav>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ==================== HEADER CARD ==================== -->
    <div class="card border-0 shadow-sm p-4 mb-4 text-white" style="border-radius: 20px; background: linear-gradient(135deg, #78281F 0%, #922B21 50%, #C0392B 100%);">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-white text-danger fw-bold px-3 py-1" style="border-radius: 20px; font-size: 0.8rem;">
                        <i class="bi bi-shield-exclamation me-1"></i> Hồ sơ #TC_@Model.TranhChap.MaTranhChap.ToString("D4")
                    </span>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1" style="border-radius: 20px; font-size: 0.8rem;">
                        HĐ: #@Model.HopDong.MaHD
                    </span>
                    <span class="badge bg-light text-dark px-3 py-1" style="border-radius: 20px; font-size: 0.8rem;">
                        Ký quỹ Escrow: @Model.TranhChap.SoTienTranhChap.ToString("#,##0") VNĐ
                    </span>
                </div>
                <h3 class="fw-bold mb-1 text-white">@Model.Job.Tieude</h3>
                <div class="small text-white-50">
                    <i class="bi bi-clock me-1"></i>Ngày tạo đơn: @Model.TranhChap.NgayTao.ToString("HH:mm dd/MM/yyyy")
                </div>
            </div>

            <div class="text-md-end">
                @if (Model.TranhChap.TrangThai == "DangMo")
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-hourglass-top me-1"></i>Đang mở hồ sơ</span>
                }
                else if (Model.TranhChap.TrangThai == "DangXuLy")
                {
                    <span class="badge bg-light text-danger fs-6 px-3 py-2 fw-bold"><i class="bi bi-gear-wide-connected me-1"></i>Trọng tài đang xử lý</span>
                }
                else if (Model.TranhChap.TrangThai == "DaGiaiQuyet")
                {
                    <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-check2-all me-1"></i>Đã giải quyết</span>
                }
            </div>
        </div>
    </div>

    <!-- ==================== MAIN CASE CONTENT & PHÁN QUYẾT ==================== -->
    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN VỤ VIỆC & KẾT LUẬN TRỌNG TÀI -->
        <div class="col-lg-7">
            <!-- Kết luận Trọng tài (nếu có hoặc đang xử lý) -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; background: #FFFFFF; border-left: 5px solid @(Model.TranhChap.TrangThai == "DaGiaiQuyet" ? "#27AE60" : "#E67E22") !important;">
                <h5 class="fw-bold text-dark mb-2">
                    <i class="bi bi-award-fill text-warning me-2"></i>Tiến trình & Kết luận Trọng tài Hệ thống
                </h5>
                @if (!string.IsNullOrEmpty(Model.TranhChap.KetLuanAdmin))
                {
                    <div class="p-3 bg-light rounded-3 text-dark small" style="line-height: 1.6; font-size: 0.92rem;">
                        <strong>Phán quyết chính thức:</strong>
                        <p class="mb-0 mt-1">@Model.TranhChap.KetLuanAdmin</p>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        Hồ sơ đang trong giai đoạn tiếp nhận chứng cứ từ hai bên. Ban Trọng tài sẽ đưa ra phán quyết giải ngân hoặc hoàn trả ký quỹ trong vòng 48 giờ làm việc.
                    </p>
                }
            </div>

            <!-- Tường trình chi tiết tranh chấp -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; background: #FFFFFF;">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-file-earmark-text text-danger me-2"></i>Nội dung khiếu nại chi tiết
                </h5>

                <div class="row g-3 small mb-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block mb-1">Người mở khiếu nại:</span>
                            <strong class="text-dark fs-6">@Model.CreatorUser.HotenUser</strong>
                            <div class="text-muted small">@Model.CreatorUser.EmailUser</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block mb-1">Bên bị khiếu nại:</span>
                            <strong class="text-dark fs-6">@(string.IsNullOrEmpty(Model.OpponentUser.HotenUser) ? "Đối tác hợp đồng" : Model.OpponentUser.HotenUser)</strong>
                            <div class="text-muted small">@Model.OpponentUser.EmailUser</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <strong class="text-secondary small d-block mb-1">Lý do tranh chấp:</strong>
                    <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-1">@Model.TranhChap.LyDo</span>
                </div>

                <div>
                    <strong class="text-secondary small d-block mb-1">Bản tường trình sự việc:</strong>
                    <div class="p-3 bg-light rounded-3 text-secondary" style="font-size: 0.92rem; line-height: 1.6;">
                        @Model.TranhChap.MoTaChiTiet
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KHO BẰNG CHỨNG & FORM NỘP BỔ SUNG -->
        <div class="col-lg-5">
            <!-- Form nộp bổ sung bằng chứng -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; background: #FFFFFF;">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-upload text-success me-2"></i>Bổ sung tài liệu bằng chứng
                </h5>

                <form method="post" asp-controller="TranhChap" asp-action="ThemBangChung">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maTranhChap" value="@Model.TranhChap.MaTranhChap" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Loại bằng chứng</label>
                        <select name="loaiBangChung" class="form-select" style="border-radius: 10px;">
                            <option value="AnhChup">Ảnh chụp màn hình (Screenshot)</option>
                            <option value="DoanChat">Lịch sử đoạn chat thỏa thuận</option>
                            <option value="TaiLieu">Tài liệu yêu cầu công việc</option>
                            <option value="FileLoi">Báo cáo kiểm thử / Code lỗi</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Đường dẫn tệp / Link ảnh (URL)</label>
                        <input type="text" name="duongDanFile" class="form-control" required placeholder="https://drive.google.com/..." style="border-radius: 10px;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mô tả tóm tắt</label>
                        <input type="text" name="moTa" class="form-control" placeholder="Mô tả bằng chứng này chứng minh điều gì..." style="border-radius: 10px;" />
                    </div>

                    <button type="submit" class="btn btn-outline-success fw-bold w-100 py-2" style="border-radius: 10px;">
                        <i class="bi bi-plus-lg me-1"></i> Tải lên bằng chứng
                    </button>
                </form>
            </div>

            <!-- Danh sách bằng chứng đã nộp -->
            <div class="card border-0 shadow-sm p-4" style="border-radius: 18px; background: #FFFFFF;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-paperclip text-primary me-2"></i>Kho tài liệu bằng chứng
                    </h5>
                    <span class="badge bg-light text-dark border">@Model.BangChungs.Count tệp</span>
                </div>

                @if (Model.BangChungs.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var bc in Model.BangChungs)
                        {
                            <div class="p-3 border rounded-3 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @bc.LoaiBangChung
                                    </span>
                                    <span class="text-muted small" style="font-size: 0.72rem;">
                                        @bc.NgayTaiLen.ToString("HH:mm dd/MM/yyyy")
                                    </span>
                                </div>
                                <div class="fw-semibold text-dark small mb-1">
                                    @(string.IsNullOrEmpty(bc.MoTa) ? "Tài liệu đính kèm vụ việc" : bc.MoTa)
                                </div>
                                <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                                    Tải lên bởi: <strong>@(bc.Uploader?.HotenUser ?? "Người dùng")</strong>
                                </div>
                                <a href="@bc.DuongDanFile" target="_blank" class="btn btn-sm btn-outline-secondary w-100" style="border-radius: 6px; font-size: 0.78rem;">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Xem tệp bằng chứng
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        Chưa có bằng chứng nào được tải lên.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
