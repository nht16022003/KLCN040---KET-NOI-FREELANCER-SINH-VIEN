@model MOCK.Models.ViewModels.LichSuGiaoDichViewModel
@{
    ViewData["Title"] = "Lịch sử biến động số dư & Giao dịch";
}

<div class="container py-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.88rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Wallet" asp-action="Index" class="text-decoration-none text-muted">Ví điện tử</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Lịch sử giao dịch</li>
        </ol>
    </nav>

    <!-- HEADER TITLE & QUICK ACTIONS -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-success me-2"></i>Lịch Sử Giao Dịch & Biến Động Số Dư
            </h3>
            <p class="text-muted small mb-0">
                Theo dõi tất cả dòng tiền nạp, rút, ký quỹ Escrow và thanh toán thù lao trong hệ thống.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Wallet" asp-action="NapTien" class="btn btn-success fw-bold px-3 py-2" style="border-radius: 10px; background-color: var(--primary-green, #3B6E53);">
                <i class="bi bi-plus-circle me-1"></i> Nạp tiền
            </a>
            <a asp-controller="Wallet" asp-action="HoTroNapTien" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 10px;">
                <i class="bi bi-headset me-1"></i> Hỗ trợ nạp tiền
            </a>
        </div>
    </div>

    <!-- FILTER & SEARCH CARD -->
    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: #FFFFFF;">
        <form method="get" asp-controller="Wallet" asp-action="LichSuGiaoDich" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Từ khóa tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 bg-light"
                           placeholder="Mã GD, nội dung..." style="font-size: 0.9rem;" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Loại giao dịch</label>
                <select name="loaiGiaoDich" class="form-select bg-light" style="font-size: 0.9rem;">
                    <option value="">-- Tất cả loại --</option>
                    <!option value="NapTien" @(Model.LoaiGiaoDich == "NapTien" ? "selected" : "")>Nạp tiền</!option>
                    <!option value="KyQuy" @(Model.LoaiGiaoDich == "KyQuy" ? "selected" : "")>Ký quỹ Escrow</!option>
                    <!option value="RutTien" @(Model.LoaiGiaoDich == "RutTien" ? "selected" : "")>Rút tiền</!option>
                    <!option value="NhanTien" @(Model.LoaiGiaoDich == "NhanTien" ? "selected" : "")>Nhận thù lao</!option>
                    <!option value="HoanTien" @(Model.LoaiGiaoDich == "HoanTien" ? "selected" : "")>Hoàn tiền</!option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Trạng thái</label>
                <select name="trangThai" class="form-select bg-light" style="font-size: 0.9rem;">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="ThanhCong" @(Model.TrangThai == "ThanhCong" ? "selected" : "")>Thành công</!option>
                    <!option value="DangXuLy" @(Model.TrangThai == "DangXuLy" ? "selected" : "")>Đang xử lý</!option>
                    <!option value="ThatBai" @(Model.TrangThai == "ThatBai" ? "selected" : "")>Thất bại</!option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Từ ngày</label>
                <input type="date" name="tuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control bg-light" style="font-size: 0.9rem;" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Đến ngày</label>
                <input type="date" name="denNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control bg-light" style="font-size: 0.9rem;" />
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-success flex-grow-1" title="Lọc" style="background-color: var(--primary-green, #3B6E53);">
                    <i class="bi bi-funnel-fill"></i>
                </button>
                <a asp-controller="Wallet" asp-action="LichSuGiaoDich" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- QUICK STATS BAR -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm border-start border-4 border-success rounded-3">
                <div class="text-muted small">Tổng tiền vào (Nạp + Nhận + Hoàn):</div>
                <div class="fw-bold text-success fs-5">+@Model.TongTienVao.ToString("#,##0") VNĐ</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm border-start border-4 border-danger rounded-3">
                <div class="text-muted small">Tổng tiền ra (Ký quỹ + Rút tiền):</div>
                <div class="fw-bold text-danger fs-5">-@Model.TongTienRa.ToString("#,##0") VNĐ</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-white shadow-sm border-start border-4 border-primary rounded-3">
                <div class="text-muted small">Tổng số lượng giao dịch:</div>
                <div class="fw-bold text-primary fs-5">@Model.TongSoGiaoDich giao dịch</div>
            </div>
        </div>
    </div>

    <!-- TRANSACTIONS TABLE -->
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 16px; background: #FFFFFF;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary" style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Mã GD / Tham chiếu</th>
                        <th class="py-3">Thời gian</th>
                        <th class="py-3">Loại giao dịch</th>
                        <th class="py-3">Nội dung chi tiết</th>
                        <th class="py-3">Phương thức</th>
                        <th class="text-end py-3">Số tiền</th>
                        <th class="text-end py-3">Số dư sau GD</th>
                        <th class="text-center pe-4 py-3">Trạng thái</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                    @if (Model.Transactions.Any())
                    {
                        @foreach (var item in Model.Transactions)
                        {
                            bool isPlus = item.LoaiGiaoDich == "NapTien" || item.LoaiGiaoDich == "NhanTien" || item.LoaiGiaoDich == "HoanTien";
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">#GD_@item.MaGiaoDich.ToString("D5")</span>
                                    @if (!string.IsNullOrEmpty(item.MaThamChieu))
                                    {
                                        <div class="text-muted small" style="font-size: 0.75rem;">Ref: @item.MaThamChieu</div>
                                    }
                                </td>
                                <td>
                                    <div>@item.NgayTao.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">@item.NgayTao.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    @if (item.LoaiGiaoDich == "NapTien")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-arrow-down-left me-1"></i>Nạp tiền</span>
                                    }
                                    else if (item.LoaiGiaoDich == "KyQuy")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-shield-lock me-1"></i>Ký quỹ Escrow</span>
                                    }
                                    else if (item.LoaiGiaoDich == "RutTien")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-arrow-up-right me-1"></i>Rút tiền</span>
                                    }
                                    else if (item.LoaiGiaoDich == "HoanTien")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-arrow-return-left me-1"></i>Hoàn tiền</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@item.LoaiGiaoDich</span>
                                    }
                                </td>
                                <td>
                                    <div class="text-dark fw-medium" style="max-width: 320px;">
                                        @item.NoiDung
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@(item.PhuongThuc ?? "Hệ thống")</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(isPlus ? "text-success" : "text-danger")">
                                        @(isPlus ? "+" : "-")@item.SoTien.ToString("#,##0") đ
                                    </span>
                                </td>
                                <td class="text-end text-muted fw-semibold">
                                    @item.SoDuSau.ToString("#,##0") đ
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.TrangThai == "ThanhCong")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Thành công</span>
                                    }
                                    else if (item.TrangThai == "DangXuLy")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Đang xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@item.TrangThai</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt-cutoff fs-1 d-block mb-2"></i>
                                Không tìm thấy giao dịch nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
