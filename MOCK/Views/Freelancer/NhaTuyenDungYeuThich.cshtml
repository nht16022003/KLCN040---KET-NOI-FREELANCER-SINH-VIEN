@model MOCK.Models.ViewModels.NhaTuyenDungYeuThichViewModel
@{
    ViewData["Title"] = "Nhà tuyển dụng quan tâm (Yêu thích)";
}

<div class="container py-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size: 0.88rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Freelancer" asp-action="HoSo" class="text-decoration-none text-muted">Freelancer</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Nhà tuyển dụng quan tâm</li>
        </ol>
    </nav>

    <!-- ALERT MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HERO BANNER -->
    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; background: linear-gradient(135deg, #1C382B 0%, #2A523E 60%, #3B6E53 100%); color: #FFFFFF;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark px-3 py-1 fw-bold" style="font-size: 0.8rem; border-radius: 20px;">
                        <i class="bi bi-building-fill-heart me-1"></i> Bookmark Doanh Nghiệp
                    </span>
                    <span class="badge bg-white text-success px-3 py-1 fw-bold" style="font-size: 0.8rem; border-radius: 20px;">
                        Đã lưu: @Model.TotalCount nhà tuyển dụng
                    </span>
                </div>
                <h2 class="fw-bold mb-2">Nhà Tuyển Dụng Quan Tâm (Yêu Thích)</h2>
                <p class="mb-0 text-white-50" style="font-size: 0.95rem; max-width: 650px;">
                    Theo dõi danh sách các doanh nghiệp, công ty uy tín bạn đã lưu để nhanh chóng đón nhận các cơ hội việc làm mới và gửi tin nhắn kết nối.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Employer" asp-action="Search" class="btn btn-light fw-bold px-4 py-2 text-success shadow-sm" style="border-radius: 30px;">
                    <i class="bi bi-search me-1"></i> Khám phá Doanh nghiệp
                </a>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 14px; background: #FFFFFF;">
        <form method="get" asp-controller="Freelancer" asp-action="NhaTuyenDungYeuThich" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 bg-light"
                           placeholder="Tìm theo tên công ty, địa chỉ, lĩnh vực, ghi chú..." style="border-radius: 0 10px 10px 0;" />
                </div>
            </div>

            <div class="col-md-3">
                <select name="linhVuc" class="form-select bg-light" style="border-radius: 10px;">
                    <option value="">-- Tất cả lĩnh vực --</option>
                    @foreach (var lv in Model.AllLinhVucs)
                    {
                        if (Model.SelectedLinhVuc == lv)
                        {
                            <option value="@lv" selected>@lv</option>
                        }
                        else
                        {
                            <option value="@lv">@lv</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="sortBy" class="form-select bg-light" style="border-radius: 10px;">
                    <option value="">Mới lưu nhất</option>
                    <!option value="rating_desc" @(Model.SortBy == "rating_desc" ? "selected" : "")>Đánh giá cao nhất</!option>
                    <!option value="jobs_desc" @(Model.SortBy == "jobs_desc" ? "selected" : "")>Nhiều việc làm nhất</!option>
                    <!option value="name_asc" @(Model.SortBy == "name_asc" ? "selected" : "")>Tên A-Z</!option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success flex-grow-1 fw-bold" style="border-radius: 10px; background-color: var(--primary-green, #3B6E53);">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.SelectedLinhVuc) || !string.IsNullOrWhiteSpace(Model.SortBy))
                {
                    <a asp-controller="Freelancer" asp-action="NhaTuyenDungYeuThich" class="btn btn-outline-secondary" title="Xóa bộ lọc" style="border-radius: 10px;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- EMPLOYER CARDS LIST -->
    @if (Model.DanhSachYeuThich != null && Model.DanhSachYeuThich.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.DanhSachYeuThich)
            {
                <div class="col-lg-6 col-xl-6">
                    <div class="card h-100 border-0 shadow-sm transition-hover" style="border-radius: 16px; border: 1px solid #EAEFF0; background: #FFFFFF;">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- TOP INFO -->
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <img src="~/@item.Logo" onerror="this.src='https://images.unsplash.com/photo-1549923746-c502d488b3ea?w=120&auto=format&fit=crop&q=80'"
                                     alt="@item.Tencongty" class="rounded-3 shadow-sm border" style="width: 68px; height: 68px; object-fit: cover; background: #FFF;" />

                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h5 class="fw-bold mb-0">
                                            <a asp-controller="Employer" asp-action="Profile" asp-route-id="@item.MaNhaTuyenDung" class="text-decoration-none text-dark hover-green">
                                                @item.Tencongty
                                            </a>
                                        </h5>
                                        <!-- ACTION NÚT BỎ LƯU -->
                                        <form asp-controller="Freelancer" asp-action="XoaNhaTuyenDungYeuThich" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn bỏ lưu nhà tuyển dụng @item.Tencongty khỏi danh sách quan tâm?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maBookMark" value="@item.MaBookMark" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1" title="Bỏ lưu khỏi danh sách yêu thích">
                                                <i class="bi bi-heart-fill fs-5 text-danger"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <div class="text-muted mb-1" style="font-size: 0.85rem;">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @(string.IsNullOrEmpty(item.Diachi) ? "TP. Hồ Chí Minh" : item.Diachi)
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.8rem;">
                                        <span class="badge bg-light text-success border border-success-subtle fw-semibold">
                                            <i class="bi bi-tag-fill me-1"></i> @item.Linhvuc
                                        </span>
                                        <span class="badge bg-warning text-dark fw-semibold">
                                            <i class="bi bi-star-fill text-dark me-1"></i> @(item.Sosaodanhgia?.ToString("0.0") ?? "5.0")
                                        </span>
                                        <span class="badge bg-primary-subtle text-primary-emphasis fw-semibold">
                                            <i class="bi bi-briefcase-fill me-1"></i> @item.ActiveJobsCount việc đang tuyển
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- BIO / INTRO -->
                            @if (!string.IsNullOrWhiteSpace(item.Gioithieu))
                            {
                                <p class="text-muted small mb-3 text-truncate-2" style="font-size: 0.86rem; line-height: 1.4;">
                                    @item.Gioithieu
                                </p>
                            }

                            <!-- GHI CHÚ RIÊNG CỦA FREELANCER -->
                            <div class="p-3 mb-3" style="background: #F8FAF9; border-radius: 12px; border-left: 4px solid var(--primary-green, #3B6E53);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold text-success" style="font-size: 0.88rem;">
                                        <i class="bi bi-person-lines-fill me-1"></i> Đại diện: @item.HotenNguoiDaiDien
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock-history me-1"></i> Đã lưu @item.NgayLuu.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="d-flex align-items-start justify-content-between mt-2 pt-2 border-top border-light-subtle">
                                    <div class="text-dark small" style="font-size: 0.82rem;">
                                        <strong class="text-secondary"><i class="bi bi-sticky-fill text-warning me-1"></i> Ghi chú riêng:</strong>
                                        <span class="text-muted fst-italic" id="ntd-note-@item.MaBookMark">
                                            @(string.IsNullOrWhiteSpace(item.GhiChu) ? "Chưa có ghi chú nào cho nhà tuyển dụng này." : item.GhiChu)
                                        </span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 ms-2 text-decoration-none"
                                            data-bs-toggle="modal" data-bs-target="#editNtdNoteModal"
                                            data-bookmark-id="@item.MaBookMark"
                                            data-company-name="@item.Tencongty"
                                            data-note-text="@item.GhiChu"
                                            title="Sửa ghi chú">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                </div>
                            </div>

                            <!-- ACTION BUTTONS -->
                            <div class="mt-auto pt-2 d-flex gap-2">
                                <a asp-controller="Employer" asp-action="Profile" asp-route-id="@item.MaNhaTuyenDung"
                                   class="btn btn-sm btn-outline-success flex-grow-1 fw-bold" style="border-radius: 8px;">
                                    <i class="bi bi-building me-1"></i> Xem Công Ty
                                </a>

                                <a asp-controller="NhanTin" asp-action="Index" asp-route-userId="@item.MaUser"
                                   class="btn btn-sm btn-success flex-grow-1 fw-bold" style="border-radius: 8px; background-color: var(--primary-green, #3B6E53);">
                                    <i class="bi bi-chat-dots-fill me-1"></i> Nhắn tin
                                </a>

                                @if (!string.IsNullOrEmpty(item.Link))
                                {
                                    <a href="@item.Link" target="_blank" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;" title="Truy cập Website công ty">
                                        <i class="bi bi-globe"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="card border-0 shadow-sm py-5 text-center my-4" style="border-radius: 18px; background: #FFFFFF;">
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle" style="width: 80px; height: 80px;">
                        <i class="bi bi-building-heart fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2">Chưa có Nhà tuyển dụng nào trong danh sách quan tâm</h4>
                <p class="text-muted mb-4 mx-auto" style="max-width: 500px; font-size: 0.95rem;">
                    Khi bạn tìm kiếm và thấy các doanh nghiệp uy tín với các dự án phù hợp, hãy nhấn biểu tượng <strong>Lưu nhà tuyển dụng</strong> để theo dõi tại đây.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Employer" asp-action="Search" class="btn btn-success fw-bold px-4 py-2" style="border-radius: 25px; background-color: var(--primary-green, #3B6E53);">
                        <i class="bi bi-search me-1"></i> Khám phá Nhà tuyển dụng
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- MODAL: CHỈNH SỬA GHI CHÚ CHO NHÀ TUYỂN DỤNG -->
<!-- ========================================== -->
<div class="modal fade" id="editNtdNoteModal" tabindex="-1" aria-labelledby="editNtdNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <form asp-controller="Freelancer" asp-action="CapNhatGhiChuNTD" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maBookMark" id="modalNtdBookmarkId" value="" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editNtdNoteModalLabel">
                        <i class="bi bi-sticky-fill text-warning me-1"></i> Ghi chú riêng về Nhà tuyển dụng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-muted small mb-2">
                        Doanh nghiệp: <strong class="text-dark" id="modalNtdCompanyName"></strong>
                    </p>
                    <div class="mb-3">
                        <label for="modalNtdGhiChuInput" class="form-label fw-semibold" style="font-size: 0.88rem;">Nội dung ghi chú cá nhân:</label>
                        <textarea class="form-control" name="ghiChu" id="modalNtdGhiChuInput" rows="4"
                                  placeholder="Nhập ghi chú riêng: Công nghệ công ty hay tuyển, mức đãi ngộ, người liên hệ HR..."
                                  style="border-radius: 10px; font-size: 0.9rem;"></textarea>
                        <div class="form-text" style="font-size: 0.78rem;">Ghi chú này chỉ có mình bạn nhìn thấy.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success fw-bold px-4" style="border-radius: 8px; background-color: var(--primary-green, #3B6E53);">
                        <i class="bi bi-check-lg me-1"></i> Lưu ghi chú
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }
    .hover-green:hover {
        color: var(--primary-green, #3B6E53) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@section Scripts {
    <script>
        const editNtdNoteModal = document.getElementById('editNtdNoteModal');
        if (editNtdNoteModal) {
            editNtdNoteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const bookmarkId = button.getAttribute('data-bookmark-id');
                const companyName = button.getAttribute('data-company-name');
                const noteText = button.getAttribute('data-note-text') || '';

                document.getElementById('modalNtdBookmarkId').value = bookmarkId;
                document.getElementById('modalNtdCompanyName').textContent = companyName;
                document.getElementById('modalNtdGhiChuInput').value = noteText;
            });
        }
    </script>
}
