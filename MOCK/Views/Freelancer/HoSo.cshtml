@model MOCK.Models.ViewModels.StudentProfileEditViewModel
@{
    ViewData["Title"] = "Cài đặt hồ sơ & Kỹ năng nhận việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-edit-page {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 30px 0 60px;
    }

    .edit-card {
        background: #FFFFFF;
        border: 1px solid #E5ECE7;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    }

    .btn-save-profile {
        background-color: #1B5E36;
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 12px 36px;
        border-radius: 30px;
        border: none;
        box-shadow: 0 4px 14px rgba(27, 94, 54, 0.25);
        transition: all 0.2s;
    }

    .btn-save-profile:hover {
        background-color: #14492A;
        transform: translateY(-1px);
    }
</style>

<div class="profile-edit-page">
    <div class="container">
        
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                
                <div class="edit-card">
                    
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">Cập nhật hồ sơ & Kỹ năng nhận việc</h2>
                            <p class="text-muted small mb-0">Tối ưu thông tin cá nhân để thu hút nhiều doanh nghiệp tìm đến (khớp bảng `FreelancerStudents`).</p>
                        </div>

                        <a href="/Freelancer/Profile/@Model.Student.MaFreelancerStudents" class="btn btn-outline-success rounded-pill px-3">
                            <i class="bi bi-person me-1"></i> Xem hồ sơ của tôi
                        </a>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Freelancer" asp-action="HoSo" method="post">
                        @Html.AntiForgeryToken()

                        <!-- PHẦN 1: THÔNG TIN CÁ NHÂN -->
                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="bi bi-person-fill text-success me-2"></i>1. Thông tin cá nhân
                            </h5>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Họ và tên <span class="text-danger">*</span></label>
                                    <input asp-for="HotenUser" class="form-control rounded-3" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Số điện thoại liên hệ</label>
                                    <input asp-for="SdtUser" class="form-control rounded-3" placeholder="0901234567" />
                                </div>
                            </div>
                        </div>

                        <!-- PHẦN 2: THIẾT LẬP NHẬN VIỆC & MỨC THÙ LAO -->
                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="bi bi-toggle-on text-success me-2"></i>2. Trạng thái & Mức thù lao khởi điểm
                            </h5>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="p-3 bg-light rounded-3 border h-100 d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="fw-bold text-dark small mb-1">Sẵn sàng nhận việc freelance</div>
                                            <div class="text-muted" style="font-size: 0.78rem;">Bật để hồ sơ của bạn hiển thị trên trang Khám phá Freelancer.</div>
                                        </div>
                                        <div class="form-check form-switch fs-4 mb-0">
                                            <input asp-for="TrangthaiNhanViec" class="form-check-input" type="checkbox" role="switch">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="p-3 bg-light rounded-3 border h-100">
                                        <label class="form-label fw-bold text-dark small mb-1">Mức giá / thù lao từ (VNĐ/dự án)</label>
                                        <div class="input-group">
                                            <input asp-for="ChiPhiTu" type="number" step="50000" class="form-control rounded-start-3" placeholder="100000" />
                                            <span class="input-group-text bg-white">VNĐ</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PHẦN 3: GIỚI THIỆU & KỸ NĂNG -->
                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="bi bi-tools text-success me-2"></i>3. Kỹ năng & Giới thiệu bản thân
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small">Giới thiệu bản thân (Bio)</label>
                                <textarea asp-for="Gioithieu" class="form-control rounded-3" rows="4" placeholder="Giới thiệu điểm mạnh, kinh nghiệm làm đồ án và mục tiêu nghề nghiệp của bạn..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small">Kỹ năng chuyên môn (bảng `KynangChuyennganh_FreelancerStudent`)</label>
                                <input asp-for="NewSkillsInput" class="form-control rounded-3" placeholder="Ví dụ: C#, ASP.NET Core, SQL Server, Flutter, Photoshop" />
                                <span class="text-muted" style="font-size: 0.78rem;">Phân cách các kỹ năng bằng dấu phẩy.</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Kỹ năng cơ bản / Tin học văn phòng</label>
                                    <input asp-for="KyNangCoBan" class="form-control rounded-3" placeholder="Word, Excel, PowerPoint" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold text-dark small">Ngoại ngữ</label>
                                    <input asp-for="NgonNgu" class="form-control rounded-3" placeholder="Tiếng Anh, Tiếng Nhật..." />
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/Freelancer/Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                                Quay lại Dashboard
                            </a>
                            <button type="submit" class="btn-save-profile">
                                <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi hồ sơ
                            </button>
                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>
