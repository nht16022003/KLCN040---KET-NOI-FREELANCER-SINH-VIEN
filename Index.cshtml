@using FreelancerStudent.Web.ViewModels.Chat
@model ChatIndexViewModel

@{
    ViewData["Title"] = "Tin nhắn & Trao đổi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeRoom = Model.PhongHienTai;
}

<div class="container-fluid py-3 px-lg-4">
    <div class="card border rounded-0 shadow-sm bg-white overflow-hidden" style="height: calc(100vh - 140px); min-height: 600px;">
        <div class="row g-0 h-100">

            <!-- CỘT TRÁI: DANH SÁCH HỘI THOẠI -->
            <div class="col-12 col-lg-4 col-xl-3 border-end d-flex flex-column h-100 bg-light @(activeRoom != null ? "d-none d-lg-flex" : "")">
                <!-- Header danh sách -->
                <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-success mb-0">
                        Hội thoại (@Model.DanhSachPhong.Count)
                    </h6>
                </div>

                <!-- Ô tìm kiếm cuộc trò chuyện -->
                <div class="p-2 border-bottom bg-white">
                    <input type="text" id="searchConversation" class="form-control form-control-sm rounded-0" placeholder="Tìm kiếm người dùng...">
                </div>

                <!-- Danh sách các phòng chat -->
                <div class="overflow-y-auto flex-grow-1" id="conversationList">
                    @if (Model.DanhSachPhong != null && Model.DanhSachPhong.Count > 0)
                    {
                        @foreach (var room in Model.DanhSachPhong)
                        {
                            bool isCurrentActive = activeRoom != null && activeRoom.maPhongChat == room.maPhongChat;
                            
                            // Xác định đối phương là ai (nếu mình là Client thì đối phương là Freelancer và ngược lại)
                            bool isMeClient = Model.CurrentUserId == room.maUserClient;
                            string partnerName = isMeClient ? (room.tenFreelancer ?? "Freelancer") : (room.tenClient ?? "Nhà tuyển dụng");
                            string partnerAvatar = (isMeClient ? room.avatarFreelancer : room.avatarClient)
                                ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(partnerName)}&background=E8F5E9&color=1B5E36";

                            <a href="/Chat?maPhongChat=@room.maPhongChat" 
                               class="d-block p-3 border-bottom text-decoration-none transition-all conversation-item @(isCurrentActive ? "bg-white border-start border-4 border-success shadow-sm" : "text-dark hover-bg")">
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Avatar -->
                                    <div class="position-relative">
                                        <img src="@partnerAvatar" alt="@partnerName" 
                                             class="border rounded-0" style="width: 44px; height: 44px; object-fit: cover;" />
                                        @if (room.soTinNhanChuaDoc > 0)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-0 bg-danger border border-white" style="font-size: 0.65rem;">
                                                @room.soTinNhanChuaDoc
                                            </span>
                                        }
                                    </div>

                                    <!-- Thông tin tóm tắt -->
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 text-truncate fw-bold @(isCurrentActive ? "text-success" : "text-dark")" style="font-size: 0.9rem;">
                                                @partnerName
                                            </h6>
                                            <small class="text-muted" style="font-size: 0.72rem;">
                                                @(room.thoiGianTinNhanCuoi?.ToString("HH:mm dd/MM") ?? "")
                                            </small>
                                        </div>

                                        @if (!string.IsNullOrEmpty(room.tieuDeJob))
                                        {
                                            <div class="text-truncate text-muted small mb-1" style="font-size: 0.75rem;">
                                                Việc: @room.tieuDeJob
                                            </div>
                                        }

                                        <p class="mb-0 text-truncate small text-secondary" style="font-size: 0.8rem;">
                                            @(room.tinNhanCuoi ?? "Chưa có tin nhắn")
                                        </p>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted px-3">
                            <p class="small mb-0">Chưa có cuộc trò chuyện nào.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI: KHUNG CHAT CHI TIẾT -->
            <div class="col-12 col-lg-8 col-xl-9 d-flex flex-column h-100 bg-white @(activeRoom == null ? "d-none d-lg-flex" : "")">
                @if (activeRoom != null)
                {
                    bool isMeClientActive = Model.CurrentUserId == activeRoom.maUserClient;
                    string partnerNameActive = isMeClientActive ? (activeRoom.tenFreelancer ?? "Freelancer") : (activeRoom.tenClient ?? "Nhà tuyển dụng");
                    string partnerAvatarActive = (isMeClientActive ? activeRoom.avatarFreelancer : activeRoom.avatarClient)
                        ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(partnerNameActive)}&background=E8F5E9&color=1B5E36";

                    <!-- 1. Header Khung Chat -->
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                        <div class="d-flex align-items-center gap-2 gap-lg-3">
                            <!-- Nút quay lại danh sách trên màn hình nhỏ/thu gọn -->
                            <a href="/Chat" class="btn btn-sm btn-light border d-lg-none rounded-0 px-2 py-1 text-decoration-none text-dark small fw-bold" title="Quay lại danh sách">
                                &larr; Danh sách
                            </a>
                            <img src="@partnerAvatarActive" alt="@partnerNameActive" 
                                 class="border rounded-0" style="width: 48px; height: 48px; object-fit: cover;" />
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@partnerNameActive</h6>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="badge @(isMeClientActive ? "bg-primary-subtle text-primary border border-primary" : "bg-success-subtle text-success border border-success") rounded-0" style="font-size: 0.72rem;">
                                        @(isMeClientActive ? "Ứng viên Freelancer" : "Nhà tuyển dụng")
                                    </span>
                                    @if (!string.IsNullOrEmpty(activeRoom.tieuDeJob))
                                    {
                                        <span class="badge bg-white text-secondary border rounded-0 text-truncate" style="font-size: 0.72rem; max-width: 280px;">
                                            Việc: @activeRoom.tieuDeJob
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Nút thao tác mở hồ sơ & Tệp chia sẻ -->
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-0 px-3 py-1" id="btnOpenSharedFiles" data-bs-toggle="modal" data-bs-target="#sharedFilesModal" title="Xem danh sách tệp đính kèm trong phòng">
                                <i class="bi bi-paperclip me-1"></i> Tệp đã chia sẻ
                            </button>
                            @if (isMeClientActive && activeRoom.maFreelancerStudent > 0)
                            {
                                <a href="/FreelancerStudent/Profile/@activeRoom.maFreelancerStudent" target="_blank" 
                                   class="btn btn-sm btn-success rounded-0 fw-semibold px-3" style="background-color: #1B5E36; border-color: #1B5E36;">
                                    Xem chi tiết hồ sơ
                                </a>
                            }
                            else if (!isMeClientActive && activeRoom.maUserClient > 0)
                            {
                                <a href="/NhaTuyenDung/Search" class="btn btn-sm btn-outline-secondary rounded-0">
                                    Khám phá NTD
                                </a>
                            }
                        </div>
                    </div>

                    <!-- BANNER THÔNG TIN CÔNG VIỆC ĐANG TRAO ĐỔI (NẾU CÓ) -->
                    @if (!string.IsNullOrEmpty(activeRoom.maJob))
                    {
                        <div class="px-3 py-2 bg-light border-bottom d-flex justify-content-between align-items-center border-start border-4 border-success">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <span class="badge bg-success text-white rounded-0" style="font-size: 0.72rem; background-color: #1B5E36 !important;">
                                    #@activeRoom.maJob
                                </span>
                                <span class="fw-bold text-dark small text-truncate">
                                    @(activeRoom.tieuDeJob ?? "Công việc tuyển dụng")
                                </span>
                                @if (activeRoom.thulaoJob.HasValue && activeRoom.thulaoJob > 0)
                                {
                                    <span class="text-danger fw-bold small ms-1">
                                        (@activeRoom.thulaoJob.Value.ToString("#,##0") VNĐ)
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                @if (isMeClientActive)
                                {
                                    <a href="/NhaTuyenDung/DanhSachUngVien?maJob=@activeRoom.maJob" class="btn btn-sm btn-outline-success rounded-0 py-1 px-3 fw-semibold text-nowrap" style="font-size: 0.75rem;">
                                        Duyệt ứng viên bài này
                                    </a>
                                }
                                else
                                {
                                    <a href="/JobPost/UngTuyen?maJob=@activeRoom.maJob" class="btn btn-sm btn-success rounded-0 py-1 px-3 fw-semibold text-nowrap" style="font-size: 0.75rem; background-color: #1B5E36; border-color: #1B5E36;">
                                        Xem bài & Ứng tuyển
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- 2. Danh sách tin nhắn (Body chat) -->
                    <div class="flex-grow-1 p-3 overflow-y-auto bg-white" id="messageContainer" style="background-color: #fafafa !important;">
                        <div id="messagesList" class="d-flex flex-column gap-3">
                            @if (Model.LichSuTinNhan != null && Model.LichSuTinNhan.Count > 0)
                            {
                                @foreach (var msg in Model.LichSuTinNhan)
                                {
                                    bool isMyMsg = msg.maNguoiGui == Model.CurrentUserId;

                                    <div class="d-flex @(isMyMsg ? "justify-content-end" : "justify-content-start") message-item" data-id="@msg.maTinNhan">
                                        <div class="d-flex gap-2 max-w-75" style="max-width: 75%;">
                                            @if (!isMyMsg)
                                            {
                                                var senderAvatar = !string.IsNullOrEmpty(msg.avatarNguoiGui)
                                                    ? msg.avatarNguoiGui
                                                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(msg.tenNguoiGui ?? "User")}&background=E8F5E9&color=1B5E36";

                                                <img src="@senderAvatar" alt="@msg.tenNguoiGui" 
                                                     class="border rounded-0 align-self-end mb-1" style="width: 32px; height: 32px; object-fit: cover;" />
                                            }

                                            <div>
                                                <div class="p-3 rounded-0 shadow-sm @(isMyMsg ? "bg-success text-white" : "bg-white text-dark border")" 
                                                     style="@(isMyMsg ? "background-color: #1B5E36 !important;" : "")">
                                                    @if (!isMyMsg)
                                                    {
                                                        <div class="fw-bold mb-1 text-success" style="font-size: 0.75rem;">@msg.tenNguoiGui</div>
                                                    }
                                                    <div class="text-break" style="font-size: 0.9rem; white-space: pre-line;">@msg.noiDung</div>

                                                    @if (!string.IsNullOrEmpty(msg.fileDinhKem))
                                                    {
                                                        var ext = System.IO.Path.GetExtension(msg.fileDinhKem).ToLowerInvariant();
                                                        var isImg = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg" }.Contains(ext) || msg.loaiTinNhan == "Image";
                                                        var rawFileName = System.IO.Path.GetFileName(msg.fileDinhKem);

                                                        if (isImg)
                                                        {
                                                            <div class="mt-2">
                                                                <a href="@msg.fileDinhKem" target="_blank" title="Bấm để xem ảnh phóng to">
                                                                    <img src="@msg.fileDinhKem" alt="Ảnh đính kèm" class="img-fluid rounded border bg-light" style="max-height: 220px; max-width: 100%; object-fit: contain;" />
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="mt-2 p-2 rounded @(isMyMsg ? "bg-white text-dark bg-opacity-25" : "bg-light border") d-flex align-items-center justify-content-between gap-2">
                                                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                                                    <i class="bi bi-file-earmark-arrow-down fs-5 @(isMyMsg ? "text-white" : "text-success")"></i>
                                                                    <span class="small fw-semibold text-truncate @(isMyMsg ? "text-white" : "text-dark")" style="max-width: 180px;" title="@rawFileName">@rawFileName</span>
                                                                </div>
                                                                <a href="@msg.fileDinhKem" download target="_blank" class="btn btn-sm @(isMyMsg ? "btn-light text-success fw-bold" : "btn-outline-success") rounded-0 py-0 px-2 small text-nowrap">
                                                                    Tải về
                                                                </a>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                <div class="small text-muted mt-1 px-1 @(isMyMsg ? "text-end" : "text-start")" style="font-size: 0.7rem;">
                                                    @msg.ngayGui.ToString("HH:mm - dd/MM/yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted empty-chat">
                                    <p class="mb-0">Hãy bắt đầu gửi tin nhắn trao đổi đầu tiên!</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 3. Khung nhập tin nhắn (Footer) -->
                    <div class="p-3 border-top bg-light">
                        <!-- Khu vực preview tệp đã chọn -->
                        <div id="attachmentPreview" class="d-none mb-2 p-2 bg-white border rounded d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <i id="previewFileIcon" class="bi bi-file-earmark-text text-success fs-5"></i>
                                <span id="previewFileName" class="small fw-bold text-truncate" style="max-width: 280px;"></span>
                                <span id="previewFileSize" class="badge bg-secondary rounded-pill small"></span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger border-0 py-0 px-1" id="btnCancelAttachment" title="Hủy bỏ đính kèm">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>

                        <form id="chatForm" class="d-flex gap-2 align-items-center">
                            <input type="hidden" id="currentRoomId" value="@activeRoom.maPhongChat" />
                            <input type="file" id="fileInput" class="d-none" accept=".jpg,.jpeg,.png,.gif,.webp,.svg,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.7z" />
                            
                            
                            
                            <button type="button"
                                    id="btnAttach"
                                    class="btn btn-success d-flex align-items-center justify-content-center"
                                    title="Đính kèm tệp"
                                    aria-label="Đính kèm tệp"
                                    style="background-color: #1B5E36;
                                        border-color: #1B5E36;
                                        width: 48px;
                                        height: 42px;
                                        flex-shrink: 0;">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                    width="23"
                                    height="23"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="white"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true">
                                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.82-2.83l8.49-8.48"/>
                                </svg>

                            </button>


                            
                            <input type="text" id="messageInput" class="form-control rounded-0 border py-2" 
                                   placeholder="Nhập nội dung trao đổi... (Nhấn Enter để gửi)" autocomplete="off" />
                            <button type="submit" id="btnSend" class="btn btn-success rounded-0 px-4 py-2 fw-semibold" style="background-color: #1B5E36; border-color: #1B5E36;">
                                Gửi
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted p-4">
                        <div class="p-4 border bg-light text-center rounded-0" style="max-width: 400px;">
                            <h6 class="fw-bold text-dark mb-1">Chưa chọn cuộc trò chuyện</h6>
                            <p class="small text-muted mb-0">Vui lòng chọn một cuộc hội thoại bên trái hoặc liên hệ ứng viên từ danh sách để bắt đầu nhắn tin.</p>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- MODAL XEM DANH SÁCH TỆP ĐÃ CHIA SẺ TRONG PHÒNG CHAT -->
<div class="modal fade" id="sharedFilesModal" tabindex="-1" aria-labelledby="sharedFilesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content rounded-0">
            <div class="modal-header border-bottom bg-light">
                <h6 class="modal-title fw-bold text-success mb-0" id="sharedFilesModalLabel">
                    <i class="bi bi-folder2-open me-2"></i> Tệp đính kèm đã chia sẻ trong phòng
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <div class="text-center py-4 text-muted" id="sharedFilesLoading">
                    <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                    <span>Đang tải danh sách tệp...</span>
                </div>
                <div id="sharedFilesEmpty" class="text-center py-5 text-muted d-none">
                    <i class="bi bi-file-earmark-x fs-1 d-block mb-2 text-secondary"></i>
                    <p class="mb-0">Chưa có tệp đính kèm nào được chia sẻ trong cuộc trò chuyện này.</p>
                </div>
                <div id="sharedFilesList" class="d-flex flex-column gap-2"></div>
            </div>
            <div class="modal-footer border-top p-2 bg-light">
                <button type="button" class="btn btn-sm btn-secondary rounded-0 px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-bg:hover {
        background-color: #e9ecef !important;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const currentUserId = @Model.CurrentUserId;
        const currentRoomId = document.getElementById("currentRoomId") ? parseInt(document.getElementById("currentRoomId").value) : 0;
        window.currentChatRoomId = currentRoomId;
        const messageContainer = document.getElementById("messageContainer");
        const messagesList = document.getElementById("messagesList");
        const chatForm = document.getElementById("chatForm");
        const messageInput = document.getElementById("messageInput");
        const btnSend = document.getElementById("btnSend");

        // Các thành phần đính kèm file
        const fileInput = document.getElementById("fileInput");
        const btnAttach = document.getElementById("btnAttach");
        const attachmentPreview = document.getElementById("attachmentPreview");
        const previewFileName = document.getElementById("previewFileName");
        const previewFileSize = document.getElementById("previewFileSize");
        const previewFileIcon = document.getElementById("previewFileIcon");
        const btnCancelAttachment = document.getElementById("btnCancelAttachment");

        // Cuộn xuống đáy khung chat
        function scrollToBottom() {
            if (messageContainer) {
                messageContainer.scrollTop = messageContainer.scrollHeight;
            }
        }
        scrollToBottom();

        // Xử lý chọn file đính kèm
        if (btnAttach && fileInput) {
            btnAttach.addEventListener("click", () => fileInput.click());

            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    if (file.size > 20 * 1024 * 1024) {
                        alert("Dung lượng file vượt quá 20MB! Vui lòng chọn file nhỏ hơn.");
                        this.value = "";
                        return;
                    }
                    previewFileName.textContent = file.name;
                    const sizeKB = (file.size / 1024).toFixed(1);
                    previewFileSize.textContent = sizeKB > 1024 ? (sizeKB / 1024).toFixed(1) + " MB" : sizeKB + " KB";
                    
                    const ext = file.name.split('.').pop().toLowerCase();
                    if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
                        previewFileIcon.className = "bi bi-file-earmark-image text-success fs-5";
                    } else if (['pdf'].includes(ext)) {
                        previewFileIcon.className = "bi bi-file-earmark-pdf text-danger fs-5";
                    } else if (['zip', 'rar', '7z'].includes(ext)) {
                        previewFileIcon.className = "bi bi-file-earmark-zip text-warning fs-5";
                    } else {
                        previewFileIcon.className = "bi bi-file-earmark-text text-primary fs-5";
                    }

                    attachmentPreview.classList.remove("d-none");
                }
            });

            btnCancelAttachment.addEventListener("click", function () {
                fileInput.value = "";
                attachmentPreview.classList.add("d-none");
            });
        }

        // 1. KHỞI TẠO KẾT NỐI SIGNALR TỚI API CHATHUB
        const API_URL = "http://localhost:5152"; // Cổng API
        const ketNoiChat = new signalR.HubConnectionBuilder()
            .withUrl(`${API_URL}/chatHub`)
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        // 2. LẮNG NGHE SỰ KIỆN TỪ SERVER (TIẾNG VIỆT)
        ketNoiChat.on("NhanTinNhanMoi", function (msg) {
            console.log("Đã nhận tin nhắn mới từ SignalR:", msg);
            if (parseInt(msg.maPhongChat) === currentRoomId) {
                const isMyMsg = parseInt(msg.maNguoiGui) === currentUserId;
                appendMessage(msg, isMyMsg);
                scrollToBottom();
            }
        });

        ketNoiChat.onreconnected(async () => {
            console.log("Đã kết nối lại SignalR!");
            if (currentRoomId > 0) {
                await ketNoiChat.invoke("ThamGiaPhongChat", currentRoomId);
            }
        });

        // 3. BẮT ĐẦU KẾT NỐI VÀ THAM GIA PHÒNG CHAT
        async function batDauKetNoi() {
            try {
                if (ketNoiChat.state === signalR.HubConnectionState.Disconnected) {
                    await ketNoiChat.start();
                    console.log("Đã kết nối SignalR ChatHub thành công!");
                }

                if (currentRoomId > 0) {
                    await ketNoiChat.invoke("ThamGiaPhongChat", currentRoomId);
                    await ketNoiChat.invoke("DanhDauDaDoc", currentRoomId, currentUserId);
                }
            } catch (err) {
                console.error("Lỗi kết nối SignalR:", err);
                setTimeout(batDauKetNoi, 3000);
            }
        }
        batDauKetNoi();

        // 4. GỬI TIN NHẮN (CÓ HỖ TRỢ UPLOAD FILE)
        if (chatForm) {
            chatForm.addEventListener("submit", async function (e) {
                e.preventDefault();
                const text = messageInput.value.trim();
                const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

                if (!text && !hasFile) return;
                if (currentRoomId === 0) return;

                btnSend.disabled = true;
                const originalBtnText = btnSend.innerHTML;
                btnSend.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang gửi...';

                try {
                    let uploadedFileUrl = null;
                    let loaiTinNhan = "Text";
                    let noiDungGui = text;

                    // Nếu có file đính kèm, upload lên trước
                    if (hasFile) {
                        const formData = new FormData();
                        formData.append("file", fileInput.files[0]);

                        const uploadRes = await fetch("/Chat/UploadFile", {
                            method: "POST",
                            body: formData
                        });
                        const uploadData = await uploadRes.json();

                        if (!uploadData.success || !uploadData.data) {
                            alert(uploadData.message || "Tải tệp đính kèm thất bại!");
                            btnSend.disabled = false;
                            btnSend.innerHTML = originalBtnText;
                            return;
                        }

                        uploadedFileUrl = uploadData.data.fileUrl;
                        loaiTinNhan = uploadData.data.loaiTinNhan || uploadData.data.loaiFile || "File";
                        if (!noiDungGui) {
                            noiDungGui = uploadData.data.fileName || uploadData.data.tenFile || "[Tệp đính kèm]";
                        }

                        // Reset file input & preview
                        fileInput.value = "";
                        attachmentPreview.classList.add("d-none");
                    }

                    messageInput.value = "";

                    // Gửi tin nhắn qua SignalR hoặc fallback AJAX
                    try {
                        if (ketNoiChat.state !== signalR.HubConnectionState.Connected) {
                            await batDauKetNoi();
                        }
                        await ketNoiChat.invoke("GuiTinNhan", currentRoomId, currentUserId, noiDungGui, uploadedFileUrl, loaiTinNhan);
                    } catch (hubErr) {
                        console.warn("SignalR không khả dụng, gửi qua AJAX:", hubErr);
                        const response = await fetch("/Chat/GuiTinNhan", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                maPhongChat: currentRoomId,
                                noiDung: noiDungGui,
                                fileDinhKem: uploadedFileUrl,
                                loaiTinNhan: loaiTinNhan
                            })
                        });
                        const res = await response.json();
                        if (res.success && res.data) {
                            appendMessage(res.data, true);
                            scrollToBottom();
                        } else {
                            alert(res.message || "Không thể gửi tin nhắn!");
                        }
                    }
                } catch (err) {
                    console.error("Lỗi khi gửi tin nhắn:", err);
                    alert("Có lỗi xảy ra khi gửi tin nhắn: " + err.message);
                } finally {
                    btnSend.disabled = false;
                    btnSend.innerHTML = originalBtnText;
                    messageInput.focus();
                }
            });
        }

        // 5. Render tin nhắn vào DOM
        function appendMessage(msg, isMyMsg) {
            const emptyNotice = document.querySelector(".empty-chat");
            if (emptyNotice) emptyNotice.remove();

            if (document.querySelector(`.message-item[data-id="${msg.maTinNhan}"]`)) return;

            let timeStr = "";
            if (msg.ngayGui) {
                const d = new Date(msg.ngayGui);
                if (!isNaN(d.getTime())) {
                    timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' - ' + d.toLocaleDateString();
                } else {
                    timeStr = msg.ngayGui;
                }
            } else {
                timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' - ' + new Date().toLocaleDateString();
            }

            const avatarUrl = msg.avatarNguoiGui || `https://ui-avatars.com/api/?name=${encodeURIComponent(msg.tenNguoiGui || 'User')}&background=E8F5E9&color=1B5E36`;

            let attachmentHtml = "";
            if (msg.fileDinhKem) {
                const ext = msg.fileDinhKem.split('.').pop().toLowerCase();
                const isImg = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext) || msg.loaiTinNhan === "Image";
                const rawName = msg.fileDinhKem.split('/').pop();

                if (isImg) {
                    attachmentHtml = `
                        <div class="mt-2">
                            <a href="${msg.fileDinhKem}" target="_blank" title="Bấm để xem ảnh phóng to">
                                <img src="${msg.fileDinhKem}" alt="Ảnh đính kèm" class="img-fluid rounded border bg-light" style="max-height: 220px; max-width: 100%; object-fit: contain;" />
                            </a>
                        </div>
                    `;
                } else {
                    attachmentHtml = `
                        <div class="mt-2 p-2 rounded ${isMyMsg ? "bg-white text-dark bg-opacity-25" : "bg-light border"} d-flex align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <i class="bi bi-file-earmark-arrow-down fs-5 ${isMyMsg ? "text-white" : "text-success"}"></i>
                                <span class="small fw-semibold text-truncate ${isMyMsg ? "text-white" : "text-dark"}" style="max-width: 180px;" title="${rawName}">${rawName}</span>
                            </div>
                            <a href="${msg.fileDinhKem}" download target="_blank" class="btn btn-sm ${isMyMsg ? "btn-light text-success fw-bold" : "btn-outline-success"} rounded-0 py-0 px-2 small text-nowrap">
                                Tải về
                            </a>
                        </div>
                    `;
                }
            }

            const wrapper = document.createElement("div");
            wrapper.className = `d-flex ${isMyMsg ? "justify-content-end" : "justify-content-start"} message-item`;
            wrapper.setAttribute("data-id", msg.maTinNhan);

            let html = `
                <div class="d-flex gap-2 max-w-75" style="max-width: 75%;">
                    ${!isMyMsg ? `<img src="${avatarUrl}" class="border rounded-0 align-self-end mb-1" style="width: 32px; height: 32px; object-fit: cover;" />` : ''}
                    <div>
                        <div class="p-3 rounded-0 shadow-sm ${isMyMsg ? 'bg-success text-white' : 'bg-white text-dark border'}" 
                             style="${isMyMsg ? 'background-color: #1B5E36 !important;' : ''}">
                            ${!isMyMsg ? `<div class="fw-bold mb-1 text-success" style="font-size: 0.75rem;">${msg.tenNguoiGui || 'Người dùng'}</div>` : ''}
                            <div class="text-break" style="font-size: 0.9rem; white-space: pre-line;">${msg.noiDung || ''}</div>
                            ${attachmentHtml}
                        </div>
                        <div class="small text-muted mt-1 px-1 ${isMyMsg ? 'text-end' : 'text-start'}" style="font-size: 0.7rem;">
                            ${timeStr}
                        </div>
                    </div>
                </div>
            `;
            wrapper.innerHTML = html;
            messagesList.appendChild(wrapper);
        }

        // 6. Xử lý Modal Xem Tệp đã chia sẻ
        const sharedFilesModal = document.getElementById("sharedFilesModal");
        if (sharedFilesModal) {
            sharedFilesModal.addEventListener("show.bs.modal", async function () {
                const loading = document.getElementById("sharedFilesLoading");
                const empty = document.getElementById("sharedFilesEmpty");
                const list = document.getElementById("sharedFilesList");

                loading.classList.remove("d-none");
                empty.classList.add("d-none");
                list.innerHTML = "";

                try {
                    const response = await fetch(`/Chat/DanhSachFile?maPhongChat=${currentRoomId}`);
                    const res = await response.json();

                    loading.classList.add("d-none");

                    if (res.success && res.data && res.data.length > 0) {
                        res.data.forEach(item => {
                            const d = new Date(item.ngayGui);
                            const timeStr = !isNaN(d.getTime()) ? d.toLocaleDateString() + " " + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : item.ngayGui;
                            const ext = item.fileUrl.split('.').pop().toLowerCase();
                            let iconClass = "bi bi-file-earmark-text text-primary";
                            if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) iconClass = "bi bi-file-earmark-image text-success";
                            else if (['pdf'].includes(ext)) iconClass = "bi bi-file-earmark-pdf text-danger";
                            else if (['zip', 'rar', '7z'].includes(ext)) iconClass = "bi bi-file-earmark-zip text-warning";

                            const div = document.createElement("div");
                            div.className = "p-2 border rounded bg-white d-flex align-items-center justify-content-between gap-3";
                            div.innerHTML = `
                                <div class="d-flex align-items-center gap-3 overflow-hidden">
                                    <i class="${iconClass} fs-3"></i>
                                    <div class="overflow-hidden">
                                        <div class="fw-bold text-dark text-truncate small" title="${item.tenFile}">${item.tenFile}</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">Người gửi: <span class="text-success fw-semibold">${item.tenNguoiGui}</span> • ${timeStr}</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="${item.fileUrl}" target="_blank" class="btn btn-sm btn-outline-secondary rounded-0 py-1 px-2 small">
                                        <i class="bi bi-eye"></i> Mở
                                    </a>
                                    <a href="${item.fileUrl}" download target="_blank" class="btn btn-sm btn-success rounded-0 py-1 px-3 small fw-bold" style="background-color: #1B5E36; border-color: #1B5E36;">
                                        <i class="bi bi-download"></i> Tải về
                                    </a>
                                </div>
                            `;
                            list.appendChild(div);
                        });
                    } else {
                        empty.classList.remove("d-none");
                    }
                } catch (err) {
                    loading.classList.add("d-none");
                    empty.classList.remove("d-none");
                    console.error("Lỗi khi tải tệp:", err);
                }
            });
        }

        // 7. Lọc danh sách hội thoại bên trái
        const searchInput = document.getElementById("searchConversation");
        if (searchInput) {
            searchInput.addEventListener("input", function (e) {
                const keyword = e.target.value.toLowerCase();
                document.querySelectorAll(".conversation-item").forEach(item => {
                    const text = item.innerText.toLowerCase();
                    if (text.includes(keyword)) {
                        item.classList.remove("d-none");
                    } else {
                        item.classList.add("d-none");
                    }
                });
            });
        }
    </script>
}
