@model FreelancerStudent.Web.ViewModels.FreelancerStudentProfileViewModel
@{
    var isProfileOwner = ViewData["IsProfileOwner"] is bool owner && owner;
}

<div id="duan" class="section-card profile-portfolio-content">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h5 class="section-card-title mb-1">
                <i class="bi bi-folder2-open text-success me-2"></i>Portfolio
            </h5>
            <p class="text-muted small mb-0">Các dự án đã thực hiện</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-muted border">@Model.DuAns.Count dự án</span>
            @if (isProfileOwner)
            {
                <a asp-controller="FreelancerStudent" asp-action="Portfolio" class="btn btn-sm btn-outline-success rounded-pill">
                    <i class="bi bi-pencil me-1"></i>Quản lý Portfolio
                </a>
            }
        </div>
    </div>

    <div class="border rounded-4 p-3 mb-4 bg-light-subtle">
        <h6 class="fw-bold text-dark mb-2">
            <i class="bi bi-file-person text-success me-2"></i>Giới thiệu Portfolio
        </h6>
        <p class="text-secondary mb-0" style="line-height: 1.6;">
            @(Model.Portfolio?.MoTaBanThan ?? "Chưa cập nhật phần giới thiệu Portfolio.")
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Portfolio?.Url_video))
    {
        <div class="border rounded-4 p-3 mb-4 bg-light-subtle">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-play-btn text-success me-2"></i>Video giới thiệu
            </h6>
            @if (Model.Portfolio.Url_video.Contains("youtube.com", StringComparison.OrdinalIgnoreCase) ||
                 Model.Portfolio.Url_video.Contains("youtu.be", StringComparison.OrdinalIgnoreCase))
            {
                <div class="ratio ratio-16x9">
                    <iframe src="@Model.Portfolio.Url_video"
                            title="Video giới thiệu Portfolio"
                            allowfullscreen></iframe>
                </div>
            }
            else
            {
                <a href="@Model.Portfolio.Url_video" target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-success btn-sm rounded-pill">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Mở video giới thiệu
                </a>
            }
        </div>
    }

    @if (!Model.DuAns.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-folder-plus display-5"></i>
            <h6 class="fw-bold mt-2">Chưa có dự án nào</h6>
            <p class="small mb-0">Portfolio chưa có dự án được công khai.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var project in Model.DuAns)
            {
                <div class="col-12 col-md-6">
                    <div class="border rounded-4 p-3 h-100 bg-white">
                        @if (project.LaDuAnNoiBat)
                        {
                            <span class="badge text-bg-warning mb-2"><i class="bi bi-star-fill me-1"></i>Dự án nổi bật</span>
                        }
                        <h6 class="fw-bold text-dark mb-1">@project.TenDuAn</h6>
                        <div class="text-muted small mb-2">@project.VaiTro</div>
                        <p class="text-secondary small mb-2">@project.MoTa</p>
                        <div class="small text-muted mb-3"><strong>Công nghệ:</strong> @project.Congnghe</div>
                        <div class="d-flex gap-2 pt-2 border-top">
                            @if (!string.IsNullOrWhiteSpace(project.LinkGithub))
                            {
                                <a href="@project.LinkGithub" target="_blank" rel="noopener" class="btn btn-sm btn-outline-dark rounded-pill">
                                    <i class="bi bi-github me-1"></i>Github
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(project.LinkDemo))
                            {
                                <a href="@project.LinkDemo" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="bi bi-link-45deg me-1"></i>Demo
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
