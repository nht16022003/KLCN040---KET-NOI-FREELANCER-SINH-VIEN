@using FreelancerStudent.Web.Services.Interfaces
@inject IWalletWebService WalletWebService
@inject IThongBaoWebService ThongBaoWebService
@inject IChatWebService ChatWebService
@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("tenRole");
    var userName = Context.Session.GetString("hovaten") ?? "Tài khoản";
    var userRoleTitle = Context.Session.GetString("tenRole") ?? "";
    var userAvatar = Context.Session.GetString("UserAvatar");
    if (string.IsNullOrWhiteSpace(userAvatar))
    {
        userAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(userName)}&background=E8F5E9&color=1B5E36";
    }
    var maUserDangNhap = Context.Session.GetInt32("maUser");

    decimal soDuKhaDung = 0;
    int soThongBaoChuaDoc = 0;
    int soTinNhanChuaDoc = 0;
    List<FreelancerStudent.Web.ViewModels.ThongBaoViewModel> danhSachThongBaoHeader = new();

    var maUser = Context.Session.GetInt32("maUser");

    if (maUser.HasValue && (role == "NhaTuyenDung" || role == "FreelancerStudent"))
    {
        var ketQuaVi = await WalletWebService.layViTheoUser(maUser.Value);

        if (ketQuaVi.success && ketQuaVi.data != null)
        {
            soDuKhaDung = ketQuaVi.data.soDuKhaDung;
        }

        try
        {
            var ketQuaTB = await ThongBaoWebService.DemChuaDocAsync(maUser.Value);
            if (ketQuaTB.success)
            {
                soThongBaoChuaDoc = ketQuaTB.data;
            }

            var danhSachTB = await ThongBaoWebService.LayDanhSachAsync(maUser.Value, 1);
            if (danhSachTB.success && danhSachTB.data?.danhSach != null)
            {
                danhSachThongBaoHeader = danhSachTB.data.danhSach;
            }
        }
        catch {}

        try
        {
            var ketQuaTN = await ChatWebService.DemTinNhanChuaDocAsync(maUser.Value);
            if (ketQuaTN.success)
            {
                soTinNhanChuaDoc = ketQuaTN.data;
            }
        }
        catch {}
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreelancerStudent</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
            :root {
                --primary-green: #3B6E53;
                --primary-green-dark: #2A523E;
                --primary-green-light: #EBF4F0;
                --primary-green-hover: #325E47;
                --text-dark: #1E293B;
                --text-muted: #64748B;
                --border-color: #E2E8F0;
                --card-bg: #FFFFFF;
                --body-bg: #FAFCFB;

                --bs-border-radius: 0 !important;
                --bs-border-radius-sm: 0 !important;
                --bs-border-radius-lg: 0 !important;
                --bs-border-radius-xl: 0 !important;
                --bs-border-radius-xxl: 0 !important;
                --bs-border-radius-2xl: 0 !important;
                --bs-border-radius-pill: 0 !important;
            }

            *,
            *::before,
            *::after,
            html *,
            body *,
            .btn,
            .form-control,
            .form-select,
            .input-group,
            .input-group-text,
            .card,
            .modal-content,
            .dropdown-menu,
            .badge,
            .alert,
            .rounded,
            .rounded-1,
            .rounded-2,
            .rounded-3,
            .rounded-4,
            .rounded-5,
            .rounded-pill,
            .rounded-circle {
                border-radius: 0 !important;
                box-sizing: border-box;
            }

            body {
                font-family: var(--font-sans);
                background-color: var(--body-bg);
                color: var(--text-dark);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ============================================================ */
            /* AUTH & DEFAULT GUEST NAVBAR                                  */
            /* ============================================================ */
            .auth-header {
                background: #FFFFFF;
                border-bottom: 1px solid #EEF2F6;
                padding: 14px 0;
            }

            .brand-logo {
                font-size: 1.35rem;
                font-weight: 800;
                color: #0F172A;
                text-decoration: none;
                letter-spacing: -0.5px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .brand-logo span {
                color: var(--primary-green);
            }

            .nav-link-custom {
                color: #475569;
                font-size: 0.95rem;
                font-weight: 500;
                text-decoration: none;
                padding: 6px 14px;
                transition: color 0.2s;
            }

            .nav-link-custom:hover {
                color: var(--primary-green);
            }

            .btn-header-login {
                background: #FFFFFF;
                border: 1px solid #D0D7DE;
                color: #334155;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 7px 20px;
                border-radius: 0;
                text-decoration: none;
                transition: all 0.2s;
            }

            .btn-header-login:hover {
                border-color: var(--primary-green);
                color: var(--primary-green);
                background: var(--primary-green-light);
            }

            .btn-header-register {
                background: var(--primary-green);
                border: 1px solid var(--primary-green);
                color: #FFFFFF;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 7px 22px;
                border-radius: 0;
                text-decoration: none;
                transition: all 0.2s;
            }

            .btn-header-register:hover {
                background: var(--primary-green-dark);
                color: #FFFFFF;
            }

            /* ============================================================ */
            /* LOGGED IN TOP NAVBAR (EMPLOYER & FREELANCER)                 */
            /* ============================================================ */
            .portal-header {
                background: #FFFFFF;
                border-bottom: 1px solid #E5ECE7;
                padding: 8px 0;
            }

            .search-pill-btn {
                background-color: #FFFFFF;
                border: 0;
                border-radius: 0;
                padding: 6px 14px;
                font-size: 0.86rem;
                font-weight: 600;
                color: #0F172A;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                transition: all 0.2s ease;
                cursor: pointer;
            }

            .search-pill-btn:hover {
                background-color: #F8FAFC;
                color: #0F172A;
            }

            .portal-nav-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 0.92rem;
                font-weight: 600;
                color: #2D3748;
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 0;
                transition: all 0.2s ease;
            }

            .portal-nav-link i {
                font-size: 1.15rem;
                color: #334155;
            }

            .portal-nav-link:hover {
                color: var(--primary-green);
                background-color: #F8FAF9;
            }

            .notification-dropdown {
                width: min(360px, calc(100vw - 24px));
                padding: 0;
                white-space: normal;
            }

            .notification-dropdown-list {
                max-height: 360px;
                overflow-y: auto;
            }

            .notification-dropdown-item {
                display: block;
                padding: 12px 16px;
                white-space: normal;
                border-bottom: 1px solid #E5ECE7;
            }

            .notification-dropdown-item strong,
            .notification-dropdown-item span,
            .notification-dropdown-item time {
                display: block;
            }

            .notification-dropdown-item strong,
            .notification-dropdown-item span {
                font-size: 1rem;
            }

            .notification-dropdown-item span {
                color: #475569;
                overflow-wrap: anywhere;
            }

            .notification-dropdown-item time {
                margin-top: 4px;
                color: #64748B;
                font-size: 0.875rem;
            }

            .notification-dropdown-item.notification-unread {
                background-color: #F0F7F2;
            }

            .notification-see-all {
                display: inline-flex;
                min-height: 44px;
                align-items: center;
                justify-content: center;
                color: var(--primary-green);
                font-size: 1rem;
                font-weight: 700;
                text-decoration: none;
            }

            .notification-see-all:hover {
                text-decoration: underline;
            }

            .portal-icon-btn {
                width: 38px;
                height: 38px;
                border-radius: 0;
                background: #F1F5F9;
                color: #334155;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                text-decoration: none;
                transition: all 0.2s ease;
                position: relative;
            }

            .portal-icon-btn:hover {
                background: #E2E8F0;
                color: #0F172A;
            }

            .btn-portal-action-green {
                background-color: #297746;
                color: #FFFFFF !important;
                font-weight: 700;
                font-size: 0.88rem;
                padding: 8px 22px;
                border-radius: 0;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s ease;
                box-shadow: 0 4px 12px rgba(41, 119, 70, 0.2);
                white-space: nowrap;
            }

            .btn-portal-action-green:hover {
                background-color: #1F5F36;
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(41, 119, 70, 0.3);
            }

            .portal-user-profile {
                display: flex;
                align-items: center;
                gap: 10px;
                grid-column: 1 / -1;
                grid-row: 1;
                text-decoration: none;
                padding: 2px 28px 2px 6px;
                border-radius: 0;
                border: 0;
                background: transparent;
                color: inherit;
                font: inherit;
                cursor: pointer;
                transition: background 0.2s;
            }

            .portal-user-profile:hover {
                background: #F8FAFC;
            }

            .portal-user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 0;
                object-fit: cover;
                border: 2px solid #E2E8F0;
            }

            .portal-user-info {
                display: flex;
                flex-direction: column;
                text-align: left;
            }

            .portal-user-name {
                font-size: 0.85rem;
                font-weight: 700;
                color: #0F172A;
                line-height: 1.2;
            }

            .portal-user-tag {
                font-size: 0.72rem;
                color: #64748B;
                font-weight: 500;
            }

            .balance-visibility-toggle {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                min-height: 32px;
                padding: 2px 0;
                border: 0;
                background: transparent;
                color: #1B5E36;
                font: inherit;
                text-align: left;
                cursor: pointer;
            }

            .balance-visibility-toggle i {
                font-size: 1rem;
                color: #1B5E36;
            }

            .portal-user-profile-wrapper {
                position: relative;
                display: grid;
                grid-template-columns: max-content 44px;
                align-items: center;
            }

            .portal-user-profile-card {
                grid-column: 1;
                grid-row: 1;
                display: grid;
                grid-template-columns: 38px max-content;
                grid-template-rows: auto auto;
                align-items: center;
                column-gap: 10px;
                padding: 2px 6px;
                background: #FFFFFF;
            }

            .portal-user-identity {
                display: contents;
            }

            .portal-user-identity .portal-user-avatar {
                grid-column: 1;
                grid-row: 1 / 3;
                align-self: center;
                justify-self: center;
            }

            .portal-user-identity .portal-user-info {
                grid-column: 2;
                grid-row: 1;
                transform: translateY(3px);
            }

            .portal-profile-menu-toggle {
                grid-column: 2;
                grid-row: 1;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 44px;
                min-height: 44px;
                padding: 0;
                border: 0;
                background: transparent;
                color: #0F172A;
                cursor: pointer;
            }

            .portal-profile-menu-toggle.dropdown-toggle::after {
                margin-left: 0;
            }

            .portal-profile-menu-toggle:focus-visible {
                outline: 2px solid #2B7A4B;
                outline-offset: 2px;
            }

            .portal-user-balance {
                display: inline-flex;
                align-items: center;
                white-space: nowrap;
            }

            .portal-user-balance-toggle {
                min-width: 44px;
                min-height: 32px;
                justify-content: flex-start;
                padding-left: 4px;
            }

            .portal-user-balance-row {
                display: flex;
                align-items: center;
                gap: 2px;
                grid-column: 2;
                grid-row: 2;
                margin-top: -6px;
            }

            .balance-visibility-toggle:focus-visible {
                outline: 2px solid #2B7A4B;
                outline-offset: 2px;
            }

            /* ============================================================ */
            /* GROUPED PROFILE NAVIGATION                                  */
            /* ============================================================ */
            .portal-profile-dropdown {
                width: max-content;
                min-width: 20rem;
                max-width: calc(100vw - 1rem);
                max-height: min(70vh, 640px);
                overflow-y: auto;
                overflow-x: auto;
            }

            .portal-profile-dropdown .dropdown-item:active {
                color: #0F172A;
                background-color: #F1F5F9;
            }

            .portal-profile-dropdown details > summary {
                cursor: pointer;
                list-style: none;
                white-space: nowrap;
            }

            .portal-profile-dropdown details > summary::-webkit-details-marker {
                display: none;
            }

            .portal-profile-dropdown details > summary::after {
                content: "▾";
                float: right;
                margin-left: 1rem;
            }

            .portal-profile-dropdown details[open] > summary::after {
                content: "▴";
            }

            .portal-profile-submenu {
                list-style: none;
                margin: 0;
                padding-left: 0.75rem;
            }

            .portal-profile-submenu .dropdown-item {
                white-space: nowrap;
            }

            /* ============================================================ */
            /* AUTH HERO & FORMS (LOGIN & REGISTER)                         */
            /* ============================================================ */
            .auth-main-container {
                flex: 1;
                padding: 40px 0 60px;
            }

            /* LEFT COLUMN: HERO */
            .hero-title-main {
                font-size: 2.75rem;
                font-weight: 800;
                line-height: 1.15;
                color: var(--primary-green);
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .hero-title-outlined {
                color: transparent;
                -webkit-text-stroke: 2px var(--primary-green);
                font-weight: 800;
            }

            .hero-subtitle {
                color: #475569;
                font-size: 1.1rem;
                font-weight: 500;
                margin-top: 12px;
                margin-bottom: 30px;
            }

            .feature-item {
                display: flex;
                align-items: flex-start;
                gap: 16px;
                margin-bottom: 22px;
            }

            .feature-icon-box {
                width: 46px;
                height: 46px;
                border-radius: 0;
                background: #E2ECE6;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--primary-green-dark);
                font-size: 1.25rem;
                flex-shrink: 0;
            }

            .feature-title {
                font-weight: 700;
                font-size: 1.02rem;
                color: #1E293B;
                margin-bottom: 2px;
            }

            .feature-desc {
                color: #64748B;
                font-size: 0.9rem;
                line-height: 1.4;
            }

            .hero-illustration-box {
                position: relative;
                margin-top: 30px;
                max-width: 480px;
            }

            .hero-student-img {
                width: 100%;
                height: auto;
                border-radius: 0;
                object-fit: cover;
                box-shadow: 0 12px 36px rgba(59, 110, 83, 0.12);
            }

            .doodle-badge,
            .doodle-text-badge {
                font-family: var(--font-sans);
                color: var(--primary-green-dark);
                font-size: 1.65rem;
                font-weight: 700;
                line-height: 1.15;
                position: absolute;
                top: 20px;
                left: -20px;
                background: rgba(255, 255, 255, 0.95);
                padding: 8px 16px;
                border-radius: 0;
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
                transform: rotate(-6deg);
                z-index: 2;
            }

            /* RIGHT COLUMN: AUTH CARD */
            .login-card-container {
                background: #FFFFFF;
                border: 1px solid #E8EFF2;
                border-radius: 0;
                padding: 40px 36px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
            }

            .login-card-title {
                font-size: 1.75rem;
                font-weight: 800;
                color: #1E293B;
                text-align: center;
                margin-bottom: 6px;
            }

            .login-card-subtitle {
                color: #64748B;
                font-size: 0.92rem;
                text-align: center;
                margin-bottom: 26px;
            }

            .btn-social {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                padding: 11px 16px;
                border-radius: 0;
                border: 1px solid #E2E8F0;
                background: #FFFFFF;
                color: #334155;
                font-weight: 600;
                font-size: 0.92rem;
                margin-bottom: 12px;
                transition: all 0.2s ease;
                text-decoration: none;
                cursor: pointer;
            }

            .btn-social:hover {
                background: #F8FAFC;
                border-color: #CBD5E1;
                color: #0F172A;
                transform: translateY(-1px);
            }

            .auth-divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin: 20px 0;
                color: #94A3B8;
                font-size: 0.85rem;
            }

            .auth-divider::before,
            .auth-divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #E2E8F0;
            }

            .auth-divider span {
                padding: 0 14px;
            }

            .form-label-auth {
                font-size: 0.9rem;
                font-weight: 600;
                color: #1E293B;
                margin-bottom: 6px;
                display: block;
            }

            .input-group-auth {
                position: relative;
                display: flex;
                align-items: center;
                margin-bottom: 18px;
            }

            .input-icon-left {
                position: absolute;
                left: 14px;
                color: #94A3B8;
                font-size: 1.1rem;
                z-index: 5;
            }

            .form-control-auth {
                width: 100%;
                height: 48px;
                padding: 10px 14px 10px 42px;
                border-radius: 0;
                border: 1px solid #CBD5E1;
                font-size: 0.92rem;
                color: #1E293B;
                background-color: #FFFFFF;
                transition: all 0.2s ease;
            }

            .form-control-auth:focus {
                outline: none;
                border-color: var(--primary-green);
                box-shadow: 0 0 0 3px rgba(59, 110, 83, 0.12);
            }

            .input-icon-right {
                position: absolute;
                right: 14px;
                color: #94A3B8;
                cursor: pointer;
                font-size: 1.1rem;
                z-index: 5;
                background: none;
                border: none;
                padding: 0;
            }

            .input-icon-right:hover {
                color: #475569;
            }

            .auth-options-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
                font-size: 0.88rem;
            }

            .form-check-input-green:checked {
                background-color: var(--primary-green);
                border-color: var(--primary-green);
            }

            .link-forgot {
                color: var(--primary-green);
                text-decoration: none;
                font-weight: 600;
            }

            .link-forgot:hover {
                text-decoration: none;
            }

            .btn-submit-auth {
                width: 100%;
                height: 50px;
                border-radius: 0;
                background: var(--primary-green);
                color: #FFFFFF;
                border: none;
                font-weight: 700;
                font-size: 1.02rem;
                transition: all 0.2s ease;
                box-shadow: 0 6px 18px rgba(59, 110, 83, 0.25);
                cursor: pointer;
            }

            .btn-submit-auth:hover {
                background: var(--primary-green-dark);
                transform: translateY(-1px);
                box-shadow: 0 8px 22px rgba(59, 110, 83, 0.32);
            }

            .auth-footer-text {
                text-align: center;
                margin-top: 18px;
                font-size: 0.9rem;
                color: #64748B;
            }

            .auth-footer-text a {
                color: var(--primary-green);
                font-weight: 700;
                text-decoration: none;
            }

            .auth-footer-text a:hover {
                text-decoration: none;
            }

            .admin-login-box {
                text-align: center;
                margin-top: 24px;
                padding-top: 18px;
                border-top: 1px dashed #E2E8F0;
                font-size: 0.85rem;
                color: #64748B;
            }

            .admin-login-box a {
                color: var(--primary-green);
                font-weight: 700;
                text-decoration: none;
                display: inline-block;
                margin-top: 4px;
            }

            .quick-fill-section {
                background: #F8FAFC;
                border: 1px dashed #CBD5E1;
                border-radius: 0;
                padding: 10px 14px;
                margin-top: 18px;
            }

            /* ============================================================ */
            /* FOOTER                                                       */
            /* ============================================================ */
            .main-footer {
                background: #FFFFFF;
                border-top: 1px solid #EEF2F6;
                padding: 50px 0 24px;
                margin-top: auto;
            }

            .footer-brand {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--primary-green-dark);
                margin-bottom: 10px;
            }

            .footer-desc {
                color: #64748B;
                font-size: 0.88rem;
                line-height: 1.5;
                margin-bottom: 16px;
            }

            .footer-social-links a {
                color: #64748B;
                font-size: 1.15rem;
                margin-right: 14px;
                transition: color 0.2s;
                text-decoration: none;
            }

            .footer-social-links a:hover {
                color: var(--primary-green);
                text-decoration: none;
            }

            .footer-heading {
                font-size: 0.95rem;
                font-weight: 700;
                color: #1E293B;
                margin-bottom: 16px;
            }

            .footer-links {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: #64748B;
                font-size: 0.88rem;
                transition: color 0.2s;
                text-decoration: none;
            }

