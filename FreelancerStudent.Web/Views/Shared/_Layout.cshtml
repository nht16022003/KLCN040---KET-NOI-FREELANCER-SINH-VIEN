@using FreelancerStudent.Web.Services.Interfaces
@inject IWalletWebService WalletWebService
@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("tenRole");
    var userName = Context.Session.GetString("hovaten") ?? (role == "NhaTuyenDung" ? "tuan_depzai" : "Son_ko_thogminh");
    var userRoleTitle = Context.Session.GetString("tenRole") ?? (role == "NhaTuyenDung" ? "Nhà tuyển dụng" :
"Freelancer Student");
    var userAvatar = Context.Session.GetString("UserAvatar");
    if (string.IsNullOrWhiteSpace(userAvatar))
    {
        userAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(userName)}&background=E8F5E9&color=1B5E36";
    }
    var maUserDangNhap = Context.Session.GetInt32("maUser");

    decimal soDuKhaDung = 0;

    var maUser = Context.Session.GetInt32("maUser");

    if (maUser.HasValue && role == "NhaTuyenDung")
    {
        var ketQuaVi = await WalletWebService.layViTheoUser(maUser.Value);

        if (ketQuaVi.success && ketQuaVi.data != null)
        {
            soDuKhaDung = ketQuaVi.data.soDuKhaDung;
        }
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Freelancer Students</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Caveat:wght@600;700&display=swap"
    rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
            :root {
                --primary-green: #3B6E53;
                --primary-green-dark: #2A523E;
                --primary-green-light: #EBF4F0;
                --primary-green-hover: #325E47;
                --text-dark: #1E293B;
                --text-muted: #64748B;
                --border-color: #E2E8F0;
                --card-bg: #FFFFFF;
                --body-bg: #FAFCFB;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                background-color: var(--body-bg);
                color: var(--text-dark);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ============================================================ */
            /* AUTH & DEFAULT GUEST NAVBAR                                  */
            /* ============================================================ */
            .auth-header {
                background: #FFFFFF;
                border-bottom: 1px solid #EEF2F6;
                padding: 14px 0;
            }

            .brand-logo {
                font-size: 1.35rem;
                font-weight: 800;
                color: #0F172A;
                text-decoration: none;
                letter-spacing: -0.5px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .brand-logo span {
                color: var(--primary-green);
            }

            .nav-link-custom {
                color: #475569;
                font-size: 0.95rem;
                font-weight: 500;
                text-decoration: none;
                padding: 6px 14px;
                transition: color 0.2s;
            }

            .nav-link-custom:hover {
                color: var(--primary-green);
            }

            .btn-header-login {
                background: #FFFFFF;
                border: 1px solid #D0D7DE;
                color: #334155;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 7px 20px;
                border-radius: 30px;
                text-decoration: none;
                transition: all 0.2s;
            }

            .btn-header-login:hover {
                border-color: var(--primary-green);
                color: var(--primary-green);
                background: var(--primary-green-light);
            }

            .btn-header-register {
                background: var(--primary-green);
                border: 1px solid var(--primary-green);
                color: #FFFFFF;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 7px 22px;
                border-radius: 30px;
                text-decoration: none;
                transition: all 0.2s;
            }

            .btn-header-register:hover {
                background: var(--primary-green-dark);
                color: #FFFFFF;
            }

            /* ============================================================ */
            /* LOGGED IN TOP NAVBAR (EMPLOYER & FREELANCER)                 */
            /* ============================================================ */
            .portal-header {
                background: #FFFFFF;
                border-bottom: 1px solid #E5ECE7;
                padding: 12px 0;
            }

            .search-pill-btn {
                background-color: #DDEAE1;
                border: 1px solid #C4D9CD;
                border-radius: 8px;
                padding: 6px 14px;
                font-size: 0.86rem;
                font-weight: 600;
                color: #26593D;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                transition: all 0.2s ease;
                cursor: pointer;
            }

            .search-pill-btn:hover {
                background-color: #CFE2D4;
                color: #1A442D;
            }

            .portal-nav-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 0.92rem;
                font-weight: 600;
                color: #2D3748;
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

            .portal-nav-link i {
                font-size: 1.15rem;
                color: #334155;
            }

            .portal-nav-link:hover {
                color: var(--primary-green);
                background-color: #F8FAF9;
            }

            .portal-icon-btn {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #F1F5F9;
                color: #334155;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                text-decoration: none;
                transition: all 0.2s ease;
                position: relative;
            }

            .portal-icon-btn:hover {
                background: #E2E8F0;
                color: #0F172A;
            }

            .btn-portal-action-green {
                background-color: #297746;
                color: #FFFFFF !important;
                font-weight: 700;
                font-size: 0.88rem;
                padding: 8px 22px;
                border-radius: 30px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s ease;
                box-shadow: 0 4px 12px rgba(41, 119, 70, 0.2);
                white-space: nowrap;
            }

            .btn-portal-action-green:hover {
                background-color: #1F5F36;
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(41, 119, 70, 0.3);
            }

            .portal-user-profile {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                padding: 2px 6px;
                border-radius: 30px;
                transition: background 0.2s;
            }

            .portal-user-profile:hover {
                background: #F8FAFC;
            }

            .portal-user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #E2E8F0;
            }

            .portal-user-info {
                display: flex;
                flex-direction: column;
                text-align: left;
            }

            .portal-user-name {
                font-size: 0.85rem;
                font-weight: 700;
                color: #0F172A;
                line-height: 1.2;
            }

            .portal-user-tag {
                font-size: 0.72rem;
                color: #64748B;
                font-weight: 500;
            }

            /* ============================================================ */
            /* SUBNAVBAR DÀNH CHO ROLE PORTALS                              */
            /* ============================================================ */
            .portal-subnav {
                background-color: #EEF6F1;
                border-bottom: 1px solid #DFECE3;
                padding: 8px 0;
            }

            .subnav-link-active {
                background-color: #1E6E38;
                color: #FFFFFF !important;
                font-weight: 700;
                font-size: 0.85rem;
                padding: 6px 18px;
                border-radius: 20px;
                text-decoration: none;
                display: inline-block;
            }

            .subnav-link {
                color: #556B5D;
                font-weight: 600;
                font-size: 0.86rem;
                padding: 6px 14px;
                text-decoration: none;
                display: inline-block;
                transition: all 0.2s ease;
                border-radius: 20px;
            }

            .subnav-link:hover {
                color: #1E6E38;
                background-color: rgba(30, 110, 56, 0.08);
            }

            /* ============================================================ */
            /* AUTH HERO & FORMS (LOGIN & REGISTER)                         */
            /* ============================================================ */
            .auth-main-container {
                flex: 1;
                padding: 40px 0 60px;
            }

            /* LEFT COLUMN: HERO */
            .hero-title-main {
                font-size: 2.75rem;
                font-weight: 800;
                line-height: 1.15;
                color: var(--primary-green);
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .hero-title-outlined {
                color: transparent;
                -webkit-text-stroke: 2px var(--primary-green);
                font-weight: 800;
            }

            .hero-subtitle {
                color: #475569;
                font-size: 1.1rem;
                font-weight: 500;
                margin-top: 12px;
                margin-bottom: 30px;
            }

            .feature-item {
                display: flex;
                align-items: flex-start;
                gap: 16px;
                margin-bottom: 22px;
            }

            .feature-icon-box {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: #E2ECE6;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--primary-green-dark);
                font-size: 1.25rem;
                flex-shrink: 0;
            }

            .feature-title {
                font-weight: 700;
                font-size: 1.02rem;
                color: #1E293B;
                margin-bottom: 2px;
            }

            .feature-desc {
                color: #64748B;
                font-size: 0.9rem;
                line-height: 1.4;
            }

            .hero-illustration-box {
                position: relative;
                margin-top: 30px;
                max-width: 480px;
            }

            .hero-student-img {
                width: 100%;
                height: auto;
                border-radius: 20px;
                object-fit: cover;
                box-shadow: 0 12px 36px rgba(59, 110, 83, 0.12);
            }

            .doodle-badge,
            .doodle-text-badge {
                font-family: 'Caveat', cursive;
                color: var(--primary-green-dark);
                font-size: 1.65rem;
                font-weight: 700;
                line-height: 1.15;
                position: absolute;
                top: 20px;
                left: -20px;
                background: rgba(255, 255, 255, 0.95);
                padding: 8px 16px;
                border-radius: 12px;
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
                transform: rotate(-6deg);
                z-index: 2;
            }

            /* RIGHT COLUMN: AUTH CARD */
            .login-card-container {
                background: #FFFFFF;
                border: 1px solid #E8EFF2;
                border-radius: 24px;
                padding: 40px 36px;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
            }

            .login-card-title {
                font-size: 1.75rem;
                font-weight: 800;
                color: #1E293B;
                text-align: center;
                margin-bottom: 6px;
            }

            .login-card-subtitle {
                color: #64748B;
                font-size: 0.92rem;
                text-align: center;
                margin-bottom: 26px;
            }

            .btn-social {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                padding: 11px 16px;
                border-radius: 12px;
                border: 1px solid #E2E8F0;
                background: #FFFFFF;
                color: #334155;
                font-weight: 600;
                font-size: 0.92rem;
                margin-bottom: 12px;
                transition: all 0.2s ease;
                text-decoration: none;
                cursor: pointer;
            }

            .btn-social:hover {
                background: #F8FAFC;
                border-color: #CBD5E1;
                color: #0F172A;
                transform: translateY(-1px);
            }

            .auth-divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin: 20px 0;
                color: #94A3B8;
                font-size: 0.85rem;
            }

            .auth-divider::before,
            .auth-divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #E2E8F0;
            }

            .auth-divider span {
                padding: 0 14px;
            }

            .form-label-auth {
                font-size: 0.9rem;
                font-weight: 600;
                color: #1E293B;
                margin-bottom: 6px;
                display: block;
            }

            .input-group-auth {
                position: relative;
                display: flex;
                align-items: center;
                margin-bottom: 18px;
            }

            .input-icon-left {
                position: absolute;
                left: 14px;
                color: #94A3B8;
                font-size: 1.1rem;
                z-index: 5;
            }

            .form-control-auth {
                width: 100%;
                height: 48px;
                padding: 10px 14px 10px 42px;
                border-radius: 12px;
                border: 1px solid #CBD5E1;
                font-size: 0.92rem;
                color: #1E293B;
                background-color: #FFFFFF;
                transition: all 0.2s ease;
            }

            .form-control-auth:focus {
                outline: none;
                border-color: var(--primary-green);
                box-shadow: 0 0 0 3px rgba(59, 110, 83, 0.12);
            }

            .input-icon-right {
                position: absolute;
                right: 14px;
                color: #94A3B8;
                cursor: pointer;
                font-size: 1.1rem;
                z-index: 5;
                background: none;
                border: none;
                padding: 0;
            }

            .input-icon-right:hover {
                color: #475569;
            }

            .auth-options-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 22px;
                font-size: 0.88rem;
            }

            .form-check-input-green:checked {
                background-color: var(--primary-green);
                border-color: var(--primary-green);
            }

            .link-forgot {
                color: var(--primary-green);
                text-decoration: none;
                font-weight: 600;
            }

            .link-forgot:hover {
                text-decoration: underline;
            }

            .btn-submit-auth {
                width: 100%;
                height: 50px;
                border-radius: 30px;
                background: var(--primary-green);
                color: #FFFFFF;
                border: none;
                font-weight: 700;
                font-size: 1.02rem;
                transition: all 0.2s ease;
                box-shadow: 0 6px 18px rgba(59, 110, 83, 0.25);
                cursor: pointer;
            }

            .btn-submit-auth:hover {
                background: var(--primary-green-dark);
                transform: translateY(-1px);
                box-shadow: 0 8px 22px rgba(59, 110, 83, 0.32);
            }

            .auth-footer-text {
                text-align: center;
                margin-top: 18px;
                font-size: 0.9rem;
                color: #64748B;
            }

            .auth-footer-text a {
                color: var(--primary-green);
                font-weight: 700;
                text-decoration: none;
            }

            .auth-footer-text a:hover {
                text-decoration: underline;
            }

            .admin-login-box {
                text-align: center;
                margin-top: 24px;
                padding-top: 18px;
                border-top: 1px dashed #E2E8F0;
                font-size: 0.85rem;
                color: #64748B;
            }

            .admin-login-box a {
                color: var(--primary-green);
                font-weight: 700;
                text-decoration: none;
                display: inline-block;
                margin-top: 4px;
            }

            .quick-fill-section {
                background: #F8FAFC;
                border: 1px dashed #CBD5E1;
                border-radius: 12px;
                padding: 10px 14px;
                margin-top: 18px;
            }

            /* ============================================================ */
            /* FOOTER                                                       */
            /* ============================================================ */
            .main-footer {
                background: #FFFFFF;
                border-top: 1px solid #EEF2F6;
                padding: 50px 0 24px;
                margin-top: auto;
            }

            .footer-brand {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--primary-green-dark);
                margin-bottom: 10px;
            }

            .footer-desc {
                color: #64748B;
                font-size: 0.88rem;
                line-height: 1.5;
                margin-bottom: 16px;
            }

            .footer-social-links a {
                color: #64748B;
                font-size: 1.15rem;
                margin-right: 14px;
                transition: color 0.2s;
            }

            .footer-social-links a:hover {
                color: var(--primary-green);
            }

            .footer-heading {
                font-size: 0.95rem;
                font-weight: 700;
                color: #1E293B;
                margin-bottom: 16px;
            }

            .footer-links {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: #64748B;
                text-decoration: none;
                font-size: 0.88rem;
                transition: color 0.2s;
            }

            .footer-links a:hover {
                color: var(--primary-green);
            }

            .subscribe-form {
                display: flex;
                gap: 6px;
            }

            .subscribe-input {
                flex: 1;
                height: 42px;
                border-radius: 8px;
                border: 1px solid #CBD5E1;
                padding: 8px 12px;
                font-size: 0.85rem;
            }

            .subscribe-btn {
                width: 42px;
                height: 42px;
                border-radius: 8px;
                background: var(--primary-green);
                color: #FFFFFF;
                border: none;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .subscribe-btn:hover {
                background: var(--primary-green-dark);
            }

            .footer-bottom {
                margin-top: 40px;
                padding-top: 20px;
                border-top: 1px solid #F1F5F9;
                font-size: 0.82rem;
                color: #94A3B8;
            }
    </style>
</head>

<body>

    @if (role == "NhaTuyenDung")
    {
        <!-- ==================== HEADER NHÀ TUYỂN DỤNG ==================== -->
        <header class="portal-header">
            <div class="container-fluid px-lg-5">
                <div class="d-flex align-items-center justify-content-between">
                    
                    <!-- Cột Trái: Logo + Khám phá + Navigation chính -->
                    <div class="d-flex align-items-center gap-3 gap-lg-4">
                        <!-- Logo -->
                        <a href="/FreelancerStudent/Search" class="brand-logo me-2">
                            Freelancer <span>Students</span>
                        </a>

                        <!-- Nút Khám phá Freelancer -->
                        <a href="/FreelancerStudent/Search" class="search-pill-btn">
                            <span>Khám phá Freelancer</span>
                        </a>

                        <!-- Navigation chính -->
                        <nav class="d-none d-md-flex align-items-center gap-2">
                            <a href="/JobPost/QuanLyTinTuyenDung" class="portal-nav-link">
                                <span>Quản lý tuyển dụng</span>
                            </a>
                            <a href="/HopDong" class="portal-nav-link">
                                <span>Hợp đồng</span>
                            </a>
                            <a href="/Wallet" class="portal-nav-link">
                                <span>Nạp tiền</span>
                            </a>
                        </nav>
                    </div>

                    <!-- Cột Phải: Thông báo + Chat + Nút Đăng bài + Profile User -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Nút Chuông Thông Báo (CUS-UC-12) -->
                        <a href="/ThongBao" class="portal-nav-link" title="Thông báo">
                            <span>Thông báo</span>
                        </a>

                        <!-- Nút Tin Nhắn (FRL-UC-07) -->
                        <a href="/Chat" class="portal-nav-link" title="Tin nhắn trao đổi">
                            <span>Tin nhắn</span>
                        </a>

                        <!-- Nút Đăng bài tuyển dụng -->
                        <a href="/JobPost/Create" class="btn-portal-action-green">
                            Đăng bài tuyển dụng
                        </a>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <a href="#" class="portal-user-profile dropdown-toggle text-decoration-none"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@userAvatar" alt="@userName" class="portal-user-avatar" />
                                <div class="portal-user-info d-none d-lg-flex">
                                    <span class="portal-user-name">@userName</span>
                                    <span class="portal-user-tag">@userRoleTitle</span>
                                    <span class="portal-user-tag">Số dư: @soDuKhaDung.ToString("N0", new
                                                                                                                    System.Globalization.CultureInfo("vi-VN"))đ</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ThietLapTaiKhoan"
                                           asp-route-tab="thongtin">
                                            Thiết lập tài khoản
                                        </a>
                                    </li>
                                    <li><a class="dropdown-item" href="/Account/Profile?tab=security">Thiết lập bảo mật</a></li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li><a class="dropdown-item" href="/Wallet">Ví tài chính & Nạp tiền</a></li>
                                            <li><a class="dropdown-item" href="/Employer/Profile/1">Hồ sơ công ty</a></li>
                                                <li><a class="dropdown-item" href="/JobPost/QuanLyTinTuyenDung">Quản lý tin tuyển dụng</a></li>
                                                    <li><a class="dropdown-item" href="/Employer/FreelancerYeuThich">Freelancer quan tâm</a></li>
                                                        <li><a class="dropdown-item" href="/HopDong">Quản lý hợp đồng</a></li>
                                                            <li><a class="dropdown-item" href="/TranhChap">Tranh chấp & Khiếu nại</a>
                                                            </li>
                                                            <li>
                                                                <hr class="dropdown-divider">
                                                            </li>
                                                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="DangXuat">Đăng xuất</a></li>
                                                            </ul>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </header>

                                        <!-- SUBNAVBAR CHO NHÀ TUYỂN DỤNG -->
                                        <nav class="portal-subnav">
