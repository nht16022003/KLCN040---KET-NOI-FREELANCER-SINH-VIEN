                                                                <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                                                                <script>
                                                                    document.querySelectorAll(".balance-visibility-toggle").forEach(button => {
                                                                        button.addEventListener("click", event => {
                                                                            event.stopPropagation();
                                                                            event.preventDefault();
                                                                            const isVisible = button.getAttribute("aria-pressed") === "true";
                                                                            const wrapper = button.closest(".portal-user-profile-wrapper");
                                                                            const value = wrapper?.querySelector(".balance-value");
                                                                            const icon = button.querySelector("i");
                                                                            if (!value || !icon) return;

                                                                            value.textContent = isVisible ? "********" : button.dataset.balanceValue;
                                                                            icon.classList.toggle("bi-eye", isVisible);
                                                                            icon.classList.toggle("bi-eye-slash", !isVisible);
                                                                            wrapper.querySelectorAll(".balance-visibility-toggle").forEach(toggle => {
                                                                                toggle.setAttribute("aria-pressed", String(!isVisible));
                                                                                toggle.setAttribute("aria-label", isVisible ? "Hiện số dư" : "Ẩn số dư");
                                                                                const toggleIcon = toggle.querySelector("i");
                                                                                if (toggleIcon) {
                                                                                    toggleIcon.classList.toggle("bi-eye", !isVisible);
                                                                                    toggleIcon.classList.toggle("bi-eye-slash", isVisible);
                                                                                }
                                                                            });
                                                                        });
                                                                    });
                                                                </script>

                                                                <!-- Global Toast Container cho Thông Báo và Tin Nhắn Mới -->
                                                                <div aria-live="polite" aria-atomic="true" class="position-relative">
                                                                    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" id="globalNotificationToastContainer"></div>
                                                                </div>

                                                                @if (maUser.HasValue)
                                                                {
                                                                    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
                                                                    <script>
                                                                        (function() {
                                                                            const globalUserId = @maUser.Value;
                                                                            const API_URL = "http://localhost:5152";

                                                                            // Hàm cập nhật Badge số lượng
                                                                            function capNhatBadgeElement(selector, count) {
                                                                                const badges = document.querySelectorAll(selector);
                                                                                badges.forEach(badge => {
                                                                                    const num = parseInt(count) || 0;
                                                                                    if (num > 0) {
                                                                                        badge.textContent = num > 99 ? '99+' : num;
                                                                                        badge.classList.remove('d-none');
                                                                                    } else {
                                                                                        badge.textContent = '0';
                                                                                        badge.classList.add('d-none');
                                                                                    }
                                                                                });
                                                                            }

                                                                            // Hàm phát âm thanh thông báo nhẹ nhàng bằng Web Audio API
                                                                            function phatAmThanhThongBao() {
                                                                                try {
                                                                                    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                                                                                    const osc = audioCtx.createOscillator();
                                                                                    const gain = audioCtx.createGain();
                                                                                    osc.type = "sine";
                                                                                    osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
                                                                                    osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.1); // A5
                                                                                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                                                                                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
                                                                                    osc.connect(gain);
                                                                                    gain.connect(audioCtx.destination);
                                                                                    osc.start();
                                                                                    osc.stop(audioCtx.currentTime + 0.35);
                                                                                } catch (e) {
                                                                                    // Trình duyệt có thể chặn audio nếu chưa có user gesture
                                                                                }
                                                                            }

                                                                            // Hàm hiển thị Toast thông báo tin nhắn mới
                                                                            function hienThiToastTinNhan(msg) {
                                                                                const container = document.getElementById("globalNotificationToastContainer");
                                                                                if (!container) return;

                                                                                const toastId = "toast_msg_" + Date.now();
                                                                                const noiDungRutGon = (msg.noiDung && msg.noiDung.length > 80)
                                                                                    ? msg.noiDung.substring(0, 77) + "..."
                                                                                    : (msg.noiDung || "[Tệp đính kèm]");

                                                                                const toastHtml = `
                                                                                    <div id="${toastId}" class="toast align-items-center text-dark bg-white border border-success border-2 shadow-lg mb-2" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; min-width: 300px;">
                                                                                        <div class="toast-header bg-success text-white py-2" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                                                                                            <i class="bi bi-chat-dots-fill me-2"></i>
                                                                                            <strong class="me-auto text-truncate" style="max-width: 180px;">${msg.tenNguoiGui || 'Tin nhắn mới'}</strong>
                                                                                            <small class="text-white-50">Vừa xong</small>
                                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                                                                                        </div>
                                                                                        <div class="toast-body p-3">
                                                                                            <p class="mb-2 text-secondary small">${noiDungRutGon}</p>
                                                                                            <div class="text-end">
                                                                                                <a href="${msg.linkDieuHuong || ('/Chat?maPhongChat=' + msg.maPhongChat)}" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 text-decoration-none">
                                                                                                    Mở cuộc trò chuyện <i class="bi bi-arrow-right ms-1"></i>
                                                                                                </a>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                `;

                                                                                container.insertAdjacentHTML("beforeend", toastHtml);
                                                                                const toastEl = document.getElementById(toastId);
                                                                                if (toastEl && window.bootstrap && window.bootstrap.Toast) {
                                                                                    const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                                                                                    bsToast.show();
                                                                                }
                                                                            }

                                                                            // Hàm đồng bộ số lượng từ server
                                                                            window.dongBoSoLuongHeader = async function() {
                                                                                try {
                                                                                    const [resTB, resTN] = await Promise.all([
                                                                                        fetch('/ThongBao/DemChuaDoc').then(r => r.json()).catch(() => ({ success: false })),
                                                                                        fetch('/Chat/DemChuaDoc').then(r => r.json()).catch(() => ({ success: false }))
                                                                                    ]);
                                                                                    if (resTB && resTB.success) {
                                                                                        capNhatBadgeElement('.badge-thong-bao', resTB.data);
                                                                                    }
                                                                                    if (resTN && resTN.success) {
                                                                                        capNhatBadgeElement('.badge-tin-nhan', resTN.data);
                                                                                    }
                                                                                } catch (e) {}
                                                                            };

                                                                            // Khởi tạo kết nối SignalR toàn cục
                                                                            const globalKetNoi = new signalR.HubConnectionBuilder()
                                                                                .withUrl(`${API_URL}/chatHub?maUser=${globalUserId}`)
                                                                                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                                                                                .build();

                                                                            // Lắng nghe sự kiện thông báo tin nhắn mới
                                                                            globalKetNoi.on("ThongBaoTinNhanMoi", function(msg) {
                                                                                // Nếu người dùng đang mở đúng phòng chat này, không tăng badge và không hiện toast
                                                                                if (window.currentChatRoomId && parseInt(window.currentChatRoomId) === parseInt(msg.maPhongChat)) {
                                                                                    return;
                                                                                }

                                                                                // Tăng badge tin nhắn hiện tại
                                                                                const firstBadge = document.querySelector('.badge-tin-nhan');
                                                                                let currentCount = firstBadge ? (parseInt(firstBadge.textContent) || 0) : 0;
                                                                                capNhatBadgeElement('.badge-tin-nhan', currentCount + 1);

                                                                                // Hiển thị Toast và phát âm thanh
                                                                                hienThiToastTinNhan(msg);
                                                                                phatAmThanhThongBao();
                                                                            });

                                                                            // Lắng nghe sự kiện cập nhật tin nhắn đã đọc
                                                                            globalKetNoi.on("CapNhatTinNhanDaDoc", function(data) {
                                                                                window.dongBoSoLuongHeader();

                                                                            });

                                                                            // Kết nối tới Hub
                                                                            async function khoiTaoSignalRToanCuc() {
                                                                                try {
                                                                                    if (globalKetNoi.state === signalR.HubConnectionState.Disconnected) {
                                                                                        await globalKetNoi.start();
                                                                                        await globalKetNoi.invoke("DangKyUser", globalUserId);
                                                                                    }
                                                                                } catch (err) {
                                                                                    setTimeout(khoiTaoSignalRToanCuc, 5000);
                                                                                }
                                                                            }

                                                                            globalKetNoi.onreconnected(async () => {
                                                                                await globalKetNoi.invoke("DangKyUser", globalUserId);
                                                                                window.dongBoSoLuongHeader();
                                                                            });

                                                                            khoiTaoSignalRToanCuc();

                                                                            // Fallback đồng bộ định kỳ mỗi 30 giây
                                                                            setInterval(window.dongBoSoLuongHeader, 30000);
                                                                        })();
                                                                    </script>
                                                                }

                                                                @await RenderSectionAsync("Scripts", required: false)

                                                            </body>

                                                        </html>