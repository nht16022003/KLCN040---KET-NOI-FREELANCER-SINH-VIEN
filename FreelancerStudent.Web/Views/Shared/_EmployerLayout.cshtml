<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Freelancer Students</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Employer Dashboard CSS -->
    <link rel="stylesheet" href="~/css/employer-dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">
    <!-- TOP PRIMARY NAVBAR -->
    <header class="top-main-navbar">
        <div class="navbar-container-custom">
            <!-- Brand Logo -->
            <a href="@Url.Action("Dashboard", "Customer")" class="navbar-brand-link">
                <div class="brand-logo-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="brand-logo-text">
                    Freelancer
                    <span>Students</span>
                </div>
            </a>

            <!-- Primary Nav Links -->
            <nav class="primary-nav-links">
                <a href="#" class="nav-item-link">
                    <i class="bi bi-search me-1"></i> Khám phá freelancer
                </a>
                <a href="#" class="nav-item-link">
                    <i class="bi bi-person-workspace me-1"></i> Quản lý tuyển dụng
                </a>
                <a href="#" class="nav-item-link">
                    <i class="bi bi-file-earmark-text me-1"></i> Hợp đồng
                </a>
                <a href="#" class="nav-item-link">
                    <i class="bi bi-credit-card me-1"></i> Thanh toán
                </a>
                <a href="#" class="nav-item-link">
                    <i class="bi bi-graph-up me-1"></i> Báo cáo
                </a>
            </nav>

            <!-- Right Actions: Notifications, Messages, Post Button, Profile -->
            <div class="navbar-right-actions">
                <!-- Notification Bell -->
                <button type="button" class="btn-circle-icon" title="Thông báo">
                    <i class="bi bi-bell"></i>
                    <span class="badge-count">3</span>
                </button>

                <!-- Messages -->
                <button type="button" class="btn-circle-icon" title="Tin nhắn">
                    <i class="bi bi-chat-dots"></i>
                    <span class="badge-count">2</span>
                </button>

                <!-- Post Job Button -->
                <a href="#" class="btn-primary-emerald">
                    + Đăng bài tuyển dụng
                </a>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <div class="user-profile-header-pill" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Avatar" class="avatar-header-img" />
                        <div class="d-none d-lg-block text-start">
                            <div class="user-header-name">@(Context.Session.GetString("UserName") ?? "khachhang_a")</div>
                            <div class="user-header-role">@(Context.Session.GetString("UserRole") == "KhachHang" ? "Nhà tuyển dụng" : "Người dùng")</div>
                        </div>
                        <i class="bi bi-chevron-down text-muted ms-1" style="font-size: 0.75rem;"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person me-2"></i> Hồ sơ công ty</a></li>
                        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-wallet2 me-2"></i> Ví của tôi</a></li>
                        <li><a class="dropdown-item py-2" href="#"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- SECONDARY HORIZONTAL SUB-NAV TABS -->
    <div class="sub-nav-bar-container">
        <div class="sub-nav-bar-content">
            <a href="@Url.Action("Dashboard", "Customer")" class="sub-nav-tab active">Dashboard</a>
            <a href="#" class="sub-nav-tab">Danh sách bài đăng</a>
            <a href="#" class="sub-nav-tab">Quản lý ứng viên</a>
            <a href="#" class="sub-nav-tab">Hợp đồng</a>
            <a href="#" class="sub-nav-tab">Thanh toán</a>
            <a href="#" class="sub-nav-tab">Nhắn tin</a>
            <a href="#" class="sub-nav-tab">Báo cáo</a>
            <a href="#" class="sub-nav-tab">Cài đặt</a>
        </div>
    </div>

    <!-- MAIN BODY CONTENT -->
    <main class="main-dashboard-body-container">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
