<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Freelancer Students</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Employer Dashboard CSS -->
    <link rel="stylesheet" href="~/css/employer-dashboard.css" asp-append-version="true" />

    <style>
        .employer-header {
            background: #FFFFFF;
            border-bottom: 1px solid #EEF2F6;
        }
        .employer-brand {
            font-size: 1.25rem;
            font-weight: 800;
            color: #1E293B;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .employer-brand span {
            color: #2D5A43;
        }
        .header-nav-item {
            color: #475569;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .header-nav-item:hover, .header-nav-item.active {
            color: #2D5A43;
            background: #EBF4F0;
        }
        .btn-icon-round {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #F1F5F9;
            border: none;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }
        .btn-post-job-green {
            background: #2D5A43;
            color: #FFFFFF;
            border-radius: 24px;
            padding: 8px 20px;
            font-size: 0.88rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            transition: all 0.2s;
        }
        .btn-post-job-green:hover {
            background: #234734;
            color: #FFFFFF;
        }
        .avatar-header-img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }
        .employer-subnav {
            background: #FFFFFF;
            border-bottom: 1px solid #EEF2F6;
        }
        .subnav-tab-item {
            color: #64748B;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 20px;
            white-space: nowrap;
            transition: all 0.2s;
        }
        .subnav-tab-item:hover {
            color: #2D5A43;
            background: #F8FAFC;
        }
        .subnav-tab-item.active {
            color: #FFFFFF;
            background: #2D5A43;
        }
    </style>
</head>
<body class="employer-body">
    <!-- 1. HEADER CHÍNH -->
    <header class="employer-header sticky-top">
        <div class="container-fluid px-lg-4">
            <div class="d-flex align-items-center justify-content-between py-2">
                <!-- Logo & Main Menu -->
                <div class="d-flex align-items-center gap-4">
                    <a href="/Customer/Dashboard" class="employer-brand">
                        <i class="bi bi-mortarboard-fill text-success"></i>
                        Freelancer <span>Students</span>
                    </a>

                    <nav class="d-none d-lg-flex align-items-center gap-1">
                        <a href="/Customer/Dashboard" class="header-nav-item active">
                            <i class="bi bi-search me-1"></i> Khám phá freelancer
                        </a>
                        <a href="#" class="header-nav-item">
                            <i class="bi bi-briefcase me-1"></i> Quản lý tuyển dụng
                        </a>
                        <a href="#" class="header-nav-item">
                            <i class="bi bi-file-earmark-text me-1"></i> Hợp đồng
                        </a>
                        <a href="#" class="header-nav-item">
                            <i class="bi bi-credit-card me-1"></i> Thanh toán
                        </a>
                        <a href="#" class="header-nav-item">
                            <i class="bi bi-graph-up me-1"></i> Báo cáo
                        </a>
                    </nav>
                </div>

                <!-- Right Header Actions -->
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-icon-round position-relative" title="Thông báo">
                        <i class="bi bi-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            3
                        </span>
                    </button>

                    <button class="btn btn-icon-round position-relative" title="Tin nhắn">
                        <i class="bi bi-chat-dots"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            2
                        </span>
                    </button>

                    <a href="#" class="btn-post-job-green d-none d-sm-inline-flex">
                        Đăng bài tuyển dụng
                    </a>

                    <!-- Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn dropdown-toggle d-flex align-items-center gap-2 p-1 border-0" 
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" 
                                 alt="Avatar" class="avatar-header-img" />
                            <div class="text-start d-none d-md-block lh-sm">
                                <div class="fw-bold small text-dark">@(Context.Session.GetString("UserName") ?? "khachhang_a")</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Nhà tuyển dụng</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 py-2">
                            <li class="px-3 py-1">
                                <div class="fw-bold">@(Context.Session.GetString("FullName") ?? "khachhang_a")</div>
                                <div class="text-muted small">@(Context.Session.GetString("UserEmail") ?? "tuandaubo@gmail.com")</div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Hồ sơ công ty</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-wallet2 me-2"></i> Số dư ví</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger fw-semibold" href="@Url.Action("Logout", "Account")" onclick="localStorage.clear(); sessionStorage.clear();">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. SUB NAVIGATION TABS -->
    <div class="employer-subnav py-2">
        <div class="container-fluid px-lg-4">
            <div class="d-flex align-items-center gap-2 overflow-x-auto">
                <a href="/Customer/Dashboard" class="subnav-tab-item active">Dashboard</a>
                <a href="#" class="subnav-tab-item">Danh sách bài đăng</a>
                <a href="#" class="subnav-tab-item">Quản lý ứng viên</a>
                <a href="#" class="subnav-tab-item">Hợp đồng</a>
                <a href="#" class="subnav-tab-item">Thanh toán</a>
                <a href="#" class="subnav-tab-item">Nhắn tin</a>
                <a href="#" class="subnav-tab-item">Báo cáo</a>
                <a href="#" class="subnav-tab-item">Cài đặt</a>
            </div>
        </div>
    </div>

    <!-- 3. NỘI DUNG CHÍNH (RENDER BODY) -->
    <main class="py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- 4. FOOTER -->
    <footer class="bg-white border-top py-3 mt-auto text-center text-muted small">
        <div class="container">
            &copy; 2026 Freelancer Students. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tự động đồng bộ thông tin đăng nhập vào LocalStorage & SessionStorage của Trình duyệt
        document.addEventListener("DOMContentLoaded", function () {
            const currentUser = {
                userId: "@(Context.Session.GetString("UserID") ?? "USR002")",
                userName: "@(Context.Session.GetString("UserName") ?? "khachhang_a")",
                fullName: "@(Context.Session.GetString("FullName") ?? "khachhang_a")",
                userRole: "@(Context.Session.GetString("UserRole") ?? "KhachHang")",
                email: "@(Context.Session.GetString("UserEmail") ?? "tuandaubo@gmail.com")",
                loginTime: new Date().toISOString()
            };

            // 1. Lưu vào Session Storage
            sessionStorage.setItem("user_session", JSON.stringify(currentUser));
            sessionStorage.setItem("user_role", currentUser.userRole);
            sessionStorage.setItem("user_id", currentUser.userId);

            // 2. Lưu vào Local Storage
            localStorage.setItem("current_user", JSON.stringify(currentUser));
            localStorage.setItem("user_role", currentUser.userRole);
            localStorage.setItem("user_id", currentUser.userId);
            localStorage.setItem("user_name", currentUser.userName);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
