@model List<FreelancerStudent.Web.ViewModels.CongViecDaLuuViewModel>
@{
    ViewData["Title"] = "Công việc đã lưu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       UI SCOPED STYLING – VIỆC ĐÃ LƯU (PHƯƠNG ÁN B – BALANCED PROPORTIONS)
       ========================================================================== */
    .saved-jobs-scope .card {
        border-radius: 10px !important;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .saved-jobs-scope .card:hover {
        border-color: #2B7A4B;
        box-shadow: 0 4px 14px rgba(43, 122, 75, 0.08);
    }

    .saved-jobs-scope .btn {
        border-radius: 6px !important;
        font-weight: 600;
    }

    .saved-jobs-scope .badge {
        border-radius: 6px !important;
    }

    .saved-jobs-scope .skill-chip {
        display: inline-block;
        background-color: #EAF5EE;
        color: #1E5C37;
        border: 1px solid #C5DEC9;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 6px !important;
    }

    .saved-jobs-scope .job-title-link {
        color: #0F172A;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .saved-jobs-scope .job-title-link:hover {
        color: #1B5E36;
    }
</style>

<div class="saved-jobs-scope container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
           
        </div>
        <div class="mt-2 mt-sm-0">
            <a href="/JobPost/Index" class="btn btn-outline-success">
                Tìm thêm việc làm
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Trạng thái trống -->
        <div class="text-center py-5 border bg-white p-5 shadow-none" style="border-radius: 10px !important;">
            <h5 class="fw-bold text-dark mb-2">Bạn chưa lưu công việc nào</h5>
            <p class="text-muted small mb-4">
                Khi duyệt danh sách việc làm, hãy nhấn vào lưu để theo dõi các cơ hội phù hợp nhất với bạn.
            </p>
            <a href="/JobPost/Index" class="btn btn-primary px-4 py-2">
                Khám phá việc làm ngay
            </a>
        </div>
    }
    else
    {
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Tổng cộng: <strong class="text-dark">@Model.Count</strong> công việc đã lưu
            </span>
        </div>

        <div class="row g-3" id="savedJobsContainer">
            @foreach (var job in Model)
            {
                var isExpired = job.thoiGianDuKienHoanThanh < DateTime.Now;
                var isOpen = job.status == "DangTuyen" || job.status == "Opening";

                <div class="col-12" id="job-card-@job.maJob">
                    <div class="card p-3 p-md-4 bg-white position-relative">
                        <div class="row g-3">
                            <!-- Cột thông tin chính (8/12) -->
                            <div class="col-12 col-md-8">
                                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                    <span class="badge bg-light text-secondary border small">
                                        Mã: @job.maJob
                                    </span>
                                    @if (isOpen && !isExpired)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Đang tuyển
                                        </span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            Hết hạn ứng tuyển
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            @job.status
                                        </span>
                                    }

                                    @if (job.daUngTuyen)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            Đã ứng tuyển
                                        </span>
                                    }
                                </div>

                                <h5 class="fw-bold mb-2">
                                    <a href="/JobPost/Detail?maJob=@job.maJob" class="job-title-link">
                                        @job.tieuDe
                                    </a>
                                </h5>

                                <div class="d-flex flex-wrap gap-3 text-muted small mb-2">
                                    <span>
                                        Công ty: <strong>@(string.IsNullOrWhiteSpace(job.tenCongTy) ? "Nhà tuyển dụng" : job.tenCongTy)</strong>
                                    </span>
                                    <span>
                                        Ngày đăng: <strong>@job.thoiGianDangTuyen.ToString("dd/MM/yyyy")</strong>
                                    </span>
                                    <span>
                                        Hạn hoàn thành: <strong>@job.thoiGianDuKienHoanThanh.ToString("dd/MM/yyyy")</strong>
                                    </span>
                                    @if (job.soLuongTuyen.HasValue && job.soLuongTuyen > 0)
                                    {
                                        <span>
                                            Số lượng: <strong>@job.soLuongTuyen người</strong>
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(job.kyNangYeuCau))
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var k in job.kyNangYeuCau.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="skill-chip">
                                                @k.Trim()
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="text-muted" style="font-size: 0.78rem;">
                                    Đã lưu lúc: @job.ngayLuu.ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(job.ghiChu))
                                    {
                                        <span class="ms-2 fst-italic">(@job.ghiChu)</span>
                                    }
                                </div>
                            </div>

                            <!-- Cột thù lao & Nút thao tác (4/12) – Phân bổ Flexbox đều trục dọc -->
                            <div class="col-12 col-md-4 border-top border-md-top-0 pt-3 pt-md-0 d-flex flex-column justify-content-between text-md-end">
                                <div>
                                    <div class="small text-muted mb-1">Mức thù lao dự án:</div>
                                    <div class="fs-5 fw-bold" style="color: #2B7A4B;">
                                        @(job.thuLao.HasValue && job.thuLao > 0 
                                            ? job.thuLao.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ" 
                                            : "Thỏa thuận")
                                    </div>
                                </div>

                                <div class="d-flex flex-md-column gap-2 justify-content-end mt-3">
                                    <a href="/JobPost/Detail?maJob=@job.maJob" class="btn btn-primary btn-sm px-3 py-2">
                                        Xem chi tiết
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm px-3 py-2" onclick="boLuuViec('@job.maJob')">
                                        Bỏ lưu
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    async function boLuuViec(maJob) {
        if (!confirm('Bạn có chắc chắn muốn bỏ lưu công việc này?')) return;

        try {
            const res = await fetch('/JobPost/ToggleLuuViec', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ maJob: maJob })
            });
            const data = await res.json();
            if (data.success) {
                const el = document.getElementById('job-card-' + maJob);
                if (el) {
                    el.style.opacity = '0';
                    el.style.transition = 'opacity 0.3s ease';
                    setTimeout(() => {
                        el.remove();
                        const container = document.getElementById('savedJobsContainer');
                        if (container && container.children.length === 0) {
                            location.reload();
                        }
                    }, 300);
                }
            } else {
                alert(data.message || 'Không thể bỏ lưu công việc.');
            }
        } catch (err) {
            alert('Lỗi kết nối máy chủ: ' + err);
        }
    }
</script>
