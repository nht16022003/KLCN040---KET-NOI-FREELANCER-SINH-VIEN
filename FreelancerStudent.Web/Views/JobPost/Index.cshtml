    }

    .ntd-dashboard-root .skill-badge-item {
        background-color: #EAF5EE;
        color: #1B5E36;
        border: 1px solid #C8E6C9;
        border-radius: 6px !important;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 3px 9px;
        display: inline-block;
        margin-right: 4px;
        margin-bottom: 4px;
    }

    .ntd-dashboard-root .job-metrics-box {
        background-color: #F4F9F6;
        border: 1px solid #D5E8DC;
        border-radius: 10px !important;
        padding: 10px 12px;
        margin: 12px 0 4px 0;
        font-size: 0.82rem;
    }

    .ntd-dashboard-root .salary-highlight {
        font-size: 0.96rem;
        font-weight: 800;
        color: #1B5E36;
    }

    .ntd-dashboard-root .job-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        background: #FAFCFB;
        border-top: 1px solid #E2E8F0;
        font-size: 0.78rem;
        color: #64748B;
        margin-top: auto;
    }

    .ntd-dashboard-root .status-tag {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 6px !important;
        display: inline-block;
        white-space: nowrap;
    }

    .ntd-dashboard-root .status-open {
        background-color: rgba(74, 222, 128, 0.22);
        color: #FFFFFF;
        border: 1px solid rgba(167, 243, 208, 0.4);
    }

    .ntd-dashboard-root .job-card-footer .status-open {
        background-color: #E8F5E9;
        color: #1E6E38;
        border: 1px solid #C8E6C9;
    }

    .ntd-dashboard-root .status-closed {
        background-color: rgba(255, 255, 255, 0.16);
        color: #E2E8F0;
        border: 1px solid rgba(255, 255, 255, 0.28);
    }

    .ntd-dashboard-root .status-done {
        background-color: #EDE7F6;
        color: #512DA8;
        border: 1px solid #D1C4E9;
    }

    .ntd-dashboard-root .btn-detail-link {
        color: #FFFFFF !important;
        border: 1px solid #2B7A4B;
        background: #2B7A4B;
        padding: 6px 14px;
        border-radius: 8px !important;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

    .ntd-dashboard-root .btn-detail-link:hover {
        background-color: #144327;
        border-color: #144327;
        color: #FFFFFF !important;
    }

    .ntd-dashboard-root .btn-applied-badge {
        background: #F1F5F9;
        color: #475569;
        border: 1px solid #CBD5E1;
        padding: 5px 10px;
        border-radius: 6px !important;
        font-size: 0.78rem;
        font-weight: 700;
        display: inline-block;
    }

    .ntd-dashboard-root .empty-state-box {
        background: #FFFFFF;
        border: 1px solid #DCE8E0;
        border-radius: 16px !important;
        padding: 48px 24px;
        text-align: center;
    }

    /* =====================================================================
       KHU VỰC 3: QUY TRÌNH HỢP TÁC (4 BƯỚC CHUẨN THEO VAI TRÒ)
       ===================================================================== */
    .ntd-dashboard-root .ntd-workflow-section {
        background: linear-gradient(180deg, #FFFFFF 0%, #EAF5EE 100%);
        border: 1px solid #C8E6C9;
        border-radius: 22px !important;
        padding: 36px 34px;
        box-shadow: 0 12px 32px rgba(13, 40, 24, 0.06);
    }

    .ntd-dashboard-root .ntd-workflow-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 26px;
    }

    .ntd-dashboard-root .ntd-workflow-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0D2818;
        margin-bottom: 4px;
    }

    .ntd-dashboard-root .ntd-workflow-sub {
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 0;
    }

    .ntd-dashboard-root .ntd-step-card {
        position: relative;
        background: #FFFFFF;
        border: 1px solid #D5E8DC;
        border-radius: 16px !important;
        padding: 24px 20px;
        height: 100%;
        box-shadow: 0 6px 18px rgba(13, 40, 24, 0.04);
        transition: all 0.22s ease;
    }

    .ntd-dashboard-root .ntd-step-card:hover {
        transform: translateY(-4px);
        border-color: #2B7A4B;
        box-shadow: 0 14px 28px rgba(13, 40, 24, 0.1);
    }

    .ntd-dashboard-root .ntd-step-number-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #0D2818 0%, #1B5E36 100%);
        color: #FFFFFF;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 99px !important;
        margin-bottom: 14px;
    }

    .ntd-dashboard-root .ntd-step-heading {
        font-size: 1.04rem;
        font-weight: 800;
        color: #0D2818;
        margin-bottom: 8px;
    }

    .ntd-dashboard-root .ntd-step-desc {
        font-size: 0.86rem;
        color: #475569;
        line-height: 1.55;
        margin-bottom: 0;
    }

    @@media (max-width: 1199.98px) {
        .ntd-dashboard-root .ntd-feature-card {
            flex: 0 0 calc(50% - 12px);
        }
        .ntd-dashboard-root .ntd-cards-track.is-grid-mode {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .ntd-dashboard-root .ntd-hero-showcase {
            padding: 28px 20px 26px 20px;
        }
        .ntd-dashboard-root .ntd-feature-card {
            flex: 0 0 88%;
        }
        .ntd-dashboard-root .ntd-cards-track.is-grid-mode {
            grid-template-columns: 1fr;
        }
        .ntd-dashboard-root .ntd-workflow-section {
            padding: 24px 18px;
        }
    }

    /* =====================================================================
       FADE UP ANIMATION (IntersectionObserver)
       ===================================================================== */
    .fade-up-element {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 500ms ease-out, transform 500ms ease-out;
        will-change: opacity, transform;
    }
    .fade-up-element.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
    @@media (prefers-reduced-motion: reduce) {
        .fade-up-element {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }
</style>

<div class="ntd-dashboard-root job-board-wrapper">
    <div class="container-fluid px-lg-5">

        <!-- ===============================================================
             KHU VỰC 1 & KHU VỰC 2: PHÂN CHIA THEO VAI TRÒ
             - NHÀ TUYỂN DỤNG: Hiển thị Trung tâm điều khiển & 8 chức năng Nhà tuyển dụng
             - FREELANCER: Hiển thị Trung tâm điều khiển & 8 chức năng Sinh viên Freelancer
             =============================================================== -->
        @if (User.IsInRole("NhaTuyenDung") || Context.Session.GetString("tenRole") == "NhaTuyenDung")
        {
          
        }

        <!-- ===============================================================
             KHU VỰC DANH SÁCH & BỘ LỌC CƠ HỘI VIỆC LÀM
             (Bảo toàn 100% biến Razor, Model, vòng lặp và sự kiện gốc)
             =============================================================== -->
        <section class="ntd-directory-section" id="co-hoi-viec-lam">

            <!-- HEADER TIÊU ĐỀ -->
            <div class="ntd-section-heading-box mb-4">
                <div>
                    <span class="ntd-section-badge">Việc làm dành cho sinh viên</span>
                    
                </div>
            </div>

            <!-- BỐ CỤC 2 CỘT: BỘ LỌC BÊN TRÁI & KẾT QUẢ BÊN PHẢI -->
            <div class="row g-4 align-items-start">

                <!-- CỘT TRÁI: KHU VỰC TÌM KIẾM & BỘ LỌC CÔNG VIỆC -->
                <div class="col-12 col-lg-4 col-xl-3">
                    <div class="sidebar-filter-wrapper sticky-lg-top" style="top: 90px; z-index: 10;">
                        <form method="get" action="/JobPost" class="filter-sidebar-card">
                            
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <h3 class="filter-sidebar-title d-flex align-items-center gap-2">
                                    <i class="bi bi-funnel-fill text-success" style="font-size: 0.95rem;"></i>
                                    <span>Bộ lọc công việc</span>
                                </h3>
                                <a href="/JobPost" class="btn-clear-filter-link text-muted small text-decoration-none" title="Đặt lại bộ lọc">
                                    Xóa lọc
                                </a>
                            </div>

                            <div class="d-flex flex-column gap-3">
                                <!-- 1. Từ khóa tìm kiếm -->
                                <div>
                                    <label class="filter-label">Từ khóa tìm kiếm</label>
                                    <input type="text" name="tuKhoa" class="form-control form-control-custom"
                                           value="@Model.TuKhoa"
                                           placeholder="Tiêu đề việc, công nghệ, công ty..." />
                                </div>

                                <!-- 2. Thứ tự sắp xếp -->
                                <div>
                                    <label class="filter-label">Thứ tự sắp xếp</label>
                                    <select name="sapXep" class="form-select form-select-custom">
                                        <option value="moi-nhat" selected="@(Model.SapXep == "moi-nhat" ? "selected" : null)">Mới nhất trước (Mặc định)</option>
                                        <option value="luong-cao" selected="@(Model.SapXep == "luong-cao" ? "selected" : null)">Thù lao cao nhất</option>
                                        <option value="luong-thap" selected="@(Model.SapXep == "luong-thap" ? "selected" : null)">Thù lao thấp nhất</option>
                                        <option value="sao-cao" selected="@(Model.SapXep == "sao-cao" ? "selected" : null)">Đánh giá NTD cao nhất</option>
                                    </select>
                                </div>

                                <!-- 3. Lọc theo Nhà tuyển dụng -->
                                <div>
                                    <label class="filter-label">Nhà tuyển dụng</label>
                                    <select name="maNhaTuyenDung" class="form-select form-select-custom">
                                        <option value="">Tất cả nhà tuyển dụng</option>
                                        @foreach (var ntd in Model.DanhSachNhaTuyenDung)
                                        {
                                            <option value="@ntd.Key" selected="@(Model.MaNhaTuyenDung == ntd.Key ? "selected" : null)">
                                                @ntd.Value
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- 4. Lọc theo mức thù lao -->
                                <div>
                                    <label class="filter-label">Mức thù lao</label>
                                    <select name="mucLuong" class="form-select form-select-custom">
                                        <option value="">Tất cả mức lương</option>
                                        <option value="duoi-1tr" selected="@(Model.MucLuong == "duoi-1tr" ? "selected" : null)">Dưới 1 triệu</option>
                                        <option value="1tr-3tr" selected="@(Model.MucLuong == "1tr-3tr" ? "selected" : null)">1 triệu - 3 triệu</option>
                                        <option value="3tr-10tr" selected="@(Model.MucLuong == "3tr-10tr" ? "selected" : null)">3 triệu - 10 triệu</option>
                                        <option value="tren-10tr" selected="@(Model.MucLuong == "tren-10tr" ? "selected" : null)">Trên 10 triệu</option>
                                        <option value="thoa-thuan" selected="@(Model.MucLuong == "thoa-thuan" ? "selected" : null)">Thỏa thuận</option>
                                    </select>
                                </div>

                                <!-- 5. Lọc theo kỹ năng -->
                                <div>
                                    <label class="filter-label">Kỹ năng yêu cầu</label>
                                    <select name="kyNang" class="form-select form-select-custom">
                                        <option value="">Tất cả kỹ năng</option>
                                        @foreach (var kn in Model.DanhSachKyNang)
                                        {
                                            <option value="@kn" selected="@(string.Equals(Model.KyNang, kn, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @kn
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- 6. Lọc theo trạng thái -->
                                <div>
                                    <label class="filter-label">Trạng thái công việc</label>
                                    <select name="trangThai" class="form-select form-select-custom">
                                        <option value="DangTuyen" selected="@(Model.TrangThai == "DangTuyen" ? "selected" : null)">Đang mở tuyển</option>
                                        <option value="DangThucHien" selected="@(Model.TrangThai == "DangThucHien" ? "selected" : null)">Đang thực hiện</option>
                                        <option value="TatCa" selected="@(Model.TrangThai == "TatCa" ? "selected" : null)">Tất cả trạng thái</option>
                                    </select>
                                </div>

                                <!-- 7. Lọc theo sao đánh giá NTD -->
                                <div>
                                    <label class="filter-label">Đánh giá NTD</label>
                                    <select name="soSaoMin" class="form-select form-select-custom">
                                        <option value="">Tất cả đánh giá</option>
                                        <option value="4" selected="@(Model.SoSaoMin == 4 ? "selected" : null)">Từ 4.0 điểm trở lên</option>
                                        <option value="4.5" selected="@(Model.SoSaoMin == 4.5 ? "selected" : null)">Từ 4.5 điểm trở lên</option>
                                        <option value="5" selected="@(Model.SoSaoMin == 5 ? "selected" : null)">5.0 điểm tuyệt đối</option>
                                    </select>
                                </div>

                                <!-- 8. Cụm nút Thao tác -->
                                <div class="pt-2 d-flex flex-column gap-2">
                                    <button type="submit" class="btn-search-main w-100 py-2">
                                        <i class="bi bi-search me-1"></i> Tìm kiếm
                                    </button>
                                    <a href="/JobPost" class="btn-reset-filter w-100 py-2 text-center">
                                        Xóa bộ lọc
                                    </a>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- CỘT PHẢI: KHU VỰC KẾT QUẢ TÌM KIẾM -->
                <div class="col-12 col-lg-8 col-xl-9">

                    <!-- THANH BÁO SỐ LƯỢNG KẾT QUẢ -->
                    <div class="results-bar">
                        <span class="results-count">
                            Tìm thấy @Model.TongSoCongViec công việc phù hợp
                        </span>
                        <span class="text-muted small">
                            Thứ tự: @(Model.SapXep == "luong-cao" ? "Thù lao cao nhất" : Model.SapXep == "luong-thap" ? "Thù lao thấp nhất" : Model.SapXep == "sao-cao" ? "Đánh giá NTD cao nhất" : "Mới nhất trước")
                        </span>
                    </div>

                    <!-- DANH SÁCH CARD CÔNG VIỆC -->
                    @if (Model.DanhSachJobPost != null && Model.DanhSachJobPost.Any())
                    {
                        var dsMaJobDaLuu = ViewBag.DanhSachMaJobDaLuu as HashSet<string> ?? new HashSet<string>();
                        <div class="row g-3">
                            @foreach (var job in Model.DanhSachJobPost)
                            {
                                var daLuu = dsMaJobDaLuu.Contains(job.maJob);
                                var tenNTD = !string.IsNullOrWhiteSpace(job.tenCongTy) ? job.tenCongTy : "Nhà tuyển dụng";
                                var avatarUrl = !string.IsNullOrEmpty(job.avatarNhaTuyenDung)
                                    ? (job.avatarNhaTuyenDung.StartsWith("http", StringComparison.OrdinalIgnoreCase) || job.avatarNhaTuyenDung.StartsWith("/")
                                        ? job.avatarNhaTuyenDung
                                        : "/" + job.avatarNhaTuyenDung)
                                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(tenNTD)}&background=E8F5E9&color=1B5E36";

                                var isDangTuyen = string.Equals(job.status, "DangTuyen", StringComparison.OrdinalIgnoreCase) || string.Equals(job.status, "Opening", StringComparison.OrdinalIgnoreCase);

                                <div class="col-12 col-md-6">
                            <div class="job-card fade-up-element">
                                
                                <!-- Phần trên: Header Nhà tuyển dụng & Trạng thái trên nền xanh lá đậm -->
                                <div class="job-card-top-banner">
                                    <div class="employer-meta-row">
                                        <img src="@avatarUrl" alt="@tenNTD" class="employer-avatar"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(tenNTD)&background=E8F5E9&color=1B5E36';" />
                                        
                                        <div class="overflow-hidden flex-grow-1">
                                            <a href="/Employer/Profile/@job.maNhaTuyenDung" class="employer-name text-truncate" title="@tenNTD">
                                                @tenNTD
                                            </a>

                                            @if (job.soSaoDanhGiaNhaTuyenDung.HasValue && job.soSaoDanhGiaNhaTuyenDung > 0)
                                            {
                                                <span class="employer-rating-text">
                                                    ★ @job.soSaoDanhGiaNhaTuyenDung.Value.ToString("0.0")/5.0 @(job.soLuotDanhGiaNhaTuyenDung > 0 ? $"({job.soLuotDanhGiaNhaTuyenDung} đánh giá)" : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="employer-rating-none">Chưa có đánh giá</span>
                                            }
                                        </div>

                                        <div>
                                            @if (string.Equals(job.status, "DaHoanThanh", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-secondary text-white px-2 py-1" style="font-size: 0.72rem; border-radius: 6px !important;">Đã hoàn thành</span>
                                            }
                                            else if (job.DaTuyenDu || string.Equals(job.status, "DaTuyenDu", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.72rem; border-radius: 6px !important;">Đã tuyển đủ</span>
                                            }
                                            else
                                            {
                                                <span class="status-tag @(isDangTuyen ? "status-open" : "status-closed")">
                                                    @(isDangTuyen ? "Đang tuyển" : (!string.IsNullOrWhiteSpace(job.status) ? job.status : "Đã đóng"))
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Phần thân: Tiêu đề, mô tả, kỹ năng & thông số thù lao -->
                                <div class="job-card-body">
                                    <!-- Tiêu đề công việc -->
                                    <h2 class="job-title-heading">
                                        <a href="/JobPost/Detail?maJob=@job.maJob">
                                            @job.tieude
                                        </a>
                                    </h2>

                                    <!-- Trích đoạn mô tả -->
                                    @if (!string.IsNullOrWhiteSpace(job.mota))
                                    {
                                        <p class="job-desc-snippet">
                                            @job.mota
                                        </p>
                                    }

                                    <!-- Kỹ năng yêu cầu -->
                                    @if (!string.IsNullOrWhiteSpace(job.kynangyeucau))
                                    {
                                        <div class="mb-2">
                                            @foreach (var kn in job.kynangyeucau.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="skill-badge-item">@kn.Trim()</span>
                                            }
                                        </div>
                                    }

                                    <!-- Thông số chi phí & thời hạn -->
                                    <div class="job-metrics-box">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted">Thù lao:</span>
                                            <span class="salary-highlight">
                                                @(job.thulao.HasValue && job.thulao > 0
                                                    ? job.thulao.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ"
                                                    : "Thỏa thuận")
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted">Hạn hoàn thành:</span>
                                            <span class="fw-semibold text-dark">
                                                @(job.thoigiandukienhoanthanh != DateTime.MinValue
                                                    ? job.thoigiandukienhoanthanh.ToString("dd/MM/yyyy")
                                                    : "Linh hoạt")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Footer card: Ngày đăng & Nút thao tác -->
                                <div class="job-card-footer">
                                    <span>
                                        Đăng @job.thoigiandangtuyen.ToString("dd/MM/yyyy")
                                    </span>

                                    <div class="d-flex align-items-center gap-2">
                                        @{
                                            trangThaiTheoJob.TryGetValue(job.maJob, out var trangThaiDon);
                                        }

                                        @if (string.Equals(job.status, "DaHoanThanh", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary text-white">Đã hoàn thành</span>
                                        }
                                        else if (job.DaTuyenDu || string.Equals(job.status, "DaTuyenDu", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="btn-applied-badge">Đã tuyển đủ</span>
                                        }
                                        else if (trangThaiDon == "ChoDuyet")
                                        {
                                            <span class="btn-applied-badge">Đã nộp đơn</span>
                                        }
                                        else if (trangThaiDon == "ChapNhan")
                                        {
                                            <span class="status-tag status-open">Đã duyệt</span>
                                        }

                                        @if (User.IsInRole("FreelancerStudent") || Context.Session.GetString("tenRole") == "FreelancerStudent")
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none bookmark-job-btn @(daLuu ? "text-success" : "text-secondary")"
                                                    onclick="toggleLuuViec('@job.maJob', this)" title="@(daLuu ? "Bỏ lưu việc" : "Lưu công việc")">
                                                <i class="bi @(daLuu ? "bi-bookmark-fill" : "bi-bookmark") fs-5" style="display:inline-block !important;"></i>
                                            </button>
                                        }

                                        <a href="/JobPost/Detail?maJob=@job.maJob" class="btn-detail-link">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-box">
                    <h3 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--ink);">
                        Không tìm thấy công việc phù hợp
                    </h3>
                    <p class="text-muted small mb-4">
                        Thử thay đổi từ khóa tìm kiếm hoặc điều chỉnh lại các tiêu chí bộ lọc của bạn.
                    </p>
                    <a href="/JobPost" class="btn-search-main">
                        Xóa bộ lọc để xem tất cả công việc
                    </a>
                </div>
            }

                </div> <!-- Đóng Cột phải col-12 col-lg-8 col-xl-9 -->
            </div> <!-- Đóng Bố cục 2 cột row g-4 -->

        </section>

        <!-- ===============================================================
