@using FreelancerStudent.Web.ViewModels
@model List<FreelancerStudent.Web.ViewModels.JobPostViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách bài đăng tuyển dụng";
}

<div class="container py-4">
    <h4 class="mb-4 text-success fw-bold">Các bài đăng tuyển dụng</h4>

    <div class="row g-4">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var jobPostViewModel in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border rounded-3 bg-white">
                        <div class="card-body">
                            @{
                                var tenNTD = !string.IsNullOrEmpty(jobPostViewModel.tenCongTy) ? jobPostViewModel.tenCongTy : "Nhà tuyển dụng";
                                var avatarNTD = !string.IsNullOrEmpty(jobPostViewModel.avatarNhaTuyenDung)
                                    ? jobPostViewModel.avatarNhaTuyenDung
                                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(tenNTD)}&background=E8F5E9&color=1B5E36";
                            }
                            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                                <img src="@avatarNTD" alt="@tenNTD" class="rounded-circle border" style="width: 36px; height: 36px; object-fit: cover; flex-shrink: 0;" />
                                <div class="overflow-hidden">
                                    <span class="text-muted small fw-semibold text-truncate d-block">@tenNTD</span>
                                </div>
                            </div>
                            <h5 class="card-title mb-2 fw-bold text-dark">@jobPostViewModel.tieude</h5>

                            <p class="small">@jobPostViewModel.mota</p>
                            <p class="fw-bold">
                                Kỹ năng yêu cầu:
                                <span class="fw-normal">@jobPostViewModel.kynangyeucau</span>
                            </p>
                            <p class="fw-bold text-danger">
                                Thù lao:
                                <span class="fw-normal text-dark">
                                    @(jobPostViewModel.thulao.HasValue
                                        ? jobPostViewModel.thulao.Value.ToString("N0") + " VNĐ"
                                        : "Thỏa thuận")
                                </span>
                            </p>
                            <p>
                                Thời gian đăng tuyển:
                                @jobPostViewModel.thoigiandangtuyen.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <div
                            class="card-footer bg-transparent border-0 d-flex justify-content-evenly align-items-center gap-3 mb-3">
                            <a asp-controller="JobPost" asp-action="Detail" asp-route-maJob="@jobPostViewModel.maJob"
                               class="btn btn-outline-success">
                                Xem Chi Tiết
                            </a>

                            <a asp-controller="HopDong" asp-action="TaoHopDong" asp-route-jobId="@jobPostViewModel.maJob"
                               class="btn btn-success">
                                Ứng Tuyển
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Chưa có bài đăng tuyển dụng nào.</div>
            </div>
        }
    </div>
</div>