@model FreelancerStudent.Web.ViewModels.JobPostViewModel

@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
}

<style>
    .create-job-page {
        background: #f6f9f7;
        min-height: 100vh;
        padding: 30px 0 60px;
    }

    .create-job-container {
        width: min(1380px, calc(100% - 40px));
        margin: 0 auto;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
        color: #34423b;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
    }

    .back-link:hover {
        color: #16864b;
    }

    /* Banner Đồ Họa CSS Gradient Project IMPROVE (Thay thế ảnh tĩnh vỡ 404) */
    .recruitment-banner-hero {
        width: 100%;
        background: #064321e4;
        border-radius: 0;
        margin-bottom: 22px;
        padding: 34px 38px;
        color: #ffffff;
        box-shadow: 0 8px 28px rgba(13, 40, 24, 0.10);
        position: relative;
        overflow: hidden;
    }

    .banner-badge {
        display: inline-block;
        background: rgba(74, 222, 128, 0.18);
        color: #4ADE80;
        border: 1px solid rgba(74, 222, 128, 0.35);
        font-size: 12px;
        font-weight: 700;
        padding: 4px 12px;
        margin-bottom: 12px;
        letter-spacing: 0.5px;
    }

    .banner-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 8px;
        color: #ffffff;
        letter-spacing: -0.3px;
    }

    .banner-subtitle {
        font-size: 14.5px;
        color: #D1E7DD;
        margin: 0 0 16px;
        max-width: 720px;
        line-height: 1.5;
    }

    .banner-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .banner-chip {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 5px 13px;
        font-size: 12.5px;
        font-weight: 600;
        color: #EAF5EE;
    }

    /* Form Card */
    .job-form-card {
        background: #fff;
        border: 1px solid #e4ebe7;
        border-radius: 0;
        padding: 34px 36px;
        box-shadow: 0 8px 30px rgba(21, 70, 44, 0.06);
    }

    /* 3-Column Layout Grid (Desktop/Laptop: 41% Nội dung / 25% Thù lao / 34% Preview) */
    .job-create-layout-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.95fr) minmax(0, 1.25fr);
        gap: 24px;
        align-items: start;
    }

    /* Cột 1: Nội dung công việc */
    .col-job-content {
        display: flex;
        flex-direction: column;
    }

    /* Cột 2: Thù lao & Kế hoạch */
    .col-job-budget-plan {
        display: flex;
        flex-direction: column;
        background: #f8faf9;
        border: 1px solid #e4ebe7;
        padding: 22px;
        border-radius: 0;
    }

    /* Cột 3: Xem trước trên giao diện Freelancer */
    .col-job-preview {
        display: flex;
        flex-direction: column;
    }

    .preview-sticky-wrap {
        position: sticky;
        top: 24px;
    }

    .preview-guide-text {
        font-size: 13px;
        color: #64748B;
        line-height: 1.45;
        margin: -14px 0 16px;
    }

    /* Card công việc chuẩn góc nhìn Freelancer */
    .col-job-preview .job-card {
        background: #FFFFFF;
        border: 1px solid #DCE8E0;
        border-radius: 16px !important;
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
        box-shadow: 0 8px 24px rgba(13, 40, 24, 0.06);
        transition: all 0.24s ease;
    }

    .col-job-preview .job-card:hover {
        border-color: #2B7A4B;
        box-shadow: 0 12px 30px rgba(13, 40, 24, 0.10);
    }

    .col-job-preview .job-card-top-banner {
        background: linear-gradient(135deg, #0D2818 0%, #1B5E36 60%, #2B7A4B 100%);
        padding: 16px 18px;
        color: #FFFFFF;
    }

    .col-job-preview .employer-meta-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .col-job-preview .employer-avatar {
        width: 42px;
        height: 42px;
        border-radius: 10px !important;
        border: 2px solid rgba(255, 255, 255, 0.85);
        background: #E8F5E9;
        color: #1B5E36;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 14px;
        flex-shrink: 0;
        letter-spacing: 0.5px;
    }

    .col-job-preview .employer-name {
        font-weight: 800;
        font-size: 0.90rem;
        color: #FFFFFF;
        text-decoration: none;
        display: block;
        line-height: 1.3;
    }

    .col-job-preview .employer-rating-text {
        font-size: 0.74rem;
        color: #FDE68A;
        font-weight: 700;
    }

    .col-job-preview .job-card-body {
        padding: 16px 18px 12px 18px;
        flex-grow: 1;
    }

    .col-job-preview .job-title-heading {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0D2818;
        margin-bottom: 8px;
        line-height: 1.38;
    }

    .col-job-preview .job-title-heading a {
        color: #0D2818;
        text-decoration: none;
        cursor: default;
    }

    .col-job-preview .job-desc-snippet {
        font-size: 0.84rem;
        color: #475569;
        line-height: 1.5;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .col-job-preview .skill-badge-item {
        background-color: #EAF5EE;
        color: #1B5E36;
        border: 1px solid #C8E6C9;
        border-radius: 6px !important;
        font-size: 0.73rem;
        font-weight: 700;
        padding: 3px 8px;
        display: inline-block;
        margin-right: 4px;
        margin-bottom: 4px;
    }

    .col-job-preview .job-metrics-box {
        background-color: #F4F9F6;
        border: 1px solid #D5E8DC;
        border-radius: 10px !important;
        padding: 10px 12px;
        margin: 12px 0 4px 0;
        font-size: 0.82rem;
    }

    .col-job-preview .salary-highlight {
        font-size: 0.95rem;
        font-weight: 800;
        color: #1B5E36;
    }

    .col-job-preview .job-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 18px;
        background: #FAFCFB;
        border-top: 1px solid #E2E8F0;
        font-size: 0.76rem;
        color: #64748B;
        margin-top: auto;
    }

    .col-job-preview .status-tag {
        font-size: 0.70rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px !important;
        display: inline-block;
        white-space: nowrap;
    }

    .col-job-preview .status-open {
        background-color: rgba(74, 222, 128, 0.22);
        color: #A7F3D0;
        border: 1px solid rgba(167, 243, 208, 0.4);
    }

    .col-job-preview .btn-detail-link {
        color: #FFFFFF !important;
        border: 1px solid #2B7A4B;
        background: #2B7A4B;
        padding: 5px 12px;
        border-radius: 7px !important;
        font-size: 0.80rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        cursor: default;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 21px;
        font-weight: 700;
        color: #10271c;
        margin: 0 0 24px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e8eeea;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 0;
        background: #e7f5ed;
        color: #16864b;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-size: 15px;
        font-weight: 650;
        color: #17251e;
    }

    .required {
        color: #dc3545;
    }

    .form-control-custom {
        box-sizing: border-box;
        width: 100%;
        padding: 13px 16px;
        border: 1px solid #d8e0dc;
        border-radius: 0;
        background: #fff;
        color: #1b2922;
        font-size: 15px;
        outline: none;
        transition: .2s;
    }

    .form-control-custom:focus {
        border-color: #16864b;
        box-shadow: 0 0 0 3px rgba(22, 134, 75, .09);
    }

    textarea.form-control-custom {
        min-height: 200px;
        resize: vertical;
        line-height: 1.5;
    }

    .field-error {
        display: block;
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
    }

    /* Skill Suggestions */
    .skill-suggestions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 12px;
    }

    .skill-label {
        color: #6b756f;
        font-size: 14px;
        font-weight: 500;
    }

    .skill-btn {
        border: 1px solid #cfe4d8;
        background: #eff8f3;
        color: #176c42;
        border-radius: 0;
        padding: 6px 12px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: background .15s, color .15s;
    }

    .skill-btn:hover {
        background: #dff1e7;
    }

    .money-input {
        display: flex;
        width: 100%;
    }

    .money-input input {
        border-radius: 0;
        flex: 1;
    }

    .money-unit {
        display: flex;
        align-items: center;
        padding: 0 16px;
        border: 1px solid #d8e0dc;
        border-left: 0;
        border-radius: 0;
        background: #f7f9f8;
        color: #56635c;
        font-weight: 600;
        font-size: 14px;
        flex-shrink: 0;
    }

    /* Fee Box */
    .fee-box {
        min-height: 52px;
        box-sizing: border-box;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border: 1px solid #dce7e1;
        border-radius: 0;
        background: #fff;
    }

    .fee-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 0;
        background: #dff2e7;
        color: #16864b;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .fee-title {
        font-weight: 700;
        color: #26372e;
        font-size: 14px;
    }

    .fee-description {
        margin-top: 4px;
        color: #69756e;
        font-size: 12.5px;
        line-height: 1.45;
    }

    /* Actions Bottom Bar */
    .form-actions {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e4ebe7;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 130px;
        height: 50px;
        border: 1px solid #aab5af;
        border-radius: 0;
        background: white;
        color: #4f5d56;
        font-size: 16px;
        text-decoration: none;
        transition: background .2s, border-color .2s;
    }

    .btn-cancel:hover {
        background: #f3f5f4;
        border-color: #8c9992;
        color: #28332d;
    }

    .btn-submit {
        min-width: 280px;
        height: 52px;
        padding: 0 28px;
        border: 0;
        border-radius: 0;
        background: #17763f;
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(23, 118, 63, .20);
        transition: background .2s;
    }

    .btn-submit:hover {
        background: #126535;
    }

    .validation-summary-errors {
        background: #fff1f1;
        border: 1px solid #f3c7c7;
        color: #b42318;
        border-radius: 0;
        padding: 12px 16px;
        margin-bottom: 22px;
    }

    /* Responsive */
    @@media (max-width: 1199px) {
        .job-create-layout-grid {
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
            gap: 20px;
        }

        .col-job-preview {
            grid-column: 1 / -1;
            margin-top: 10px;
            padding-top: 24px;
            border-top: 1px dashed #DCE8E0;
        }

        .preview-sticky-wrap {
            position: static;
        }

        .col-job-preview .job-card {
            max-width: 600px;
            margin: 0 auto;
        }
    }

    @@media (max-width: 991px) {
        .recruitment-banner-hero {
            padding: 26px 22px;
        }

        .banner-title {
            font-size: 22px;
        }

        .job-form-card {
            padding: 26px 20px;
        }

        .job-create-layout-grid {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .col-job-budget-plan {
            padding: 20px;
        }

        .col-job-preview .job-card {
            max-width: 100%;
        }
    }

    @@media (max-width: 576px) {
        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
        }
    }
</style>

<div class="create-job-page">
    <div class="create-job-container">

        <!-- Quay lại -->
        <a asp-controller="JobPost" asp-action="Index" class="back-link">
            ← Quay lại
        </a>

        <!-- Banner Đồ Họa Thương Hiệu (Khắc phục 100% lỗi vỡ ảnh 404) -->
        <div class="recruitment-banner-hero">
            
            <h1 class="banner-title">Đăng tin tuyển dụng Freelancer sinh viên</h1>
           
        </div>

        <form asp-controller="JobPost" asp-action="Create" method="post" class="job-form-card">

            @Html.AntiForgeryToken()

            <input asp-for="maUser" type="hidden" />

            <div asp-validation-summary="ModelOnly"></div>

            <!-- BỐ CỤC 3 CỘT (DESKTOP/LAPTOP: NỘI DUNG / THÙ LAO / PREVIEW) -->
            <div class="job-create-layout-grid">

                <!-- CỘT 1: NỘI DUNG CÔNG VIỆC -->
                <div class="col-job-content">

                    <h2 class="section-title">
                        <span class="section-number">1</span>
                        Nội dung công việc
                    </h2>

                    <!-- 1. Tiêu đề -->
                    <div class="form-group">
                        <label asp-for="tieude" class="form-label">
                            Tiêu đề bài đăng
                            <span class="required">*</span>
                        </label>

                        <input asp-for="tieude" class="form-control-custom"
                               placeholder="Ví dụ: Thiết kế website bán hàng bằng ASP.NET Core" />

                        <span asp-validation-for="tieude" class="field-error"></span>
                    </div>

                    <!-- 2. Mô tả -->
                    <div class="form-group">
                        <label asp-for="mota" class="form-label">
                            Mô tả chi tiết yêu cầu công việc
                            <span class="required">*</span>
                        </label>

                        <textarea asp-for="mota" class="form-control-custom"
                                  placeholder="Mô tả phạm vi công việc, mục tiêu, yêu cầu kỹ thuật và sản phẩm cần bàn giao..."></textarea>

                        <span asp-validation-for="mota" class="field-error"></span>
                    </div>

                    <!-- 3. Kỹ năng yêu cầu & Gợi ý -->
                    <div class="form-group">
                        <label asp-for="kynangyeucau" class="form-label">
                            Kỹ năng yêu cầu
                        </label>

                        <input asp-for="kynangyeucau" id="skillInput" class="form-control-custom"
                               placeholder="Ví dụ: ASP.NET Core, SQL Server, HTML/CSS" />

                        <span asp-validation-for="kynangyeucau" class="field-error"></span>

                        <div class="skill-suggestions" id="skillSuggestionsBox">
                            <div class="d-flex align-items-center gap-2">
                                <span class="skill-label">Gợi ý kỹ năng:</span>
                                <span id="skillLoadingText" style="display:none; font-size: 13px; color: #16864b;">
                                    <span class="spinner-border spinner-border-sm" role="status" style="width: 14px; height: 14px;"></span> Đang tìm kỹ năng phù hợp...
                                </span>
                            </div>

                            <div id="skillListContainer" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px;">
                                <button type="button" class="skill-btn" data-skill="Photoshop">
                                    + Photoshop
                                </button>

                                <button type="button" class="skill-btn" data-skill="Figma">
                                    + Figma
                                </button>

                                <button type="button" class="skill-btn" data-skill="ASP.NET Core">
                                    + ASP.NET Core
                                </button>

                                <button type="button" class="skill-btn" data-skill="Flutter">
                                    + Flutter
                                </button>

                                <button type="button" class="skill-btn" data-skill="HTML/CSS">
                                    + HTML/CSS
                                </button>

                                <button type="button" class="skill-btn" data-skill="SQL Server">
                                    + SQL Server
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- CỘT 2: THÙ LAO & KẾ HOẠCH HOÀN THÀNH -->
                <div class="col-job-budget-plan">

                    <h2 class="section-title">
                        <span class="section-number">2</span>
                        Thù lao &amp; Kế hoạch
                    </h2>

                    <!-- 1. Mức thù lao -->
                    <div class="form-group">
                        <label asp-for="thulao" class="form-label">
                            Mức thù lao ngân sách (VNĐ)
                            <span class="required">*</span>
                        </label>

                        <div class="money-input">
                            <input asp-for="thulao" type="number" min="50000" class="form-control-custom"
                                   placeholder="Ví dụ: 1500000" />

                            <span class="money-unit">
                                VNĐ
                            </span>
                        </div>

                        <span asp-validation-for="thulao" class="field-error"></span>
                    </div>

                    <!-- 2. Số lượng sinh viên cần tuyển -->
                    <div class="form-group">
                        <label asp-for="soluongtuyen" class="form-label">
                            Số lượng sinh viên cần tuyển
                            <span class="required">*</span>
                        </label>

                        <input asp-for="soluongtuyen" type="number" min="1" max="50" class="form-control-custom" />

                        <span asp-validation-for="soluongtuyen" class="field-error"></span>
                    </div>

                    <!-- 3. Hạn hoàn thành dự kiến -->
                    <div class="form-group">
                        <label asp-for="thoigiandukienhoanthanh" class="form-label">
                            Hạn hoàn thành dự kiến
                            <span class="required">*</span>
                        </label>

                        <input asp-for="thoigiandukienhoanthanh" type="date" class="form-control-custom" />

                        <span asp-validation-for="thoigiandukienhoanthanh" class="field-error"></span>
                    </div>

                    <!-- 4. Chính sách phí đăng bài & Số dư ví -->
                    <div class="form-group">
                        <label class="form-label">
                            Chính sách thanh toán phí đăng bài
                        </label>

                        @{
                            decimal soDuHienTai = ViewBag.SoDuKhaDung != null ? (decimal)ViewBag.SoDuKhaDung : 0m;
                            bool khongDuTien = Model.phiDangBai > 0 && soDuHienTai < Model.phiDangBai;
                        }

                        <div class="fee-box" style="@(khongDuTien ? "border: 1.5px solid #dc3545; background-color: #fff5f5;" : "")">
                            <div class="fee-icon" style="@(khongDuTien ? "color: #dc3545; background-color: #ffe6e6;" : "")">@(khongDuTien ? "!" : "✓")</div>

                            <div style="flex-grow: 1;">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="fee-title" style="@(khongDuTien ? "color: #dc3545;" : "")">
                                        @Model.phiDangBai.ToString("N0") VNĐ phí đăng bài
                                    </div>
                                    <span class="badge @(khongDuTien ? "bg-danger" : "bg-success") text-white px-2 py-1" style="font-size: 0.8rem;">
                                        Ví: @soDuHienTai.ToString("N0") VNĐ
                                    </span>
                                </div>

                                <div class="fee-description mt-1">
                                    Phí đăng tin được trừ trực tiếp từ số dư khả dụng khi xuất bản bài đăng thành công (không ký quỹ).
                                </div>

                                @if (khongDuTien)
                                {
                                    <div class="mt-2 p-2 rounded bg-white border border-danger d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span class="text-danger small fw-semibold">
                                            ⚠️ Thiếu: @((Model.phiDangBai - soDuHienTai).ToString("N0")) VNĐ.
                                        </span>
                                        <a href="/Wallet" target="_blank" class="btn btn-sm btn-danger text-white px-3 py-1 text-decoration-none fw-bold" style="font-size: 0.8rem;">
                                            Nạp ví ngay &rarr;
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <!-- CỘT 3: XEM TRƯỚC TRÊN GIAO DIỆN FREELANCER (PREVIEW TĨNH) -->
                <div class="col-job-preview">
                    <div class="preview-sticky-wrap">
                        <h2 class="section-title">
                            <span class="section-number">3</span>
                            Dạng bài đăng sẽ hiển thị
                        </h2>
                        

                        <!-- Card công việc chuẩn góc nhìn Freelancer -->
                        <div class="job-card">
