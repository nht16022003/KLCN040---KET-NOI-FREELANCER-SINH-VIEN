                            <!-- Phần thân: Tiêu đề, mô tả tóm tắt, kỹ năng & thông số thù lao -->
                            <div class="job-card-body">
                                <h3 class="job-title-heading">
                                    <a href="javascript:void(0);" tabindex="-1" style="pointer-events: none;">
