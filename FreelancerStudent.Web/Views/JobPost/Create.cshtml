@model FreelancerStudent.Web.ViewModels.JobPostViewModel

@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
}

<style>
    .create-job-page {
        background: #f6f9f7;
        min-height: 100vh;
        padding: 30px 0 60px;
    }

    .create-job-container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
        color: #34423b;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
    }

    .back-link:hover {
        color: #16864b;
    }

    /* Banner */
    .recruitment-banner {
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 28px;
        background: white;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    }

    .recruitment-banner img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* Form */
    .job-form-card {
        background: #fff;
        border: 1px solid #e4ebe7;
        border-radius: 22px;
        padding: 38px 42px;
        box-shadow: 0 8px 30px rgba(21, 70, 44, 0.06);
    }

    .form-section+.form-section {
        margin-top: 38px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 24px;
        font-weight: 700;
        color: #10271c;
        margin: 0 0 26px;
        padding-bottom: 17px;
        border-bottom: 1px solid #e8eeea;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #e7f5ed;
        color: #16864b;
        font-size: 17px;
    }

    .form-group {
        margin-bottom: 23px;
    }

    .form-label {
        display: block;
        margin-bottom: 9px;
        font-size: 16px;
        font-weight: 650;
        color: #17251e;
    }

    .required {
        color: #dc3545;
    }

    .form-control-custom {
        box-sizing: border-box;
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #d8e0dc;
        border-radius: 11px;
        background: #fff;
        color: #1b2922;
        font-size: 16px;
        outline: none;
        transition: .2s;
    }

    .form-control-custom:focus {
        border-color: #16864b;
        box-shadow: 0 0 0 3px rgba(22, 134, 75, .09);
    }

    textarea.form-control-custom {
        min-height: 160px;
        resize: vertical;
    }

    .field-error {
        display: block;
        color: #dc3545;
        font-size: 13px;
        margin-top: 6px;
    }

    /* Skill */
    .skill-suggestions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        margin-top: 12px;
    }

    .skill-label {
        color: #6b756f;
        margin-right: 3px;
    }

    .skill-btn {
        border: 1px solid #cfe4d8;
        background: #eff8f3;
        color: #176c42;
        border-radius: 50px;
        padding: 8px 15px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .skill-btn:hover {
        background: #dff1e7;
    }

    /* 2 columns */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .money-input {
        display: flex;
    }

    .money-input input {
        border-radius: 11px 0 0 11px;
    }

    .money-unit {
        display: flex;
        align-items: center;
        padding: 0 18px;
        border: 1px solid #d8e0dc;
        border-left: 0;
        border-radius: 0 11px 11px 0;
        background: #f7f9f8;
        color: #56635c;
        font-weight: 600;
    }

    /* Fee */
    .fee-box {
        min-height: 52px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        border: 1px solid #dce7e1;
        border-radius: 11px;
        background: #f5faf7;
    }

    .fee-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #dff2e7;
        color: #16864b;
        font-weight: 800;
    }

    .fee-title {
        font-weight: 700;
        color: #26372e;
    }

    .fee-description {
        margin-top: 2px;
        color: #69756e;
        font-size: 13px;
    }

    /* Buttons */
    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 36px;
        padding-top: 26px;
        border-top: 1px solid #e4ebe7;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 130px;
        height: 50px;
        border: 1px solid #aab5af;
        border-radius: 50px;
        background: white;
        color: #4f5d56;
        font-size: 16px;
        text-decoration: none;
    }

    .btn-submit {
        min-width: 300px;
        height: 54px;
        padding: 0 28px;
        border: 0;
        border-radius: 50px;
        background: #17763f;
        color: white;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(23, 118, 63, .20);
    }

    .btn-submit:hover {
        background: #126535;
    }

    .validation-summary-errors {
        background: #fff1f1;
        border: 1px solid #f3c7c7;
        color: #b42318;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 22px;
    }

    @@media (max-width: 768px) {
        .job-form-card {
            padding: 25px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
        }
    }
</style>

<div class="create-job-page">
    <div class="create-job-container">

        <!-- Quay lại -->
        <a asp-controller="JobPost" asp-action="Index" class="back-link">
            ← Quay lại
        </a>

        <!-- Banner -->
        <div class="recruitment-banner">
            <img src="~/images/tuyendung.png" alt="Đăng tin tuyển dụng sinh viên" />
        </div>

        <form asp-controller="JobPost" asp-action="Create" method="post" class="job-form-card">

            @Html.AntiForgeryToken()

            <input asp-for="maUser" type="hidden" />

            <div asp-validation-summary="ModelOnly"></div>

            <!-- PHẦN 1 -->
            <section class="form-section">

                <h2 class="section-title">
                    <span class="section-number">1</span>
                    Nội dung công việc
                </h2>

                <div class="form-group">
                    <label asp-for="tieude" class="form-label">
                        Tiêu đề bài đăng
                        <span class="required">*</span>
                    </label>

                    <input asp-for="tieude" class="form-control-custom"
                           placeholder="Ví dụ: Thiết kế website bán hàng bằng ASP.NET Core" />

                    <span asp-validation-for="tieude" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="mota" class="form-label">
                        Mô tả chi tiết yêu cầu công việc
                        <span class="required">*</span>
                    </label>

                    <textarea asp-for="mota" class="form-control-custom"
                              placeholder="Mô tả phạm vi công việc, mục tiêu, yêu cầu kỹ thuật và sản phẩm cần bàn giao..."></textarea>

                    <span asp-validation-for="mota" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="kynangyeucau" class="form-label">
                        Kỹ năng yêu cầu
                    </label>

                    <input asp-for="kynangyeucau" id="skillInput" class="form-control-custom"
                           placeholder="Ví dụ: ASP.NET Core, SQL Server, HTML/CSS" />

                    <span asp-validation-for="kynangyeucau" class="field-error"></span>

                    <div class="skill-suggestions">
                        <span class="skill-label">Gợi ý:</span>

                        <button type="button" class="skill-btn" data-skill="Photoshop">
                            + Photoshop
                        </button>

                        <button type="button" class="skill-btn" data-skill="Figma">
                            + Figma
                        </button>

                        <button type="button" class="skill-btn" data-skill="ASP.NET Core">
                            + ASP.NET Core
                        </button>

                        <button type="button" class="skill-btn" data-skill="Flutter">
                            + Flutter
                        </button>

                        <button type="button" class="skill-btn" data-skill="HTML/CSS">
                            + HTML/CSS
                        </button>

                        <button type="button" class="skill-btn" data-skill="SQL Server">
                            + SQL Server
                        </button>
                    </div>
                </div>

            </section>

            <!-- PHẦN 2 -->
            <section class="form-section">

                <h2 class="section-title">
                    <span class="section-number">2</span>
                    Ngân sách thù lao &amp; Kế hoạch hoàn thành
                </h2>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="thulao" class="form-label">
                            Mức thù lao ngân sách (VNĐ)
                            <span class="required">*</span>
                        </label>

                        <div class="money-input">
                            <input asp-for="thulao" type="number" min="50000" class="form-control-custom"
                                   placeholder="Ví dụ: 1500000" />

                            <span class="money-unit">
                                VNĐ
                            </span>
                        </div>

                        <span asp-validation-for="thulao" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="soluongtuyen" class="form-label">
                            Số lượng sinh viên cần tuyển
                            <span class="required">*</span>
                        </label>

                        <input asp-for="soluongtuyen" type="number" min="1" max="50" class="form-control-custom" />

                        <span asp-validation-for="soluongtuyen" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="thoigiandukienhoanthanh" class="form-label">
                            Hạn hoàn thành dự kiến
                            <span class="required">*</span>
                        </label>

                        <input asp-for="thoigiandukienhoanthanh" type="date" class="form-control-custom" />

                        <span asp-validation-for="thoigiandukienhoanthanh" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Chính sách thanh toán
                        </label>

                        <div class="fee-box">
                            <div class="fee-icon">✓</div>

                            <div>
                                <div class="fee-title">
                                    @Model.phiDangBai.ToString("N0") đồng phí đăng tin tuyển dụng
                                </div>

                                <div class="fee-description">
                                    Phí đăng bài hiện tại của hệ thống.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </section>

            <div class="form-actions">

                <a asp-controller="JobPost" asp-action="Index" class="btn-cancel">
                    Hủy bỏ
                </a>

                <button type="submit" class="btn-submit">
                    Đăng tin tuyển dụng ngay
                </button>

            </div>

        </form>

    </div>
</div>

<script>
    document.querySelectorAll(".skill-btn").forEach(function (button) {

        button.addEventListener("click", function () {

            const input = document.getElementById("skillInput");
            const skill = this.dataset.skill;

            let skills = input.value
                .split(",")
                .map(x => x.trim())
                .filter(x => x.length > 0);

            if (!skills.includes(skill)) {
                skills.push(skill);
            }

            input.value = skills.join(", ");
        });

    });
</script>