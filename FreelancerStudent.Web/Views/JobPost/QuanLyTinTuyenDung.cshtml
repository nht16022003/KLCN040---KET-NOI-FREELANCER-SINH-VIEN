@using FreelancerStudent.Web.ViewModels
@model List<FreelancerStudent.Web.ViewModels.JobPostViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý bài tuyển dụng";

    var dsJob = Model ?? new List<JobPostViewModel>();
    var tongTin = dsJob.Count;
    var dangTuyen = dsJob.Count(j => j.status == "DangTuyen" || string.IsNullOrEmpty(j.status));
    var daDong = dsJob.Count(j => j.status != "DangTuyen" && !string.IsNullOrEmpty(j.status));
    var tongUngVien = dsJob.Sum(j => j.soLuongUngTuyen);
}

<style>
    .ql-page {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 28px 0 50px;
    }

    /* Thống kê */
    .stat-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 16px 20px;
    }
    .stat-box .num {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.2;
        margin-top: 4px;
    }
    .stat-box .lbl {
        font-size: 0.82rem;
        color: #64748B;
        font-weight: 500;
    }

    /* Thẻ công việc */
    .job-item-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 14px;
        transition: border-color 0.15s;
    }
    .job-item-card:hover {
        border-color: #2E7D32;
    }

    .job-title-link {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1E293B;
        text-decoration: none;
    }
    .job-title-link:hover {
        color: #1B5E36;
    }

    /* Badge trạng thái */
    .badge-status-on {
        background-color: #E8F5E9;
        color: #1B5E36;
        border: 1px solid #C8E6C9;
        font-size: 0.76rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 12px;
        display: inline-block;
    }
    .badge-status-off {
        background-color: #F1F5F9;
        color: #475569;
        border: 1px solid #CBD5E1;
        font-size: 0.76rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 12px;
        display: inline-block;
    }

    /* Nút lọc */
    .tab-filter-btn {
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #475569;
        font-size: 0.88rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .tab-filter-btn.active {
        background: #1B5E36;
        border-color: #1B5E36;
        color: #FFFFFF;
    }

    .meta-tag {
        display: inline-block;
        font-size: 0.82rem;
        color: #475569;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        padding: 3px 9px;
        border-radius: 4px;
    }
</style>

<div class="ql-page">
    <div class="container">

        <!-- Thông báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-2 mb-3" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-2 mb-3" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Header trang -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4 pb-2 border-bottom">
            <div>
                <h4 class="fw-bold text-dark mb-1">Quản lý bài tuyển dụng</h4>
                <p class="text-muted small mb-0">Theo dõi các tin tuyển dụng, tiếp nhận và duyệt hồ sơ ứng tuyển sinh viên</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="NhaTuyenDung" asp-action="DanhSachUngVien" class="btn btn-outline-success">
                    Tất cả ứng viên
                </a>
                <a asp-controller="JobPost" asp-action="Create" class="btn btn-success fw-semibold">
                    + Đăng tin mới
                </a>
            </div>
        </div>

        <!-- Khối thống kê 4 ô -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-box">
                    <div class="lbl">Tổng số tin đăng</div>
                    <div class="num text-dark">@tongTin</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-box">
                    <div class="lbl">Đang nhận hồ sơ</div>
                    <div class="num text-success">@dangTuyen</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-box">
                    <div class="lbl">Đã đóng / Tạm dừng</div>
                    <div class="num text-secondary">@daDong</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-box">
                    <div class="lbl">Tổng lượt ứng tuyển</div>
                    <div class="num text-primary">@tongUngVien</div>
                </div>
            </div>
        </div>

        <!-- Thanh tìm kiếm & lọc trạng thái -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <div style="max-width: 360px; width: 100%;">
                <input type="text" id="filterSearch" class="form-control" placeholder="Tìm theo tiêu đề, kỹ năng, mã tin..." />
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="tab-filter-btn active" data-filter="all">Tất cả (@tongTin)</button>
                <button type="button" class="tab-filter-btn" data-filter="DangTuyen">Đang tuyển (@dangTuyen)</button>
                <button type="button" class="tab-filter-btn" data-filter="DaDong">Đã đóng (@daDong)</button>
            </div>
        </div>

        <!-- Danh sách bài đăng -->
        <div id="jobCardList">
            @if (dsJob.Any())
            {
                @foreach (var job in dsJob)
                {
                    var isDangTuyen = job.status == "DangTuyen" || string.IsNullOrEmpty(job.status);
                    var statusCategory = isDangTuyen ? "DangTuyen" : "DaDong";

                    <div class="job-item-card" data-status="@statusCategory"
                         data-search="@((job.tieude + " " + job.maJob + " " + (job.kynangyeucau ?? "")).ToLower())">
                        <div class="row align-items-center g-3">
                            
                            <!-- Thông tin bên trái -->
                            <div class="col-md-8 col-lg-9">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge bg-light text-dark border">#@job.maJob</span>
                                    
                                    @if (isDangTuyen)
                                    {
                                        <span class="badge-status-on">Đang nhận đơn</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-off">Đã đóng tin</span>
                                    }

                                    <span class="text-muted small ms-1">
                                        Đăng ngày @job.thoigiandangtuyen.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <div class="mb-2">
                                    <a asp-action="Detail" asp-route-maJob="@job.maJob" class="job-title-link">
                                        @job.tieude
                                    </a>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(job.mota))
                                {
                                    <p class="text-muted small mb-2 text-truncate" style="max-width: 720px;">
                                        @job.mota
                                    </p>
                                }

                                <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                    <span class="meta-tag fw-bold text-danger">
                                        @((job.thulao ?? 0).ToString("#,##0")) VNĐ
                                    </span>
                                    <span class="meta-tag">
                                        Tuyển @(job.soluongtuyen ?? 1) sinh viên
                                    </span>
                                    <span class="meta-tag">
                                        Hạn: @job.thoigiandukienhoanthanh.ToString("dd/MM/yyyy")
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(job.kynangyeucau))
                                    {
                                        <span class="meta-tag text-truncate" style="max-width: 260px;">
                                            @job.kynangyeucau
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Hành động bên phải: Xếp dạng cột dọc, không có dấu gạch ngang -->
                            <div class="col-md-4 col-lg-3 text-md-end">
                                <div class="d-flex flex-column gap-2 justify-content-center" style="max-width: 170px; margin-left: auto;">
                                    <a asp-controller="NhaTuyenDung" asp-action="DanhSachUngVien" asp-route-maJob="@job.maJob"
                                       class="btn btn-sm @(job.soLuongUngTuyen > 0 ? "btn-success" : "btn-outline-secondary") w-100">
                                        Ứng viên (@job.soLuongUngTuyen)
                                    </a>

                                    <a asp-action="Detail" asp-route-maJob="@job.maJob" class="btn btn-sm btn-outline-secondary w-100">
                                        Xem chi tiết
                                    </a>

                                    <a asp-action="Edit" asp-route-maJob="@job.maJob" class="btn btn-sm btn-outline-secondary w-100">
                                        Sửa tin
                                    </a>

                                    <form asp-action="DoiTrangThai" method="post" class="w-100 m-0"
                                          onsubmit="return confirm('@(isDangTuyen ? "Bạn muốn đóng bài tuyển dụng này? Sinh viên sẽ không thể nộp đơn mới." : "Bạn muốn mở lại bài tuyển dụng này?")')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maJob" value="@job.maJob" />
                                        <input type="hidden" name="trangThaiMoi" value="@(isDangTuyen ? "DaDong" : "DangTuyen")" />
                                        @if (isDangTuyen)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                Đóng tin
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                                Mở lại
                                            </button>
                                        }
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-white border rounded-2 p-5 text-center text-muted">
                    <h6 class="fw-bold text-dark">Bạn chưa có bài tuyển dụng nào</h6>
                    <p class="small text-muted mb-3">Đăng tin để kết nối với các bạn sinh viên ngay hôm nay.</p>
                    <a asp-controller="JobPost" asp-action="Create" class="btn btn-success btn-sm px-3">
                        + Đăng bài tuyển dụng đầu tiên
                    </a>
                </div>
            }
        </div>

        <div id="noResultBox" class="bg-white border rounded-2 p-4 text-center text-muted mt-3 d-none">
            Không tìm thấy bài tuyển dụng nào phù hợp với từ khóa hoặc bộ lọc đã chọn.
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("filterSearch");
        const filterBtns = document.querySelectorAll(".tab-filter-btn");
        const jobCards = document.querySelectorAll(".job-item-card");
        const noResultBox = document.getElementById("noResultBox");

        let currentFilter = "all";
        let currentKeyword = "";

        function applyFilter() {
            let matchedCount = 0;
            jobCards.forEach(card => {
                const status = card.getAttribute("data-status");
                const searchData = card.getAttribute("data-search") || "";

                const matchStatus = (currentFilter === "all") || (status === currentFilter);
                const matchSearch = (currentKeyword === "") || searchData.includes(currentKeyword);

                if (matchStatus && matchSearch) {
                    card.style.display = "";
                    matchedCount++;
                } else {
                    card.style.display = "none";
                }
            });

            if (noResultBox) {
                if (matchedCount === 0 && jobCards.length > 0) {
                    noResultBox.classList.remove("d-none");
                } else {
                    noResultBox.classList.add("d-none");
                }
            }
        }

        if (searchInput) {
            searchInput.addEventListener("input", function (e) {
                currentKeyword = e.target.value.toLowerCase().trim();
                applyFilter();
            });
        }

        filterBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                filterBtns.forEach(b => b.classList.remove("active"));
                this.classList.add("active");
                currentFilter = this.getAttribute("data-filter");
                applyFilter();
            });
        });
    });
</script>
