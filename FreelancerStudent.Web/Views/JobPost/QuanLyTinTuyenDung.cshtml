@using FreelancerStudent.Web.ViewModels
@model List<FreelancerStudent.Web.ViewModels.JobPostViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý tin tuyển dụng";
}

<div class="container py-4">
    <!-- TIÊU ĐỀ & NÚT ĐĂNG TIN -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="text-success fw-bold mb-1">
                <i class="bi bi-briefcase-fill me-2"></i>Quản lý tin tuyển dụng đã đăng
            </h4>
            <span class="text-muted small">Theo dõi danh sách các bài tuyển dụng và quản lý ứng viên</span>
        </div>
        <a asp-controller="JobPost" asp-action="Create" class="btn btn-success fw-bold px-3 py-2 rounded-0">
            <i class="bi bi-plus-circle me-1"></i>Đăng tin tuyển dụng mới
        </a>
    </div>

    <!-- DANH SÁCH BÀI JOB -->
    <div class="row g-3">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var job in Model)
            {
                <div class="col-12">
                    <div class="card border p-3 bg-white rounded-0 shadow-sm">
                        <div class="row align-items-center">
                            
                            <!-- Thông tin bài tuyển dụng -->
                            <div class="col-lg-7 mb-3 mb-lg-0">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-light text-muted border rounded-0">#@job.maJob</span>
                                    <span class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>Đăng ngày: @job.thoigiandangtuyen.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">@job.tieude</h5>

                                <p class="text-secondary small mb-2"
                                   style="max-height: 42px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @job.mota
                                </p>

                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="text-danger fw-bold small">
                                        Ngân sách: @((job.thulao ?? 0).ToString("#,##0")) VNĐ
                                    </span>
                                    <span class="text-muted small ms-2">
                                        <i class="bi bi-people me-1"></i>Tuyển: @(job.soluongtuyen ?? 1) bạn
                                    </span>
                                    <span class="text-muted small ms-2">
                                        <i class="bi bi-hourglass-split me-1"></i>Hạn:
                                        @job.thoigiandukienhoanthanh.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                            </div>

                            <!-- Trạng thái & Nút thao tác -->
                            <div class="col-lg-5 text-lg-end border-top border-lg-0 pt-3 pt-lg-0">
                                <div class="mb-3">
                                    @if (job.status == "DangTuyen")
                                    {
                                        <span
                                            class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-0">
                                            <i class="bi bi-broadcast me-1"></i>Đang tuyển dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-0">@job.status</span>
                                    }
                                </div>

                                <div class="d-flex justify-content-lg-end gap-2">
                                    <!-- Nút Xem danh sách ứng viên theo mã Job -->
                                    <a asp-controller="NhaTuyenDung" asp-action="DanhSachUngVien" asp-route-maJob="@job.maJob"
                                       class="btn btn-sm btn-outline-success rounded-0 fw-semibold">
                                        <i class="bi bi-people me-1"></i>Xem ứng viên
                                    </a>
                                    <a asp-action="Edit" asp-route-maJob="@job.maJob"
                                       class="btn btn-sm btn-outline-secondary rounded-0">
                                        <i class="bi bi-pencil me-1"></i>Sửa tin
                                    </a>


                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border rounded-0 text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    Bạn chưa đăng bài tuyển dụng nào.
                    <div class="mt-3">
                        <a asp-controller="JobPost" asp-action="Create" class="btn btn-sm btn-success rounded-0">
                            Đăng bài tuyển dụng đầu tiên
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
