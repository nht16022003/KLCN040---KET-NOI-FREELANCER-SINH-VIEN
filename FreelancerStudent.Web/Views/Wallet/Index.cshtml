@model FreelancerStudent.Web.ViewModels.WalletViewModel
@{
    ViewData["Title"] = "Ví tài khoản & Thanh toán mô phỏng";
    var chuVi = Model?.tenUsers ?? Context.Session.GetString("hovaten") ?? "Người dùng";
    var soDuKhaDung = Model?.soDuKhaDung ?? 0;
    var soDuDongBang = Model?.soDuDongBang ?? 0;
    var tongTaiSan = Model?.tongTaiSan ?? (soDuKhaDung + soDuDongBang);
    var lichSu = Model?.LichSuGiaoDichs ?? new List<FreelancerStudent.Web.ViewModels.LichSuGiaoDichItemViewModel>();
    var danhSachRut = Model?.DanhSachRutTiens ?? new List<FreelancerStudent.Web.ViewModels.YeuCauRutTienItemViewModel>();
}

<style>
    .wallet-page {
        background-color: #F8FAF9;
        min-height: 85vh;
        padding: 28px 0 60px;
        color: #2B2B2B;
    }

    /* Thẻ Hero ví chính */
    .wallet-hero-box {
        background: #234E36;
        color: #FFFFFF;
        border-radius: 10px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 12px rgba(35, 78, 54, 0.12);
    }

    .wallet-sub-card {
        background: rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        padding: 14px 18px;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Hộp nội dung chung */
    .content-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    /* Tabs điều hướng */
    .wallet-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 2px solid #E2E8F0;
        margin-bottom: 24px;
        overflow-x: auto;
    }

    .wallet-tab-btn {
        background: transparent;
        border: none;
        padding: 12px 20px;
        font-weight: 600;
        color: #64748B;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .wallet-tab-btn:hover {
        color: #234E36;
    }

    .wallet-tab-btn.active {
        color: #234E36;
        border-bottom-color: #234E36;
    }

    /* Nút chọn mức tiền nạp */
    .amount-pick-btn {
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #334155;
        font-weight: 600;
        padding: 10px 8px;
        border-radius: 6px;
        width: 100%;
        transition: all 0.15s;
    }
    .amount-pick-btn:hover {
        border-color: #234E36;
        color: #234E36;
        background: #F0FDF4;
    }
    .amount-pick-btn.active {
        background: #234E36;
        border-color: #234E36;
        color: #FFFFFF;
    }

    /* Bảng thông tin thanh toán */
    .bank-info-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 16px;
        font-size: 0.9rem;
    }
    .bank-info-row {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        border-bottom: 1px dashed #E2E8F0;
    }
    .bank-info-row:last-child {
        border-bottom: none;
    }

    /* Bảng lịch sử giao dịch */
    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }
    .custom-table th {
        background: #F1F5F9;
        color: #475569;
        font-weight: 600;
        padding: 12px 14px;
        border-bottom: 2px solid #CBD5E1;
        text-align: left;
    }
    .custom-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #E2E8F0;
        vertical-align: middle;
    }
    .custom-table tr:hover {
        background-color: #F8FAFC;
    }

    .badge-soft {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .badge-soft-green { background: #E6F4EA; color: #1E7E34; }
    .badge-soft-yellow { background: #FEF3C7; color: #B45309; }
    .badge-soft-blue { background: #E0F2FE; color: #0369A1; }
    .badge-soft-red { background: #FEE2E2; color: #B91C1C; }
    .badge-soft-purple { background: #F3E8FF; color: #6B21A8; }
    .badge-soft-gray { background: #F1F5F9; color: #475569; }

    .sim-banner {
        background: #F0FDF4;
        border-left: 4px solid #234E36;
        padding: 12px 16px;
        border-radius: 4px;
        font-size: 0.86rem;
        margin-bottom: 20px;
        color: #166534;
    }
</style>

<div class="wallet-page">
    <div class="container" style="max-width: 1020px;">

        <!-- ==================== BANNER MÔ PHỎNG ==================== -->
        <div class="sim-banner">
            <strong>Hệ thống thanh toán mô phỏng nội bộ:</strong> Tất cả giao dịch nạp tiền, giữ tiền ký quỹ hợp đồng, giải ngân và rút tiền được quản lý và cập nhật an toàn trực tiếp trong SQL Server.
        </div>

        @if (ViewBag.DaXacMinhSinhVien == false)
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-3 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-shield-exclamation text-warning fs-2 flex-shrink-0"></i>
                    <div>
                        <strong class="d-block text-dark fs-6">Yêu cầu xác thực thẻ sinh viên!</strong>
                        <span class="text-secondary small">Trạng thái minh chứng: <strong class="text-dark">@(ViewBag.TrangThaiXacMinh ?? "Chưa gửi")</strong>. Bạn cần được xác thực Thẻ sinh viên (trạng thái 'Đã xác minh') để thực hiện nạp tiền và rút tiền ví.</span>
                    </div>
                </div>
                <a href="@Url.Action("MinhChung", "Account")" class="btn btn-warning fw-semibold btn-sm px-3 shadow-sm text-nowrap">
                    <i class="bi bi-person-badge me-1"></i> Xác thực ngay
                </a>
            </div>
        }

        <!-- ==================== THẺ VÍ TỔNG QUAN ==================== -->
        <div class="wallet-hero-box">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div style="font-size: 0.85rem; opacity: 0.85;">Ví tài khoản cá nhân</div>
                    <h4 class="fw-bold text-white mb-0">@chuVi</h4>
                </div>
                <div class="text-end">
                    <span class="badge bg-light text-dark px-3 py-1 fw-bold" style="font-size: 0.82rem;">
                        @(Model?.maWallet > 0 ? $"Mã ví: #{Model.maWallet}" : "Tài khoản nội bộ")
                    </span>
                </div>
            </div>

            <div class="mb-4">
                <div style="font-size: 0.84rem; opacity: 0.85;">Số dư khả dụng (Có thể sử dụng / rút)</div>
                <div class="fs-1 fw-bold text-white">
                    @soDuKhaDung.ToString("#,##0") <span style="font-size: 1.15rem; font-weight: normal;">VNĐ</span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="wallet-sub-card">
                        <div style="font-size: 0.78rem; opacity: 0.85;">Số dư đóng băng (Ký quỹ HĐ / Chờ rút):</div>
                        <div class="fw-bold fs-5 text-white">@soDuDongBang.ToString("#,##0") VNĐ</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="wallet-sub-card">
                        <div style="font-size: 0.78rem; opacity: 0.85;">Tổng tài sản trong ví:</div>
                        <div class="fw-bold fs-5 text-white">@tongTaiSan.ToString("#,##0") VNĐ</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== ĐIỀU HƯỚNG TABS ==================== -->
        <div class="wallet-tabs">
            <button class="wallet-tab-btn active" onclick="switchWalletTab('nap-tien')">Nạp tiền vào ví</button>
            <button class="wallet-tab-btn" onclick="switchWalletTab('rut-tien')">Rút tiền mô phỏng</button>
            <button class="wallet-tab-btn" onclick="switchWalletTab('lich-su')">Lịch sử giao dịch (@lichSu.Count)</button>
            <button class="wallet-tab-btn" onclick="switchWalletTab('ds-rut')">Yêu cầu rút tiền (@danhSachRut.Count)</button>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 1: NẠP TIỀN VÀO VÍ                                    -->
        <!-- ========================================================= -->
        <div id="tab-nap-tien" class="wallet-tab-pane">
            <div class="content-box">
                <h5 class="fw-bold text-dark mb-2">Tạo yêu cầu nạp tiền</h5>
                <p class="text-muted small mb-3">Chọn số tiền nạp nhanh hoặc tự nhập số tiền cần nạp vào ví (Tối thiểu 100.000 VNĐ):</p>

                <!-- Các mức tiền gợi ý -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-sm-3">
                        <button type="button" class="amount-pick-btn amount-btn" data-amount="100000">100.000 đ</button>
                    </div>
                    <div class="col-6 col-sm-3">
                        <button type="button" class="amount-pick-btn amount-btn" data-amount="200000">200.000 đ</button>
                    </div>
                    <div class="col-6 col-sm-3">
                        <button type="button" class="amount-pick-btn amount-btn" data-amount="500000">500.000 đ</button>
                    </div>
                    <div class="col-6 col-sm-3">
                        <button type="button" class="amount-pick-btn amount-btn" data-amount="1000000">1.000.000 đ</button>
                    </div>
                </div>

                <!-- Nhập số tiền khác -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Số tiền cần nạp (VNĐ):</label>
                    <div class="input-group">
                        <input type="number" id="soTien" class="form-control" placeholder="Tối thiểu 100.000 đ" />
                        <span class="input-group-text bg-light">VNĐ</span>
                    </div>
                    <div id="thongBaoLoiNap" class="text-danger small mt-1"></div>
                </div>

                <button type="button" id="btnXacNhanNap" class="btn btn-success fw-semibold px-4 py-2" style="background:#234E36; border-color:#234E36;">
                    Tạo mã nạp tiền
                </button>
            </div>

            <!-- Khung thông tin giao dịch sau khi tạo -->
            <div id="thongTinGiaoDich" class="content-box" style="display:none;">
                <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">Thông tin chuyển khoản & Xác nhận</h5>

                <div class="row g-4 align-items-center">
                    <div class="col-md-5 text-center">
                        <p class="fw-semibold small text-dark mb-2">Mã QR VietQR chuyển khoản:</p>
                        <div class="p-2 border rounded bg-white d-inline-block">
                            <img id="qrThanhToan" src="" alt="Mã QR thanh toán" style="width:230px; max-width:100%; height:auto;" />
                        </div>
                        <div class="small text-muted mt-2">
                            Hiệu lực còn lại: <b id="thoiGianConLai" class="text-danger">30:00</b>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="bank-info-box mb-3">
                            <div class="bank-info-row">
                                <span class="text-muted">Ngân hàng thụ hưởng:</span>
                                <strong class="text-dark">MB Bank</strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Số tài khoản:</span>
                                <strong class="text-dark">0378896290</strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Chủ tài khoản:</span>
                                <strong class="text-dark">DANG TUAN ANH</strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Mã giao dịch:</span>
                                <strong id="maGiaoDichHienThi" class="text-dark"></strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Số tiền:</span>
                                <strong id="soTienGiaoDich" class="text-danger fw-bold fs-6"></strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Nội dung CK:</span>
                                <strong id="noiDungChuyenKhoan" class="text-primary fw-bold"></strong>
                            </div>
                            <div class="bank-info-row">
                                <span class="text-muted">Trạng thái:</span>
                                <span id="trangThaiGiaoDich" class="badge bg-warning text-dark">Đang xử lý</span>
                            </div>
                        </div>

                        <!-- Khối xác nhận mô phỏng demo -->
                        <div class="p-3 border rounded bg-light mb-3">
                            <div class="fw-semibold small text-dark mb-1">Môi trường kiểm thử Demo:</div>
                            <p class="small text-muted mb-2">
                                Trong môi trường thử nghiệm, bạn có thể bấm nút dưới để hệ thống cập nhật tiền vào ví và ghi nhận lịch sử giao dịch trong SQL Server ngay lập tức:
                            </p>
                            <button type="button" id="btnXacNhanMoPhong" class="btn btn-outline-success fw-semibold btn-sm px-3 py-2">
                                Xác nhận nạp tiền mô phỏng
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 2: RÚT TIỀN MÔ PHỎNG                                  -->
        <!-- ========================================================= -->
        <div id="tab-rut-tien" class="wallet-tab-pane" style="display:none;">
            <div class="content-box">
                <h5 class="fw-bold text-dark mb-2">Tạo yêu cầu rút tiền mô phỏng</h5>
                <p class="text-muted small mb-3">
                    Số tiền rút sẽ được tạm chuyển sang <strong>Số dư đóng băng</strong> trong thời gian chờ duyệt mô phỏng.
                </p>

                <div class="alert alert-light border small text-dark mb-3">
                    Số dư khả dụng hiện tại: <strong>@soDuKhaDung.ToString("N0") VNĐ</strong> (Rút tối thiểu 50.000 VNĐ).
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Số tiền cần rút (VNĐ):</label>
                        <input type="number" id="rutSoTien" class="form-control" placeholder="Ví dụ: 100000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Tên ngân hàng thụ hưởng:</label>
                        <input type="text" id="rutNganHang" class="form-control" placeholder="Ví dụ: Vietcombank, MB Bank, Techcombank..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Số tài khoản ngân hàng:</label>
                        <input type="text" id="rutSoTaiKhoan" class="form-control" placeholder="Nhập số tài khoản thụ hưởng" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Tên chủ tài khoản:</label>
                        <input type="text" id="rutTenChuTaiKhoan" class="form-control" placeholder="Ví dụ: NGUYEN VAN A" />
                    </div>
                </div>

                <div id="thongBaoLoiRut" class="text-danger small mb-3"></div>

                <button type="button" id="btnGuiYeuCauRut" class="btn btn-primary fw-semibold px-4 py-2" style="background:#234E36; border-color:#234E36;">
                    Gửi yêu cầu rút tiền
                </button>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 3: LỊCH SỬ BIẾN ĐỘNG SỐ DƯ                             -->
        <!-- ========================================================= -->
        <div id="tab-lich-su" class="wallet-tab-pane" style="display:none;">
            <div class="content-box p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
                    <h6 class="fw-bold mb-0 text-dark">Lịch sử biến động số dư (SQL Server)</h6>
                    <span class="small text-muted">Tổng cộng: @lichSu.Count bản ghi</span>
                </div>

                @if (lichSu.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        Chưa có biến động số dư nào được ghi nhận cho ví của bạn.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Mã GD</th>
                                    <th>Thời gian</th>
                                    <th>Loại giao dịch</th>
                                    <th>Số tiền</th>
                                    <th>Số dư sau</th>
                                    <th>Nội dung</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in lichSu)
                                {
                                    var isCong = item.loaiGiaoDich is "NapTien" or "NhanThuLao" or "NhanTienHopDong" or "AdminCongTien" or "HoanTienRut";
                                    var badgeClass = item.loaiGiaoDich switch
                                    {
                                        "NapTien" => "badge-soft-green",
                                        "NhanThuLao" or "NhanTienHopDong" => "badge-soft-green",
                                        "KyQuyHopDong" => "badge-soft-yellow",
                                        "GiaiNganHopDong" => "badge-soft-blue",
                                        "GiuTienRut" => "badge-soft-yellow",
                                        "RutTien" => "badge-soft-blue",
                                        "HoanTienRut" => "badge-soft-green",
                                        "AdminCongTien" => "badge-soft-purple",
                                        "AdminTruTien" => "badge-soft-red",
                                        _ => "badge-soft-gray"
                                    };

                                    var loaiHienThi = item.loaiGiaoDich switch
                                    {
                                        "NapTien" => "Nạp tiền",
                                        "NhanThuLao" or "NhanTienHopDong" => "Nhận thù lao",
                                        "KyQuyHopDong" => "Ký quỹ HĐ",
                                        "GiaiNganHopDong" => "Giải ngân HĐ",
                                        "GiuTienRut" => "Khóa tiền rút",
                                        "RutTien" => "Rút tiền",
                                        "HoanTienRut" => "Hoàn tiền rút",
                                        "AdminCongTien" => "Admin cộng tiền",
                                        "AdminTruTien" => "Admin trừ tiền",
                                        _ => item.loaiGiaoDich
                                    };

                                    <tr>
                                        <td>#@item.maGiaoDich</td>
                                        <td class="text-muted small">@item.ngayTao?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge-soft @badgeClass">@loaiHienThi</span></td>
                                        <td class="fw-bold @(isCong ? "text-success" : "text-danger")">
                                            @(isCong ? "+" : "-")@item.soTien.ToString("N0") đ
                                        </td>
                                        <td class="text-muted">@item.soDuSauGD.ToString("N0") đ</td>
                                        <td>@item.noiDung</td>
                                        <td>
                                            @if (item.trangThai == "ThanhCong")
                                            {
                                                <span class="badge bg-success">Thành công</span>
                                            }
                                            else if (item.trangThai == "ChoXuLy")
                                            {
                                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.trangThai</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 4: DANH SÁCH YÊU CẦU RÚT TIỀN                         -->
        <!-- ========================================================= -->
        <div id="tab-ds-rut" class="wallet-tab-pane" style="display:none;">
            <div class="content-box p-0 overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
                    <h6 class="fw-bold mb-0 text-dark">Danh sách yêu cầu rút tiền mô phỏng</h6>
                    <span class="small text-muted">Tổng cộng: @danhSachRut.Count yêu cầu</span>
                </div>

                @if (danhSachRut.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        Bạn chưa gửi yêu cầu rút tiền nào.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Mã yêu cầu</th>
                                    <th>Ngày gửi</th>
                                    <th>Số tiền rút</th>
                                    <th>Ngân hàng</th>
                                    <th>Số tài khoản</th>
                                    <th>Chủ tài khoản</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác mô phỏng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in danhSachRut)
                                {
                                    <tr>
                                        <td>#@r.maRutTien</td>
                                        <td class="text-muted small">@r.ngayYeuCau?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-bold text-dark">@r.soTienRut.ToString("N0") đ</td>
                                        <td>@r.tenNganHang</td>
                                        <td class="text-muted">@r.soTaiKhoan</td>
                                        <td class="fw-semibold">@r.tenChuTaiKhoan</td>
                                        <td>
                                            @if (r.trangThai == "HoanThanh")
                                            {
                                                <span class="badge bg-success">Đã hoàn thành</span>
                                            }
                                            else if (r.trangThai == "ChoXuLy")
                                            {
                                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Từ chối / Hủy</span>
                                            }
                                        </td>
                                        <td>
                                            @if (r.trangThai == "ChoXuLy")
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-success btn-sm" onclick="xacNhanRutTienMoPhong(@r.maRutTien, true)">
                                                        Duyệt mô phỏng
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="xacNhanRutTienMoPhong(@r.maRutTien, false)">
                                                        Hủy yêu cầu
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@(r.ngayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<script>
    let maGiaoDichHienTai = "";
    let intervalKiemTra = null;
    let intervalDemNguoc = null;

    function switchWalletTab(tabName) {
        document.querySelectorAll('.wallet-tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.wallet-tab-pane').forEach(pane => pane.style.display = 'none');

        const activeBtn = event ? event.target : null;
        if (activeBtn) activeBtn.classList.add('active');

        const targetPane = document.getElementById('tab-' + tabName);
        if (targetPane) targetPane.style.display = 'block';
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Amount buttons
        const amountButtons = document.querySelectorAll(".amount-btn");
        const soTienInput = document.getElementById("soTien");
        const thongBaoLoiNap = document.getElementById("thongBaoLoiNap");
        const btnXacNhanNap = document.getElementById("btnXacNhanNap");
        const btnXacNhanMoPhong = document.getElementById("btnXacNhanMoPhong");

        amountButtons.forEach(button => {
            button.addEventListener("click", function () {
                amountButtons.forEach(b => b.classList.remove("active"));
                this.classList.add("active");
                soTienInput.value = this.dataset.amount;
                thongBaoLoiNap.innerText = "";
            });
        });

        if (soTienInput) {
            soTienInput.addEventListener("input", function () {
                amountButtons.forEach(b => b.classList.remove("active"));
            });
        }

        // Tạo mã nạp tiền
        btnXacNhanNap.addEventListener("click", async function () {
            const daXacMinhSinhVien = @(ViewBag.DaXacMinhSinhVien == false ? "false" : "true");
            if (!daXacMinhSinhVien) {
                if (confirm("Tài khoản sinh viên cần hoàn tất xác thực minh chứng Thẻ sinh viên (trạng thái 'Đã xác minh') trước khi nạp tiền vào ví!\n\nBạn có muốn chuyển đến trang Xác thực minh chứng ngay bây giờ không?")) {
                    window.location.href = "/Account/MinhChung";
                }
                return;
            }

            const soTien = Number(soTienInput.value);
            if (soTien < 100000 || soTien % 50000 !== 0) {
                thongBaoLoiNap.innerText = "Số tiền nạp phải từ 100.000 VNĐ trở lên và là bội số của 50.000 VNĐ.";
                return;
            }
            thongBaoLoiNap.innerText = "";

            try {
                btnXacNhanNap.disabled = true;
                btnXacNhanNap.innerText = "Đang tạo mã...";

                const response = await fetch("/Wallet/TaoGiaoDich", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ soTien: soTien })
                });

                const result = await response.json();
                btnXacNhanNap.disabled = false;
                btnXacNhanNap.innerText = "Tạo mã nạp tiền";

                if (!result.success) {
                    thongBaoLoiNap.innerText = result.message;
                    return;
                }

                const gd = result.data;
                maGiaoDichHienTai = gd.maGiaoDich;

                document.getElementById("thongTinGiaoDich").style.display = "block";
                document.getElementById("maGiaoDichHienThi").innerText = gd.maGiaoDich;
                document.getElementById("soTienGiaoDich").innerText = Number(gd.soTien).toLocaleString("vi-VN") + " VNĐ";
                document.getElementById("noiDungChuyenKhoan").innerText = gd.noiDungChuyenKhoan;
                document.getElementById("trangThaiGiaoDich").innerText = "Đang xử lý";
                document.getElementById("trangThaiGiaoDich").className = "badge bg-warning text-dark";

                // Render VietQR
                const qrUrl = "https://img.vietqr.io/image/MB-0378896290-compact2.png?amount=" 
                    + gd.soTien + "&addInfo=" + encodeURIComponent(gd.noiDungChuyenKhoan) 
                    + "&accountName=" + encodeURIComponent("DANG TUAN ANH");
                document.getElementById("qrThanhToan").src = qrUrl;

                document.getElementById("thongTinGiaoDich").scrollIntoView({ behavior: "smooth" });

                batDauDemNguoc(gd.ngayHetHan);
                batDauPolling(gd.maGiaoDich, gd.soTien);
            } catch (err) {
                btnXacNhanNap.disabled = false;
                btnXacNhanNap.innerText = "Tạo mã nạp tiền";
                thongBaoLoiNap.innerText = "Lỗi kết nối khi tạo mã nạp tiền: " + err.message;
            }
        });

        // Xác nhận nạp tiền mô phỏng (Demo)
        if (btnXacNhanMoPhong) {
            btnXacNhanMoPhong.addEventListener("click", async function () {
                if (!maGiaoDichHienTai) {
                    alert("Chưa có mã giao dịch nào được tạo.");
                    return;
                }

                if (!confirm("Xác nhận cộng " + document.getElementById("soTienGiaoDich").innerText + " vào ví mô phỏng của bạn?")) {
                    return;
                }

                btnXacNhanMoPhong.disabled = true;
                btnXacNhanMoPhong.innerText = "Đang ghi nhận...";

                try {
                    const response = await fetch("/Wallet/XacNhanNapTienMoPhong", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ maGiaoDich: maGiaoDichHienTai })
                    });

                    const res = await response.json();
                    if (res.success) {
                        alert("Thành công! " + res.message);
                        window.location.reload();
                    } else {
                        alert("Thất bại: " + res.message);
                        btnXacNhanMoPhong.disabled = false;
                        btnXacNhanMoPhong.innerText = "Xác nhận nạp tiền mô phỏng";
                    }
                } catch (err) {
                    alert("Lỗi khi xác nhận nạp tiền mô phỏng: " + err.message);
                    btnXacNhanMoPhong.disabled = false;
                    btnXacNhanMoPhong.innerText = "Xác nhận nạp tiền mô phỏng";
                }
            });
        }

        // Tạo yêu cầu rút tiền mô phỏng
        const btnGuiYeuCauRut = document.getElementById("btnGuiYeuCauRut");
        if (btnGuiYeuCauRut) {
            btnGuiYeuCauRut.addEventListener("click", async function () {
                const daXacMinhSinhVien = @(ViewBag.DaXacMinhSinhVien == false ? "false" : "true");
                if (!daXacMinhSinhVien) {
                    if (confirm("Tài khoản sinh viên cần hoàn tất xác thực minh chứng Thẻ sinh viên (trạng thái 'Đã xác minh') trước khi tạo yêu cầu rút tiền!\n\nBạn có muốn chuyển đến trang Xác thực minh chứng ngay bây giờ không?")) {
                        window.location.href = "/Account/MinhChung";
                    }
                    return;
                }

                const soTien = Number(document.getElementById("rutSoTien").value);
                const tenNganHang = document.getElementById("rutNganHang").value.trim();
                const soTaiKhoan = document.getElementById("rutSoTaiKhoan").value.trim();
                const tenChuTaiKhoan = document.getElementById("rutTenChuTaiKhoan").value.trim();
                const thongBaoLoiRut = document.getElementById("thongBaoLoiRut");

                if (soTien < 50000) {
                    thongBaoLoiRut.innerText = "Số tiền rút tối thiểu là 50.000 VNĐ.";
                    return;
                }
                if (!tenNganHang || !soTaiKhoan || !tenChuTaiKhoan) {
                    thongBaoLoiRut.innerText = "Vui lòng nhập đầy đủ thông tin tài khoản ngân hàng thụ hưởng.";
                    return;
                }
                thongBaoLoiRut.innerText = "";

                if (!confirm("Xác nhận tạo yêu cầu rút " + soTien.toLocaleString("vi-VN") + " VNĐ về ngân hàng " + tenNganHang + "?")) {
                    return;
                }

                btnGuiYeuCauRut.disabled = true;
                btnGuiYeuCauRut.innerText = "Đang gửi yêu cầu...";

                try {
                    const response = await fetch("/Wallet/TaoYeuCauRutTien", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            soTienRut: soTien,
                            tenNganHang: tenNganHang,
                            soTaiKhoan: soTaiKhoan,
                            tenChuTaiKhoan: tenChuTaiKhoan
                        })
                    });

                    const res = await response.json();
                    btnGuiYeuCauRut.disabled = false;
                    btnGuiYeuCauRut.innerText = "Gửi yêu cầu rút tiền";

                    if (res.success) {
                        alert(res.message);
                        window.location.reload();
                    } else {
                        thongBaoLoiRut.innerText = res.message;
                    }
                } catch (err) {
                    btnGuiYeuCauRut.disabled = false;
                    btnGuiYeuCauRut.innerText = "Gửi yêu cầu rút tiền";
                    thongBaoLoiRut.innerText = "Lỗi kết nối khi gửi yêu cầu rút tiền: " + err.message;
                }
            });
        }
    });

    // Duyệt / Hủy yêu cầu rút tiền mô phỏng
    async function xacNhanRutTienMoPhong(maRutTien, chapNhan) {
        const actionText = chapNhan ? "duyệt hoàn thành" : "hủy và hoàn tiền";
        if (!confirm("Bạn có chắc chắn muốn " + actionText + " yêu cầu rút tiền #" + maRutTien + "?")) {
            return;
        }

        try {
            const response = await fetch("/Wallet/XacNhanRutTienMoPhong", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ maRutTien: maRutTien, chapNhan: chapNhan })
            });

            const res = await response.json();
            if (res.success) {
                alert(res.message);
                window.location.reload();
            } else {
                alert("Thao tác thất bại: " + res.message);
            }
        } catch (err) {
            alert("Lỗi khi xử lý yêu cầu rút tiền: " + err.message);
        }
    }

    function batDauDemNguoc(ngayHetHan) {
        if (intervalDemNguoc) clearInterval(intervalDemNguoc);
        const thoiGianEl = document.getElementById("thoiGianConLai");

        function update() {
            const now = new Date();
            const exp = new Date(ngayHetHan);
            const diff = exp - now;

            if (diff <= 0) {
                thoiGianEl.innerText = "00:00";
                clearInterval(intervalDemNguoc);
                return;
            }

            const totalSec = Math.floor(diff / 1000);
            const min = Math.floor(totalSec / 60);
            const sec = totalSec % 60;
            thoiGianEl.innerText = String(min).padStart(2, '0') + ":" + String(sec).padStart(2, '0');
        }
        update();
        intervalDemNguoc = setInterval(update, 1000);
    }

    function batDauPolling(maGiaoDich, soTien) {
        if (intervalKiemTra) clearInterval(intervalKiemTra);

        intervalKiemTra = setInterval(async function () {
            try {
                const response = await fetch("/Wallet/TrangThai?maGiaoDich=" + encodeURIComponent(maGiaoDich));
                const res = await response.json();
                if (res.success && res.data) {
                    if (res.data.trangThai === "HoanThanh") {
                        clearInterval(intervalKiemTra);
                        alert("Đã nhận được tiền nạp " + Number(soTien).toLocaleString("vi-VN") + " VNĐ vào ví!");
                        window.location.reload();
                    } else if (res.data.trangThai === "HetHan") {
                        clearInterval(intervalKiemTra);
                        document.getElementById("trangThaiGiaoDich").innerText = "Hết hạn";
                        document.getElementById("trangThaiGiaoDich").className = "badge bg-danger";
                    }
                }
            } catch (err) {
                console.error("Polling error:", err);
            }
        }, 5000);
    }
</script>