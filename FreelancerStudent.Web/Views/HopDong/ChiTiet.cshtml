                                            {
                                                <div class="mt-2 text-muted small fst-italic">
                                                    <i class="bi bi-hourglass-split me-1"></i>Đã nộp - Chờ NTD đánh giá
                                                </div>
                                            }
                                            else if (gd.trangThai != "Dat" && gd.trangThai != "DaNghiemThu")
                                            {
