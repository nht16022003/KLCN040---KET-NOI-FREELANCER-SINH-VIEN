                            <input type="hidden" name="maHD" value="@Model.maHD" />
                            <input type="hidden" name="trangThai" value="Dat" />
                            <button type="submit" class="btn btn-success">Đánh dấu tất cả đạt</button>
                        </form>
                    </div>

                    <!-- Modal Đánh dấu tất cả chưa đạt -->
                    <div class="modal fade text-start" id="modalChuaDatTatCa" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-0">
                                <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maHD" value="@Model.maHD" />
                                    <input type="hidden" name="trangThai" value="ChuaDat" />
                                    <div class="modal-header bg-light">
                                        <h6 class="modal-title fw-bold text-danger">Đánh dấu tất cả giai đoạn Chưa đạt</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="text-muted small">
                                            Vui lòng nhập lý do chung áp dụng cho các mốc tiến độ chưa đạt để Freelancer nắm rõ và điều chỉnh.
                                        </p>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Lý do chưa đạt <span class="text-danger">*</span></label>
                                            <textarea name="lyDo" class="form-control rounded-0" rows="3" required placeholder="Nhập lý do cụ thể (bắt buộc)..."></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-danger rounded-0 fw-bold">Xác nhận Chưa đạt tất cả</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-3 text-center text-muted">
                    Hợp đồng này nghiệm thu toàn bộ một lần sau khi hoàn thành.
                </div>
            }
        </div>
    </div>

    @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien" && Model.TatCaMocDaDat)
    {
        @if (Model.CoSanPhamBanGiaoChoNghiemThu)
        {
            <div class="alert alert-success d-flex justify-content-between align-items-center gap-3 shadow-sm rounded-0">
                <div>
                    <strong><i class="bi bi-check-circle-fill me-1"></i> Freelancer đã bàn giao sản phẩm!</strong>
                    <div class="small">Toàn bộ mốc tiến độ đã Đạt và sản phẩm hoàn chỉnh đã được gửi nộp. Vui lòng kiểm tra sản phẩm và thực hiện nghiệm thu.</div>
                </div>
                <a asp-controller="BanGiaoSanPham" asp-action="Index" asp-route-maHD="@Model.maHD" class="btn btn-success fw-bold rounded-0 px-3">
                    Kiểm tra &amp; Nghiệm thu sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center gap-3 shadow-sm rounded-0">
                <div>
                    <strong><i class="bi bi-info-circle-fill me-1"></i> Toàn bộ mốc tiến độ đã đạt yêu cầu!</strong>
                    <div class="small">Hệ thống đang chờ Freelancer kiểm tra lại và thực hiện bàn giao sản phẩm hoàn chỉnh.</div>
                </div>
                <a asp-controller="BanGiaoSanPham" asp-action="Index" asp-route-maHD="@Model.maHD" class="btn btn-outline-primary rounded-0">
                    Xem lịch sử bàn giao
                </a>
            </div>
        }
    }

    @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DaHoanThanh")
    {
        <div class="alert alert-primary d-flex justify-content-between align-items-center gap-3">
            <span>Hợp đồng đã nghiệm thu và đang chờ thanh toán.</span>
            <a asp-controller="HopDong" asp-action="ThanhToan" asp-route-maHD="@Model.maHD" class="btn btn-primary">Thanh toán cho Freelancer</a>
        </div>
    }

    @{
        var ttHopDong = Model.trangThai?.Trim();
        var laTrangThaiDanhGia = string.Equals(ttHopDong, "DaThanhToan", StringComparison.OrdinalIgnoreCase) 
                             || string.Equals(ttHopDong, "DaHoanThanh", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(ttHopDong, "DaHuyHoanTien", StringComparison.OrdinalIgnoreCase);
    }
    @if (laTrangThaiDanhGia)
    {
        <div class="card border-0 shadow-sm rounded-0 mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-2">
                    <div>
                        <h5 class="mb-1">Đánh giá đối tác</h5>
                        <span class="text-muted small">@(Model.trangThaiDanhGia == "DaDanhGia" ? "Bạn đã gửi đánh giá cho đối tác trên hợp đồng này." : "Chia sẻ trải nghiệm và đánh giá chất lượng làm việc của đối tác.")</span>
                    </div>
                    <div>
                        @if (Model.trangThaiDanhGia == "DaDanhGia")
                        {
                            <span class="badge text-bg-success me-2">Đã đánh giá</span>
                            @if (Model.coTheChinhSuaDanhGia && Model.maDanhGia.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="moFormDanhGia('@Model.maHD', @Model.maDanhGia)">Chỉnh sửa đánh giá</button>
                            }
                        }
                        else if (Model.coTheDanhGia)
                        {
                            <button type="button" class="btn btn-sm btn-primary" onclick="moFormDanhGia('@Model.maHD')">Gửi đánh giá</button>
                        }
                        else
                        {
                            <span class="text-muted small">Đã hết thời hạn gửi đánh giá.</span>
                        }
                    </div>
                </div>

                @if (Model.ThongTinDanhGiaHienTai != null)
                {
                    <div class="bg-light p-3 rounded mt-3 border">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <div>
                                <span class="fw-bold text-dark">Đánh giá bạn đã gửi:</span>
                                <span class="text-warning fw-bold ms-2">
                                    @for (var s = 1; s <= 5; s++)
                                    {
                                        <span>@(Model.ThongTinDanhGiaHienTai.soSaoTongThe >= s ? "★" : "☆")</span>
                                    }
                                    <span class="text-dark small fw-normal">(@Model.ThongTinDanhGiaHienTai.soSaoTongThe/5)</span>
                                </span>
                            </div>
                            <small class="text-muted">Ngày gửi: @Model.ThongTinDanhGiaHienTai.ngayDanhGia.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        <div class="row g-2 small text-secondary mb-2">
                            @if (Model.ThongTinDanhGiaHienTai.soSaoChatLuong.HasValue)
                            {
                                <div class="col-sm-4">Chất lượng: <strong>@Model.ThongTinDanhGiaHienTai.soSaoChatLuong ★</strong></div>
                            }
                            @if (Model.ThongTinDanhGiaHienTai.soSaoDungHan.HasValue)
                            {
                                <div class="col-sm-4">Đúng hạn: <strong>@Model.ThongTinDanhGiaHienTai.soSaoDungHan ★</strong></div>
                            }
                            @if (Model.ThongTinDanhGiaHienTai.soSaoGiaoTiep.HasValue)
                            {
                                <div class="col-sm-4">Giao tiếp: <strong>@Model.ThongTinDanhGiaHienTai.soSaoGiaoTiep ★</strong></div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ThongTinDanhGiaHienTai.nhanXet))
                        {
                            <div class="mt-2 text-dark bg-white p-2 rounded border-start border-3 border-success small">
                                <em>"@Model.ThongTinDanhGiaHienTai.nhanXet"</em>
                            </div>
                        }
                        else
                        {
                            <div class="mt-1 text-muted small fst-italic">Không có lời nhận xét kèm theo.</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div id="danhGiaModalContainer"></div>

    <!-- ================= KHU VỰC TIẾN ĐỘ DỰ ÁN (FRL-UC-09) ================= -->
    @{
        var tienDo = Model.TienDoDuAn;
        var coTheCapNhat = Model.LaFreelancerCuaHopDong && Model.trangThai == "DangThucHien";
        var danhSachMoc = Model.giaiDoans ?? new List<FreelancerStudent.Web.ViewModels.GiaiDoanHopDongViewModel>();
        var tongSoMoc = tienDo?.tongSoMoc > 0 ? tienDo.tongSoMoc : danhSachMoc.Count;
        var soMocDat = tienDo?.soMocDat ?? danhSachMoc.Count(g => g.trangThai == "Dat" || g.trangThai == "DaNghiemThu");
        var soMocChuaDat = tienDo?.soMocChuaDat ?? danhSachMoc.Count(g => g.trangThai == "ChuaDat");
        var soMocChoDanhGia = tienDo?.soMocChoDanhGia ?? danhSachMoc.Count(g => g.trangThai == "ChoDanhGia");
        var tyLe = tienDo?.tyLeHoanThanh ?? (tongSoMoc > 0 ? Math.Round((decimal)soMocDat / tongSoMoc * 100, 1) : 0);
        var tongTask = tienDo?.tongSoTask ?? 0;
        var hoanThanhTask = tienDo?.soTaskHoanThanh ?? 0;
        var dangThucHienTask = tienDo?.soTaskDangThucHien ?? 0;
        var chuaThucHienTask = tienDo?.soTaskChuaThucHien ?? 0;
    }

    <div class="card border-0 shadow-sm rounded-0 mb-4" id="sectionTienDoDuAn">
        <div class="card-header bg-light border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h5 class="mb-0 fw-bold text-dark">
                    Tiến độ dự án (Project Progress)
                </h5>
                @if (tongSoMoc > 0)
                {
                    <span class="badge @(tyLe == 100 ? "bg-success" : (tyLe >= 50 ? "bg-primary" : "bg-warning text-dark")) rounded-0 px-3 py-1">
                        @tyLe% hoàn thành (@soMocDat/@tongSoMoc mốc đạt)
                    </span>
                }
            </div>

            @if (coTheCapNhat)
            {
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success rounded-0 px-3 fw-medium shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemTask">
                        <i class="bi bi-plus-circle me-1"></i> Thêm đầu việc chi tiết
                    </button>
                </div>
            }
        </div>

        <div class="card-body p-4">
            <!-- Thanh tiến trình tổng thể -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tỷ lệ hoàn thành tổng thể (dựa trên mốc tiến độ đạt)</span>
                    <span class="fw-bold text-success fs-5">@tyLe%</span>
                </div>
                <div class="progress rounded-0" style="height: 14px; background-color: #e9ecef;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         role="progressbar"
                         style="width: @tyLe%; background-color: #1B5E36 !important;"
                         aria-valuenow="@tyLe"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>

            <!-- Thống kê 4 mốc tiến độ -->
            <div class="row g-3 mb-4">
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Tổng mốc tiến độ</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@tongSoMoc</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Chưa đạt / Cần sửa</div>
                        <div class="fs-4 fw-bold @(soMocChuaDat > 0 ? "text-danger" : "text-secondary") mt-1">@soMocChuaDat</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Chờ NTD đánh giá</div>
                        <div class="fs-4 fw-bold @(soMocChoDanhGia > 0 ? "text-info" : "text-secondary") mt-1">@soMocChoDanhGia</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Đã đạt tiêu chuẩn</div>
                        <div class="fs-4 fw-bold text-success mt-1">@soMocDat</div>
                    </div>
                </div>
            </div>

            <!-- Thông báo trạng thái nếu không ở DangThucHien -->
            @if (Model.trangThai != "DangThucHien")
            {
                <div class="alert alert-secondary rounded-0 py-2 px-3 small mb-3">
                    Hợp đồng hiện tại đang ở trạng thái <strong>@tenTrangThai</strong>.
                    @if (Model.LaFreelancerCuaHopDong)
                    {
                        <span>Bạn chỉ có thể tạo và quản lý đầu việc khi hợp đồng đã được ký quỹ và chuyển sang trạng thái <strong>Đang thực hiện</strong>.</span>
                    }
                    else
                    {
                        <span>Tiến độ đang được hiển thị ở chế độ theo dõi dành cho Nhà tuyển dụng.</span>
                    }
                </div>
            }

            <!-- BẢNG MỐC TIẾN ĐỘ DỰ ÁN HỢP NHẤT -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-diagram-3-fill me-1 text-success"></i> Danh sách các mốc tiến độ &amp; Đánh giá bàn giao
                </h6>
                <span class="text-muted small">Dữ liệu đồng bộ trực tiếp với Lộ trình mốc bàn giao</span>
            </div>

            @if (danhSachMoc != null && danhSachMoc.Count > 0)
            {
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle mb-0 border">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th>Mốc tiến độ &amp; Chi tiết nội dung / Minh chứng</th>
                                <th style="width: 140px;">Hạn chót</th>
                                <th style="width: 170px;">Trạng thái</th>
                                <th class="text-end" style="width: 220px;">Thao tác &amp; Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < danhSachMoc.Count; i++)
                            {
                                var gd = danhSachMoc[i];
                                var moTaHienThi = System.Text.RegularExpressions.Regex.Replace(string.IsNullOrWhiteSpace(gd.moTa) ? "Theo yêu cầu chung" : gd.moTa, @"\[Giải ngân:[^\]]*\]\s*", "");
                                var linkMoc = gd.linkSanPham;
                                if (string.IsNullOrWhiteSpace(linkMoc) && !string.IsNullOrWhiteSpace(gd.moTa))
                                {
                                    var match = System.Text.RegularExpressions.Regex.Match(gd.moTa, @"https?://[^\s]+");
                                    if (match.Success) { linkMoc = match.Value; }
                                }
                                if (string.IsNullOrWhiteSpace(linkMoc) && tienDo?.danhSachTask != null)
                                {
                                    var taskCoLink = tienDo.danhSachTask.FirstOrDefault(t => t.maGiaiDoan == gd.maGiaiDoan && (!string.IsNullOrWhiteSpace(t.linkSanPham) || (!string.IsNullOrWhiteSpace(t.moTa) && (t.moTa.Contains("[LINK_SAN_PHAM]") || t.moTa.Contains("http")))));
                                    if (taskCoLink != null)
                                    {
                                        if (!string.IsNullOrWhiteSpace(taskCoLink.linkSanPham))
                                        {
                                            linkMoc = taskCoLink.linkSanPham;
                                        }
                                        else
                                        {
                                            var mTask = System.Text.RegularExpressions.Regex.Match(taskCoLink.moTa, @"https?://[^\s]+");
                                            if (mTask.Success) { linkMoc = mTask.Value; }
                                        }
                                    }
                                }

                                <tr>
                                    <td class="text-center fw-bold text-muted">@(i + 1)</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">@gd.tenGiaiDoan</div>
                                        <div class="text-muted small mt-1" style="white-space: pre-line;">@moTaHienThi</div>
                                        @if (!string.IsNullOrWhiteSpace(linkMoc))
                                        {
                                            <div class="mt-2">
                                                <a href="@linkMoc" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success py-1 px-2 fw-semibold rounded-0 shadow-sm">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Xem sản phẩm / minh chứng
                                                </a>
                                                <span class="text-muted small ms-1 text-truncate d-inline-block" style="max-width: 250px; vertical-align: middle;">@linkMoc</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(gd.lyDoChuaDat) && gd.trangThai == "ChuaDat")
                                        {
                                            <div class="alert alert-danger border-danger small my-2 py-2 px-3 rounded-0 text-start">
                                                <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Lý do Nhà tuyển dụng đánh giá Chưa đạt:</strong>
                                                <div class="mt-1">@gd.lyDoChuaDat</div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark small">@gd.hanChot.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        @if (gd.trangThai == "Dat" || gd.trangThai == "DaNghiemThu")
                                        {
                                            <span class="badge bg-success rounded-0 px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đạt</span>
                                        }
                                        else if (gd.trangThai == "ChoDanhGia")
                                        {
                                            <span class="badge bg-info text-dark rounded-0 px-2 py-1"><i class="bi bi-clock-history me-1"></i>Chờ NTD đánh giá</span>
                                        }
                                        else if (gd.trangThai == "ChuaDat")
                                        {
                                            <span class="badge bg-danger rounded-0 px-2 py-1"><i class="bi bi-x-circle-fill me-1"></i>Chưa đạt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-0 px-2 py-1">Chưa bàn giao</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (coTheCapNhat)
                                        {
                                            if (gd.trangThai == "ChuaDat")
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-warning rounded-0 fw-bold shadow-sm" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#modalCapNhatMocTienDo_@gd.maGiaiDoan">
                                                    <i class="bi bi-pencil-square me-1"></i> Cập nhật lại tiến độ/bàn giao
                                                </button>
                                            }
                                            else if (gd.trangThai == "ChoDanhGia")
                                            {
                                                <span class="badge bg-light text-muted border py-1 px-2">
                                                    <i class="bi bi-hourglass-split me-1"></i>Đang chờ NTD đánh giá
                                                </span>
                                            }
                                            else if (gd.trangThai == "Dat" || gd.trangThai == "DaNghiemThu")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success py-1 px-2">
                                                    <i class="bi bi-check-all me-1"></i>Mốc đã hoàn thành
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-success rounded-0 fw-semibold shadow-sm" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#modalCapNhatMocTienDo_@gd.maGiaiDoan">
                                                    <i class="bi bi-cloud-arrow-up me-1"></i> Cập nhật tiến độ / Bàn giao
                                                </button>
                                            }

                                            <!-- Modal Cập nhật mốc trong Tiến độ dự án -->
                                            <div class="modal fade text-start" id="modalCapNhatMocTienDo_@gd.maGiaiDoan" tabindex="-1" aria-labelledby="labelCapNhatMocTienDo_@gd.maGiaiDoan" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-0">
                                                        <form asp-controller="HopDong" asp-action="CapNhatMocBanGiao" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="maHD" value="@Model.maHD" />
                                                            <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                            <div class="modal-header bg-light">
                                                                <h6 class="modal-title fw-bold text-dark" id="labelCapNhatMocTienDo_@gd.maGiaiDoan">
                                                                    <i class="bi bi-arrow-repeat text-warning me-1"></i> Cập nhật tiến độ / Bàn giao: @gd.tenGiaiDoan
                                                                </h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                @if (!string.IsNullOrWhiteSpace(gd.lyDoChuaDat) && gd.trangThai == "ChuaDat")
                                                                {
                                                                    <div class="alert alert-danger border-danger small mb-3">
                                                                        <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Lý do Nhà tuyển dụng đánh giá Chưa đạt:</strong>
                                                                        <div class="mt-1">@gd.lyDoChuaDat</div>
                                                                    </div>
                                                                }
                                                                <p class="text-muted small">
                                                                    Vui lòng cung cấp đường dẫn sản phẩm hoặc tài liệu minh chứng cho mốc này để Nhà tuyển dụng kiểm tra và đánh giá lại.
                                                                </p>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold small">
                                                                        Đường dẫn sản phẩm / Minh chứng mốc <span class="text-danger">*</span>
                                                                    </label>
                                                                    <input type="url" 
                                                                           name="linkSanPham" 
                                                                           class="form-control rounded-0" 
                                                                           placeholder="https://drive.google.com/... hoặc link github, figma" 
                                                                           value="@linkMoc" 
                                                                           required />
                                                                    <div class="form-text small">Nhập link Google Drive, GitHub hoặc tài liệu nghiệm thu mốc này.</div>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold small">
                                                                        Mô tả nội dung hoàn thiện &amp; giải trình chỉnh sửa
                                                                    </label>
                                                                    <textarea name="moTa" 
                                                                              class="form-control rounded-0" 
                                                                              rows="3" 
                                                                              placeholder="Mô tả tóm tắt nội dung bạn đã chỉnh sửa, khắc phục theo yêu cầu...">@moTaHienThi</textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-success rounded-0 fw-bold">
                                                                    <i class="bi bi-send-fill me-1"></i> Gửi cập nhật cho NTD
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien")
                                        {
                                            <div class="d-flex justify-content-end gap-1">
                                                <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maHD" value="@Model.maHD" />
                                                    <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                    <input type="hidden" name="trangThai" value="Dat" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-0" disabled="@(gd.trangThai == "Dat" || gd.trangThai == "DaNghiemThu")">Đạt</button>
                                                </form>

                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-bs-toggle="modal" data-bs-target="#modalChuaDatTienDo_@gd.maGiaiDoan">
                                                    Chưa đạt
                                                </button>
                                            </div>

                                            <!-- Modal Chưa Đạt trong Tiến độ dự án cho NTD -->
                                            <div class="modal fade text-start" id="modalChuaDatTienDo_@gd.maGiaiDoan" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-0">
                                                        <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="maHD" value="@Model.maHD" />
                                                            <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                            <input type="hidden" name="trangThai" value="ChuaDat" />
                                                            <div class="modal-header bg-light">
                                                                <h6 class="modal-title fw-bold text-danger">
                                                                    Đánh giá Chưa đạt mốc: @gd.tenGiaiDoan
                                                                </h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="text-muted small">
                                                                    Vui lòng cung cấp lý do cụ thể vì sao mốc tiến độ này chưa đạt yêu cầu để Freelancer có căn cứ điều chỉnh và nộp lại.
                                                                </p>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Lý do chưa đạt <span class="text-danger">*</span></label>
                                                                    <textarea name="lyDo" class="form-control rounded-0" rows="3" required placeholder="Nhập lý do chi tiết (bắt buộc)...">@gd.lyDoChuaDat</textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-danger rounded-0 fw-bold">Xác nhận Chưa đạt</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chỉ xem</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 border bg-light mb-4">
                    <p class="text-muted mb-0">Hợp đồng này không chia giai đoạn bàn giao theo mốc.</p>
                </div>
            }

            <!-- KHU VỰC CHECKLIST ĐẦU VIỆC CHI TIẾT -->
            <div class="pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-list-check me-1 text-success"></i> Checklist đầu việc chi tiết (@hoanThanhTask/@tongTask hoàn thành)
                        </h6>
                        <span class="text-muted small">Các đầu việc phụ chia nhỏ bên trong mốc để theo dõi việc thực hiện</span>
                    </div>
                    @if (coTheCapNhat)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success rounded-0 px-3 fw-medium shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemTask">
                            <i class="bi bi-plus-lg me-1"></i> Thêm đầu việc
                        </button>
                    }
                </div>

                @if (tienDo != null && tienDo.danhSachTask.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 border">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 45px;" class="text-center">#</th>
                                    <th>Đầu việc &amp; Chi tiết</th>
                                    <th style="width: 170px;">Mốc giai đoạn</th>
                                    <th style="width: 140px;">Hạn chót</th>
                                    <th style="width: 160px;">Trạng thái</th>
                                    <th class="text-end" style="width: 110px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < tienDo.danhSachTask.Count; i++)
                                {
                                    var task = tienDo.danhSachTask[i];
                                    var taskStatusBadge = task.trangThai switch
                                    {
                                        "HoanThanh" => "bg-success text-white",
                                        "DangThucHien" => "bg-primary text-white",
                                        _ => "bg-secondary text-white"
                                    };
                                    var taskStatusText = task.trangThai switch
                                    {
                                        "HoanThanh" => "Hoàn thành",
                                        "DangThucHien" => "Đang thực hiện",
                                        _ => "Chưa thực hiện"
                                    };

                                    <tr>
                                        <td class="text-center fw-bold text-muted">@(i + 1)</td>
                                        <td>
                                            <div class="fw-bold text-dark fs-6">@task.tenTask</div>
                                            @if (!string.IsNullOrWhiteSpace(task.moTa))
                                            {
                                                <div class="text-muted small mt-1" style="white-space: pre-line;">@task.moTa</div>
                                            }
                                            <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                                Cập nhật: @task.ngayCapNhat.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(task.tenGiaiDoan))
                                            {
                                                <span class="badge bg-light text-dark border">@task.tenGiaiDoan</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Toàn bộ dự án</span>
                                            }
                                        </td>
                                        <td>
                                            @if (task.hanHoanThanh.HasValue)
                                            {
                                                var isOverdue = task.trangThai != "HoanThanh" && task.hanHoanThanh.Value.Date < DateTime.Now.Date;
                                                <div class="@(isOverdue ? "text-danger fw-bold" : "text-dark") small">
                                                    @task.hanHoanThanh.Value.ToString("dd/MM/yyyy")
                                                </div>
                                                @if (isOverdue)
                                                {
                                                    <span class="badge bg-danger mt-1" style="font-size: 0.7rem;">Quá hạn</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (coTheCapNhat)
                                            {
                                                <div class="dropdown">
                                                    <button class="btn btn-sm dropdown-toggle rounded-0 @taskStatusBadge border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        @taskStatusText
                                                    </button>
                                                    <ul class="dropdown-menu shadow-sm rounded-0">
                                                        <li><a class="dropdown-item py-2 small @(task.trangThai == "ChuaThucHien" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'ChuaThucHien')">Chưa thực hiện</a></li>
                                                        <li><a class="dropdown-item py-2 small @(task.trangThai == "DangThucHien" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'DangThucHien')">Đang thực hiện</a></li>
                                                        <li><a class="dropdown-item py-2 small @(task.trangThai == "HoanThanh" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'HoanThanh')">Hoàn thành</a></li>
                                                    </ul>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge @taskStatusBadge rounded-0 px-2 py-1">@taskStatusText</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (coTheCapNhat)
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-primary rounded-0 me-1" 
                                                        title="Chỉnh sửa đầu việc"
                                                        onclick="moModalSuaTask(@task.maTask, '@Html.Raw(JavaScriptEncoder.Default.Encode(task.tenTask))', '@Html.Raw(JavaScriptEncoder.Default.Encode(task.moTa ?? ""))', '@(task.hanHoanThanh?.ToString("yyyy-MM-dd") ?? "")', '@task.trangThai', '@(task.maGiaiDoan?.ToString() ?? "")')">
                                                    Sửa
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-danger rounded-0" 
                                                        title="Xóa đầu việc"
                                                        onclick="xacNhanXoaTask(@task.maTask, '@Html.Raw(JavaScriptEncoder.Default.Encode(task.tenTask))')">
                                                    Xóa
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Chỉ xem</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 border bg-light">
                        <span class="text-muted small">Chưa có checklist đầu việc chi tiết nào. Bạn có thể bấm "Thêm đầu việc chi tiết" để tạo thêm nhiệm vụ con nếu cần.</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Điều khoản giao kết cụ thể -->
    <div class="card border-0 shadow-sm rounded-0 mb-4">
        <div class="card-header bg-light border-bottom py-3">
            <h5 class="mb-0 fw-bold text-dark">
                Điều khoản giao kết cụ thể
            </h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.dieuKhoan))
            {
                <div class="p-3 bg-light border font-monospace small" style="white-space: pre-line; line-height: 1.7;">
                    @Model.dieuKhoan
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Áp dụng theo các điều khoản tiêu chuẩn của nền tảng kết nối Freelancer Sinh Viên.</p>
            }
        </div>
    </div>

    <!-- Nút quay lại & Hành động cuối trang -->
    <div class="d-flex justify-content-between align-items-center">
        <a asp-controller="HopDong" asp-action="Index" class="btn btn-outline-secondary rounded-0">
            Trở về danh sách hợp đồng
        </a>

        @if (Model.CoQuyenXacNhan)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-danger rounded-0 px-3" data-bs-toggle="modal" data-bs-target="#modalTuChoi">
                    Từ chối
                </button>
                <form asp-controller="HopDong" asp-action="XacNhan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận đồng ý dự thảo hợp đồng này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maHD" value="@Model.maHD" />
                    <input type="hidden" name="dongY" value="true" />
                    <button type="submit" class="btn btn-success rounded-0 px-4 fw-bold" style="background-color: #1B5E36; border-color: #1B5E36;">
                        Xác nhận hợp đồng
                    </button>
                </form>
            </div>
        }
    </div>
    
    @if ((Model.LaFreelancerCuaHopDong ||
        Model.LaNhaTuyenDungCuaHopDong) &&
        (Model.trangThai == "DangThucHien" ||
        Model.trangThai == "DaHoanThanh" ||
        Model.trangThai == "DaThanhToan"))
    {
        <div class="card shadow-sm rounded-0 mb-4" id="sectionBanGiaoSanPham">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h5 class="fw-bold mb-1">
                            Bàn giao và nghiệm thu sản phẩm
                        </h5>

                        <p class="text-muted mb-0">
                            Quản lý các phiên bản bàn giao, yêu cầu chỉnh sửa và nghiệm thu sản phẩm.
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a asp-controller="BanGiaoSanPham"
                           asp-action="Index"
                           asp-route-maHD="@Model.maHD"
                           class="btn btn-outline-success rounded-0">
                            Xem lịch sử bàn giao
                        </a>

                        @if (Model.LaFreelancerCuaHopDong && Model.trangThai == "DangThucHien")
                        {
                            @if (Model.TrangThaiBanGiaoMoiNhat == "YeuCauChinhSua" || Model.TrangThaiBanGiaoMoiNhat == "ChuaDat")
                            {
                                <a asp-controller="BanGiaoSanPham"
                                   asp-action="Index"
                                   asp-route-maHD="@Model.maHD"
                                   asp-route-mode="capnhat"
                                   class="btn btn-warning rounded-0 fw-bold text-dark shadow-sm">
                                    <i class="bi bi-pencil-square me-1"></i> Cập nhật lại bàn giao
                                </a>
                            }
                            else if (Model.TatCaMocDaDat)
                            {
                                <a asp-controller="BanGiaoSanPham"
                                   asp-action="Index"
                                   asp-route-maHD="@Model.maHD"
                                   class="btn btn-success rounded-0 fw-bold shadow-sm">
                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Bàn giao sản phẩm
                                </a>
                            }
                        }

                        @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DaHoanThanh")
                        {
                            <a asp-controller="HopDong"
                               asp-action="ThanhToan"
                               asp-route-maHD="@Model.maHD"
                               class="btn btn-primary rounded-0 fw-bold shadow-sm">
                                Thanh toán cho Freelancer
                            </a>
                        }
                    </div>
                </div>

                @if (Model.LaFreelancerCuaHopDong && Model.trangThai == "DangThucHien" && !Model.TatCaMocDaDat)
                {
                    <div class="alert alert-warning mt-3 mb-0 rounded-0 small border-warning">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                            <div>
                                <strong>Chưa đủ điều kiện bàn giao sản phẩm:</strong>
                                <span>Toàn bộ các mốc tiến độ của dự án phải được Nhà tuyển dụng đánh giá <strong>Đạt được</strong> trước khi bạn được phép bàn giao sản phẩm hoàn chỉnh (Hiện tại vẫn còn mốc Chưa đạt hoặc chưa được đánh giá).</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.trangThai == "DangThucHien" && (Model.TrangThaiBanGiaoMoiNhat == "YeuCauChinhSua" || Model.TrangThaiBanGiaoMoiNhat == "ChuaDat"))
                {
                    <div class="alert alert-danger mt-3 mb-0 rounded-0 small border-danger">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <strong><i class="bi bi-x-circle-fill me-1"></i> Sản phẩm bàn giao (@(Model.PhienBanBanGiaoMoiNhat ?? "Phiên bản mới nhất")) bị đánh giá Chưa đạt:</strong>
                                <div class="mt-1 text-dark">@(string.IsNullOrWhiteSpace(Model.PhanHoiBanGiaoMoiNhat) ? "Nhà tuyển dụng yêu cầu chỉnh sửa và bổ sung sản phẩm." : Model.PhanHoiBanGiaoMoiNhat)</div>
                            </div>
                            @if (Model.LaFreelancerCuaHopDong)
                            {
                                <a asp-controller="BanGiaoSanPham"
                                   asp-action="Index"
                                   asp-route-maHD="@Model.maHD"
                                   asp-route-mode="capnhat"
                                   class="btn btn-warning btn-sm rounded-0 fw-bold px-3 shadow-sm text-dark">
                                    <i class="bi bi-pencil-square me-1"></i> Cập nhật lại bàn giao
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (Model.trangThai == "DaThanhToan")
                {
                    <div class="alert alert-success mt-3 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-3 rounded-0">
                        <div class="d-flex align-items-center gap-2">
                            <div>
                                <strong><i class="bi bi-check-circle-fill me-1"></i> Hợp đồng đã hoàn thành và thanh toán thành công!</strong>
                                <div class="small">Thù lao hợp đồng đã được giải ngân an toàn vào ví của Freelancer.</div>
                            </div>
                        </div>
                        <a asp-controller="Wallet" asp-action="Index" class="btn btn-outline-success rounded-0">
                            Xem ví tài khoản
                        </a>
                    </div>
                }

                @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DaHoanThanh")
                {
                    <div class="alert alert-primary mt-3 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-3 rounded-0">
                        <div class="d-flex align-items-center gap-2">
                            <div>
                                <strong>Hợp đồng đã nghiệm thu hoàn thành!</strong>
                                <div class="small">Sản phẩm đã được nghiệm thu đạt yêu cầu. Vui lòng xác nhận giải ngân thù lao cho Freelancer để hoàn tất hợp đồng.</div>
                            </div>
                        </div>
                        <a asp-controller="HopDong"
                           asp-action="ThanhToan"
                           asp-route-maHD="@Model.maHD"
                           class="btn btn-primary rounded-0 fw-bold text-nowrap">
                            Xác nhận thanh toán
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- Modal Thêm Đầu Việc -->
<div class="modal fade" id="modalThemTask" tabindex="-1" aria-labelledby="modalThemTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-success" id="modalThemTaskLabel">
                    Thêm đầu việc tiến độ dự án
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="alertThemTask" class="alert alert-danger d-none py-2 px-3 small mb-3 rounded-0"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề đầu việc <span class="text-danger">*</span></label>
                    <input type="text" id="tenTaskThem" class="form-control rounded-0" placeholder="Ví dụ: Thiết kế cơ sở dữ liệu, Thiết kế giao diện Figma, Xây dựng API..." maxlength="500" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mốc giai đoạn liên kết (tùy chọn)</label>
                        <select id="maGiaiDoanThem" class="form-select rounded-0">
                            <option value="">-- Toàn bộ dự án / Không phân giai đoạn --</option>
                            @if (Model.giaiDoans != null && Model.giaiDoans.Count > 0)
                            {
                                @foreach (var gd in Model.giaiDoans)
                                {
                                    <option value="@gd.maGiaiDoan">@gd.tenGiaiDoan (Hạn: @gd.hanChot.ToString("dd/MM/yyyy"))</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Hạn hoàn thành (Deadline) <span class="text-danger">*</span></label>
                        <input type="date" id="hanHoanThanhThem" class="form-control rounded-0" max="@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")" />
                        <div class="form-text small text-muted">
                            Hạn chót hợp đồng: <strong class="text-danger">@(Model.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả công việc & Minh chứng / Đường dẫn tệp đính kèm <span class="text-danger">*</span></label>
                    <textarea id="moTaThem" class="form-control rounded-0" rows="4" placeholder="Mô tả cụ thể nội dung cần thực hiện, tiêu chí nghiệm thu và có thể kèm link Google Drive, Github PR hoặc link demo sản phẩm..." maxlength="1000"></textarea>
                    <div class="form-text small text-muted">Tối đa 1000 ký tự. Có thể đính kèm URL tài liệu hoặc link minh chứng.</div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-success rounded-0 fw-bold px-4" id="btnLuuThemTask" onclick="luuThemTask()" style="background-color: #1B5E36; border-color: #1B5E36;">
                    Lưu đầu việc
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Đầu Việc -->
<div class="modal fade" id="modalSuaTask" tabindex="-1" aria-labelledby="modalSuaTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary" id="modalSuaTaskLabel">
                    Chỉnh sửa đầu việc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="alertSuaTask" class="alert alert-danger d-none py-2 px-3 small mb-3 rounded-0"></div>
                <input type="hidden" id="maTaskSua" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề đầu việc <span class="text-danger">*</span></label>
                    <input type="text" id="tenTaskSua" class="form-control rounded-0" maxlength="500" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mốc giai đoạn</label>
                        <select id="maGiaiDoanSua" class="form-select rounded-0">
                            <option value="">-- Toàn bộ dự án --</option>
                            @if (Model.giaiDoans != null && Model.giaiDoans.Count > 0)
                            {
                                @foreach (var gd in Model.giaiDoans)
                                {
                                    <option value="@gd.maGiaiDoan">@gd.tenGiaiDoan</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hạn hoàn thành <span class="text-danger">*</span></label>
                        <input type="date" id="hanHoanThanhSua" class="form-control rounded-0" max="@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")" />
                        <div class="form-text small text-muted">
                            Deadline hợp đồng: <strong class="text-danger">@(Model.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Trạng thái công việc <span class="text-danger">*</span></label>
                        <select id="trangThaiSua" class="form-select rounded-0">
                            <option value="ChuaThucHien">Chưa thực hiện</option>
                            <option value="DangThucHien">Đang thực hiện</option>
                            <option value="HoanThanh">Hoàn thành</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả công việc & Minh chứng / Đường dẫn tệp <span class="text-danger">*</span></label>
                    <textarea id="moTaSua" class="form-control rounded-0" rows="4" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary rounded-0 fw-bold px-4" id="btnLuuSuaTask" onclick="luuSuaTask()">
                    Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const contractEndDateStr = '@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")';
        const maHDHienTai = '@Model.maHD';

        async function moFormDanhGia(maHD, maDanhGia) {
            const container = document.getElementById('danhGiaModalContainer');
            if (!container) return;
            try {
                const url = `/DanhGia/Form?maHD=${encodeURIComponent(maHD)}`;
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) {
                    let errMsg = 'Không thể tải biểu mẫu đánh giá.';
                    try {
                        const errJson = await response.json();
                        if (errJson && errJson.message) errMsg = errJson.message;
                    } catch (_) {}
                    throw new Error(errMsg);
                }
                container.innerHTML = await response.text();
                const modalElement = container.querySelector('.modal');
                if (!modalElement) throw new Error('Biểu mẫu đánh giá không hợp lệ.');
                if (maDanhGia) modalElement.dataset.maDanhGia = maDanhGia;
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            } catch (error) {
                alert(error.message || 'Không thể tải biểu mẫu đánh giá.');
            }
        }

        async function guiDanhGia(form, event) {
            event.preventDefault();
            const modalElement = form.closest('.modal');
            const tongSao = Number(form.querySelector('[name="soSaoTongThe"]').value);
            if (!tongSao) {
                const message = form.querySelector('[data-review-message]');
                if (message) {
                    message.textContent = 'Vui lòng chọn số sao đánh giá tổng thể.';
                    message.classList.remove('d-none');
                }
                return;
            }
            const payload = {
                maHD: form.querySelector('[name="maHD"]').value,
                soSaoTongThe: tongSao,
                soSaoChatLuong: Number(form.querySelector('[name="soSaoChatLuong"]').value) || null,
                soSaoDungHan: Number(form.querySelector('[name="soSaoDungHan"]').value) || null,
                soSaoGiaoTiep: Number(form.querySelector('[name="soSaoGiaoTiep"]').value) || null,
                nhanXet: form.querySelector('[name="nhanXet"]').value
            };
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const maDanhGia = modalElement.dataset.maDanhGia;
            const url = maDanhGia ? `/DanhGia/CapNhat?maDanhGia=${encodeURIComponent(maDanhGia)}` : '/DanhGia/Gui';
            const message = form.querySelector('[data-review-message]');
            const button = form.querySelector('[type="submit"]');
            button.disabled = true;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Không thể lưu đánh giá.');
                location.reload();
            } catch (error) {
                if (message) { message.textContent = error.message; message.classList.remove('d-none'); }
                button.disabled = false;
            }
        }

        document.addEventListener('click', event => {
            const starButton = event.target.closest('[data-rating-group][data-rating-value]');
            if (starButton) {
                const form = starButton.closest('form');
                const groupName = starButton.dataset.ratingGroup;
                const selectedValue = Number(starButton.dataset.ratingValue);
                const valueInput = form?.querySelector(`[name="${groupName}"]`);
                if (!valueInput) return;

                valueInput.value = selectedValue;
                form.querySelectorAll(`[data-rating-group="${groupName}"][data-rating-value]`).forEach(button => {
                    const value = Number(button.dataset.ratingValue);
                    const selected = value === selectedValue;
                    button.setAttribute('aria-checked', selected ? 'true' : 'false');
                    button.classList.toggle('text-warning', value <= selectedValue);
                    button.classList.toggle('text-secondary', value > selectedValue);
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-star-fill', value <= selectedValue);
                        icon.classList.toggle('bi-star', value > selectedValue);
                    }
                    const starSpan = button.querySelector('.star-char');
                    if (starSpan) {
                        starSpan.textContent = value <= selectedValue ? '★' : '☆';
                    }
                });

                const label = form.querySelector(`[data-rating-label="${groupName}"]`);
                if (label) label.textContent = `${selectedValue} trên 5`;
                return;
            }

            const clearButton = event.target.closest('[data-rating-clear]');
            if (clearButton) {
                const form = clearButton.closest('form');
                const groupName = clearButton.dataset.ratingClear;
                const valueInput = form?.querySelector(`[name="${groupName}"]`);
                if (!valueInput) return;
                valueInput.value = '';
                form.querySelectorAll(`[data-rating-group="${groupName}"][data-rating-value]`).forEach(button => {
                    button.setAttribute('aria-checked', 'false');
                    button.classList.remove('text-warning');
                    button.classList.add('text-secondary');
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('bi-star-fill');
                        icon.classList.add('bi-star');
                    }
                    const starSpan = button.querySelector('.star-char');
                    if (starSpan) {
                        starSpan.textContent = '☆';
                    }
                });
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const reviewContract = '@(TempData["MoPopupDanhGia"] as string ?? "")';
            if (reviewContract) moFormDanhGia(reviewContract);
        });

        function showAlert(alertId, message) {
            const alertEl = document.getElementById(alertId);
            if (alertEl) {
                alertEl.textContent = message;
                alertEl.classList.remove('d-none');
            }
        }

        function hideAlert(alertId) {
            const alertEl = document.getElementById(alertId);
            if (alertEl) {
                alertEl.classList.add('d-none');
                alertEl.textContent = '';
            }
        }

        async function luuThemTask() {
            hideAlert('alertThemTask');
            const tenTask = document.getElementById('tenTaskThem').value.trim();
            const moTa = document.getElementById('moTaThem').value.trim();
            const hanHoanThanh = document.getElementById('hanHoanThanhThem').value;
            const maGiaiDoanVal = document.getElementById('maGiaiDoanThem').value;

            if (!tenTask) {
                showAlert('alertThemTask', 'Tiêu đề đầu việc không được để trống.');
                return;
            }

            if (!moTa) {
                showAlert('alertThemTask', 'Mô tả công việc không được để trống.');
                return;
            }

            if (hanHoanThanh && contractEndDateStr) {
                if (hanHoanThanh > contractEndDateStr) {
                    showAlert('alertThemTask', 'Deadline của công việc phải trước hoặc trùng với hạn chót bàn giao của hợp đồng.');
                    return;
                }
            }

            const payload = {
                maHD: maHDHienTai,
                tenTask: tenTask,
                moTa: moTa,
                hanHoanThanh: hanHoanThanh ? hanHoanThanh : null,
                maGiaiDoan: maGiaiDoanVal ? parseInt(maGiaiDoanVal) : null
            };

            const btn = document.getElementById('btnLuuThemTask');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

            try {
                const res = await fetch('/HopDong/ThemTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    showAlert('alertThemTask', data.message || 'Có lỗi xảy ra khi thêm đầu việc.');
                }
            } catch (err) {
                showAlert('alertThemTask', 'Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Lưu đầu việc';
            }
        }

        function moModalSuaTask(maTask, tenTask, moTa, hanHoanThanh, trangThai, maGiaiDoan) {
            hideAlert('alertSuaTask');
            document.getElementById('maTaskSua').value = maTask;
            document.getElementById('tenTaskSua').value = tenTask;
            document.getElementById('moTaSua').value = moTa;
            document.getElementById('hanHoanThanhSua').value = hanHoanThanh;
            document.getElementById('trangThaiSua').value = trangThai;
            document.getElementById('maGiaiDoanSua').value = maGiaiDoan || '';

            const modalEl = document.getElementById('modalSuaTask');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function luuSuaTask() {
            hideAlert('alertSuaTask');
            const maTask = parseInt(document.getElementById('maTaskSua').value);
            const tenTask = document.getElementById('tenTaskSua').value.trim();
            const moTa = document.getElementById('moTaSua').value.trim();
            const hanHoanThanh = document.getElementById('hanHoanThanhSua').value;
            const trangThai = document.getElementById('trangThaiSua').value;
            const maGiaiDoanVal = document.getElementById('maGiaiDoanSua').value;

            if (!tenTask) {
                showAlert('alertSuaTask', 'Tiêu đề đầu việc không được để trống.');
                return;
            }

            if (!moTa) {
                showAlert('alertSuaTask', 'Mô tả công việc không được để trống.');
                return;
            }

            if (hanHoanThanh && contractEndDateStr) {
                if (hanHoanThanh > contractEndDateStr) {
                    showAlert('alertSuaTask', 'Deadline của công việc phải trước hoặc trùng với hạn chót bàn giao của hợp đồng.');
                    return;
                }
            }

            const payload = {
                maTask: maTask,
                maHD: maHDHienTai,
                tenTask: tenTask,
                moTa: moTa,
                hanHoanThanh: hanHoanThanh ? hanHoanThanh : null,
                trangThai: trangThai,
                maGiaiDoan: maGiaiDoanVal ? parseInt(maGiaiDoanVal) : null
            };

            const btn = document.getElementById('btnLuuSuaTask');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang cập nhật...';

            try {
                const res = await fetch('/HopDong/CapNhatTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    showAlert('alertSuaTask', data.message || 'Có lỗi xảy ra khi cập nhật.');
                }
            } catch (err) {
                showAlert('alertSuaTask', 'Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Cập nhật';
            }
        }

        async function doiTrangThaiTask(maTask, trangThai) {
            try {
                const payload = {
                    maTask: maTask,
                    trangThai: trangThai
                };

                const res = await fetch('/HopDong/CapNhatTrangThaiTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Không thể cập nhật trạng thái.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }

        async function xacNhanXoaTask(maTask, tenTask) {
            if (!confirm(`Bạn có chắc chắn muốn xóa đầu việc "${tenTask}" không?`)) {
                return;
            }

            try {
                const res = await fetch('/HopDong/XoaTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(maTask)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Không thể xóa đầu việc.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }
    </script>
}
