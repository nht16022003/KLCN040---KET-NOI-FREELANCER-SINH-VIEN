                                                                {
                                                                    <div class="alert alert-danger border-danger small mb-3">
                                                                        <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Lý do Nhà tuyển dụng đánh giá Chưa đạt:</strong>
                                                                        <div class="mt-1">@gd.lyDoChuaDat</div>
