                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-0">
                                                        <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="maHD" value="@Model.maHD" />
                                                            <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                            <input type="hidden" name="trangThai" value="ChuaDat" />
                                                            <div class="modal-header bg-light">
                                                                <h6 class="modal-title fw-bold text-danger" id="labelChuaDat_@gd.maGiaiDoan">
                                                                    Đánh giá Chưa đạt mốc: @gd.tenGiaiDoan
                                                                </h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="text-muted small">
                                                                    Vui lòng cung cấp lý do cụ thể vì sao mốc tiến độ này chưa đạt yêu cầu để Freelancer có căn cứ điều chỉnh và bổ sung.
                                                                </p>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Lý do chưa đạt <span class="text-danger">*</span></label>
                                                                    <textarea name="lyDo" class="form-control rounded-0" rows="3" required placeholder="Nhập lý do chi tiết (bắt buộc)...">@gd.lyDoChuaDat</textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-danger rounded-0 fw-bold">Xác nhận Chưa đạt</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                <div class="p-3 bg-light border-top d-flex align-items-center gap-2 small text-muted">
                    <span>Toàn bộ thù lao hợp đồng (<strong>@((Model.sotienkyquy ?? 0).ToString("N0")) VNĐ</strong>) được giữ an toàn tại ví ký quỹ. Sau khi nghiệm thu đạt toàn bộ dự án, Nhà tuyển dụng sẽ xác nhận hoàn thành và giải ngân thanh toán 1 lần cho Freelancer.</span>
                </div>
            </div>

                @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien")
                {
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalChuaDatTatCa">
                            Đánh dấu tất cả chưa đạt
                        </button>
                        <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post" onsubmit="return confirm('Xác nhận tất cả giai đoạn đều đạt yêu cầu?');">
