@model FreelancerStudent.Web.ViewModels.HopDongViewModel
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Chi tiết hợp đồng " + Model.maHD;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dsTrangThai = new Dictionary<string, string>
    {
        { "ChoXacNhan", "Chờ Freelancer xác nhận" },
        { "ChoKyKet", "Chờ ký kết" },
        { "ChoKyQuy", "Chờ ký quỹ" },
        { "DangThucHien", "Đang thực hiện" },
        { "DaHoanThanh", "Đã hoàn thành – chờ thanh toán" },
        { "DaThanhToan", "Đã thanh toán" },
        { "DaHuy", "Đã hủy" },
        { "DaHuyHoanTien", "Đã hủy – đã hoàn tiền" },
        { "DangTranhChap", "Đang tranh chấp" }
    };

    var tenTrangThai = dsTrangThai.TryGetValue(Model.trangThai, out var ten) ? ten : Model.trangThai;

    var badgeClass = Model.trangThai switch
    {
        "ChoXacNhan" => "bg-warning text-dark",
        "ChoKyKet" => "bg-info text-dark",
        "ChoKyQuy" => "bg-primary text-white",
        "DangThucHien" => "bg-success text-white",
        "DaHoanThanh" => "bg-dark text-white",
        "DaThanhToan" => "bg-success text-white",
        "DaHuy" => "bg-danger text-white",
        "DaHuyHoanTien" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="HopDong" asp-action="Index" class="text-decoration-none text-success">Quản lý hợp đồng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết hợp đồng #@Model.maHD</li>
        </ol>
    </nav>

    <!-- Thông báo Alert nếu có -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BANNER HÀNH ĐỘNG CHO FREELANCER (KHI HỢP ĐỒNG ĐANG Ở TRẠNG THÁI CHỜ XÁC NHẬN) -->
    @if (Model.CoQuyenXacNhan)
    {
        <div class="card border-warning bg-warning bg-opacity-10 rounded-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                <i class="bi bi-bell-fill me-1"></i> Dự thảo hợp đồng đang chờ bạn xác nhận
                            </span>
                        </div>
                        <p class="text-dark mb-0 mt-2">
                            Nhà tuyển dụng đã tạo dự thảo hợp đồng này và gửi cho bạn. Vui lòng xem kỹ thông tin công việc, thù lao, các mốc bàn giao và điều khoản cam kết bên dưới trước khi đưa ra quyết định.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <!-- Nút Từ chối -->
                        <button type="button" class="btn btn-outline-danger rounded-0 px-3 fw-medium" data-bs-toggle="modal" data-bs-target="#modalTuChoi">
                            <i class="bi bi-x-circle me-1"></i> Từ chối hợp đồng
                        </button>

                        <!-- Form Xác nhận hợp đồng -->
                        <form asp-controller="HopDong" asp-action="XacNhan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận đồng ý dự thảo hợp đồng này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maHD" value="@Model.maHD" />
                            <input type="hidden" name="dongY" value="true" />
                            <button type="submit" class="btn btn-success rounded-0 px-4 fw-bold shadow-sm" style="background-color: #1B5E36; border-color: #1B5E36;">
                                <i class="bi bi-check2-circle me-1"></i> Xác nhận hợp đồng
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Từ chối hợp đồng -->
        <div class="modal fade" id="modalTuChoi" tabindex="-1" aria-labelledby="modalTuChoiLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <form asp-controller="HopDong" asp-action="XacNhan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maHD" value="@Model.maHD" />
                        <input type="hidden" name="dongY" value="false" />
                        <div class="modal-header bg-light">
                            <h5 class="modal-title text-danger fw-bold" id="modalTuChoiLabel">
                                <i class="bi bi-x-circle me-1"></i> Từ chối dự thảo hợp đồng
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted small">
                                Bạn có chắc chắn muốn từ chối dự thảo hợp đồng này không? Khi từ chối, hợp đồng sẽ bị hủy và thông báo sẽ được gửi đến Nhà tuyển dụng.
                            </p>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do từ chối (tùy chọn):</label>
                                <textarea name="lyDoTuChoi" class="form-control rounded-0" rows="3" placeholder="Nhập lý do thù lao chưa phù hợp, thời gian không đủ hoặc điều khoản chưa thỏa đáng..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-danger rounded-0 fw-bold">Xác nhận từ chối</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- BANNER HÀNH ĐỘNG CHO NHÀ TUYỂN DỤNG (KHI HỢP ĐỒNG ĐANG Ở TRẠNG THÁI CHỜ KÝ QUỸ) -->
    @if (Model.CoQuyenKyQuy || (!Model.LaFreelancerCuaHopDong && Model.trangThai == "ChoKyQuy"))
    {
        <div class="card border-primary bg-primary bg-opacity-10 rounded-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary text-white px-2 py-1 fs-6">
                                <i class="bi bi-wallet2 me-1"></i> Hợp đồng đang chờ bạn ký quỹ
                            </span>
                        </div>
                        <h5 class="fw-bold text-primary mb-1 mt-2">
                            Freelancer đã đồng ý nhận việc! Vui lòng tiến hành ký quỹ để kích hoạt hợp đồng.
                        </h5>
                        <p class="text-muted small mb-0">
                            Số tiền ký quỹ bảo chứng: <strong class="text-danger fs-6">@(Model.sotienkyquy?.ToString("N0") ?? "0") VNĐ</strong>.
                            Tiền ký quỹ sẽ được bảo lưu an toàn tại hệ thống và chỉ giải ngân cho Freelancer khi bạn nghiệm thu đạt từng mốc bàn giao.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-lg rounded-0 fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalKyQuy">
                            <i class="bi bi-shield-check me-1"></i> Tiến hành ký quỹ ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Xác nhận Ký quỹ -->
        <div class="modal fade" id="modalKyQuy" tabindex="-1" aria-labelledby="modalKyQuyLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <form asp-controller="HopDong" asp-action="KyQuy" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maHD" value="@Model.maHD" />
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title fw-bold" id="modalKyQuyLabel">
                                <i class="bi bi-shield-lock-fill me-1"></i> Ký quỹ bảo chứng hợp đồng (Escrow)
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="text-center mb-4">
                                <span class="text-muted small text-uppercase">Tổng số tiền ký quỹ</span>
                                <h2 class="text-primary fw-bold mt-1 mb-0">@(Model.sotienkyquy?.ToString("N0") ?? "0") VNĐ</h2>
                                <span class="badge bg-light text-muted border mt-2">Áp dụng cho Hợp đồng #@Model.maHD</span>
                            </div>

                            <div class="alert alert-info rounded-0 small mb-3">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Tiền ký quỹ sẽ được bảo lưu an toàn tại hệ thống cho tới khi bạn kiểm tra và xác nhận nghiệm thu các mốc sản phẩm bàn giao từ Freelancer.
                            </div>

                            <ul class="list-unstyled small text-muted mb-0">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Trạng thái hợp đồng sẽ chuyển sang <strong>Đang thực hiện</strong>.</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Freelancer sẽ nhận được thông báo để bắt đầu công việc ngay lập tức.</li>
                                <li><i class="bi bi-check-circle-fill text-success me-2"></i> Bạn có thể theo dõi tiến độ và duyệt từng giai đoạn.</li>
                            </ul>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="submit" class="btn btn-primary rounded-0 fw-bold px-4">
                                <i class="bi bi-check2-circle me-1"></i> Xác nhận Ký quỹ & Kích hoạt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Header Chi tiết Hợp đồng -->
    <div class="card border-0 shadow-sm rounded-0 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 border-bottom">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Hợp đồng dịch vụ Freelance</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.tenCongViec</h3>
                    <div class="text-muted small mt-1">Mã hợp đồng: <strong class="text-dark">#@Model.maHD</strong> | Mã bài đăng: <strong class="text-dark">#@Model.maJob</strong></div>
                </div>
                <div class="text-end">
                    <div class="d-flex align-items-center justify-content-end flex-wrap gap-2">
                        <span class="badge @badgeClass px-3 py-2 fs-6 rounded-0">
                            @tenTrangThai
                        </span>
                        @if (Model.CoQuyenKyQuy || (!Model.LaFreelancerCuaHopDong && Model.trangThai == "ChoKyQuy"))
                        {
                            <button type="button" class="btn btn-primary rounded-0 fw-bold px-3 py-2 shadow-sm d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#modalKyQuy">
                                <i class="bi bi-wallet2 me-1"></i> Tiến hành ký quỹ
                            </button>
                        }
                    </div>
                    <div class="text-muted small mt-2">
                        Ngày tạo: @(Model.ngayBatDau?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))
                    </div>
                </div>
            </div>

            <!-- 4 Thông số chính -->
            <div class="row g-3 text-center mt-3">
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light border">
                        <div class="text-muted small text-uppercase">Thù lao thỏa thuận</div>
                        <div class="fs-5 fw-bold text-success mt-1">
                            @(Model.sotienkyquy?.ToString("N0") ?? "0") VNĐ
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light border">
                        <div class="text-muted small text-uppercase">Hình thức làm việc</div>
                        <div class="fs-5 fw-bold text-dark mt-1">
                            @(string.IsNullOrWhiteSpace(Model.hinhthuclamviec) ? "Remote" : Model.hinhthuclamviec)
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light border">
                        <div class="text-muted small text-uppercase">Ngày bắt đầu</div>
                        <div class="fs-5 fw-bold text-dark mt-1">
                            @(Model.ngayBatDau?.ToString("dd/MM/yyyy") ?? "-")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light border">
                        <div class="text-muted small text-uppercase">Hạn chót hoàn thành</div>
                        <div class="fs-5 fw-bold text-danger mt-1">
                            @(Model.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin 2 bên giao kết -->
    <div class="row g-4 mb-4">
        <!-- Bên A: Khách hàng / Nhà tuyển dụng -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-0 h-100">
                <div class="card-header bg-light border-bottom py-2">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-building text-success me-2"></i>BÊN A: BÊN THUÊ (NHÀ TUYỂN DỤNG)
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <span class="text-muted small">Tên doanh nghiệp / Đơn vị:</span>
                        <div class="fw-bold text-dark">@(!string.IsNullOrWhiteSpace(Model.tenNhaTuyenDung) ? Model.tenNhaTuyenDung : "Nhà tuyển dụng")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.emailNhaTuyenDung))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">Email liên hệ:</span>
                            <div class="text-secondary">@Model.emailNhaTuyenDung</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.sdtNhaTuyenDung))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">Số điện thoại:</span>
                            <div class="text-secondary">@Model.sdtNhaTuyenDung</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bên B: Freelancer / Sinh viên -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-0 h-100">
                <div class="card-header bg-light border-bottom py-2">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-person-badge text-success me-2"></i>BÊN B: BÊN NHẬN VIỆC (FREELANCER)
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <span class="text-muted small">Họ và tên Freelancer:</span>
                        <div class="fw-bold text-success">@(!string.IsNullOrWhiteSpace(Model.tenFreelancer) ? Model.tenFreelancer : "Sinh viên")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.truongFreelancer))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">Trường / Học viện:</span>
                            <div class="text-secondary">@Model.truongFreelancer</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.chuyenNganhFreelancer))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">Chuyên ngành đào tạo:</span>
                            <div class="text-secondary">@Model.chuyenNganhFreelancer</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.emailFreelancer))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">Email sinh viên:</span>
                            <div class="text-secondary">@Model.emailFreelancer</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Mô tả công việc yêu cầu nếu có -->
    @if (!string.IsNullOrWhiteSpace(Model.moTaCongViec))
    {
        <div class="card border-0 shadow-sm rounded-0 mb-4">
            <div class="card-header bg-light border-bottom py-2">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-file-text text-success me-2"></i>Mô tả yêu cầu công việc
                </h6>
            </div>
            <div class="card-body">
                <p class="mb-0 text-muted" style="white-space: pre-line;">@Model.moTaCongViec</p>
            </div>
        </div>
    }

    <!-- Lộ trình các mốc bàn giao (Milestones) -->
    <div class="card border-0 shadow-sm rounded-0 mb-4">
        <div class="card-header bg-light border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-signpost-split text-success me-2"></i>Lộ trình các mốc bàn giao (Milestones)
            </h5>
            <span class="badge bg-secondary rounded-0">@(Model.giaiDoans?.Count ?? 0) giai đoạn</span>
        </div>
        <div class="card-body p-0">
            @if (Model.giaiDoans != null && Model.giaiDoans.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th>Tên giai đoạn / Mốc bàn giao</th>
                                <th>Mô tả & Tiêu chí nghiệm thu</th>
                                <th>Hạn chót mốc</th>
                                <th class="text-end">Trạng thái &amp; nghiệm thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.giaiDoans.Count; i++)
                            {
                                var gd = Model.giaiDoans[i];
                                <tr>
                                    <td class="text-center fw-bold text-muted">@(i + 1)</td>
                                    <td class="fw-semibold text-dark">@gd.tenGiaiDoan</td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(gd.moTa) ? "Theo yêu cầu chung" : gd.moTa)</td>
                                    <td class="fw-medium text-dark">@gd.hanChot.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        @if (gd.trangThai == "Dat")
                                        {
                                            <span class="badge bg-success rounded-0">Đạt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border rounded-0">Chưa đạt</span>
                                        }
                                        @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien")
                                        {
                                            <div class="d-flex justify-content-end gap-1 mt-2">
                                                <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maHD" value="@Model.maHD" />
                                                    <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                    <input type="hidden" name="trangThai" value="Dat" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" disabled="@(gd.trangThai == "Dat")">Đạt</button>
                                                </form>
                                                <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maHD" value="@Model.maHD" />
                                                    <input type="hidden" name="maGiaiDoan" value="@gd.maGiaiDoan" />
                                                    <input type="hidden" name="trangThai" value="ChuaDat" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(gd.trangThai != "Dat")">Chưa đạt</button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien")
                {
                    <div class="d-flex justify-content-end gap-2 p-3 border-top">
                        <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post" onsubmit="return confirm('Đánh dấu tất cả giai đoạn là Chưa đạt?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maHD" value="@Model.maHD" />
                            <input type="hidden" name="trangThai" value="ChuaDat" />
                            <button type="submit" class="btn btn-outline-danger">Đánh dấu tất cả chưa đạt</button>
                        </form>
                        <form asp-controller="HopDong" asp-action="DanhGiaGiaiDoan" method="post" onsubmit="return confirm('Xác nhận tất cả giai đoạn đều đạt yêu cầu?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maHD" value="@Model.maHD" />
                            <input type="hidden" name="trangThai" value="Dat" />
                            <button type="submit" class="btn btn-success">Đánh dấu tất cả đạt</button>
                        </form>
                    </div>
                }

            }
            else
            {
                <div class="p-3 text-center text-muted">
                    Hợp đồng này nghiệm thu toàn bộ một lần sau khi hoàn thành.
                </div>
            }
        </div>
    </div>

    @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DangThucHien" && Model.giaiDoans.Count > 0 && Model.giaiDoans.All(g => g.trangThai == "Dat"))
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center gap-3">
            <span>Tất cả các giai đoạn đã được nghiệm thu đạt.</span>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNghiemThu">Xác nhận nghiệm thu &amp; Hoàn thành</button>
        </div>
        <div class="modal fade" id="modalNghiemThu" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <form asp-controller="HopDong" asp-action="NghiemThu" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maHD" value="@Model.maHD" />
                    <div class="modal-header"><h5 class="modal-title">Xác nhận nghiệm thu</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body"><p>Việc xác nhận đồng nghĩa với việc chấp thuận toàn bộ sản phẩm và hợp đồng chuyển sang bước thanh toán.</p></div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Quay lại</button><button type="submit" class="btn btn-success">Xác nhận nghiệm thu</button></div>
                </form>
            </div></div>
        </div>
    }

    @if (Model.LaNhaTuyenDungCuaHopDong && Model.trangThai == "DaHoanThanh")
    {
        <div class="alert alert-primary d-flex justify-content-between align-items-center gap-3">
            <span>Hợp đồng đã nghiệm thu và đang chờ thanh toán.</span>
            <a asp-controller="HopDong" asp-action="ThanhToan" asp-route-maHD="@Model.maHD" class="btn btn-primary">Thanh toán cho Freelancer</a>
        </div>
    }

    @if (Model.trangThai is "DaThanhToan" or "DaHuyHoanTien")
    {
        <div class="card border-0 shadow-sm rounded-0 mb-4">
            <div class="card-body d-flex justify-content-between align-items-center gap-3">
                <div><h5 class="mb-1">Đánh giá đối tác</h5><span class="text-muted">@(Model.trangThaiDanhGia == "DaDanhGia" ? "Bạn đã gửi đánh giá." : "Chia sẻ trải nghiệm làm việc của bạn.")</span></div>
                @if (Model.trangThaiDanhGia == "DaDanhGia")
                {
                    if (Model.coTheChinhSuaDanhGia)
                    {
                        <button type="button" class="btn btn-outline-primary" onclick="moFormDanhGia('@Model.maHD', @Model.maDanhGia)">Chỉnh sửa đánh giá</button>
                    }
                    else { <span class="badge text-bg-success">Đã đánh giá</span> }
                }
                else if (Model.coTheDanhGia)
                {
                    <button type="button" class="btn btn-outline-primary" onclick="moFormDanhGia('@Model.maHD')">Đánh giá</button>
                }
                else { <span class="text-muted small">Đã hết thời hạn gửi đánh giá.</span> }
            </div>
        </div>
        <div id="danhGiaModalContainer"></div>
    }

    <!-- ================= KHU VỰC TIẾN ĐỘ DỰ ÁN (FRL-UC-09) ================= -->
    @{
        var tienDo = Model.TienDoDuAn;
        var coTheCapNhat = Model.LaFreelancerCuaHopDong && Model.trangThai == "DangThucHien";
        var tongTask = tienDo?.tongSoTask ?? 0;
        var hoanThanh = tienDo?.soTaskHoanThanh ?? 0;
        var dangThucHien = tienDo?.soTaskDangThucHien ?? 0;
        var chuaThucHien = tienDo?.soTaskChuaThucHien ?? 0;
        var tyLe = tienDo?.tyLeHoanThanh ?? 0;
    }

    <div class="card border-0 shadow-sm rounded-0 mb-4" id="sectionTienDoDuAn">
        <div class="card-header bg-light border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-kanban text-success me-2"></i>Tiến độ dự án (Project Progress)
                </h5>
                @if (tongTask > 0)
                {
                    <span class="badge @(tyLe == 100 ? "bg-success" : (tyLe >= 50 ? "bg-primary" : "bg-warning text-dark")) rounded-pill px-3 py-1">
                        @tyLe% hoàn thành (@hoanThanh/@tongTask việc)
                    </span>
                }
            </div>

            @if (coTheCapNhat)
            {
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success rounded-0 px-3 fw-medium shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemTask" style="background-color: #1B5E36; border-color: #1B5E36;">
                        <i class="bi bi-plus-circle me-1"></i> Cập nhật tiến độ dự án
                    </button>
                </div>
            }
        </div>

        <div class="card-body p-4">
            <!-- Thanh tiến trình tổng thể -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tỷ lệ hoàn thành tổng thể</span>
                    <span class="fw-bold text-success fs-5">@tyLe%</span>
                </div>
                <div class="progress rounded-0" style="height: 14px; background-color: #e9ecef;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                         role="progressbar"
                         style="width: @tyLe%; background-color: #1B5E36 !important;"
                         aria-valuenow="@tyLe"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>

            <!-- Thống kê đầu việc -->
            <div class="row g-3 mb-4">
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Tổng đầu việc</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@tongTask</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Chưa thực hiện</div>
                        <div class="fs-4 fw-bold text-secondary mt-1">@chuaThucHien</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Đang thực hiện</div>
                        <div class="fs-4 fw-bold text-primary mt-1">@dangThucHien</div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="p-3 border bg-light text-center">
                        <div class="text-muted small text-uppercase fw-semibold">Đã hoàn thành</div>
                        <div class="fs-4 fw-bold text-success mt-1">@hoanThanh</div>
                    </div>
                </div>
            </div>

            <!-- Thông báo trạng thái nếu không ở DangThucHien -->
            @if (Model.trangThai != "DangThucHien")
            {
                <div class="alert alert-secondary rounded-0 py-2 px-3 small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Hợp đồng hiện tại đang ở trạng thái <strong>@tenTrangThai</strong>.
                    @if (Model.LaFreelancerCuaHopDong)
                    {
                        <span>Bạn chỉ có thể tạo và quản lý đầu việc khi hợp đồng đã được ký quỹ và chuyển sang trạng thái <strong>Đang thực hiện</strong>.</span>
                    }
                    else
                    {
                        <span>Tiến độ đang được hiển thị ở chế độ theo dõi dành cho Nhà tuyển dụng.</span>
                    }
                </div>
            }

            <!-- Danh sách đầu việc -->
            @if (tienDo != null && tienDo.danhSachTask.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 border">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th>Đầu việc & Chi tiết / Minh chứng</th>
                                <th style="width: 170px;">Mốc giai đoạn</th>
                                <th style="width: 150px;">Hạn chót</th>
                                <th style="width: 160px;">Trạng thái</th>
                                <th class="text-end" style="width: 110px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < tienDo.danhSachTask.Count; i++)
                            {
                                var task = tienDo.danhSachTask[i];
                                var taskStatusBadge = task.trangThai switch
                                {
                                    "HoanThanh" => "bg-success text-white",
                                    "DangThucHien" => "bg-primary text-white",
                                    _ => "bg-secondary text-white"
                                };
                                var taskStatusText = task.trangThai switch
                                {
                                    "HoanThanh" => "Hoàn thành",
                                    "DangThucHien" => "Đang thực hiện",
                                    _ => "Chưa thực hiện"
                                };

                                <tr>
                                    <td class="text-center fw-bold text-muted">@(i + 1)</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">@task.tenTask</div>
                                        @if (!string.IsNullOrWhiteSpace(task.moTa))
                                        {
                                            <div class="text-muted small mt-1" style="white-space: pre-line;">@task.moTa</div>
                                        }
                                        <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock me-1"></i>Cập nhật: @task.ngayCapNhat.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(task.tenGiaiDoan))
                                        {
                                            <span class="badge bg-light text-dark border">@task.tenGiaiDoan</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Toàn bộ dự án</span>
                                        }
                                    </td>
                                    <td>
                                        @if (task.hanHoanThanh.HasValue)
                                        {
                                            var isOverdue = task.trangThai != "HoanThanh" && task.hanHoanThanh.Value.Date < DateTime.Now.Date;
                                            <div class="@(isOverdue ? "text-danger fw-bold" : "text-dark") small">
                                                <i class="bi bi-calendar-event me-1"></i>@task.hanHoanThanh.Value.ToString("dd/MM/yyyy")
                                            </div>
                                            @if (isOverdue)
                                            {
                                                <span class="badge bg-danger mt-1" style="font-size: 0.7rem;">Quá hạn</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (coTheCapNhat)
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-sm dropdown-toggle rounded-0 @taskStatusBadge border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    @taskStatusText
                                                </button>
                                                <ul class="dropdown-menu shadow-sm rounded-0">
                                                    <li><a class="dropdown-item py-2 small @(task.trangThai == "ChuaThucHien" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'ChuaThucHien')"><i class="bi bi-hourglass me-2"></i>Chưa thực hiện</a></li>
                                                    <li><a class="dropdown-item py-2 small @(task.trangThai == "DangThucHien" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'DangThucHien')"><i class="bi bi-arrow-repeat me-2"></i>Đang thực hiện</a></li>
                                                    <li><a class="dropdown-item py-2 small @(task.trangThai == "HoanThanh" ? "active" : "")" href="javascript:void(0)" onclick="doiTrangThaiTask(@task.maTask, 'HoanThanh')"><i class="bi bi-check-circle me-2"></i>Hoàn thành</a></li>
                                                </ul>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge @taskStatusBadge rounded-0 px-2 py-1">@taskStatusText</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (coTheCapNhat)
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-primary rounded-0 me-1" 
                                                    title="Chỉnh sửa đầu việc"
                                                    onclick="moModalSuaTask(@task.maTask, '@Html.Raw(JavaScriptEncoder.Default.Encode(task.tenTask))', '@Html.Raw(JavaScriptEncoder.Default.Encode(task.moTa ?? ""))', '@(task.hanHoanThanh?.ToString("yyyy-MM-dd") ?? "")', '@task.trangThai', '@(task.maGiaiDoan?.ToString() ?? "")')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger rounded-0" 
                                                    title="Xóa đầu việc"
                                                    onclick="xacNhanXoaTask(@task.maTask, '@Html.Raw(JavaScriptEncoder.Default.Encode(task.tenTask))')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-lock me-1"></i>Chỉ xem</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Trạng thái chưa có đầu việc nào -->
                <div class="text-center py-5 border bg-light">
                    <div class="text-muted mb-2">
                        <i class="bi bi-clipboard2-x display-5 text-secondary"></i>
                    </div>
                    @if (Model.LaFreelancerCuaHopDong)
                    {
                        <h6 class="fw-bold text-dark mb-1">Chưa có đầu việc nào được tạo cho dự án này</h6>
                        <p class="text-muted small mb-3">
                            Hãy chia nhỏ công việc và thêm các đầu việc để quản lý tiến độ hiệu quả cũng như giúp Nhà tuyển dụng theo dõi sát sao.
                        </p>
                        @if (coTheCapNhat)
                        {
                            <button type="button" class="btn btn-success rounded-0 px-4 fw-medium shadow-sm" data-bs-toggle="modal" data-bs-target="#modalThemTask" style="background-color: #1B5E36; border-color: #1B5E36;">
                                <i class="bi bi-plus-circle me-1"></i> Thêm đầu việc ngay
                            </button>
                        }
                    }
                    else
                    {
                        <h6 class="fw-bold text-muted mb-1">Freelancer chưa cập nhật tiến độ dự án</h6>
                        <p class="text-muted small mb-0">Khi Freelancer cập nhật các đầu việc của hợp đồng, tiến độ chi tiết sẽ được hiển thị tại đây.</p>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Điều khoản giao kết cụ thể -->
    <div class="card border-0 shadow-sm rounded-0 mb-4">
        <div class="card-header bg-light border-bottom py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-shield-lock text-success me-2"></i>Điều khoản giao kết cụ thể
            </h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.dieuKhoan))
            {
                <div class="p-3 bg-light border font-monospace small" style="white-space: pre-line; line-height: 1.7;">
                    @Model.dieuKhoan
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Áp dụng theo các điều khoản tiêu chuẩn của nền tảng kết nối Freelancer Sinh Viên.</p>
            }
        </div>
    </div>

    <!-- Nút quay lại & Hành động cuối trang -->
    <div class="d-flex justify-content-between align-items-center">
        <a asp-controller="HopDong" asp-action="Index" class="btn btn-outline-secondary rounded-0">
            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách hợp đồng
        </a>

        @if (Model.CoQuyenXacNhan)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-danger rounded-0 px-3" data-bs-toggle="modal" data-bs-target="#modalTuChoi">
                    Từ chối
                </button>
                <form asp-controller="HopDong" asp-action="XacNhan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận đồng ý dự thảo hợp đồng này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maHD" value="@Model.maHD" />
                    <input type="hidden" name="dongY" value="true" />
                    <button type="submit" class="btn btn-success rounded-0 px-4 fw-bold" style="background-color: #1B5E36; border-color: #1B5E36;">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận hợp đồng
                    </button>
                </form>
            </div>
        }
    </div>
</div>

<!-- Modal Thêm Đầu Việc -->
<div class="modal fade" id="modalThemTask" tabindex="-1" aria-labelledby="modalThemTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-success" id="modalThemTaskLabel">
                    <i class="bi bi-plus-circle me-1"></i> Thêm đầu việc tiến độ dự án
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="alertThemTask" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề đầu việc <span class="text-danger">*</span></label>
                    <input type="text" id="tenTaskThem" class="form-control rounded-0" placeholder="Ví dụ: Thiết kế cơ sở dữ liệu, Thiết kế giao diện Figma, Xây dựng API..." maxlength="500" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mốc giai đoạn liên kết (tùy chọn)</label>
                        <select id="maGiaiDoanThem" class="form-select rounded-0">
                            <option value="">-- Toàn bộ dự án / Không phân giai đoạn --</option>
                            @if (Model.giaiDoans != null && Model.giaiDoans.Count > 0)
                            {
                                @foreach (var gd in Model.giaiDoans)
                                {
                                    <option value="@gd.maGiaiDoan">@gd.tenGiaiDoan (Hạn: @gd.hanChot.ToString("dd/MM/yyyy"))</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Hạn hoàn thành (Deadline) <span class="text-danger">*</span></label>
                        <input type="date" id="hanHoanThanhThem" class="form-control rounded-0" max="@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")" />
                        <div class="form-text small text-muted">
                            Hạn chót hợp đồng: <strong class="text-danger">@(Model.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả công việc & Minh chứng / Đường dẫn tệp đính kèm <span class="text-danger">*</span></label>
                    <textarea id="moTaThem" class="form-control rounded-0" rows="4" placeholder="Mô tả cụ thể nội dung cần thực hiện, tiêu chí nghiệm thu và có thể kèm link Google Drive, Github PR hoặc link demo sản phẩm..." maxlength="1000"></textarea>
                    <div class="form-text small text-muted">Tối đa 1000 ký tự. Có thể đính kèm URL tài liệu hoặc link minh chứng.</div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-success rounded-0 fw-bold px-4" id="btnLuuThemTask" onclick="luuThemTask()" style="background-color: #1B5E36; border-color: #1B5E36;">
                    <i class="bi bi-save me-1"></i> Lưu đầu việc
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Đầu Việc -->
<div class="modal fade" id="modalSuaTask" tabindex="-1" aria-labelledby="modalSuaTaskLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary" id="modalSuaTaskLabel">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa đầu việc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="alertSuaTask" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>
                <input type="hidden" id="maTaskSua" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề đầu việc <span class="text-danger">*</span></label>
                    <input type="text" id="tenTaskSua" class="form-control rounded-0" maxlength="500" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mốc giai đoạn</label>
                        <select id="maGiaiDoanSua" class="form-select rounded-0">
                            <option value="">-- Toàn bộ dự án --</option>
                            @if (Model.giaiDoans != null && Model.giaiDoans.Count > 0)
                            {
                                @foreach (var gd in Model.giaiDoans)
                                {
                                    <option value="@gd.maGiaiDoan">@gd.tenGiaiDoan</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hạn hoàn thành <span class="text-danger">*</span></label>
                        <input type="date" id="hanHoanThanhSua" class="form-control rounded-0" max="@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")" />
                        <div class="form-text small text-muted">
                            Deadline hợp đồng: <strong class="text-danger">@(Model.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Trạng thái công việc <span class="text-danger">*</span></label>
                        <select id="trangThaiSua" class="form-select rounded-0">
                            <option value="ChuaThucHien">Chưa thực hiện</option>
                            <option value="DangThucHien">Đang thực hiện</option>
                            <option value="HoanThanh">Hoàn thành</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả công việc & Minh chứng / Đường dẫn tệp <span class="text-danger">*</span></label>
                    <textarea id="moTaSua" class="form-control rounded-0" rows="4" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary rounded-0 fw-bold px-4" id="btnLuuSuaTask" onclick="luuSuaTask()">
                    <i class="bi bi-save me-1"></i> Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const contractEndDateStr = '@(Model.ngayKetThuc?.ToString("yyyy-MM-dd") ?? "")';
        const maHDHienTai = '@Model.maHD';

        async function moFormDanhGia(maHD, maDanhGia) {
            const container = document.getElementById('danhGiaModalContainer');
            if (!container) return;
            try {
                const url = `/DanhGia/Form?maHD=${encodeURIComponent(maHD)}`;
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) throw new Error('Không thể tải biểu mẫu đánh giá.');
                container.innerHTML = await response.text();
                const modalElement = container.querySelector('.modal');
                if (!modalElement) throw new Error('Biểu mẫu đánh giá không hợp lệ.');
                if (maDanhGia) modalElement.dataset.maDanhGia = maDanhGia;
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            } catch (error) {
                alert(error.message || 'Không thể tải biểu mẫu đánh giá.');
            }
        }

        async function guiDanhGia(form, event) {
            event.preventDefault();
            const modalElement = form.closest('.modal');
            const tongSao = Number(form.querySelector('[name="soSaoTongThe"]').value);
            if (!tongSao) {
                const message = form.querySelector('[data-review-message]');
                if (message) {
                    message.textContent = 'Vui lòng chọn số sao đánh giá tổng thể.';
                    message.classList.remove('d-none');
                }
                return;
            }
            const payload = {
                maHD: form.querySelector('[name="maHD"]').value,
                soSaoTongThe: tongSao,
                soSaoChatLuong: Number(form.querySelector('[name="soSaoChatLuong"]').value) || null,
                soSaoDungHan: Number(form.querySelector('[name="soSaoDungHan"]').value) || null,
                soSaoGiaoTiep: Number(form.querySelector('[name="soSaoGiaoTiep"]').value) || null,
                nhanXet: form.querySelector('[name="nhanXet"]').value
            };
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const maDanhGia = modalElement.dataset.maDanhGia;
            const url = maDanhGia ? `/DanhGia/CapNhat?maDanhGia=${encodeURIComponent(maDanhGia)}` : '/DanhGia/Gui';
            const message = form.querySelector('[data-review-message]');
            const button = form.querySelector('[type="submit"]');
            button.disabled = true;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Không thể lưu đánh giá.');
                location.reload();
            } catch (error) {
                if (message) { message.textContent = error.message; message.classList.remove('d-none'); }
                button.disabled = false;
            }
        }

        document.addEventListener('click', event => {
            const starButton = event.target.closest('[data-rating-group][data-rating-value]');
            if (starButton) {
                const form = starButton.closest('form');
                const groupName = starButton.dataset.ratingGroup;
                const selectedValue = Number(starButton.dataset.ratingValue);
                const valueInput = form?.querySelector(`[name="${groupName}"]`);
                if (!valueInput) return;

                valueInput.value = selectedValue;
                form.querySelectorAll(`[data-rating-group="${groupName}"][data-rating-value]`).forEach(button => {
                    const value = Number(button.dataset.ratingValue);
                    const selected = value === selectedValue;
                    button.setAttribute('aria-checked', selected ? 'true' : 'false');
                    button.classList.toggle('text-warning', value <= selectedValue);
                    button.classList.toggle('text-secondary', value > selectedValue);
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-star-fill', value <= selectedValue);
                        icon.classList.toggle('bi-star', value > selectedValue);
                    }
                });

                const label = form.querySelector(`[data-rating-label="${groupName}"]`);
                if (label) label.textContent = `${selectedValue} trên 5`;
                return;
            }

            const clearButton = event.target.closest('[data-rating-clear]');
            if (clearButton) {
                const form = clearButton.closest('form');
                const groupName = clearButton.dataset.ratingClear;
                const valueInput = form?.querySelector(`[name="${groupName}"]`);
                if (!valueInput) return;
                valueInput.value = '';
                form.querySelectorAll(`[data-rating-group="${groupName}"][data-rating-value]`).forEach(button => {
                    button.setAttribute('aria-checked', 'false');
                    button.classList.remove('text-warning');
                    button.classList.add('text-secondary');
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('bi-star-fill');
                        icon.classList.add('bi-star');
                    }
                });
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const reviewContract = '@(TempData["MoPopupDanhGia"] as string ?? "")';
            if (reviewContract) moFormDanhGia(reviewContract);
        });

        function showAlert(alertId, message) {
            const alertEl = document.getElementById(alertId);
            if (alertEl) {
                alertEl.textContent = message;
                alertEl.classList.remove('d-none');
            }
        }

        function hideAlert(alertId) {
            const alertEl = document.getElementById(alertId);
            if (alertEl) {
                alertEl.classList.add('d-none');
                alertEl.textContent = '';
            }
        }

        async function luuThemTask() {
            hideAlert('alertThemTask');
            const tenTask = document.getElementById('tenTaskThem').value.trim();
            const moTa = document.getElementById('moTaThem').value.trim();
            const hanHoanThanh = document.getElementById('hanHoanThanhThem').value;
            const maGiaiDoanVal = document.getElementById('maGiaiDoanThem').value;

            if (!tenTask) {
                showAlert('alertThemTask', 'Tiêu đề đầu việc không được để trống.');
                return;
            }

            if (!moTa) {
                showAlert('alertThemTask', 'Mô tả công việc không được để trống.');
                return;
            }

            if (hanHoanThanh && contractEndDateStr) {
                if (hanHoanThanh > contractEndDateStr) {
                    showAlert('alertThemTask', 'Deadline của công việc phải trước hoặc trùng với hạn chót bàn giao của hợp đồng.');
                    return;
                }
            }

            const payload = {
                maHD: maHDHienTai,
                tenTask: tenTask,
                moTa: moTa,
                hanHoanThanh: hanHoanThanh ? hanHoanThanh : null,
                maGiaiDoan: maGiaiDoanVal ? parseInt(maGiaiDoanVal) : null
            };

            const btn = document.getElementById('btnLuuThemTask');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

            try {
                const res = await fetch('/HopDong/ThemTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    showAlert('alertThemTask', data.message || 'Có lỗi xảy ra khi thêm đầu việc.');
                }
            } catch (err) {
                showAlert('alertThemTask', 'Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-1"></i> Lưu đầu việc';
            }
        }

        function moModalSuaTask(maTask, tenTask, moTa, hanHoanThanh, trangThai, maGiaiDoan) {
            hideAlert('alertSuaTask');
            document.getElementById('maTaskSua').value = maTask;
            document.getElementById('tenTaskSua').value = tenTask;
            document.getElementById('moTaSua').value = moTa;
            document.getElementById('hanHoanThanhSua').value = hanHoanThanh;
            document.getElementById('trangThaiSua').value = trangThai;
            document.getElementById('maGiaiDoanSua').value = maGiaiDoan || '';

            const modalEl = document.getElementById('modalSuaTask');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function luuSuaTask() {
            hideAlert('alertSuaTask');
            const maTask = parseInt(document.getElementById('maTaskSua').value);
            const tenTask = document.getElementById('tenTaskSua').value.trim();
            const moTa = document.getElementById('moTaSua').value.trim();
            const hanHoanThanh = document.getElementById('hanHoanThanhSua').value;
            const trangThai = document.getElementById('trangThaiSua').value;
            const maGiaiDoanVal = document.getElementById('maGiaiDoanSua').value;

            if (!tenTask) {
                showAlert('alertSuaTask', 'Tiêu đề đầu việc không được để trống.');
                return;
            }

            if (!moTa) {
                showAlert('alertSuaTask', 'Mô tả công việc không được để trống.');
                return;
            }

            if (hanHoanThanh && contractEndDateStr) {
                if (hanHoanThanh > contractEndDateStr) {
                    showAlert('alertSuaTask', 'Deadline của công việc phải trước hoặc trùng với hạn chót bàn giao của hợp đồng.');
                    return;
                }
            }

            const payload = {
                maTask: maTask,
                maHD: maHDHienTai,
                tenTask: tenTask,
                moTa: moTa,
                hanHoanThanh: hanHoanThanh ? hanHoanThanh : null,
                trangThai: trangThai,
                maGiaiDoan: maGiaiDoanVal ? parseInt(maGiaiDoanVal) : null
            };

            const btn = document.getElementById('btnLuuSuaTask');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang cập nhật...';

            try {
                const res = await fetch('/HopDong/CapNhatTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    showAlert('alertSuaTask', data.message || 'Có lỗi xảy ra khi cập nhật.');
                }
            } catch (err) {
                showAlert('alertSuaTask', 'Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save me-1"></i> Cập nhật';
            }
        }

        async function doiTrangThaiTask(maTask, trangThai) {
            try {
                const payload = {
                    maTask: maTask,
                    trangThai: trangThai
                };

                const res = await fetch('/HopDong/CapNhatTrangThaiTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Không thể cập nhật trạng thái.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }

        async function xacNhanXoaTask(maTask, tenTask) {
            if (!confirm(`Bạn có chắc chắn muốn xóa đầu việc "${tenTask}" không?`)) {
                return;
            }

            try {
                const res = await fetch('/HopDong/XoaTask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(maTask)
                });

                const data = await res.json();
                if (data && data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Không thể xóa đầu việc.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            }
        }
    </script>
}
