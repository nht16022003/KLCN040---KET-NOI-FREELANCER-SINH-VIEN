
@model FreelancerStudent.Web.ViewModels.DanhSachHopDongViewModel

@{
    ViewData["Title"] = "Quản lý hợp đồng";

    var dsTrangThai = new Dictionary<string, string>
    {
        { "ChoKyKet", "Chờ ký kết" },
        { "ChoKyQuy", "Chờ ký quỹ" },
        { "DangThucHien", "Đang thực hiện" },
        { "DaHoanThanh", "Đã hoàn thành" },
        { "DaHuy", "Đã hủy" },
        { "DangTranhChap", "Đang tranh chấp" }
    };
}

<div class="container py-4">

    <h2 class="fw-bold mb-3">Quản lý hợp đồng</h2>

    <p class="text-muted">
        Danh sách các hợp đồng của Nhà tuyển dụng
    </p>

    <!-- Tìm kiếm và lọc -->
    <form asp-controller="HopDong"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-5">
            <label class="form-label">Tìm kiếm hợp đồng</label>

            <input type="text"
                   name="tuKhoa"
                   value="@Model.TuKhoa"
                   class="form-control"
                   placeholder="Mã hợp đồng hoặc tên Freelancer" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Trạng thái</label>

            <select name="trangThai" class="form-select">

                <option value="">Tất cả trạng thái</option>

                @foreach (var item in dsTrangThai)
                {
                    if (Model.TrangThai == item.Key)
                    {
                        <option value="@item.Key" selected>
                            @item.Value
                        </option>
                    }
                    else
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a asp-controller="HopDong"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Xóa lọc
            </a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Loi))
    {
        <div class="alert alert-danger">
            @Model.Loi
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Mã hợp đồng</th>
                            <th>Công việc</th>
                            <th>Freelancer</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Tiền ký quỹ</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.HopDongs.Count == 0)
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-4 text-muted">
                                    Không có hợp đồng phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var hd in Model.HopDongs)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @hd.maHD
                                    </td>

                                    <td>@hd.tenCongViec</td>

                                    <td>@hd.tenFreelancer</td>

                                    <td>
                                        @(hd.ngayBatDau?.ToString("dd/MM/yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(hd.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(hd.sotienkyquy?.ToString("N0") ?? "0") VNĐ
                                    </td>

                                    <td>
                                        @{
                                            var tenTrangThai =
                                                dsTrangThai.TryGetValue(
                                                    hd.trangThai, out var ten)
                                                    ? ten
                                                    : hd.trangThai;
                                        }

                                        <span class="badge bg-secondary">
                                            @tenTrangThai
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <p class="mt-3 text-muted">
            Tổng số: @Model.HopDongs.Count hợp đồng
        </p>
    }

</div>
