@model FreelancerStudent.Web.ViewModels.DanhSachHopDongViewModel

@{
    ViewData["Title"] = "Quản lý hợp đồng";

    var dsTrangThai = new Dictionary<string, string>
    {
        { "ChoXacNhan", "Chờ Freelancer xác nhận" },
        { "ChoKyKet", "Chờ ký kết" },
        { "ChoKyQuy", "Chờ ký quỹ" },
        { "DangThucHien", "Đang thực hiện" },
        { "DaHoanThanh", "Đã hoàn thành – chờ thanh toán" },
        { "DaThanhToan", "Đã thanh toán" },
        { "DaHuy", "Đã hủy" },
        { "DaHuyHoanTien", "Đã hủy – đã hoàn tiền" },
        { "DangTranhChap", "Đang tranh chấp" }
    };
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="fw-bold mb-3">Quản lý hợp đồng</h2>

    <p class="text-muted">
        @(Model.LaFreelancer ? "Danh sách các hợp đồng nhận việc của bạn" : "Danh sách các hợp đồng của Nhà tuyển dụng")
    </p>

    <!-- Tìm kiếm và lọc -->
    <form asp-controller="HopDong" asp-action="Index" method="get" class="row g-3 mb-4">

        <div class="col-md-5">
            <label class="form-label">Tìm kiếm hợp đồng</label>

            <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                   placeholder="@(Model.LaFreelancer ? "Mã hợp đồng, tên công việc hoặc Nhà tuyển dụng" : "Mã hợp đồng, tên công việc hoặc Freelancer")" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Trạng thái</label>

            <select name="trangThai" class="form-select">

                <option value="">Tất cả trạng thái</option>

                @foreach (var item in dsTrangThai)
                {
                    if (Model.TrangThai == item.Key)
                    {
                        <option value="@item.Key" selected>
                            @item.Value
                        </option>
                    }
                    else
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a asp-controller="HopDong" asp-action="Index" class="btn btn-outline-secondary">
                Xóa lọc
            </a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Loi))
    {
        <div class="alert alert-danger">
            @Model.Loi
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Mã hợp đồng</th>
                            <th>Công việc</th>
                            <th>@(Model.LaFreelancer ? "Nhà tuyển dụng" : "Freelancer")</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Tiền ký quỹ</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.HopDongs.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Không có hợp đồng phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var hd in Model.HopDongs)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@hd.maHD" class="text-decoration-none text-success">
                                            @hd.maHD
                                        </a>
                                    </td>

                                    <td>@hd.tenCongViec</td>

                                    <td>
                                        @if (Model.LaFreelancer)
                                        {
                                            @(!string.IsNullOrWhiteSpace(hd.tenNhaTuyenDung) ? hd.tenNhaTuyenDung : "Nhà tuyển dụng")
                                        }
                                        else
                                        {
                                            @(!string.IsNullOrWhiteSpace(hd.tenFreelancer) ? hd.tenFreelancer : "Freelancer")
                                        }
                                    </td>

                                    <td>
                                        @(hd.ngayBatDau?.ToString("dd/MM/yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(hd.ngayKetThuc?.ToString("dd/MM/yyyy") ?? "-")
                                    </td>

                                    <td>
                                        @(hd.sotienkyquy?.ToString("N0") ?? "0") VNĐ
                                    </td>

                                    <td>
                                        @{
                                            var tenTrangThai =
                                                dsTrangThai.TryGetValue(
                                                    hd.trangThai, out var ten)
                                                    ? ten
                                                    : hd.trangThai;

                                            var badgeClass = hd.trangThai switch
                                            {
                                                "ChoXacNhan" => "bg-warning text-dark",
                                                "ChoKyKet" => "bg-info text-dark",
                                                "ChoKyQuy" => "bg-primary",
                                                "DangThucHien" => "bg-success",
                                                "DaHoanThanh" => "bg-dark",
                                                "DaThanhToan" => "bg-success",
                                                "DaHuy" => "bg-danger",
                                                "DaHuyHoanTien" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <div class="d-flex align-items-center flex-wrap gap-2">
                                            <span class="badge @badgeClass rounded-0">
                                                @tenTrangThai
                                            </span>

                                            @if (!Model.LaFreelancer && hd.trangThai == "ChoKyQuy")
                                            {
                                                <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@hd.maHD"
                                                   class="btn btn-sm btn-primary rounded-0 fw-bold shadow-sm d-inline-flex align-items-center"
                                                   style="padding: 2px 8px; font-size: 0.78rem;"
                                                   title="Xem chi tiết và tiến hành ký quỹ cho hợp đồng này">
                                                    <i class="bi bi-wallet2 me-1"></i> Tiến hành ký quỹ
                                                </a>
                                            }
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        @if (!Model.LaFreelancer && hd.trangThai == "DaHoanThanh")
                                        {
                                            <a asp-controller="HopDong" asp-action="ThanhToan" asp-route-maHD="@hd.maHD" class="btn btn-sm btn-primary rounded-0 me-1">Thanh toán</a>
                                        }
                                        <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@hd.maHD"
                                           class="btn btn-sm btn-outline-success rounded-0">
                                            <i class="bi bi-file-earmark-text me-1"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <p class="mt-3 text-muted">
            Tổng số: @Model.HopDongs.Count hợp đồng
        </p>
    }

</div>