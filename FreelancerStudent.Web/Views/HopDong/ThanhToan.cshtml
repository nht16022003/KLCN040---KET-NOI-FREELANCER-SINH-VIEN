@model FreelancerStudent.Web.ViewModels.HopDongThanhToanViewModel
@{
    ViewData["Title"] = "Thanh toán hợp đồng";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="HopDong" asp-action="Index">Quản lý hợp đồng</a></li>
            <li class="breadcrumb-item"><a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@Model.maHD">@Model.maHD</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
        </ol>
    </nav>
    <h2 class="mb-4">Xác nhận thanh toán</h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@Model.tenCongViec</h5>
            <p class="text-muted">Freelancer: @Model.tenFreelancer · Hợp đồng @Model.maHD</p>
            @if (!Model.daCoDuLieuEscrow)
            {
                <div class="alert alert-warning">Không tìm thấy khoản ký quỹ hợp lệ. Vui lòng liên hệ hỗ trợ trước khi tiếp tục.</div>
            }
            <dl class="row mb-4">
                <dt class="col-sm-7">Tiền ký quỹ</dt><dd class="col-sm-5 text-end">@Model.sotienkyquy.ToString("N0") VNĐ</dd>
                <dt class="col-sm-7">Phí dịch vụ</dt><dd class="col-sm-5 text-end">@Model.soTienHoaHong.ToString("N0") VNĐ</dd>
                <dt class="col-sm-7 fw-bold">Freelancer nhận</dt><dd class="col-sm-5 text-end fw-bold">@Model.soTienFreelancerNhan.ToString("N0") VNĐ</dd>
                <dt class="col-sm-7">Số dư khả dụng</dt><dd class="col-sm-5 text-end">@Model.soDuKhaDung.ToString("N0") VNĐ</dd>
                <dt class="col-sm-7">Số dư đang đóng băng</dt><dd class="col-sm-5 text-end">@Model.soDuDongBang.ToString("N0") VNĐ</dd>
            </dl>
            <div class="alert alert-info">Xác nhận thanh toán sẽ giải ngân khoản ký quỹ theo thông tin trên và đóng hợp đồng. Giao dịch không thể hoàn tác.</div>
            <form asp-controller="HopDong" asp-action="XacNhanThanhToan" method="post" class="d-flex justify-content-end gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maHD" value="@Model.maHD" />
                <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@Model.maHD" class="btn btn-outline-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary" disabled="@(!Model.daCoDuLieuEscrow)">Xác nhận giải ngân</button>
            </form>
        </div>
    </div>
</div>
