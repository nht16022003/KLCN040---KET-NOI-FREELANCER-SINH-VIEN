@model FreelancerStudent.Web.ViewModels.AdminContractTemplateViewModel
@{
    ViewData["Title"] = "Quản lý Hợp đồng";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
   

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Thống kê chỉ số hợp đồng -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng hợp đồng</span>
                <div class="h4 fw-bold text-dark mb-0">@Model.DanhSachHopDongHeThong.Count</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Đang thực hiện</span>
                <div class="h4 fw-bold text-primary mb-0">@Model.DanhSachHopDongHeThong.Count(c => c.TrangThai == "DangThucHien" || c.TrangThai == "DANG_THUC_HIEN")</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Đã hoàn thành</span>
                <div class="h4 fw-bold text-success mb-0">@Model.DanhSachHopDongHeThong.Count(c => c.TrangThai == "DaHoanThanh" || c.TrangThai == "HoanThanh" || c.TrangThai == "HOAN_THANH")</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng tiền ký quỹ</span>
                <div class="h4 fw-bold text-dark mb-0">@Model.DanhSachHopDongHeThong.Sum(c => c.SoTienKyQuy).ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách hợp đồng hệ thống -->
    <div class="border bg-white p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
            <div>
                <h2 class="h6 fw-bold text-dark mb-0">Danh sách hợp đồng trên hệ thống</h2>
            </div>
            <div>
                <input type="text" id="filterContractInput" class="form-control form-control-sm" style="width: 280px;" placeholder="Tìm theo mã HĐ, tên sinh viên, NTD..." />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="contractsTable">
                <thead class="table-light text-muted small">
                    <tr>
                        <th style="width: 80px;">Mã HĐ</th>
                        <th>Công việc</th>
                        <th>Bên A (Nhà tuyển dụng)</th>
                        <th>Bên B (Freelancer)</th>
                        <th class="text-end" style="width: 140px;">Giá trị ký quỹ</th>
                        <th class="text-center" style="width: 110px;">Hình thức</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-center" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSachHopDongHeThong.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted small">Chưa có hợp đồng nào được giao kết trên hệ thống.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DanhSachHopDongHeThong)
                        {
                            var statusClass = item.TrangThai switch
                            {
                                "DaHoanThanh" or "HoanThanh" or "HOAN_THANH" => "badge bg-light text-success border border-success",
                                "DangThucHien" or "DANG_THUC_HIEN" => "badge bg-light text-primary border border-primary",
                                "DaHuy" or "DA_HUY" => "badge bg-light text-danger border border-danger",
                                _ => "badge bg-light text-warning border border-warning"
                            };
                            var statusText = item.TrangThai switch
                            {
                                "DaHoanThanh" or "HoanThanh" or "HOAN_THANH" => "Đã hoàn thành",
                                "DangThucHien" or "DANG_THUC_HIEN" => "Đang thực hiện",
                                "DaHuy" or "DA_HUY" => "Đã hủy",
                                _ => item.TrangThai
                            };

                            <tr>
                                <td class="small fw-bold text-dark">#@item.MaHD</td>
                                <td>
                                    <div class="fw-bold text-dark small text-truncate" style="max-width: 250px;" title="@item.TenCongViec">
                                        @item.TenCongViec
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        Bắt đầu: @(item.NgayBatDau?.ToString("dd/MM/yyyy") ?? "-")
                                    </div>
                                </td>
                                <td class="small">
                                    <div class="fw-semibold text-dark">@item.TenNhaTuyenDung</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Mã NTD: #@item.MaNhaTuyenDung</div>
                                </td>
                                <td class="small">
                                    <div class="fw-semibold text-dark">@item.TenFreelancer</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Mã SV: #@item.MaFreelancer</div>
                                </td>
                                <td class="small text-end fw-bold text-dark">
                                    @item.SoTienKyQuy.ToString("N0") đ
                                </td>
                                <td class="small text-center">
                                    <span class="badge bg-light text-secondary border">
                                        @(item.HinhThucLamViec ?? "Remote")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="@statusClass px-2 py-1 small">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="/Admin/ChiTietHopDong/@item.MaHD" class="btn btn-sm btn-outline-dark px-2 py-1">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Cấu hình mẫu điều khoản hợp đồng -->
    <div class="border bg-white p-3">
        <h2 class="h6 fw-bold text-dark mb-3 pb-2 border-bottom">Cấu hình mẫu điều khoản hợp đồng chuẩn</h2>

        <form method="post" asp-action="CapNhatMauHopDong">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark mb-1">Tiêu đề mẫu hợp đồng <span class="text-danger">*</span></label>
                    <input type="text" name="tieuDe" value="@Model.TenMauHopDong" class="form-control form-control-sm" required />
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold text-dark mb-1">Thời hạn nghiệm thu (Ngày) <span class="text-danger">*</span></label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="thoiHan" value="@Model.ThoiHanNghiemThuNgay" class="form-control" min="1" max="30" required />
                        <span class="input-group-text bg-light">Ngày</span>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold text-dark mb-1">Tỷ lệ giải ngân mặc định (%) <span class="text-danger">*</span></label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="tyLe" value="@Model.TyLeGiaiNganMacDinh" class="form-control" min="1" max="100" required />
                        <span class="input-group-text bg-light">%</span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold text-dark mb-1">Nội dung điều khoản tiêu chuẩn <span class="text-danger">*</span></label>
                    <textarea name="dieuKhoan" class="form-control form-control-sm font-monospace" rows="5" required>@Model.DieuKhoanChung</textarea>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-sm btn-dark px-4 py-2 fw-semibold">
                        Lưu mẫu hợp đồng
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('filterContractInput')?.addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#contractsTable tbody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
