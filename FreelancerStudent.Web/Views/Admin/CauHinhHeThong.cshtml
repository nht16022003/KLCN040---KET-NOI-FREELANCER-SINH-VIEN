@model FreelancerStudent.Web.ViewModels.AdminQuanLyCauHinhViewModel
@{
    ViewData["Title"] = "Cấu hình Phí sàn & Phí đăng tin";
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cấu hình Phí hệ thống</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">Cấu hình Phí sàn & Phí đăng tin</h3>
            <p class="text-muted small mb-0">Quản trị mức phí dịch vụ đăng tin tuyển dụng đối với Nhà tuyển dụng và tỷ lệ chiết khấu hoa hồng Escrow.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin" class="btn btn-outline-secondary btn-sm px-3">
                Tổng quan Dashboard
            </a>
            <a href="/Admin/DieuChinhSoDu" class="btn btn-outline-secondary btn-sm px-3">
                Quản lý ví & Số dư
            </a>
            <a href="/Admin/DuyetRutTien" class="btn btn-outline-secondary btn-sm px-3">
                Duyệt rút tiền
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Phí Đăng Tin Hiện Hành</span>
                <h3 class="fw-bold text-primary mt-2 mb-0">
                    @Model.FormCapNhat.PhiDangBai.ToString("N0") <small class="fs-6">VNĐ / tin</small>
                </h3>
                <div class="small text-muted mt-2 pt-2 border-top">
                    Trừ trực tiếp ví khả dụng NTD khi xuất bản bài đăng
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Tổng Thu Phí Đăng Tin</span>
                <h3 class="fw-bold text-success mt-2 mb-0">
                    @Model.TongDoanhThuPhiDangBai.ToString("N0") <small class="fs-6">VNĐ</small>
                </h3>
                <div class="small text-muted mt-2 pt-2 border-top">
                    Đã cộng dồn trực tiếp vào số dư ví Quản trị viên
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Phí Nền Tảng Hợp Đồng</span>
                <h3 class="fw-bold text-info mt-2 mb-0">
                    10% <small class="fs-6">giá trị hợp đồng</small>
                </h3>
                <div class="small text-muted mt-2 pt-2 border-top">
                    Khấu trừ tự động khi giải ngân Escrow cho Freelancer
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Form cập nhật phí đăng bài -->
        <div class="col-12 col-lg-5">
            <div class="card border rounded-3 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3">Điều chỉnh Mức Phí Đăng Tin</h5>
                <p class="text-muted small mb-4">
                    Thiết lập mức phí mà Nhà tuyển dụng phải chi trả khi xuất bản một tin tuyển dụng mới.
                </p>

                <form method="post" asp-action="CapNhatPhiDangBai">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">
                            Mức phí mới (VNĐ) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="FormCapNhat.PhiDangBai" type="number" min="0" step="5000" class="form-control" placeholder="Ví dụ: 50000" required />
                            <span class="input-group-text bg-light text-muted fw-semibold">VNĐ</span>
                        </div>
                        <span asp-validation-for="FormCapNhat.PhiDangBai" class="text-danger small"></span>
                        <div class="form-text small text-muted mt-1">
                            Nhập <code>0</code> nếu muốn tạm thời miễn phí đăng tin cho Nhà tuyển dụng.
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-4">
                        <div class="fw-semibold text-dark mb-1">
                            <i class="bi bi-info-circle me-1"></i>Quy tắc tài chính áp dụng:
                        </div>
                        <ul class="mb-0 ps-3">
                            <li>Mức phí mới sẽ áp dụng ngay cho các tin tuyển dụng được đăng sau thời điểm cập nhật.</li>
                            <li>Tin đăng trước thời điểm này giữ nguyên mức phí tại thời điểm xuất bản.</li>
                            <li>Số tiền thu phí sẽ được cộng thẳng vào <strong>Số dư khả dụng của ví Quản trị viên</strong>, hoàn toàn độc lập với tiền ký quỹ hợp đồng (Escrow).</li>
                        </ul>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        Lưu Cấu Hình Mức Phí Mới
                    </button>
                </form>
            </div>
        </div>

        <!-- Bảng danh sách cấu hình hệ thống -->
        <div class="col-12 col-lg-7">
            <div class="card border rounded-3 bg-white p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Danh sách Cấu hình Phí Hệ Thống</h5>
                    <span class="badge bg-light text-dark border">@Model.DanhSachCauHinh.Count cấu hình</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Tên Cấu Hình</th>
                                <th>Mức Áp Dụng</th>
                                <th>Hình Thức</th>
                                <th>Cập Nhật Lần Cuối</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DanhSachCauHinh.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted small">
                                        Chưa có cấu hình phí nào trong cơ sở dữ liệu.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ch in Model.DanhSachCauHinh)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">
                                                @(ch.TenCauHinh == "PhiDangBai" ? "Phí đăng tin tuyển dụng" : (ch.TenCauHinh == "HoaHongDuAn" ? "Hoa hồng hợp đồng Escrow" : ch.TenCauHinh))
                                            </div>
                                            <div class="small text-muted" style="max-width: 250px;">
                                                @(ch.MoTa ?? "Cấu hình chuẩn của nền tảng")
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-primary">
                                                @(ch.LoaiCauHinh == "PhanTram" ? $"{ch.GiaTri:N0}%" : $"{ch.GiaTri:N0} VNĐ")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">
                                                @(ch.LoaiCauHinh == "TienMat" ? "Tiền mặt (VNĐ)" : "Phần trăm (%)")
                                            </span>
                                        </td>
                                        <td class="small text-muted">
                                            @(ch.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm") ?? "Mặc định")
                                            @if (!string.IsNullOrEmpty(ch.TenAdmin))
                                            {
                                                <div class="text-dark">bởi @ch.TenAdmin</div>
                                            }
                                        </td>
                                        <td>
                                            @if (ch.HieuLuc)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    Đang áp dụng
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-white">
                                                    Tạm dừng
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

