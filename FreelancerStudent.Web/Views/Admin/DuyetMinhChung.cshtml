@model List<FreelancerStudent.Web.ViewModels.MinhChungItemViewModel>
@{
    ViewData["Title"] = "Phê duyệt Thẻ Sinh viên";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
    

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Thống kê nhanh hồ sơ chờ thẩm định -->
    <div class="border bg-white p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Hồ sơ chờ thẩm định</span>
            <div class="h5 fw-bold text-warning mb-0">@Model.Count minh chứng thẻ sinh viên</div>
        </div>
        <div class="small text-muted border bg-light p-2">
            Khi duyệt, dữ liệu thẻ sinh viên sẽ tự động cập nhật và khóa quyền chỉnh sửa trên hồ sơ sinh viên.
        </div>
    </div>

    <!-- Danh sách thẻ sinh viên chờ duyệt -->
    @if (!Model.Any())
    {
        <div class="border bg-white p-5 text-center">
            <div class="h5 fw-bold text-dark mb-1">Không có minh chứng nào chờ duyệt</div>
            <div class="text-muted small">Tất cả hồ sơ thẻ sinh viên đã được xử lý xong.</div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="border bg-white p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <span class="badge bg-light text-dark border me-2">#MC-@item.MaMinhChung</span>
                            <strong class="text-dark">Sinh viên: @(item.HoTenUserHienTai ?? "Mã User #" + item.MaUser)</strong>
                            <span class="text-muted small ms-2">(@item.EmailUserHienTai)</span>
                        </div>
                        <div class="small text-muted">
                            Ngày nộp: <strong>@item.NgayNop.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                    </div>

                    <form asp-action="XuLyMinhChung" method="post" id="form-approve-@item.MaMinhChung">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaMinhChung" value="@item.MaMinhChung" />
                        <input type="hidden" name="ChapNhan" value="true" id="chapNhan-@item.MaMinhChung" />
                        <input type="hidden" name="LyDoTuChoi" value="" id="lyDoTuChoi-@item.MaMinhChung" />

                        <div class="row g-3">
                            <!-- Ảnh thẻ sinh viên -->
                            <div class="col-12 col-lg-4 text-center">
                                <div class="border bg-light p-2 text-center h-100 d-flex flex-column justify-content-center align-items-center">
                                    @{
                                        var imgUrl = !string.IsNullOrWhiteSpace(item.FileMinhChung)
                                            ? (item.FileMinhChung.StartsWith("http")
                                                ? item.FileMinhChung
                                                : "http://localhost:5152/" + item.FileMinhChung.TrimStart('/', '\\'))
                                            : "/images/placeholder-id.png";
                                    }
                                    <a href="@imgUrl" target="_blank" title="Bấm xem ảnh kích thước gốc">
                                        <img src="@imgUrl" alt="Thẻ sinh viên"
                                             class="img-fluid border"
                                             style="max-height: 240px; object-fit: contain;"
                                             onerror="this.onerror=null; this.src='/images/placeholder-id.png';" />
                                    </a>
                                    <span class="small text-muted mt-2">Bấm vào ảnh để xem ảnh gốc</span>
                                </div>
                            </div>

                            <!-- Bảng đối chiếu & xác nhận thông tin -->
                            <div class="col-12 col-lg-8">
                                <div class="table-responsive mb-3">
                                    <table class="table table-bordered table-sm align-middle mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th style="width: 25%;">Trường dữ liệu</th>
                                               
                                                <th style="width: 40%;" class="text-success">Dữ liệu thẻ SV xác nhận</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="small fw-semibold">Họ và tên</td>
                                                
                                                <td>
                                                    <input type="text" name="HoVaTen" class="form-control form-control-sm text-success fw-semibold"
                                                           value="@(item.HoTenXacNhan ?? item.HoTenUserHienTai)" required />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="small fw-semibold">Mã số sinh viên (MSSV)</td>
                                               
                                                <td class="small fw-semibold text-primary">
                                                    @(item.MssvXacNhan ?? "Không phát hiện")
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="small fw-semibold">Trường học</td>
                                               
                                                <td>
                                                    <input type="text" name="TenTruong" class="form-control form-control-sm text-success fw-semibold"
                                                           value="@(item.TenTruongXacNhan ?? item.TenTruongHienTai)" required />
                                                    <input type="hidden" name="MaTruong" value="@item.MaTruongXacNhan" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="small fw-semibold">Chuyên ngành</td>
                                               
                                                <td>
                                                    <select name="MaChuyenNganh" class="form-select form-select-sm text-success fw-semibold">
                                                        <option value="KTPM" selected="@(item.MaChuyenNganhXacNhan == "KTPM")">Kỹ thuật phần mềm (KTPM)</option>
                                                        <option value="TKDH" selected="@(item.MaChuyenNganhXacNhan == "TKDH")">Thiết kế đồ họa (TKDH)</option>
                                                        <option value="CNTT" selected="@(item.MaChuyenNganhXacNhan == "CNTT")">Công nghệ thông tin (CNTT)</option>
                                                        <option value="MKT" selected="@(item.MaChuyenNganhXacNhan == "MKT")">Digital Marketing</option>
                                                        <option value="TMDT" selected="@(item.MaChuyenNganhXacNhan == "TMDT")">Thương mại điện tử</option>
                                                        @if (!string.IsNullOrEmpty(item.MaChuyenNganhXacNhan) && !new[] { "KTPM", "TKDH", "CNTT", "MKT", "TMDT" }.Contains(item.MaChuyenNganhXacNhan))
                                                        {
                                                            <option value="@item.MaChuyenNganhXacNhan" selected>@item.MaChuyenNganhXacNhan</option>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="small fw-semibold">Niên khóa & Năm thứ</td>
                                               
                                                <td>
                                                    <div class="row g-2">
                                                        <div class="col-7">
                                                            <input type="text" name="NienKhoa" class="form-control form-control-sm text-success fw-semibold"
                                                                   placeholder="VD: 2021-2025" value="@item.NienKhoaXacNhan" />
                                                        </div>
                                                        <div class="col-5">
                                                            <select name="NamThu" class="form-select form-select-sm text-success fw-semibold">
                                                                <option value="1" selected="@(item.NamThuXacNhan == 1)">Năm 1</option>
                                                                <option value="2" selected="@(item.NamThuXacNhan == 2)">Năm 2</option>
                                                                <option value="3" selected="@(item.NamThuXacNhan == 3)">Năm 3</option>
                                                                <option value="4" selected="@(item.NamThuXacNhan == 4)">Năm 4</option>
                                                                <option value="5" selected="@(item.NamThuXacNhan == 5)">Đã tốt nghiệp</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            @if (item.NgaySinhXacNhan.HasValue)
                                            {
                                                <tr>
                                                    <td class="small fw-semibold">Ngày sinh</td>
                                                    <td class="text-muted small">--</td>
                                                    <td>
                                                        <input type="date" name="NgaySinh" class="form-control form-control-sm text-success"
                                                               value="@item.NgaySinhXacNhan.Value.ToString("yyyy-MM-dd")" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-danger px-3"
                                            onclick="tuChoiMinhChung(@item.MaMinhChung)">
                                        Từ chối
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-success px-4 fw-semibold">
                                        Duyệt & Đồng bộ hồ sơ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
</div>

<!-- Modal nhập lý do từ chối -->
<div class="modal fade" id="modalTuChoi" tabindex="-1" aria-labelledby="modalTuChoiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border">
            <div class="modal-header border-bottom py-2">
                <h2 class="h6 modal-title fw-bold text-danger mb-0" id="modalTuChoiLabel">
                    Từ chối minh chứng thẻ sinh viên
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="currentRejectId" />
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark mb-1">Lý do từ chối <span class="text-danger">*</span></label>
                    <textarea id="lyDoTuChoiInput" class="form-control form-control-sm" rows="3"
                              placeholder="Ví dụ: Ảnh thẻ mờ không rõ họ tên hoặc thẻ sinh viên đã hết hạn..."></textarea>
                </div>
                <div class="small text-muted border bg-light p-2">
                    Lý do từ chối sẽ được gửi đến sinh viên để sinh viên chụp lại thẻ mới.
                </div>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-sm btn-danger px-3 fw-semibold" onclick="submitTuChoi()">
                    Xác nhận từ chối
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let rejectModal = null;
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById('modalTuChoi');
            if (modalEl) {
                rejectModal = new bootstrap.Modal(modalEl);
            }
        });

        function tuChoiMinhChung(id) {
            document.getElementById('currentRejectId').value = id;
            document.getElementById('lyDoTuChoiInput').value = '';
            if (rejectModal) {
                rejectModal.show();
            }
        }

        function submitTuChoi() {
            const id = document.getElementById('currentRejectId').value;
            const reason = document.getElementById('lyDoTuChoiInput').value.trim();
            if (!reason) {
                alert('Vui lòng nhập lý do từ chối minh chứng.');
                return;
            }

            const form = document.getElementById('form-approve-' + id);
            if (form) {
                document.getElementById('chapNhan-' + id).value = 'false';
                document.getElementById('lyDoTuChoi-' + id).value = reason;
                form.submit();
            }
        }
    </script>
}
