@model FreelancerStudent.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Quản trị Hệ thống";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Tiêu đề và thanh thao tác nhanh -->
    

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Khối chỉ số tổng quan (Stat Metrics) -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Người dùng hệ thống</span>
                <div class="h4 fw-bold text-dark mb-2">@Model.TongSoUser.ToString("N0")</div>
                <div class="small text-muted pt-2 border-top">
                    <span class="text-success fw-semibold">@Model.TongSoSinhVien Sinh viên</span> |
                    <span class="text-primary fw-semibold">@Model.TongSoNhaTuyenDung NTD</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng doanh thu hệ thống</span>
                <div class="h4 fw-bold text-success mb-2">@Model.TongDoanhThuHeThong.ToString("N0") <span class="fs-6 fw-normal text-muted">VNĐ</span></div>
                <div class="small text-muted pt-2 border-top d-flex justify-content-between">
                    <span>Hoa hồng HĐ: @((Model.TongDoanhThuHeThong - Model.TongDoanhThuPhiDangBai).ToString("N0")) đ</span>
                    <span>Phí đăng tin: @Model.TongDoanhThuPhiDangBai.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Bài đăng & Hợp đồng</span>
                <div class="h4 fw-bold text-dark mb-2">@Model.TongSoJob <span class="fs-6 fw-normal text-muted">tin tuyển</span></div>
                <div class="small text-muted pt-2 border-top">
                    <span>Tổng hợp đồng giao kết: <strong class="text-dark">@Model.TongSoHopDong</strong></span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="border bg-white p-3 h-100">
                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tiền ký quỹ</span>
                <div class="h4 fw-bold text-dark mb-2">@Model.TongTienDangKyQuy.ToString("N0") <span class="fs-6 fw-normal text-muted">VNĐ</span></div>
                <div class="small text-muted pt-2 border-top">
                    <span>Bảo chứng hợp đồng dịch vụ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bố cục 2 phần: Chức năng quản trị và Nhật ký giao dịch -->
    <div class="row g-3">
        <!-- Cột điều hướng chức năng quản trị -->
        <div class="col-12 col-lg-4">
            <div class="border bg-white p-3 h-100">
               

                <div class="mb-3">
                  
                    <div class="list-group list-group-flush border-top border-bottom">
                        <a href="/Admin/DanhSachNguoiDung" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Danh sách tài khoản người dùng</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                        <a href="/Admin/DuyetMinhChung" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-success">Phê duyệt thẻ sinh viên</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                        <a href="/Admin/XuLyTaiKhoan" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-danger">Khóa / Mở khóa tài khoản</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                    </div>
                     <div class="list-group list-group-flush border-top border-bottom">
                        <a href="/Admin/DuyetNapTien" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Duyệt yêu cầu nạp tiền</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                        <a href="/Admin/DuyetRutTien" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Duyệt yêu cầu rút tiền</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                        <a href="/Admin/DieuChinhSoDu" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Điều chỉnh số dư ví</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                    </div>
                    <div>
           
                    <div class="list-group list-group-flush border-top border-bottom">
                        <a href="/Admin/QuanLyHopDong" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Quản lý hợp đồng & mẫu điều khoản</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                        <a href="/Admin/CauHinhHeThong" class="list-group-item list-group-item-action py-2 px-1 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Cấu hình phí sàn & phí đăng tin</span>
                            <span class="small text-muted">&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>
                </div>

               

                
        </div>

        <!-- Cột nhật ký giao dịch ví -->
        <div class="col-12 col-lg-8">
            <div class="border bg-white p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h2 class="h6 fw-bold text-dark mb-0">Nhật ký giao dịch ví gần nhất</h2>
                    <a href="/Admin/DieuChinhSoDu" class="text-decoration-none small fw-semibold text-success">Quản lý ví &rarr;</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th style="width: 80px;">Mã GD</th>
                                <th style="width: 90px;">Ví</th>
                                <th>Loại giao dịch</th>
                                <th>Số tiền</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.GiaoDichMoiNhat != null && Model.GiaoDichMoiNhat.Any())
                            {
                                @foreach (var gd in Model.GiaoDichMoiNhat)
                                {
                                    <tr>
                                        <td class="small fw-bold text-dark">#@gd.MaGiaoDich</td>
                                        <td class="small text-muted">Ví #@gd.MaWallet</td>
                                        <td class="small">
                                            <span class="badge bg-light text-dark border">@gd.LoaiGiaoDich</span>
                                            @if (!string.IsNullOrEmpty(gd.NoiDung))
                                            {
                                                <div class="text-muted" style="font-size: 0.75rem;">@gd.NoiDung</div>
                                            }
                                        </td>
                                        <td class="small fw-bold @(gd.SoTien >= 0 ? "text-success" : "text-danger")">
                                            @gd.SoTien.ToString("+#,##0;-#,##0;0") VNĐ
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-success border border-success small">@(gd.TrangThai ?? "Thành công")</span>
                                        </td>
                                        <td class="text-muted small">@(gd.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4 small">Chưa có giao dịch nào được ghi nhận trong cơ sở dữ liệu.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
