@model FreelancerStudent.Web.ViewModels.AdminHopDongItemViewModel
@{
    ViewData["Title"] = $"Chi tiết hợp đồng #{Model.MaHD}";
    var totalAmount = Model.SoTienKyQuy;
    var platformFee = totalAmount * 0.05m;
    var netFreelancer = totalAmount - platformFee;

    var statusBadgeClass = Model.TrangThai switch
    {
        "DaHoanThanh" or "HoanThanh" or "HOAN_THANH" => "bg-success-subtle text-success border border-success-subtle",
        "DangThucHien" or "DANG_THUC_HIEN" => "bg-primary-subtle text-primary border border-primary-subtle",
        "DaHuy" or "DA_HUY" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-warning-subtle text-warning border border-warning-subtle"
    };

    var statusText = Model.TrangThai switch
    {
        "DaHoanThanh" or "HoanThanh" or "HOAN_THANH" => "Đã hoàn thành",
        "DangThucHien" or "DANG_THUC_HIEN" => "Đang thực hiện",
        "DaHuy" or "DA_HUY" => "Đã hủy bỏ",
        _ => Model.TrangThai
    };
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Breadcrumb & Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/QuanLyHopDong" class="text-decoration-none text-muted">Quản lý hợp đồng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">HĐ #@Model.MaHD</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">Hồ sơ hợp đồng dịch vụ: #@Model.MaHD</h3>
            <p class="text-muted small mb-0">Giám sát pháp lý, tài chính ký quỹ và tiến độ giữa Nhà tuyển dụng và Freelancer Sinh viên.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="/Admin/QuanLyHopDong" class="btn btn-outline-secondary btn-sm px-3">
                Danh sách hợp đồng
            </a>
            <a href="/Admin/DieuChinhSoDu" class="btn btn-outline-secondary btn-sm px-3">
                Điều chỉnh ví
            </a>
        </div>
    </div>

    <!-- Top Banner Card -->
    <div class="card border rounded-3 bg-white p-4 mb-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge @statusBadgeClass px-3 py-1 fw-bold">
                        @statusText
                    </span>
                    <span class="badge bg-light text-secondary border">Hình thức: @(Model.HinhThucLamViec ?? "Remote")</span>
                    <span class="badge bg-light text-secondary border">Mã HĐ: #@Model.MaHD</span>
                </div>
                <h4 class="fw-bold text-dark mb-2">@Model.TenCongViec</h4>
                <div class="d-flex flex-wrap gap-4 text-muted small">
                    <div>Ngày bắt đầu: <strong>@(Model.NgayBatDau?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                    <div>Hạn hoàn thành: <strong>@(Model.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                    <div>Mã bài đăng: <strong>#@Model.MaJob</strong></div>
                </div>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="p-3 bg-light rounded-3 border text-lg-end text-start">
                    <span class="text-muted small fw-semibold text-uppercase d-block">Tổng giá trị hợp đồng</span>
                    <h3 class="fw-bold text-dark mb-1">@totalAmount.ToString("N0") <small class="fs-6 fw-normal text-muted">VNĐ</small></h3>
                    <div class="badge bg-success-subtle text-success border border-success-subtle">
                        Ký quỹ bảo chứng 100%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Bên A: Nhà tuyển dụng -->
        <div class="col-12 col-lg-6">
            <div class="card border rounded-3 bg-white p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">Bên thuê (Nhà tuyển dụng)</h5>
                    <span class="badge bg-light text-dark border">Bên A</span>
                </div>
                <div class="mb-3">
                    <h6 class="fw-bold text-dark mb-1">@Model.TenNhaTuyenDung</h6>
                    <div class="text-muted small">Mã đối tác: #@Model.MaNhaTuyenDung</div>
                </div>
                <div class="p-3 bg-light rounded-3 small">
                    <div class="text-muted mb-1 fw-semibold">Nghĩa vụ Bên A:</div>
                    <ul class="mb-0 ps-3 text-secondary">
                        <li>Ký quỹ đủ 100% kinh phí hợp đồng vào tài khoản ký quỹ trung gian.</li>
                        <li>Cung cấp đầy đủ yêu cầu dự án, tài liệu và môi trường thử nghiệm.</li>
                        <li>Nghiệm thu và phản hồi kết quả bàn giao theo thời hạn thỏa thuận.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Bên B: Freelancer Sinh viên -->
        <div class="col-12 col-lg-6">
            <div class="card border rounded-3 bg-white p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">Bên nhận việc (Freelancer sinh viên)</h5>
                    <span class="badge bg-light text-dark border">Bên B</span>
                </div>
                <div class="mb-3">
                    <h6 class="fw-bold text-dark mb-1">@Model.TenFreelancer</h6>
                    <div class="text-muted small">Mã Freelancer: #@Model.MaFreelancer</div>
                </div>
                <div class="p-3 bg-light rounded-3 small">
                    <div class="text-muted mb-1 fw-semibold">Nghĩa vụ Bên B:</div>
                    <ul class="mb-0 ps-3 text-secondary">
                        <li>Cam kết triển khai đúng tiến độ và tiêu chuẩn kỹ thuật thỏa thuận.</li>
                        <li>Bàn giao toàn bộ mã nguồn, tài liệu hướng dẫn và sản phẩm hoàn chỉnh.</li>
                        <li>Bảo hành và khắc phục lỗi phát sinh theo yêu cầu nghiệm thu hợp lý.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Breakdown & Escrow -->
    <div class="card border rounded-3 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">Hạch toán tài chính ký quỹ</h5>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="p-3 border rounded-3 bg-light text-center">
                    <span class="small text-muted d-block mb-1">Số tiền ký quỹ Bên A</span>
                    <h5 class="fw-bold text-dark mb-0">@totalAmount.ToString("N0") VNĐ</h5>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 border rounded-3 bg-light text-center">
                    <span class="small text-muted d-block mb-1">Phí sàn dịch vụ (5%)</span>
                    <h5 class="fw-bold text-dark mb-0">@platformFee.ToString("N0") VNĐ</h5>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 border rounded-3 bg-light text-center">
                    <span class="small text-muted d-block mb-1">Thực nhận Bên B (Dự kiến)</span>
                    <h5 class="fw-bold text-success mb-0">@netFreelancer.ToString("N0") VNĐ</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Contract Terms / Điều khoản -->
    <div class="card border rounded-3 bg-white p-4">
        <h5 class="fw-bold text-dark mb-3">Toàn văn điều khoản hợp đồng</h5>
        <div class="p-4 bg-light rounded-3 border font-monospace small text-dark" style="white-space: pre-line; line-height: 1.7;">
            @(string.IsNullOrWhiteSpace(Model.DieuKhoan) 
                ? "Hai bên thỏa thuận tuân thủ các quy định về quyền tác giả, bảo mật thông tin dự án, bàn giao đúng hạn và tiến hành giải ngân qua ví trung gian của hệ thống Freelancer Students."
                : Model.DieuKhoan)
        </div>
    </div>
</div>
