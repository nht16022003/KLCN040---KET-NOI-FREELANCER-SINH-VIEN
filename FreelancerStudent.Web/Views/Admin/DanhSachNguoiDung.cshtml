@model FreelancerStudent.Web.ViewModels.AdminUserManagementViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Tiêu đề và thao tác nhanh -->
    

    <!-- Thanh tìm kiếm & bộ lọc -->
    <div class="border bg-white p-3 mb-3">
        <form method="get" asp-action="DanhSachNguoiDung" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Từ khóa tìm kiếm</label>
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Họ tên, email, tài khoản hoặc SĐT..." />
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Vai trò người dùng</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="1" selected="@(Model.SelectedRole == 1)">Sinh viên Freelancer</option>
                    <option value="2" selected="@(Model.SelectedRole == 2)">Nhà tuyển dụng</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái tài khoản</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="ACTIVE" selected="@(Model.SelectedStatus == "ACTIVE")">Đang hoạt động (ACTIVE)</option>
                    <option value="LOCKED" selected="@(Model.SelectedStatus == "LOCKED")">Đã khóa (LOCKED)</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Lọc</button>
                <a href="/Admin/DanhSachNguoiDung" class="btn btn-sm btn-outline-secondary text-nowrap">Đặt lại</a>
            </div>
        </form>

        <div class="d-flex flex-wrap gap-3 text-muted small pt-2 mt-2 border-top">
            <span>Tổng số: <strong class="text-dark">@Model.TongSoNguoiDung</strong></span>
            <span>Sinh viên: <strong class="text-success">@Model.SoSinhVien</strong></span>
            <span>Nhà tuyển dụng: <strong class="text-primary">@Model.SoNhaTuyenDung</strong></span>
            <span>Bị khóa: <strong class="text-danger">@Model.SoBiKhoa</strong></span>
        </div>
    </div>

    <!-- Bảng danh sách người dùng -->
    <div class="border bg-white p-3">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Họ tên & Tài khoản</th>
                        <th style="width: 140px;">Vai trò</th>
                        <th>Thông tin liên hệ</th>
                        <th>Trường học / Doanh nghiệp</th>
                        <th style="width: 130px;">Số dư ví</th>
                        <th style="width: 120px;">Trạng thái</th>
                        <th class="text-end" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted small">
                                Không tìm thấy tài khoản người dùng nào khớp với tiêu chí tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="small fw-bold text-dark">@u.MaUser</td>
                                <td>
                                    <div class="fw-bold text-dark small">@u.HotenUser</div>
                                    <div class="text-muted small">@@@u.TenTaiKhoanUser</div>
                                </td>
                                <td>
                                    @if (u.MaRole == 1)
                                    {
                                        <span class="badge  text-success ">Sinh viên</span>
                                    }
                                    else if (u.MaRole == 2)
                                    {
                                        <span class="badge  text-primary ">Nhà tuyển dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-warning small">Quản trị</span>
                                    }
                                </td>
                                <td class="small">
                                    <div class="text-dark">@u.EmailUser</div>
                                    <div class="text-muted">@(u.SdtUser ?? "Chưa có SĐT")</div>
                                </td>
                                <td class="small text-muted">
                                    @(u.ThongTinPhu ?? "-")
                                </td>
                                <td class="small fw-bold text-dark">
                                    @u.SoDuVi.ToString("N0") đ
                                </td>
                                <td>
                                    @if (u.Status == "ACTIVE" || u.Status == "HoatDong")
                                    {
                                        <span class="badge  text-success ">Hoạt động</span>
                                    }
                                    else if (u.Status == "LOCKED" || u.Status == "BiKhoa")
                                    {
                                        <span class="badge text-danger ">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-warning border border-warning small">@(u.Status)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Admin/XuLyTaiKhoan?maUser=@u.MaUser" class="btn btn-sm btn-outline-danger py-1 px-2" title="Khóa hoặc mở khóa tài khoản">
                                        Khóa/Mở
                                    </a>
                                    <a href="/Admin/DieuChinhSoDu" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Điều chỉnh số dư ví">
                                        Ví
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
