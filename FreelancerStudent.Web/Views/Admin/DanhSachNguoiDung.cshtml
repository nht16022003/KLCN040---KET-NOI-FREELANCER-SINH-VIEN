@model FreelancerStudent.Web.ViewModels.AdminUserManagementViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container-fluid px-lg-5 py-4" style="background-color: #F8FAFC; min-height: 85vh;">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quản lý Người dùng</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">Quản lý Tài khoản & Hồ sơ Người dùng</h3>
            <p class="text-muted small mb-0">Tra cứu, phân loại, kiểm tra số dư ví và quản lý trạng thái tài khoản sinh viên và nhà tuyển dụng.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="/Admin/DuyetRutTien" class="btn btn-outline-warning btn-sm rounded-pill px-3 text-dark fw-semibold">
                Duyệt rút tiền
            </a>
            <a href="/Admin/XuLyTaiKhoan" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                Khóa và mở tài khoản
            </a>
            <a href="/Admin/DieuChinhSoDu" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                Điều chỉnh số dư ví
            </a>
        </div>
    </div>

    <!-- Filter & Statistics Bar -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4 mb-4">
        <form method="get" asp-action="DanhSachNguoiDung" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted">Tìm kiếm theo tên / email / SĐT</label>
                <input type="text" name="keyword" value="@Model.Keyword" class="form-control bg-light" placeholder="Nhập tên, email hoặc tài khoản..." />
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted">Loại người dùng</label>
                <select name="role" class="form-select bg-light">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="1" selected="@(Model.SelectedRole == 1)">Freelancer Sinh viên</option>
                    <option value="2" selected="@(Model.SelectedRole == 2)">Nhà tuyển dụng</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted">Trạng thái tài khoản</label>
                <select name="status" class="form-select bg-light">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="ACTIVE" selected="@(Model.SelectedStatus == "ACTIVE")">Đang hoạt động (ACTIVE)</option>
                    <option value="LOCKED" selected="@(Model.SelectedStatus == "LOCKED")">Đã khóa (LOCKED)</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100 rounded-3">
                    Lọc dữ liệu
                </button>
                <a href="/Admin/DanhSachNguoiDung" class="btn btn-light border rounded-3 text-nowrap" title="Đặt lại">
                    Đặt lại
                </a>
            </div>
        </form>

        <hr class="my-3 text-muted opacity-25" />

        <div class="d-flex flex-wrap gap-3 text-muted small">
            <div>Tổng số: <span class="badge bg-secondary">@Model.TongSoNguoiDung</span></div>
            <div>Sinh viên: <span class="badge bg-light text-success border border-success">@Model.SoSinhVien</span></div>
            <div>Nhà tuyển dụng: <span class="badge bg-light text-primary border border-primary">@Model.SoNhaTuyenDung</span></div>
            <div>Bị khóa: <span class="badge bg-light text-danger border border-danger">@Model.SoBiKhoa</span></div>
        </div>
    </div>

    <!-- User Table List -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>ID</th>
                        <th>Họ tên & Tài khoản</th>
                        <th>Vai trò</th>
                        <th>Thông tin liên hệ</th>
                        <th>Đơn vị / ĐH</th>
                        <th>Số dư ví</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Không tìm thấy tài khoản người dùng nào khớp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td class="fw-bold text-dark small">#@u.MaUser</td>
                                <td>
                                    <div class="fw-bold text-dark small">@u.HotenUser</div>
                                    <div class="text-muted small">@@@u.TenTaiKhoanUser</div>
                                </td>
                                <td>
                                    @if (u.MaRole == 1)
                                    {
                                        <span class="badge bg-light text-success border border-success small">
                                            Sinh viên
                                        </span>
                                    }
                                    else if (u.MaRole == 2)
                                    {
                                        <span class="badge bg-light text-primary border border-primary small">
                                            Nhà tuyển dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark small">
                                            Quản trị
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark">@u.EmailUser</div>
                                    <div class="small text-muted">@(u.SdtUser ?? "Chưa có SĐT")</div>
                                </td>
                                <td>
                                    <span class="small text-dark">@(u.ThongTinPhu ?? "N/A")</span>
                                </td>
                                <td class="fw-bold text-dark small">
                                    @u.SoDuVi.ToString("N0") VNĐ
                                </td>
                                <td>
                                    @if (u.Status == "ACTIVE" || u.Status == "HoatDong")
                                    {
                                        <span class="badge bg-light text-success border border-success small">Hoạt động</span>
                                    }
                                    else if (u.Status == "LOCKED" || u.Status == "BiKhoa")
                                    {
                                        <span class="badge bg-light text-danger border border-danger small">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-warning border border-warning small">@(u.Status)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Admin/XuLyTaiKhoan?maUser=@u.MaUser" class="btn btn-sm btn-outline-danger me-1">
                                        Khóa/Mở
                                    </a>
                                    <a href="/Admin/DieuChinhSoDu" class="btn btn-sm btn-outline-secondary">
                                        Sửa ví
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
