@model FreelancerStudent.Web.ViewModels.AdminBalanceAdjustmentViewModel
@{
    ViewData["Title"] = "Điều chỉnh Số dư Ví";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
    

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Bố cục 2 cột: Biểu mẫu tạo lệnh và Lịch sử điều chỉnh -->
    <div class="row g-3">
        <!-- Cột trái: Form điều chỉnh -->
        <div class="col-12 col-lg-5">
            <div class="border bg-white p-3 h-100">
                <h2 class="h6 fw-bold text-dark mb-3 pb-2 border-bottom">Tạo lệnh điều chỉnh số dư</h2>

                <form method="post" asp-action="DieuChinhSoDu">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Chọn ví người dùng <span class="text-danger">*</span></label>
                        <select asp-for="FormModel.MaWallet" class="form-select form-select-sm">
                            @foreach (var w in Model.Wallets)
                            {
                                <option value="@w.MaWallet">
                                    [Ví #@w.MaWallet] @w.TenChuVi (@w.RoleName) - Số dư: @w.SoDuKhaDung.ToString("N0") đ
                                </option>
                            }
                        </select>
                        <span asp-validation-for="FormModel.MaWallet" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Loại điều chỉnh <span class="text-danger">*</span></label>
                        <div class="d-flex gap-4 pt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="FormModel.LoaiDieuChinh" id="typeAdd" value="CongTien" checked />
                                <label class="form-check-label text-success fw-semibold small" for="typeAdd">
                                    Cộng tiền (Tăng số dư)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="FormModel.LoaiDieuChinh" id="typeSub" value="TruTien" />
                                <label class="form-check-label text-danger fw-semibold small" for="typeSub">
                                    Trừ tiền (Giảm số dư)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Số tiền điều chỉnh (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <input type="number" asp-for="FormModel.SoTien" class="form-control" step="1000" min="1000" />
                            <span class="input-group-text bg-light">VNĐ</span>
                        </div>
                        <span asp-validation-for="FormModel.SoTien" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Lý do điều chỉnh (Kiểm toán) <span class="text-danger">*</span></label>
                        <textarea asp-for="FormModel.LyDo" class="form-control form-control-sm" rows="3" placeholder="Nhập căn cứ xử lý bồi hoàn, đối soát hoặc bù trừ số dư..."></textarea>
                        <span asp-validation-for="FormModel.LyDo" class="text-danger small"></span>
                    </div>

                    

                    <button type="submit" class="btn btn-sm btn-dark w-100 py-2 fw-semibold" onclick="return confirm('Xác nhận thực hiện lệnh điều chỉnh số dư này?');">
                        Xác nhận điều chỉnh số dư
                    </button>
                </form>
            </div>
        </div>

        <!-- Cột phải: Lịch sử điều chỉnh -->
        <div class="col-12 col-lg-7">
            <div class="border bg-white p-3 h-100">
                <h2 class="h6 fw-bold text-dark mb-3 pb-2 border-bottom">Nhật ký điều chỉnh số dư ví</h2>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th style="width: 60px;">Mã</th>
                                <th style="width: 80px;">Ví</th>
                                <th style="width: 100px;">Loại</th>
                                <th>Số tiền</th>
                                <th>Biến động số dư</th>
                                <th>Lý do</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.LichSuDieuChinhs.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted small">Chưa có lịch sử điều chỉnh số dư nào trong hệ thống.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var dc in Model.LichSuDieuChinhs)
                                {
                                    <tr>
                                        <td class="small fw-bold text-dark">#@dc.MaDieuChinh</td>
                                        <td class="small text-muted">Ví #@dc.MaWallet</td>
                                        <td>
                                            @if (dc.LoaiDieuChinh == "CongTien")
                                            {
                                                <span class="badge bg-light text-success border border-success small">+ Cộng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-danger border border-danger small">- Trừ</span>
                                            }
                                        </td>
                                        <td class="small fw-bold @(dc.LoaiDieuChinh == "CongTien" ? "text-success" : "text-danger")">
                                            @dc.SoTienDieuChinh.ToString("N0") đ
                                        </td>
                                        <td class="small text-muted font-monospace">
                                            @dc.SoDuTruoc.ToString("N0") &rarr; @dc.SoDuSau.ToString("N0")
                                        </td>
                                        <td class="small text-dark" style="max-width: 180px;">
                                            @dc.LyDo
                                        </td>
                                        <td class="small text-muted">@dc.NgayDieuChinh.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
