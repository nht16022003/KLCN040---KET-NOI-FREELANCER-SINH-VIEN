@model FreelancerStudent.Web.ViewModels.AdminAccountStatusViewModel
@{
    ViewData["Title"] = "Khóa và Mở khóa Tài khoản";
}

<div class="container-fluid px-3 px-md-4 py-3" style="background-color: #F8FAFC; min-height: 85vh;">
    

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2 px-3 small" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Bố cục 2 cột: Biểu mẫu xử lý và Nhật ký kiểm toán -->
    <div class="row g-3">
        <!-- Cột trái: Biểu mẫu thực thi -->
        <div class="col-12 col-lg-5">
            <div class="border bg-white p-3 h-100">
                

                <form method="post" asp-action="XuLyTaiKhoan">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Tài khoản cần xử lý <span class="text-danger">*</span></label>
                        <select asp-for="XuLyModel.MaUser" class="form-select form-select-sm">
                            @foreach (var u in Model.DanhSachTaiKhoan)
                            {
                                <option value="@u.MaUser">
                                    [#@u.MaUser] @u.HotenUser (@(u.MaRole == 1 ? "Sinh viên" : u.MaRole == 2 ? "Nhà tuyển dụng" : "Quản trị")) - Trạng thái: @u.Status
                                </option>
                            }
                        </select>
                        <span asp-validation-for="XuLyModel.MaUser" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Hành động áp dụng <span class="text-danger">*</span></label>
                        <div class="d-flex gap-3 pt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="XuLyModel.HanhDong" id="actLock" value="KHOA_TAI_KHOAN" checked />
                                <label class="form-check-label text-danger fw-semibold small" for="actLock">
                                    Khóa tài khoản
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="XuLyModel.HanhDong" id="actUnlock" value="MO_KHOA_TAI_KHOAN" />
                                <label class="form-check-label text-success fw-semibold small" for="actUnlock">
                                    Mở khóa tài khoản
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Lý do xử lý  <span class="text-danger">*</span></label>
                        <textarea asp-for="XuLyModel.LyDo" class="form-control form-control-sm" rows="3" placeholder="Nhập căn cứ vi phạm hoặc lý do khôi phục hoạt động tài khoản..."></textarea>
                        <span asp-validation-for="XuLyModel.LyDo" class="text-danger small"></span>
                    </div>

                    <div class="border bg-light p-2 mb-3 small text-muted">
                        Tài khoản sẽ bị khóa .
                    </div>

                    <button type="submit" class="btn btn-sm btn-danger w-100 py-2 fw-semibold">
                        Xác nhận thực hiện
                    </button>
                </form>
            </div>
        </div>

        <!-- Cột phải: Lịch sử xử lý -->
        <div class="col-12 col-lg-7">
            <div class="border bg-white p-3 h-100">
                <h2 class="h6 fw-bold text-dark mb-3 pb-2 border-bottom">Nhật ký xử lý tài khoản</h2>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th style="width: 70px;">Mã LS</th>
                                <th>Người dùng</th>
                                <th style="width: 100px;">Hành động</th>
                                <th>Lý do</th>
                                <th>Quản trị viên</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.LichSuXuLys.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted small">Chưa có lịch sử xử lý tài khoản nào trong hệ thống.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ls in Model.LichSuXuLys)
                                {
                                    <tr>
                                        <td class="small fw-bold text-dark">#@ls.MaLichSu</td>
                                        <td class="small">
                                            <span class="fw-bold">#@ls.MaUser</span> @(string.IsNullOrWhiteSpace(ls.TenUser) ? "" : $"({ls.TenUser})")
                                        </td>
                                        <td>
                                            @if (ls.HanhDong == "KHOA_TAI_KHOAN")
                                            {
                                                <span class="badge bg-light text-danger border border-danger small">Khóa TK</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-success border border-success small">Mở khóa</span>
                                            }
                                        </td>
                                        <td class="small text-dark" style="max-width: 200px;">
                                            @ls.LyDo
                                        </td>
                                        <td class="small text-muted">@(string.IsNullOrWhiteSpace(ls.TenAdmin) ? $"Admin #{ls.MaAdmin}" : ls.TenAdmin)</td>
                                        <td class="small text-muted">@ls.NgayXuLy.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
