@{
    ViewData["Title"] = "Giới thiệu tổng quan nền tảng - Freelancer Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var maUser = Context.Session.GetInt32("maUser");
    var tenRole = Context.Session.GetString("tenRole");
    var userName = Context.Session.GetString("hovaten");
}

<style>
    :root {
        --overview-green: #3B6E53;
        --overview-green-dark: #2A523E;
        --overview-green-light: #EBF4F0;
        --overview-border: #E2E8F0;
        --overview-card-bg: #FFFFFF;
        --overview-bg: #FAFCFB;
        --overview-heading: #1E293B;
        --overview-text: #64748B;
    }

    .overview-wrapper {
        background-color: var(--overview-bg);
        color: var(--overview-heading);
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* SECTION PADDING & TITLES */
    .overview-section {
        padding: 64px 0;
        border-bottom: 1px solid var(--overview-border);
    }

    .overview-section-alt {
        background-color: #FFFFFF;
    }

    .section-badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--overview-green);
        background-color: var(--overview-green-light);
        padding: 5px 14px;
        margin-bottom: 12px;
        border: 1px solid #D1E5DB;
    }

    .section-title {
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--overview-heading);
        letter-spacing: -0.5px;
        margin-bottom: 14px;
    }

    .section-desc {
        color: var(--overview-text);
        font-size: 1.02rem;
        line-height: 1.65;
        max-width: 720px;
        margin: 0 auto 36px;
    }

    /* HERO SECTION */
    .hero-box {
        padding: 70px 0 60px;
        background: linear-gradient(180deg, #FFFFFF 0%, #F4F8F5 100%);
        border-bottom: 1px solid var(--overview-border);
    }

    .hero-title {
        font-size: 2.75rem;
        font-weight: 800;
        color: #0F172A;
        line-height: 1.25;
        letter-spacing: -1px;
        margin-bottom: 20px;
    }

    .hero-title span {
        color: var(--overview-green);
    }

    .hero-desc {
        font-size: 1.15rem;
        color: #475569;
        line-height: 1.7;
        margin-bottom: 32px;
        max-width: 780px;
    }

    .btn-hero-primary {
        background-color: var(--overview-green);
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 13px 30px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: 1px solid var(--overview-green);
        box-shadow: 0 4px 14px rgba(59, 110, 83, 0.25);
    }

    .btn-hero-primary:hover {
        background-color: var(--overview-green-dark);
        border-color: var(--overview-green-dark);
        transform: translateY(-2px);
    }

    .btn-hero-secondary {
        background-color: #FFFFFF;
        color: #1E293B !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 13px 30px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: 1px solid #CBD5E1;
    }

    .btn-hero-secondary:hover {
        background-color: var(--overview-green-light);
        border-color: var(--overview-green);
        color: var(--overview-green) !important;
        transform: translateY(-2px);
    }

    /* STATS & HIGHLIGHT CHIPS */
    .hero-highlight-card {
        background: #FFFFFF;
        border: 1px solid var(--overview-border);
        padding: 22px 20px;
        transition: transform 0.2s;
        height: 100%;
    }

    .hero-highlight-card:hover {
        border-color: var(--overview-green);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
    }

    .highlight-icon-box {
        width: 44px;
        height: 44px;
        background-color: var(--overview-green-light);
        color: var(--overview-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 14px;
        border: 1px solid #D1E5DB;
    }

    .highlight-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--overview-heading);
        margin-bottom: 6px;
    }

    .highlight-desc {
        font-size: 0.88rem;
        color: var(--overview-text);
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* FEATURE CARDS */
    .feature-card {
        background: #FFFFFF;
        border: 1px solid var(--overview-border);
        padding: 26px 22px;
        height: 100%;
        transition: all 0.2s ease;
    }

    .feature-card:hover {
        border-color: var(--overview-green);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }

    .feature-step-num {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--overview-green);
        background-color: var(--overview-green-light);
        padding: 3px 10px;
        display: inline-block;
        margin-bottom: 12px;
        border: 1px solid #D1E5DB;
    }

    .feature-title {
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--overview-heading);
        margin-bottom: 8px;
    }

    .feature-desc {
        font-size: 0.9rem;
        color: var(--overview-text);
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* SAMPLE SHOWCASE CARDS (JOB & FREELANCER) */
    .showcase-nav-pills {
        display: inline-flex;
        background-color: #EEF4F0;
        border: 1px solid #D1E5DB;
        padding: 4px;
        margin-bottom: 28px;
    }

    .showcase-nav-pills .nav-link {
        font-weight: 700;
        font-size: 0.95rem;
        color: #475569;
        border-radius: 0 !important;
        border: none;
        padding: 9px 22px;
        transition: all 0.2s ease;
        background: transparent;
    }

    .showcase-nav-pills .nav-link.active {
        background-color: var(--overview-green) !important;
        color: #FFFFFF !important;
        box-shadow: 0 2px 8px rgba(59, 110, 83, 0.25);
    }

    .sample-showcase-card {
        background: #FFFFFF;
        border: 1px solid var(--overview-border);
        padding: 24px 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.2s ease;
        text-align: left;
    }

    .sample-showcase-card:hover {
        border-color: var(--overview-green);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
        transform: translateY(-2px);
    }

    .sample-top-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #F1F5F9;
    }

    .sample-avatar-box {
        width: 44px;
        height: 44px;
        background-color: var(--overview-green-light);
        color: var(--overview-green);
        font-weight: 800;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #D1E5DB;
        flex-shrink: 0;
    }

    .sample-meta-name {
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--overview-heading);
        line-height: 1.3;
    }

    .sample-meta-sub {
        font-size: 0.8rem;
        color: var(--overview-text);
    }

    .sample-card-title {
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--overview-heading);
        margin-bottom: 8px;
        line-height: 1.35;
    }

    .sample-card-desc {
        font-size: 0.86rem;
        color: var(--overview-text);
        line-height: 1.5;
        margin-bottom: 14px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .sample-metrics-panel {
        background-color: #FAFCFA;
        border: 1px solid #EDF2EE;
        padding: 10px 14px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sample-metric-highlight {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--overview-green);
    }

    .sample-metric-secondary {
        font-size: 0.8rem;
        font-weight: 600;
        color: #475569;
    }

    .sample-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 18px;
    }

    .sample-chip {
        background-color: #F1F5F9;
        color: #334155;
        font-size: 0.74rem;
        font-weight: 600;
        padding: 3px 8px;
        border: 1px solid #E2E8F0;
        display: inline-block;
    }

    .sample-verified-tag {
        font-size: 0.74rem;
        font-weight: 700;
        color: #15803D;
        background-color: #DCFCE7;
        padding: 2px 7px;
        border: 1px solid #BBF7D0;
        display: inline-block;
    }

    .btn-sample-action {
        width: 100%;
        border-radius: 0;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 8px 16px;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    /* CATEGORY BOX */
    .category-card {
        background: #FFFFFF;
        border: 1px solid var(--overview-border);
        padding: 22px 18px;
        text-align: center;
        transition: all 0.2s ease;
        height: 100%;
    }

    .category-card:hover {
        border-color: var(--overview-green);
        background-color: var(--overview-green-light);
    }

    .category-icon {
        font-size: 1.8rem;
        color: var(--overview-green);
        margin-bottom: 12px;
        font-weight: 800;
    }

    .category-name {
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--overview-heading);
        margin-bottom: 6px;
    }

    .category-tags {
        font-size: 0.82rem;
        color: var(--overview-text);
        line-height: 1.4;
        margin-bottom: 0;
    }

    /* CTA FOOTER BANNER */
    .cta-banner {
        background: linear-gradient(135deg, #244835 0%, #3B6E53 100%);
        color: #FFFFFF;
        padding: 60px 30px;
        text-align: center;
        border: 1px solid #1E3D2C;
    }

    .cta-title {
        font-size: 2.1rem;
        font-weight: 800;
        margin-bottom: 14px;
        letter-spacing: -0.5px;
    }

    .cta-desc {
        font-size: 1.05rem;
        color: #DDEBE2;
        max-width: 650px;
        margin: 0 auto 30px;
        line-height: 1.6;
    }

    .btn-cta-white {
        background-color: #FFFFFF;
        color: #1E3D2C !important;
        font-weight: 700;
        font-size: 0.98rem;
        padding: 12px 28px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        border: 1px solid #FFFFFF;
    }

    .btn-cta-white:hover {
        background-color: #E2E8F0;
        transform: translateY(-2px);
    }

    .btn-cta-outline {
        background-color: transparent;
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 0.98rem;
        padding: 12px 28px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .btn-cta-outline:hover {
        background-color: rgba(255, 255, 255, 0.15);
        border-color: #FFFFFF;
        transform: translateY(-2px);
    }

    /* LOGGED IN NOTICE BANNER */
    .logged-in-banner {
        background-color: #EBF4F0;
        border-bottom: 1px solid #C4D9CD;
        padding: 12px 0;
        font-size: 0.92rem;
    }
</style>

<div class="overview-wrapper">

    @if (maUser.HasValue)
    {
        <!-- BANNER THÔNG BÁO CHO NGƯỜI DÙNG ĐÃ ĐĂNG NHẬP -->
        <div class="logged-in-banner">
            <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <span class="fw-bold text-success">Xin chào @userName!</span>
                    <span class="text-secondary ms-1">Bạn đang đăng nhập với vai trò: <strong>@tenRole</strong>.</span>
                </div>
                <div>
                    @if (tenRole == "FreelancerStudent")
                    {
                        <a href="/JobPost" class="btn btn-sm btn-success fw-bold px-3">Đến trang tìm việc làm</a>
                    }
                    else if (tenRole == "NhaTuyenDung")
                    {
                        <a href="/FreelancerStudent" class="btn btn-sm btn-success fw-bold px-3">Đến trang quản lý tuyển dụng</a>
                    }
                    else if (tenRole == "Admin")
                    {
                        <a href="/Admin" class="btn btn-sm btn-success fw-bold px-3">Đến bảng điều khiển Quản trị</a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ==================== KHU VỰC 2: HERO SECTION ==================== -->
    <section class="hero-box">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="section-badge">Kết nối freelancer sinh viên</span>
                    <h1 class="hero-title">
                        Kết nối Freelancer sinh viên với <span>cơ hội việc làm phù hợp</span>
                    </h1>
                    <p class="hero-desc">
                       Nền tảng kết nối sinh viên có nhu cầu làm việc tự do với nhà tuyển dụng
                    </p>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a asp-controller="Account" asp-action="DangKy" asp-route-role="1" class="btn-hero-primary">
                            Tôi là Freelancer
                        </a>
                        <a asp-controller="Account" asp-action="DangKy" asp-route-role="2" class="btn-hero-secondary">
                            Tôi là Nhà tuyển dụng
                        </a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="d-flex flex-column gap-3">
                        <!-- Card 1 -->
                        <div class="hero-highlight-card">
                            <div class="highlight-icon-box">01 </div>
                            <h3 class="highlight-title">Xác thực sinh viên minh bạch</h3>
                         
                        </div>

                        <!-- Card 2 -->
                        <div class="hero-highlight-card">
                            <div class="highlight-icon-box">02</div>
                            <h3 class="highlight-title">Đảm bảo thanh toán hợp lý</h3>
                          
                        </div>

                        <!-- Card 3 -->
                        <div class="hero-highlight-card">
                            <div class="highlight-icon-box">03</div>
                            <h3 class="highlight-title">Tiến độ theo mốc rõ ràng</h3>
                          
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== KHU VỰC 3: GIỚI THIỆU NỀN TẢNG ==================== -->
    <section id="gioi-thieu" class="overview-section overview-section-alt">
        <div class="container text-center">
            <span class="section-badge"> Freelancer Sinh Viên</span>
            <h2 class="section-title">Nền tảng việc làm tự do dành cho sinh viên</h2>
          
            <div class="row g-4 text-start mt-2">
                <div class="col-md-4">
                    <div class="feature-card">
                        <span class="feature-step-num">1</span>
                        <h3 class="feature-title">Xác minh danh tính minh bạch</h3>
                        <p class="feature-desc">
                            Đảm bảo sinh viên các trường đại học
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <span class="feature-step-num">2</span>
                        <h3 class="feature-title">Đảm bảo nhận thù lao</h3>
                        <p class="feature-desc">
                          Đảm bảo nhận tiền thù lao khi hoàn thành công việc
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card">
                        <span class="feature-step-num">3</span>
                        <h3 class="feature-title">Đánh giá và nhận xét công khai</h3>
                        <p class="feature-desc">
                          Tăng uy tín của sinh viên
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== KHU VỰC 4: DÀNH CHO FREELANCER SINH VIÊN ==================== -->
    <section id="danh-cho-freelancer" class="overview-section">
        <div class="container">
            <div class="text-center">
                <span class="section-badge">Dành cho sinh viên</span>
               
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Hồ sơ portfolio cá nhân</h3>
                       
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Xác thực minh chứng sinh viên</h3>
                        
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Tìm kiếm ứng tuyển công việc</h3>
                       
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Ký kết hợp đồng điện tử</h3>
                        
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Báo cáo tiến độ và bàn giao</h3>
                       
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Ví thu nhập & Đánh giá năng lực</h3>
                        
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== KHU VỰC 5: DÀNH CHO NHÀ TUYỂN DỤNG ==================== -->
    <section id="danh-cho-nha-tuyen-dung" class="overview-section overview-section-alt">
        <div class="container">
            <div class="text-center">
                <span class="section-badge">Dành cho Nhà tuyển dụng</span>
               
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Đăng tin tuyển dụng nhanh chóng</h3>
                        
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Tra cứu và lọc ứng viên</h3>
                       
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Quản lý và duyệt đơn ứng tuyển</h3>
                       
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Tạo hợp đồng ký quỹ an toàn</h3>
                      
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Theo dõi tiến độ nghiệm thu</h3>
                      
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <h3 class="feature-title">Đánh giá lưu hồ sơ yêu thích</h3>
                       
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== KHU VỰC 6: CƠ HỘI & NHÂN TÀI TIÊU BIỂU (CARD MẪU) ==================== -->
    <section id="cach-hoat-dong" class="overview-section">
        <div class="container">
            <div class="text-center">
              

                <!-- TAB SWITCH BUTTONS -->
                <ul class="nav nav-pills showcase-nav-pills justify-content-center" id="showcaseTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="jobs-tab" data-bs-toggle="pill" data-bs-target="#jobs-content" type="button" role="tab" aria-controls="jobs-content" aria-selected="true">
                            Việc làm dự án nổi bật 
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="freelancers-tab" data-bs-toggle="pill" data-bs-target="#freelancers-content" type="button" role="tab" aria-controls="freelancers-content" aria-selected="false">
                            Freelancer sinh viên tiêu biểu 
                        </button>
                    </li>
                </ul>
            </div>

            <div class="tab-content" id="showcaseTabContent">
                <!-- ==================== TAB 1: JOBPOST CARDS ==================== -->
                <div class="tab-pane fade show active" id="jobs-content" role="tabpanel" aria-labelledby="jobs-tab">
                    <div class="row g-4 text-start">
                        <!-- Job Card 1 -->
                        <div class="col-lg-4 col-md-6">
                            <div class="sample-showcase-card">
                                <div>
                                    <div class="sample-top-meta">
                                        <div class="sample-avatar-box">TN</div>
                                        <div>
                                            <div class="sample-meta-name">TechNova Solutions</div>
                                            <div class="sample-meta-sub">⭐ 4.9 • 18 dự án đã đăng</div>
                                        </div>
                                        <span class="sample-badge-open ms-auto">Đang tuyển</span>
                                    </div>

                                    <h3 class="sample-card-title">Phát triển Website Thương Mại Điện Tử Sinh Viên</h3>
                                    <p class="sample-card-desc">
                                        Xây dựng website bán tài liệu và giáo trình cho sinh viên, tích hợp giỏ hàng, API quản lý đơn hàng và giao diện chuẩn responsive trên mọi thiết bị.
                                    </p>

                                    <div class="sample-metrics-panel">
                                        <div>
