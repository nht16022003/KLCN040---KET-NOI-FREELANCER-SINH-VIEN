@model List<FreelancerStudent.Web.Models.UngTuyenViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách ứng viên nộp hồ sơ";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold mb-0 text-success">Danh sách ứng viên nộp hồ sơ</h5>
        <span class="badge bg-light text-success border border-success rounded-0 px-3 py-2">
            Tổng cộng: @(Model?.Count ?? 0) đơn ứng tuyển
        </span>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        @foreach (var item in Model)
        {
            var rawAvt = item.avatar;
            var avatarSinhVien = !string.IsNullOrEmpty(rawAvt)
                ? (rawAvt.StartsWith("http", StringComparison.OrdinalIgnoreCase) || rawAvt.StartsWith("/") ? rawAvt : "/" + rawAvt)
                : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(item.tenUser ?? "Student")}&background=E8F5E9&color=2E7D32";

            <!-- Mỗi ứng viên là một hàng (row) -->
            <div class="row align-items-center p-3 mb-2 border rounded-0 bg-white shadow-sm">
                
                <!-- Cột 1: Thông tin sinh viên ứng tuyển -->
                <div class="col-md-5 d-flex align-items-center">
                    <!-- Ảnh đại diện sinh viên (click xem hồ sơ) -->
                    <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" target="_blank" title="Xem hồ sơ @item.tenUser">
                        <img src="@avatarSinhVien" alt="@item.tenUser" class="rounded-0 border"
                             style="width: 50px; height: 50px; object-fit: cover;"
                             onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.tenUser ?? "Student")&background=E8F5E9&color=2E7D32';" />
                    </a>

                    <div style="margin-left: 12px;">
                        <div class="d-flex align-items-center gap-2">
                            <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" target="_blank"
                               class="text-decoration-none text-dark" title="Xem hồ sơ @item.tenUser">
                                <h6 class="mb-0 text-success fw-bold">@(item.tenUser ?? "Sinh viên ẩn danh")</h6>
                            </a>
                            <span class="text-muted" style="font-size: 0.8rem;">(Năm thứ @item.namThu)</span>
                        </div>
                        
                        <p class="mb-1 text-muted" style="font-size: 0.85rem;">
                            @(item.tenTruong ?? "Chưa cập nhật trường") - @(item.tenChuyenNganh ?? "Chuyên ngành khác")
                        </p>
                        
                        <p class="mb-1 text-secondary" style="font-size: 0.8rem;">
                            <strong>Thư giới thiệu:</strong> @(string.IsNullOrEmpty(item.thuGioiThieu) ? "Không có lời nhắn" : item.thuGioiThieu)
                        </p>

                        <!-- Link xem file CV đính kèm nếu có -->
                        @if (!string.IsNullOrEmpty(item.fileCV))
                        {
                            <a href="@item.fileCV" target="_blank" class="text-primary text-decoration-none"
                               style="font-size: 0.8rem;">
                                Xem CV đính kèm
                            </a>
                        }
                    </div>
                </div>

                <!-- Cột 2: Thông tin công việc & Đề xuất -->
                <div class="col-md-4">
                    <div>
                        <strong class="text-dark">Công việc:</strong>
                        <span class="text-success fw-semibold">@item.tieude</span>
                    </div>
                    
                    <div class="text-muted" style="font-size: 0.85rem; margin-top: 4px;">
                        <span>Thù lao đề xuất: <strong>@((item.thulaoDeXuat ?? item.thulao ?? 0).ToString("#,##0")) đ</strong></span>
                        @if (!string.IsNullOrEmpty(item.thoiGianHoanThanhDeXuat))
                        {
                            <span> - Cam kết: <strong>@item.thoiGianHoanThanhDeXuat</strong></span>
                        }
                    </div>

                    <div class="text-muted" style="font-size: 0.8rem; margin-top: 2px;">
                        Ngày nộp: @item.ngayUngTuyen.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <!-- Trạng thái & Thao tác duyệt -->
                <div class="col-md-3 text-end">
                    <!-- Trạng thái đơn -->
                    <div class="mb-2">
                        @if (item.trangThaiUngTuyen == "ChoDuyet")
                        {
                            <span class="badge bg-warning text-dark rounded-0">Chờ duyệt</span>
                        }
                        else if (item.trangThaiUngTuyen == "ChapNhan")
                        {
                            <span class="badge bg-success rounded-0">Đã chấp nhận</span>
                        }
                        else if (item.trangThaiUngTuyen == "TuChoi")
                        {
                            <span class="badge bg-danger rounded-0">Đã từ chối</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-0">@item.trangThaiUngTuyen</span>
                        }
                    </div>

                    <!-- Các nút thao tác -->
                    <!-- Các nút thao tác -->
                    <div class="d-flex justify-content-end gap-2 align-items-center flex-wrap">

                        @if (item.trangThaiUngTuyen == "TuChoi" && item.TrangThaiHopDong == "DaHuy")
                        {
                            <span class="badge bg-danger rounded-0 p-2">
                                <i class="bi bi-x-circle me-1"></i>
                                Đã hủy - Chờ ứng tuyển lại
                            </span>
                        }
                        else if (item.trangThaiUngTuyen == "ChapNhan")
                        {
                            @if (item.TrangThaiHopDong == "DaHuy")
                            {
                                <span class="badge bg-danger rounded-0 p-2">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Đã hủy
                                </span>
                            }
                            else if (item.TrangThaiHopDong == "ChoXacNhan")
                            {
                                <span class="badge bg-warning text-dark rounded-0 p-2">
                                    Chờ Freelancer xác nhận
                                </span>
                            }
                            else if (item.TrangThaiHopDong == "ChoKyQuy")
                            {
                                <span class="badge bg-warning text-dark rounded-0 p-2">
                                    Chờ ký quỹ
                                </span>
                            }
                            else if (item.TrangThaiHopDong == "DangThucHien")
                            {
                                <span class="badge bg-success rounded-0 p-2">
                                    Đang thực hiện
                                </span>
                            }
                            else if (string.IsNullOrEmpty(item.TrangThaiHopDong))
                            {
                                <!-- Nút trao đổi -->
                                <a href="/Chat?maFreelancerStudent=@item.maFreelancerStudents&maJob=@item.maJob"
                                class="btn btn-sm btn-outline-success rounded-0">
                                    <i class="bi bi-chat-dots me-1"></i>
                                    Trao đổi
                                </a>

                                <!-- Nút tạo hợp đồng -->
                                <a href="/HopDong/TaoHopDong?maJob=@item.maJob&maFreelancerStudent=@item.maFreelancerStudents&maUngTuyen=@item.maUngTuyen"
                                class="btn btn-sm btn-primary rounded-0 text-white fw-medium shadow-sm"
                                title="Khởi tạo dự thảo hợp đồng với ứng viên này">
                                    <i class="bi bi-file-earmark-text me-1"></i>
                                    Tạo hợp đồng
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-0 p-2">
                                    @item.TrangThaiHopDong
                                </span>
                            }
                        }
                        else if (item.trangThaiUngTuyen == "ChoDuyet")
                        {
                            <!-- Nút duyệt -->
                            <form asp-controller="JobPost"
                                asp-action="DuyetUngTuyen"
                                method="post"
                                class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="maUngTuyen" value="@item.maUngTuyen" />
                                <input type="hidden" name="trangThai" value="ChapNhan" />
                                <input type="hidden" name="maJob" value="@item.maJob" />

                                <button type="submit"
                                        class="btn btn-sm btn-success rounded-0"
                                        style="background-color: #1B5E36; border-color: #1B5E36;"
                                        onclick="return confirm('Bạn có chắc chắn muốn duyệt ứng viên này?');">
                                    Duyệt
                                </button>
                            </form>

                            <!-- Nút từ chối -->
                            <form asp-controller="JobPost"
                                asp-action="DuyetUngTuyen"
                                method="post"
                                class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="maUngTuyen" value="@item.maUngTuyen" />
                                <input type="hidden" name="trangThai" value="TuChoi" />
                                <input type="hidden" name="maJob" value="@item.maJob" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger rounded-0"
                                        onclick="return confirm('Bạn có chắc chắn muốn từ chối ứng viên này?');">
                                    Từ chối
                                </button>
                            </form>
                        }
                        else if (item.trangThaiUngTuyen == "TuChoi")
                        {
                            <span class="badge bg-secondary rounded-0 p-2">
                                Đã từ chối / Chờ ứng tuyển lại
                            </span>
                        }

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-light border rounded-0 text-center py-4 text-muted mt-3">
            Chưa có sinh viên nào ứng tuyển vào các bài đăng của bạn.
        </div>
    }
</div>
