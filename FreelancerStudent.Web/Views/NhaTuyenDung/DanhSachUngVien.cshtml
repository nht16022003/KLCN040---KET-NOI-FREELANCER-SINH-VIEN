@model List<FreelancerStudent.Web.Models.UngTuyenViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách ứng viên nộp hồ sơ";
}

<style>
    /* Scoped styling for Employer Candidates List - Balanced Proportions UI */
    .candidates-scope .candidate-card {
        border: 1px solid #E2E8F0 !important;
        border-radius: 10px !important;
        background-color: #FFFFFF !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
    }
    .candidates-scope .candidate-card:hover {
        transform: translateY(-2px);
        border-color: #2B7A4B !important;
        box-shadow: 0 4px 14px rgba(43, 122, 75, 0.08) !important;
    }
    .candidates-scope .candidate-avatar {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 8px !important;
        border: 1px solid #E2E8F0;
    }
    .candidates-scope .btn {
        border-radius: 6px !important;
        font-weight: 500;
        transition: all 0.15s ease-in-out;
    }
    .candidates-scope .badge {
        border-radius: 6px !important;
        font-weight: 500;
        letter-spacing: 0.2px;
    }
    .candidates-scope .intro-letter-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.5;
    }
    .candidates-scope .btn-approve-action {
        background-color: #1B5E36 !important;
        border-color: #1B5E36 !important;
        color: #FFFFFF !important;
    }
    .candidates-scope .btn-approve-action:hover {
        background-color: #154728 !important;
        border-color: #154728 !important;
        color: #FFFFFF !important;
    }
    .candidates-scope .btn-contract-action {
        background-color: #2B7A4B !important;
        border-color: #2B7A4B !important;
        color: #FFFFFF !important;
    }
    .candidates-scope .btn-contract-action:hover {
        background-color: #1E5C37 !important;
        border-color: #1E5C37 !important;
        color: #FFFFFF !important;
    }
    .candidates-scope .empty-state-card {
        border: 1px solid #E2E8F0 !important;
        border-radius: 10px !important;
        background-color: #FFFFFF !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    }
</style>

<div class="candidates-scope container py-4">
    <!-- Header chuẩn phân hệ Nhà tuyển dụng -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
       
        <span class="badge bg-light text-success border border-success-subtle px-3 py-2">
            Tổng cộng: @(Model?.Count ?? 0) đơn ứng tuyển
        </span>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                var rawAvt = item.avatar;
                var avatarSinhVien = !string.IsNullOrEmpty(rawAvt)
                    ? (rawAvt.StartsWith("http", StringComparison.OrdinalIgnoreCase) || rawAvt.StartsWith("/") ? rawAvt : "/" + rawAvt)
                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(item.tenUser ?? "Student")}&background=E8F5E9&color=2E7D32";

                <div class="card candidate-card p-3">
                    <div class="row align-items-center g-3">
                        
                        <!-- Cột 1: Thông tin sinh viên ứng tuyển (Tỷ lệ 5/12) -->
                        <div class="col-12 col-lg-5 d-flex align-items-start gap-3">
                            <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" target="_blank" title="Xem hồ sơ @item.tenUser" class="flex-shrink-0">
                                <img src="@avatarSinhVien" alt="@item.tenUser" class="candidate-avatar"
                                     onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.tenUser ?? "Student")&background=E8F5E9&color=2E7D32';" />
                            </a>

                            <div class="min-w-0 flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" target="_blank"
                                       class="text-decoration-none fw-bold" style="color: #1B5E36;" title="Xem hồ sơ @item.tenUser">
                                        @(item.tenUser ?? "Sinh viên ẩn danh")
                                    </a>
                                    <span class="text-muted small">(Năm thứ @item.namThu)</span>
                                </div>
                                
                                <p class="mb-1 text-muted small text-truncate">
                                    @(item.tenTruong ?? "Chưa cập nhật trường") - @(item.tenChuyenNganh ?? "Chuyên ngành khác")
                                </p>
                                
                                <p class="mb-2 text-secondary small intro-letter-clamp" title="@item.thuGioiThieu">
                                    <strong class="text-dark">Thư giới thiệu:</strong> @(string.IsNullOrEmpty(item.thuGioiThieu) ? "Không có lời nhắn" : item.thuGioiThieu)
                                </p>

                                @if (!string.IsNullOrEmpty(item.fileCV))
                                {
                                    <a href="@item.fileCV" target="_blank" class="text-decoration-none small fw-semibold" style="color: #2B7A4B;">
                                        Xem CV / Sản phẩm mẫu &rarr;
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Cột 2: Thông tin công việc & Đề xuất (Tỷ lệ 3/12) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="mb-1">
                                <span class="text-muted small">Công việc:</span>
                                <strong class="text-dark ms-1">@item.tieude</strong>
                            </div>
                            
                            <div class="small mb-1">
                                <span class="text-muted">Thù lao đề xuất:</span>
                                <strong class="text-success ms-1">@((item.thulaoDeXuat ?? item.thulao ?? 0).ToString("#,##0")) VNĐ</strong>
                                @if (!string.IsNullOrEmpty(item.thoiGianHoanThanhDeXuat))
                                {
                                    <span class="text-muted ms-2">| Cam kết: <strong class="text-dark">@item.thoiGianHoanThanhDeXuat</strong></span>
                                }
                            </div>

                            <div class="text-muted small" style="font-size: 0.78rem;">
                                Ngày nộp đơn: @item.ngayUngTuyen.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <!-- Cột 3: Trạng thái & Thao tác duyệt (Tỷ lệ 4/12 rộng rãi cho Laptop) -->
                        <div class="col-12 col-md-6 col-lg-4 text-md-end text-lg-end">
                            <div class="mb-2">
                                @if (item.trangThaiUngTuyen == "ChoDuyet")
                                {
                                    <span class=" text-warning-emphasis ">Chờ duyệt</span>
                                }
                                else if (item.trangThaiUngTuyen == "ChapNhan")
                                {
                                    <span class=" text-success ">Đã chấp nhận</span>
                                }
                                else if (item.trangThaiUngTuyen == "TuChoi")
                                {
                                    <span class=" text-danger ">Đã từ chối</span>
                                }
                                else
                                {
                                    <span class=" text-secondary ">@item.trangThaiUngTuyen</span>
                                }
                            </div>

                            <div class="d-flex justify-content-md-end justify-content-lg-end gap-2 align-items-center flex-wrap">

                                @if (item.trangThaiUngTuyen == "TuChoi" && item.TrangThaiHopDong == "DaHuy")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                        Đã hủy - Chờ ứng tuyển lại
                                    </span>
                                }
                                else if (item.trangThaiUngTuyen == "ChapNhan")
                                {
                                    @if (item.TrangThaiHopDong == "DaHuy")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                            Đã hủy
                                        </span>
                                    }
                                    else if (item.TrangThaiHopDong == "ChoXacNhan")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small">
                                            Chờ Freelancer xác nhận
                                        </span>
                                    }
                                    else if (item.TrangThaiHopDong == "ChoKyQuy")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small">
                                            Chờ ký quỹ
                                        </span>
                                    }
                                    else if (item.TrangThaiHopDong == "DangThucHien")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                            Đang thực hiện
                                        </span>
                                    }
                                    else if (string.IsNullOrEmpty(item.TrangThaiHopDong))
                                    {
                                        <!-- Nút trao đổi -->
                                        <a href="/Chat?maFreelancerStudent=@item.maFreelancerStudents&maJob=@item.maJob"
                                           class="btn btn-sm btn-outline-success">
                                            Trao đổi
                                        </a>

                                        <!-- Nút tạo hợp đồng -->
                                        <a href="/HopDong/TaoHopDong?maJob=@item.maJob&maFreelancerStudent=@item.maFreelancerStudents&maUngTuyen=@item.maUngTuyen"
                                           class="btn btn-sm btn-contract-action fw-medium"
                                           title="Khởi tạo dự thảo hợp đồng với ứng viên này">
                                            Tạo hợp đồng
                                        </a>
                                    }
                                                                       else if (item.TrangThaiHopDong == "DaHoanThanh")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 small">
                                            Đã hoàn thành
                                        </span>
                                    }
                                    else if (item.TrangThaiHopDong == "DaThanhToan")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                            Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small">
                                            @item.TrangThaiHopDong
                                        </span>
                                    }
                                }
                                else if (item.trangThaiUngTuyen == "ChoDuyet")
                                {
                                    bool jobDaTuyenDu = Model.Any(x => x.maJob == item.maJob && x.trangThaiUngTuyen == "ChapNhan");
                                    if (jobDaTuyenDu)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small" title="Công việc đã có ứng viên được chấp nhận. Mỗi công việc chỉ tuyển tối đa 1 ứng viên.">
                                            Đã tuyển đủ
                                        </span>
                                    }
                                    else
                                    {
                                        <!-- Nút duyệt -->
                                        <form asp-controller="JobPost"
                                              asp-action="DuyetUngTuyen"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="maUngTuyen" value="@item.maUngTuyen" />
                                            <input type="hidden" name="trangThai" value="ChapNhan" />
                                            <input type="hidden" name="maJob" value="@item.maJob" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-approve-action"
                                                    onclick="return confirm('Bạn có chắc chắn muốn duyệt ứng viên này? (Công việc sẽ chuyển sang trạng thái đã tuyển đủ)');">
                                                Duyệt
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút từ chối -->
                                    <form asp-controller="JobPost"
                                          asp-action="DuyetUngTuyen"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="maUngTuyen" value="@item.maUngTuyen" />
                                        <input type="hidden" name="trangThai" value="TuChoi" />
                                        <input type="hidden" name="maJob" value="@item.maJob" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Bạn có chắc chắn muốn từ chối ứng viên này?');">
                                            Từ chối
                                        </button>
                                    </form>
                                }
                                else if (item.trangThaiUngTuyen == "TuChoi")
                                {
                                    <span class="badge bg-light text-secondary border border-light-subtle px-2 py-1 small">
                                        Đã từ chối / Chờ ứng tuyển lại
                                    </span>
                                }

                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state-card text-center py-5">
            <h5 class="fw-bold text-dark mb-2">Chưa có ứng viên nào</h5>
            <p class="text-muted small mb-0">Hiện tại chưa có sinh viên nào nộp hồ sơ ứng tuyển vào các bài đăng của bạn.</p>
        </div>
    }
</div>
