@using FreelancerStudent.Web.ViewModels
@model XacNhanThueFreelancerViewModel

@{
    ViewData["Title"] = "Xác nhận gửi yêu cầu thuê Freelancer";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var avatarUrl = !string.IsNullOrEmpty(Model.AvatarFreelancer) 
        ? Model.AvatarFreelancer 
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.TenFreelancer)}&background=E8F5E9&color=1B5E36&size=120";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("ChonJobThueFreelancer", "NhaTuyenDung", new { maFreelancerStudent = Model.MaFreelancerStudent })" class="text-decoration-none text-muted">Chọn công việc</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Xác nhận đề xuất thuê</li>
        </ol>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-0 border-0 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Header Card -->
    <div class="card border rounded-0 shadow-sm p-4 mb-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h4 class="fw-bold text-success mb-1">
                    <i class="bi bi-clipboard-check-fill me-2"></i> Xác nhận yêu cầu thuê Freelancer
                </h4>
                <p class="text-muted small mb-0">
                    Kiểm tra lại thông tin đề xuất công việc và mức thù lao trước khi gửi yêu cầu tới ứng viên.
                </p>
            </div>
            <!-- Progress Steps -->
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-muted border rounded-0 px-3 py-2">1. Chọn bài tuyển dụng</span>
                <i class="bi bi-chevron-right text-muted"></i>
                <span class="badge bg-success rounded-0 px-3 py-2 fw-bold">2. Xác nhận & Đề xuất</span>
                <i class="bi bi-chevron-right text-muted"></i>
                <span class="badge bg-light text-muted border rounded-0 px-3 py-2">3. Chờ phản hồi</span>
            </div>
        </div>
    </div>

    <form asp-action="GuiYeuCauThue" asp-controller="NhaTuyenDung" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maFreelancerStudent" value="@Model.MaFreelancerStudent" />
        <input type="hidden" name="maJob" value="@Model.MaJob" />
        <input type="hidden" asp-for="FormModel.maFreelancerStudent" value="@Model.MaFreelancerStudent" />
        <input type="hidden" asp-for="FormModel.maJob" value="@Model.MaJob" />

        <div class="row g-4 mb-4">
            <!-- Cột trái: Tóm tắt Freelancer & JobPost gốc -->
            <div class="col-12 col-lg-5">
                <!-- Freelancer Info Card -->
                <div class="card border rounded-0 shadow-sm p-3 mb-3 bg-white">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-person-badge me-2 text-success"></i> Ứng viên được đề xuất thuê
                    </h6>
                    <div class="d-flex align-items-center gap-3">
                        <img src="@avatarUrl" alt="@Model.TenFreelancer" class="border rounded-0" style="width: 56px; height: 56px; object-fit: cover;" />
                        <div>
                            <div class="fw-bold text-dark">@Model.TenFreelancer</div>
                            <div class="text-muted small">
                                <div><i class="bi bi-mortarboard me-1 text-success"></i>@(Model.ChuyenNganh ?? "Sinh viên")</div>
                                @if (!string.IsNullOrEmpty(Model.TruongDaiHoc))
                                {
                                    <div class="text-truncate" style="max-width: 260px;">@Model.TruongDaiHoc</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- JobPost Info Card -->
                <div class="card border rounded-0 shadow-sm p-3 bg-white">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-briefcase me-2 text-success"></i> Bài đăng tuyển dụng gốc
                        </h6>
                        <span class="badge bg-success-subtle text-success border border-success rounded-0">#@Model.MaJob</span>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small d-block">Tiêu đề:</span>
                        <div class="fw-bold text-dark">@Model.TieuDeJob</div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small d-block">Mức thù lao ban đầu:</span>
                        <div class="text-danger fw-bold">
                            @(Model.ThuLaoJob.HasValue ? Model.ThuLaoJob.Value.ToString("#,##0") + " VNĐ" : "Thỏa thuận")
                        </div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small d-block">Hạn hoàn thành dự kiến:</span>
                        <div class="text-dark small">
                            @(Model.ThoiHanHoanThanhJob.HasValue && Model.ThoiHanHoanThanhJob.Value != DateTime.MinValue ? Model.ThoiHanHoanThanhJob.Value.ToString("dd/MM/yyyy") : "Chưa đặt")
                        </div>
                    </div>

                    <a href="@Url.Action("ChonJobThueFreelancer", "NhaTuyenDung", new { maFreelancerStudent = Model.MaFreelancerStudent })" class="btn btn-sm btn-outline-secondary rounded-0 mt-2">
                        <i class="bi bi-arrow-repeat me-1"></i> Đổi bài đăng khác
                    </a>
                </div>
            </div>

            <!-- Cột phải: Form tùy chỉnh nội dung đề xuất -->
            <div class="col-12 col-lg-7">
                <div class="card border rounded-0 shadow-sm p-4 bg-white">
                    <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                        <i class="bi bi-pencil-square me-2 text-success"></i> Chi tiết đề xuất gửi tới ứng viên
                    </h5>

                    <!-- Tiêu đề công việc -->
                    <div class="mb-3">
                        <label asp-for="FormModel.tieuDeCongViec" class="form-label fw-bold text-dark small">
                            Tiêu đề công việc <span class="text-danger">*</span>
                        </label>
                        <input asp-for="FormModel.tieuDeCongViec" class="form-control rounded-0" placeholder="Nhập tiêu đề công việc..." required />
                        <span asp-validation-for="FormModel.tieuDeCongViec" class="text-danger small"></span>
                    </div>

                    <!-- Mức thù lao đề nghị -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FormModel.nganSachDeNghi" class="form-label fw-bold text-dark small">
                                Thù lao đề xuất (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FormModel.nganSachDeNghi" type="number" min="1000" step="1000" class="form-control rounded-0 fw-bold text-danger" placeholder="Ví dụ: 1,500,000" required />
                            <span asp-validation-for="FormModel.nganSachDeNghi" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FormModel.thoiHanDuKien" class="form-label fw-bold text-dark small">
                                Hạn hoàn thành dự kiến
                            </label>
                            <input asp-for="FormModel.thoiHanDuKien" type="date" class="form-control rounded-0" />
                        </div>
                    </div>

                    <!-- Mô tả yêu cầu công việc -->
                    <div class="mb-3">
                        <label asp-for="FormModel.moTaCongViec" class="form-label fw-bold text-dark small">
                            Mô tả yêu cầu và kết quả bàn giao <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="FormModel.moTaCongViec" rows="6" class="form-control rounded-0" placeholder="Mô tả cụ thể nhiệm vụ bạn muốn Freelancer thực hiện..." required></textarea>
                        <span asp-validation-for="FormModel.moTaCongViec" class="text-danger small"></span>
                    </div>

                    <!-- Lưu ý quy trình -->
                    <div class="alert alert-info rounded-0 border-0 small mb-4">
                        <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> Quy trình tiếp theo:</div>
                        <ul class="mb-0 ps-3">
                            <li>Sau khi gửi, ứng viên sẽ nhận được thông báo đề xuất thuê trong tài khoản của họ.</li>
                            <li>Khi ứng viên <strong>Chấp nhận</strong>, bạn sẽ có thể bấm nút <strong>Tạo hợp đồng</strong> và thực hiện <strong>Ký quỹ đảm bảo</strong> theo quy trình an toàn của hệ thống.</li>
                            <li>Bạn có thể nhắn tin trực tiếp để trao đổi chi tiết bất kỳ lúc nào qua hệ thống Chat.</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="@Url.Action("ChonJobThueFreelancer", "NhaTuyenDung", new { maFreelancerStudent = Model.MaFreelancerStudent })" class="btn btn-outline-secondary rounded-0 px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success rounded-0 px-5 py-2 fw-bold" style="background-color: #1B5E36; border-color: #1B5E36;">
                            <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu thuê ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

