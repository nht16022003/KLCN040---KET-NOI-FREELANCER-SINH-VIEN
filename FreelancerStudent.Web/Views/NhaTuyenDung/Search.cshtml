@model List<FreelancerStudent.Web.ViewModels.NhaTuyenDungViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Khám phá Nhà Tuyển Dụng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-bold text-success">
            <i class="bi bi-buildings me-2"></i>Danh sách Nhà Tuyển Dụng
        </h4>
        <span class="text-muted small">Tìm thấy <strong>@(Model?.Count ?? 0)</strong> đối tác tuyển dụng</span>
    </div>

    <div class="row g-3">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var ntd in Model)
            {
                var tenHienThi = !string.IsNullOrWhiteSpace(ntd.tencongty) ? ntd.tencongty : ntd.hotenUser;
                var hinhAnh = !string.IsNullOrEmpty(ntd.logo) ? ntd.logo : (!string.IsNullOrEmpty(ntd.avatar) ? ntd.avatar :
        $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(tenHienThi ?? "NTD")}&background=E8F5E9&color=2E7D32");

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border rounded-3 shadow-sm bg-white">
                        <div class="card-body p-3 d-flex flex-column">
                            
                            <!-- Phần đầu: Logo + Tên + Lĩnh vực -->
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img src="@hinhAnh" alt="@tenHienThi" class="rounded border"
                                     style="width: 52px; height: 52px; object-fit: cover;" />
                                
                                <div class="overflow-hidden">
                                    <h6 class="mb-1 fw-bold text-truncate" title="@tenHienThi">
                                        @tenHienThi
                                    </h6>
                                    <span class="badge bg-light text-success border border-success-subtle"
                                          style="font-size: 0.75rem;">
                                        <i class="bi bi-tag me-1"></i>@(ntd.linhvuc ?? "Đa ngành")
                                    </span>
                                </div>
                            </div>

                            <!-- Giới thiệu ngắn -->
                            <p class="text-secondary small mb-2 text-truncate-2" style="font-size: 0.82rem; min-height: 38px;">
                                @(ntd.gioithieu ?? "Nhà tuyển dụng chưa cập nhật phần giới thiệu...")
                            </p>

                            <!-- Địa chỉ -->
                            <div class="text-muted small mb-3 text-truncate" style="font-size: 0.8rem;">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@(ntd.diachi ?? "Chưa cập nhật địa chỉ")
                            </div>

                            <!-- Phần chân thẻ: Đánh giá + Nút xem chi tiết -->
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-warning small fw-bold">
                                        <i class="bi bi-star-fill"></i> @((ntd.sosaodanhgia ?? 5.0).ToString("0.0"))
                                    </span>
                                    <small class="text-muted ms-1" style="font-size: 0.75rem;">(@(ntd.hotenUser ?? "Cá nhân"))</small>
                                </div>

                                <!-- Nút Xem hồ sơ / Các tin đăng -->
                                <a href="/Employer/Profile/@ntd.maNhaTuyenDung" class="btn btn-sm btn-outline-success px-3">
                                    Xem hồ sơ
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Chưa có nhà tuyển dụng nào trong hệ thống.
                </div>
            </div>
        }
    </div>
</div>
