@model List<FreelancerStudent.Web.ViewModels.NhaTuyenDungViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Khám phá Nhà Tuyển Dụng";
}

<style>
    .ntd-dashboard-root {
        --ntd-deep-forest: #0D2818;
        --ntd-forest-mid: #144327;
        --ntd-forest-rich: #1B5E36;
        --ntd-primary: #2B7A4B;
        --ntd-primary-hover: #23653E;
        --ntd-accent-bright: #4ADE80;
        --ntd-mint-soft: #EAF5EE;
        --ntd-mint-border: #C8E6C9;
        --ntd-surface-dark: #0A2013;
        --ntd-surface-card-bottom: #0E2B1A;
        --ntd-text-dark: #0F172A;
        --ntd-text-body: #334155;
        --ntd-text-muted: #64748B;
        --ntd-border-light: #E2E8F0;
        font-family: var(--font-sans);
        color: var(--ntd-text-dark);
        background-color: #F4F8F5;
        min-height: 100vh;
        padding-bottom: 72px;
    }

    .ntd-dashboard-root .ntd-hero-showcase {
        position: relative;
        background: linear-gradient(135deg, #091E12 0%, #123C23 42%, #1B5E36 78%, #246A40 100%);
        border-radius: 24px !important;
        padding: 48px 44px 40px 44px;
        margin-top: 24px;
        margin-bottom: 36px;
        overflow: hidden;
        box-shadow: 0 24px 54px rgba(13, 40, 24, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(74, 222, 128, 0.18);
    }

    .ntd-dashboard-root .ntd-hero-showcase::before {
        content: "";
        position: absolute;
        top: -30%;
        right: -10%;
        width: 68%;
        height: 165%;
        background: linear-gradient(125deg, rgba(255, 255, 255, 0.0) 20%, rgba(74, 222, 128, 0.08) 48%, rgba(43, 122, 75, 0.22) 52%, rgba(13, 40, 24, 0.0) 80%);
        transform: rotate(-14deg);
        pointer-events: none;
        z-index: 0;
    }

    .ntd-dashboard-root .ntd-hero-showcase::after {
        content: "";
        position: absolute;
        bottom: -25%;
        left: 18%;
        width: 55%;
        height: 90%;
        background: radial-gradient(circle, rgba(59, 178, 105, 0.24) 0%, rgba(13, 40, 24, 0) 70%);
        pointer-events: none;
        z-index: 0;
    }

    .ntd-dashboard-root .ntd-hero-inner {
        position: relative;
        z-index: 2;
    }

    .ntd-dashboard-root .ntd-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(74, 222, 128, 0.14);
        color: #FFFFFF;
        border: 1px solid rgba(167, 243, 208, 0.28);
        border-radius: 8px !important;
        padding: 6px 14px;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 1.1px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .ntd-dashboard-root .ntd-hero-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50% !important;
        background: #4ADE80;
        box-shadow: 0 0 8px #4ADE80;
    }

    .ntd-dashboard-root .ntd-hero-title {
        font-size: clamp(1.95rem, 3.2vw, 2.75rem);
        font-weight: 800;
        color: #FFFFFF;
        line-height: 1.18;
        letter-spacing: -0.02em;
        max-width: none;
        margin-bottom: 14px;
    }

    .ntd-dashboard-root .ntd-hero-desc {
        font-size: 1.02rem;
        color: rgba(234, 245, 238, 0.84);
        line-height: 1.6;
        max-width: none;
        width: 100%;
        margin-bottom: 26px;
    }

    .ntd-dashboard-root .ntd-hero-controls-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 34px;
    }

    .ntd-dashboard-root .ntd-hero-cta-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .ntd-dashboard-root .ntd-btn-hero-primary {
        background: #FFFFFF !important;
        color: #0D2818 !important;
        border: 1px solid #FFFFFF !important;
        border-radius: 12px !important;
        padding: 12px 24px;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
        transition: all 0.22s ease;
    }

    .ntd-dashboard-root .ntd-btn-hero-primary:hover {
        background: #EAF5EE !important;
        color: #091E12 !important;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.24);
    }

    .ntd-dashboard-root .ntd-btn-hero-secondary {
        background: rgba(255, 255, 255, 0.1) !important;
        color: #FFFFFF !important;
        border: 1px solid rgba(255, 255, 255, 0.28) !important;
        border-radius: 12px !important;
        padding: 12px 22px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        backdrop-filter: blur(8px);
        transition: all 0.22s ease;
    }

    .ntd-dashboard-root .ntd-btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.2) !important;
        border-color: #FFFFFF !important;
        color: #FFFFFF !important;
        transform: translateY(-2px);
    }

    .ntd-dashboard-root .ntd-carousel-nav-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ntd-dashboard-root .ntd-btn-toggle-view {
        background: rgba(255, 255, 255, 0.08);
        color: #D1FAE5;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 999px !important;
        padding: 9px 16px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ntd-dashboard-root .ntd-btn-toggle-view:hover {
        background: rgba(255, 255, 255, 0.18);
        color: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-nav-circle {
        width: 44px;
        height: 44px;
        border-radius: 50% !important;
        background: #FFFFFF;
        color: #0D2818;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
        transition: all 0.2s ease;
    }

    .ntd-dashboard-root .ntd-nav-circle:hover {
        background: #4ADE80;
        color: #091E12;
        transform: scale(1.06);
    }

    .ntd-dashboard-root .ntd-functions-header-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        margin-bottom: 18px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .ntd-dashboard-root .ntd-functions-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #FFFFFF;
        margin-bottom: 2px;
    }

    .ntd-dashboard-root .ntd-functions-subtitle {
        font-size: 0.86rem;
        color: rgba(234, 245, 238, 0.74);
        margin-bottom: 0;
    }

    .ntd-dashboard-root .ntd-cards-track {
        display: flex;
        gap: 22px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        padding: 6px 4px 18px 4px;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .ntd-dashboard-root .ntd-cards-track::-webkit-scrollbar {
        display: none;
    }

    .ntd-dashboard-root .ntd-cards-track.is-grid-mode {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        overflow-x: visible;
    }

    .ntd-dashboard-root .ntd-feature-card {
        flex: 0 0 calc(33.333% - 15px);
        min-width: 300px;
        scroll-snap-align: start;
        background: var(--ntd-surface-card-bottom);
        border: 1px solid rgba(167, 243, 208, 0.16);
        border-radius: 18px !important;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 16px 36px rgba(5, 18, 10, 0.38);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .ntd-dashboard-root .ntd-cards-track.is-grid-mode .ntd-feature-card {
        flex: unset;
        min-width: 0;
    }

    .ntd-dashboard-root .ntd-feature-card:hover {
        transform: translateY(-6px);
        border-color: rgba(74, 222, 128, 0.55);
        box-shadow: 0 22px 44px rgba(5, 18, 10, 0.52);
    }

    .ntd-dashboard-root .ntd-card-visual-top {
        position: relative;
        height: 168px;
        padding: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .ntd-dashboard-root .ntd-visual-theme-1 {
        background: linear-gradient(135deg, #EAF5EE 0%, #C8E6C9 55%, #A7F3D0 100%);
        color: #0D2818;
    }

    .ntd-dashboard-root .ntd-visual-theme-2 {
        background: linear-gradient(135deg, #134E2B 0%, #1F7A44 55%, #2B9356 100%);
        color: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-visual-theme-3 {
        background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 50%, #6EE7B7 100%);
        color: #0D2818;
    }

    .ntd-dashboard-root .ntd-visual-theme-4 {
        background: linear-gradient(135deg, #0F3820 0%, #1B5E36 55%, #2E8552 100%);
        color: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-visual-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 2;
    }

    .ntd-dashboard-root .ntd-visual-tag {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 4px 10px;
        border-radius: 6px !important;
        background: rgba(13, 40, 24, 0.12);
        color: inherit;
        backdrop-filter: blur(4px);
    }

    .ntd-dashboard-root .ntd-visual-theme-2 .ntd-visual-tag,
    .ntd-dashboard-root .ntd-visual-theme-4 .ntd-visual-tag {
        background: rgba(255, 255, 255, 0.16);
        color: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-visual-step-num {
        font-size: 0.75rem;
        font-weight: 800;
        opacity: 0.75;
    }

    .ntd-dashboard-root .ntd-mini-ui-window {
        background: rgba(255, 255, 255, 0.94);
        border-radius: 10px !important;
        padding: 12px 14px;
        box-shadow: 0 10px 24px rgba(13, 40, 24, 0.15);
        color: #0F172A;
        z-index: 2;
        border: 1px solid rgba(43, 122, 75, 0.15);
    }

    .ntd-dashboard-root .ntd-mini-ui-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }

    .ntd-dashboard-root .ntd-mini-ui-row:last-child {
        margin-bottom: 0;
    }

    .ntd-dashboard-root .ntd-mini-ui-title {
        font-size: 0.78rem;
        font-weight: 800;
        color: #0D2818;
    }

    .ntd-dashboard-root .ntd-mini-ui-pill {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 99px !important;
        background: #E8F5E9;
        color: #1B5E36;
        border: 1px solid #C8E6C9;
    }

    .ntd-dashboard-root .ntd-mini-ui-bar {
        height: 6px;
        border-radius: 4px !important;
        background: #E2E8F0;
        overflow: hidden;
        width: 100%;
    }

    .ntd-dashboard-root .ntd-mini-ui-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #1B5E36, #4ADE80);
        border-radius: 4px !important;
    }

    .ntd-dashboard-root .ntd-mini-ui-sub {
        font-size: 0.71rem;
        color: #475569;
        font-weight: 600;
    }

    .ntd-dashboard-root .ntd-card-body-bottom {
        padding: 22px 22px 20px 22px;
        background: linear-gradient(180deg, rgba(16, 49, 30, 0.96) 0%, #091D11 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-grow: 1;
    }

    .ntd-dashboard-root .ntd-card-fn-title {
        font-size: 1.12rem;
        font-weight: 800;
        color: #FFFFFF;
        margin-bottom: 8px;
        line-height: 1.3;
    }

    .ntd-dashboard-root .ntd-card-fn-desc {
        font-size: 0.85rem;
        color: rgba(226, 242, 232, 0.76);
        line-height: 1.55;
        margin-bottom: 18px;
    }

    .ntd-dashboard-root .ntd-card-fn-btn {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 10px 16px;
        background: rgba(43, 122, 75, 0.28);
        color: #FFFFFF !important;
        border: 1px solid rgba(74, 222, 128, 0.32);
        border-radius: 10px !important;
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .ntd-dashboard-root .ntd-card-fn-btn:hover {
        background: #2B7A4B;
        color: #FFFFFF !important;
        border-color: #4ADE80;
    }

    .ntd-dashboard-root .ntd-hero-dots-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
    }

    .ntd-dashboard-root .ntd-hero-dot {
        flex: 0 0 8px;
        width: 8px;
        height: 8px !important;
        min-width: 8px;
        min-height: 8px !important;
        aspect-ratio: 1;
        border-radius: 50% !important;
        background: rgba(255, 255, 255, 0.26);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ntd-dashboard-root .ntd-hero-dot.active {
        width: 8px;
        height: 8px !important;
        min-height: 8px !important;
        border-radius: 50% !important;
        background: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-section-badge {
        display: inline-block;
        background: #EAF5EE;
        color: #1B5E36;
        border: 1px solid #C8E6C9;
        border-radius: 6px !important;
        padding: 4px 12px;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 6px;
    }

    .ntd-dashboard-root .ntd-filter-bar-card {
        background: #FFFFFF;
        border: 1px solid #D5E6DC;
        border-radius: 18px !important;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px rgba(13, 40, 24, 0.05);
    }

    .ntd-dashboard-root .ntd-company-card {
        background: #FFFFFF;
        border: 1px solid #DCE8E0;
        border-radius: 16px !important;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 8px 24px rgba(13, 40, 24, 0.05);
        transition: all 0.24s ease;
    }

    .ntd-dashboard-root .ntd-company-card:hover {
        border-color: #2B7A4B;
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(13, 40, 24, 0.12);
    }

    .ntd-dashboard-root .ntd-company-top {
        background: linear-gradient(135deg, #0D2818 0%, #1B5E36 60%, #2B7A4B 100%);
        padding: 18px 20px;
        color: #FFFFFF;
    }

    .ntd-dashboard-root .ntd-company-logo {
        width: 54px;
        height: 54px;
        border-radius: 12px !important;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.85);
        background: #FFFFFF;
        flex-shrink: 0;
    }

    .ntd-dashboard-root .ntd-company-body {
        padding: 18px 20px 14px 20px;
        flex-grow: 1;
    }

    .ntd-dashboard-root .ntd-company-footer {
        padding: 14px 20px;
        background: #FAFCFB;
        border-top: 1px solid #E2E8F0;
        display: flex;
        gap: 10px;
    }

    .ntd-dashboard-root .ntd-workflow-section {
        background: linear-gradient(180deg, #FFFFFF 0%, #EAF5EE 100%);
        border: 1px solid #C8E6C9;
        border-radius: 22px !important;
        padding: 36px 34px;
        margin-top: 44px;
        box-shadow: 0 12px 32px rgba(13, 40, 24, 0.06);
    }

    .ntd-dashboard-root .ntd-workflow-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 26px;
    }

    .ntd-dashboard-root .ntd-workflow-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0D2818;
        margin-bottom: 4px;
    }

    .ntd-dashboard-root .ntd-workflow-sub {
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 0;
    }

    .ntd-dashboard-root .ntd-step-card {
        position: relative;
        background: #FFFFFF;
        border: 1px solid #D5E8DC;
        border-radius: 16px !important;
        padding: 24px 20px;
        height: 100%;
        box-shadow: 0 6px 18px rgba(13, 40, 24, 0.04);
        transition: all 0.22s ease;
    }

    .ntd-dashboard-root .ntd-step-card:hover {
        transform: translateY(-4px);
        border-color: #2B7A4B;
        box-shadow: 0 14px 28px rgba(13, 40, 24, 0.1);
    }

    .ntd-dashboard-root .ntd-step-number-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #0D2818 0%, #1B5E36 100%);
        color: #FFFFFF;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 99px !important;
        margin-bottom: 14px;
    }

    .ntd-dashboard-root .ntd-step-heading {
        font-size: 1.04rem;
        font-weight: 800;
        color: #0D2818;
        margin-bottom: 8px;
    }

    .ntd-dashboard-root .ntd-step-desc {
        font-size: 0.86rem;
        color: #475569;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .ntd-dashboard-root .btn-search-main {
        background: linear-gradient(135deg, #1B5E36 0%, #2B7A4B 100%);
        color: #FFFFFF !important;
        border: 1px solid #1B5E36;
        border-radius: 10px !important;
        padding: 10px 22px;
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 6px 16px rgba(27, 94, 54, 0.2);
    }

    @@media (max-width: 1199.98px) {
        .ntd-dashboard-root .ntd-feature-card {
            flex: 0 0 calc(50% - 12px);
        }
        .ntd-dashboard-root .ntd-cards-track.is-grid-mode {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .ntd-dashboard-root .ntd-hero-showcase {
            padding: 28px 20px 26px 20px;
        }
        .ntd-dashboard-root .ntd-feature-card {
            flex: 0 0 88%;
        }
        .ntd-dashboard-root .ntd-cards-track.is-grid-mode {
            grid-template-columns: 1fr;
        }
        .ntd-dashboard-root .ntd-workflow-section {
            padding: 24px 18px;
        }
    }
</style>

<div class="ntd-dashboard-root">
    <div class="container-fluid px-lg-5">

        <!-- ===============================================================
             KHU VỰC 1 & KHU VỰC 2: PHÂN CHIA THEO VAI TRÒ
             - NHÀ TUYỂN DỤNG: Hiển thị Trung tâm điều khiển & 8 chức năng Nhà tuyển dụng
             - FREELANCER: Hiển thị Trung tâm điều khiển & 8 chức năng Sinh viên Freelancer
             =============================================================== -->
        @if (User.IsInRole("NhaTuyenDung") || Context.Session.GetString("tenRole") == "NhaTuyenDung")
        {
            <section class="ntd-hero-showcase" aria-label="Trung tâm điều khiển Nhà tuyển dụng">
                <div class="ntd-hero-inner">

                   

                    <h1 class="ntd-hero-title">Trung tâm điều khiển Nhà tuyển dụng</h1>

                    <p class="ntd-hero-desc">
                        Đăng tin tuyển dụng, xem hồ sơ ứng viên, theo dõi hợp đồng và quản lý khoản ký quỹ.
                    </p>

                    <div class="ntd-hero-controls-row">
                        <div class="ntd-hero-cta-group">
                            <a asp-controller="JobPost" asp-action="Create" class="ntd-btn-hero-primary">
                                <span>Đăng tin tuyển dụng</span>
                                <span>→</span>
                            </a>
                            <a asp-controller="FreelancerStudent" asp-action="Search" class="ntd-btn-hero-secondary">
                                <span>Tìm kiếm Freelancer</span>
                            </a>
                        </div>

                        <div class="ntd-carousel-nav-group">
                            <button type="button" class="ntd-btn-toggle-view" id="ntdToggleViewBtn" onclick="toggleNtdCardsLayout()">
                                Xem tất cả 8 chức năng
                            </button>
                            <button type="button" class="ntd-nav-circle" onclick="scrollNtdCards(-1)" title="Trượt sang trái" aria-label="Trượt sang trái">
                                ←
                            </button>
                            <button type="button" class="ntd-nav-circle" onclick="scrollNtdCards(1)" title="Trượt sang phải" aria-label="Trượt sang phải">
                                →
                            </button>
                        </div>
                    </div>

