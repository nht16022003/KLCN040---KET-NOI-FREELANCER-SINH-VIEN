@model List<FreelancerStudent.Web.ViewModels.NhaTuyenDungViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Khám phá Nhà Tuyển Dụng";
}

<div class="container py-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="text-success fw-bold mb-1">
                Khám phá & Kết nối Nhà Tuyển Dụng
            </h4>
            <span class="text-muted small">Tìm kiếm các doanh nghiệp, công ty đối tác và trực tiếp trao đổi qua tin
                nhắn</span>
            </div>
            <span class="badge bg-light text-success border border-success px-3 py-2 rounded-0">
                Tổng cộng: @(Model?.Count ?? 0) Nhà Tuyển Dụng
            </span>
        </div>

        <!-- THANH BỘ LỌC TÌM KIẾM NHÀ TUYỂN DỤNG (FLAT DESIGN, ROUNDED-0) -->
        <div class="card border rounded-0 p-3 mb-4 bg-light shadow-sm">
            <div class="row g-2 align-items-center">
                <!-- 1. Từ khoá tìm kiếm -->
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white rounded-0 border-end-0 text-muted small">Tìm</span>
                        <input type="text" id="filterKeyword" class="form-control rounded-0 border-start-0"
                               placeholder="Tìm theo tên công ty, người liên hệ, địa chỉ...">
                    </div>
                </div>

                <!-- 2. Lĩnh vực hoạt động -->
                <div class="col-md-6">
                    <select id="filterLinhVuc" class="form-select rounded-0">
                        <option value="">-- Tất cả lĩnh vực --</option>
                        @if (Model != null)
                        {
                            var linhVucs = Model.Where(x => !string.IsNullOrEmpty(x.linhvuc))
                                                .Select(x => x.linhvuc!)
                                                .Distinct()
                                                .OrderBy(x => x);
                            foreach (var lv in linhVucs)
                            {
                                <option value="@lv">@lv</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- DANH SÁCH NHÀ TUYỂN DỤNG DẠNG GRID CARD -->
        <div class="row g-3" id="ntdListContainer">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var ntd in Model)
                {
                    var tenHienThi = !string.IsNullOrWhiteSpace(ntd.tencongty) ? ntd.tencongty : ntd.hotenUser;
                    var hinhAnh = !string.IsNullOrEmpty(ntd.logo) ? ntd.logo : (!string.IsNullOrEmpty(ntd.avatar) ? ntd.avatar :
                        "");

                    <div class="col-md-6 col-lg-4 ntd-card-wrapper" data-company="@((ntd.tencongty ?? "").ToLower())"
                         data-name="@((ntd.hotenUser ?? "").ToLower())" data-address="@((ntd.diachi ?? "").ToLower())"
                         data-field="@(ntd.linhvuc ?? "")">
                        <div class="card h-100 border rounded-0 p-3 bg-white shadow-sm d-flex flex-column">
                            
                            <!-- Header Card: Logo + Tên công ty + Lĩnh vực -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@hinhAnh" alt="@tenHienThi" class="rounded-0 border"
                                     style="width: 52px; height: 52px; object-fit: cover; flex-shrink: 0;" />
                                
                                <div class="overflow-hidden">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate" title="@tenHienThi">
                                        @tenHienThi
                                    </h6>
                                    <span class="badge bg-light text-success border border-success-subtle rounded-0"
                                          style="font-size: 0.72rem;">
                                        @(string.IsNullOrEmpty(ntd.linhvuc) ? "Đa ngành" : ntd.linhvuc)
                                    </span>
                                </div>
                            </div>

                            <!-- Giới thiệu ngắn -->
                            <div class="p-2 mb-2 bg-light rounded-0 border">
                                <span class="text-muted small d-block" style="font-size: 0.72rem;">Giới thiệu:</span>
                                <p class="text-secondary small mb-0"
                                   style="font-size: 0.8rem; line-height: 1.4; max-height: 38px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @(string.IsNullOrEmpty(ntd.gioithieu) ? "Chưa cập nhật phần giới thiệu..." : ntd.gioithieu)
                                </p>
                            </div>

                            <!-- Địa chỉ & Người đại diện -->
                            <div class="text-muted small mb-3 text-truncate" style="font-size: 0.78rem;">
                                <div class="mb-1">Khu vực: @(string.IsNullOrEmpty(ntd.diachi) ? "Toàn quốc" : ntd.diachi)</div>
                                <div>Đại diện: @(ntd.hotenUser ?? "Chưa cập nhật")</div>
                            </div>

                            <!-- Footer Card: 2 Nút (Xem hồ sơ & Nhắn tin trao đổi) Vuông góc -->
                            <div class="mt-auto pt-2 border-top d-flex gap-2">
                                <!-- 1. Nút Xem hồ sơ công ty -->
                                <a href="/Employer/Profile/@ntd.maNhaTuyenDung"
                                   class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-0 fw-semibold">
                                    Xem hồ sơ
                                </a>

                                <!-- 2. Nút Nhắn tin trao đổi trực tiếp với NTD -->
                                <a href="/Chat?maUserNTD=@ntd.maUser"
                                   class="btn btn-sm btn-success flex-grow-1 rounded-0 fw-semibold"
                                   style="background-color: #1B5E36; border-color: #1B5E36;">
                                    Nhắn tin
                                </a>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-light border rounded-0 text-center py-5 text-muted">
                        Hiện tại chưa có nhà tuyển dụng nào trong hệ thống.
                    </div>
                </div>
            }
        </div>
    </div>

    @section Scripts {
        <script>
            const filterKeyword = document.getElementById("filterKeyword");
            const filterLinhVuc = document.getElementById("filterLinhVuc");
            const ntdCards = document.querySelectorAll(".ntd-card-wrapper");

            function applyFilter() {
                const kw = filterKeyword.value.toLowerCase().trim();
                const field = filterLinhVuc.value;

                ntdCards.forEach(card => {
                    const comp = card.getAttribute("data-company") || "";
                    const name = card.getAttribute("data-name") || "";
                    const addr = card.getAttribute("data-address") || "";
                    const cardField = card.getAttribute("data-field") || "";

                    let matchKw = !kw || comp.includes(kw) || name.includes(kw) || addr.includes(kw);
                    let matchField = !field || cardField === field;

                    if (matchKw && matchField) {
                        card.classList.remove("d-none");
                    } else {
                        card.classList.add("d-none");
                    }
                });
            }

            if (filterKeyword) filterKeyword.addEventListener("input", applyFilter);
            if (filterLinhVuc) filterLinhVuc.addEventListener("change", applyFilter);
        </script>
    }
