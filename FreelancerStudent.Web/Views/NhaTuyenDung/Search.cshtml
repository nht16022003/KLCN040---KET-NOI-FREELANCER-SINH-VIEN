@model List<FreelancerStudent.Web.ViewModels.NhaTuyenDungViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-4 text-success fw-bold">Danh sách Nhà Tuyển Dụng</h2>
    <div class="row g-4">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var ntd in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@(string.IsNullOrEmpty(ntd.logo) ? "https://via.placeholder.com/60" : ntd.logo)"
                                     alt="@ntd.tencongty" class="rounded-circle border"
                                     style="width: 60px; height: 60px; object-fit: cover;" />
                                <div>
                                    <h5 class="card-title mb-1 fw-bold">@(ntd.tencongty ?? "Công ty ẩn danh")</h5>
                                    <span class="badge bg-success-subtle text-success">@(ntd.linhvuc ?? "Đa ngành")</span>
                                </div>
                            </div>
                            
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i> @(ntd.diachi ?? "Chưa cập nhật địa chỉ")</p>
                            <p class="text-secondary small mb-3">@(ntd.gioithieu ?? "Chưa có lời giới thiệu...")</p>
                            
                            <div class="d-flex justify-content-between align-items-center border-top pt-2">
                                <span class="text-warning small"><i class="bi bi-star-fill"></i> @(ntd.sosaodanhgia ??
                                                                5.0)</span>
                                    <span class="text-muted small">Người đại diện: @ntd.hotenUser</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        else
            {
                <div class="col-12">
                    <div class="alert alert-info">Chưa có nhà tuyển dụng nào.</div>
                </div>
            }
        </div>
    </div>
