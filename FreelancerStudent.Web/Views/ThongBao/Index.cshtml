@model FreelancerStudent.Web.ViewModels.ThongBaoDanhSachViewModel
@{
    ViewData["Title"] = "Thông báo";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div><h2 class="mb-1">Thông báo</h2><p class="text-muted mb-0">@Model.soThongBaoChuaDoc thông báo chưa đọc</p></div>
        @if (Model.soThongBaoChuaDoc > 0)
        {
            <form asp-controller="ThongBao" asp-action="DanhDauTatCaDaDoc" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-primary" type="submit">Đánh dấu tất cả đã đọc</button>
            </form>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Loi))
    {
        <div class="alert alert-warning">@Model.Loi</div>
    }
    @if (Model.danhSach.Count == 0)
    {
        <div class="alert alert-light border">Bạn chưa có thông báo nào.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model.danhSach)
            {
                <a asp-controller="ThongBao" asp-action="DiDen" asp-route-maThongBao="@item.maThongBao" asp-route-link="@item.linkDieuHuong" asp-route-trang="@Model.trang"
                   class="list-group-item list-group-item-action @(item.daDoc ? "" : "list-group-item-primary")">
                    <div class="d-flex justify-content-between gap-3">
                        <div><strong>@item.tieuDe</strong><div class="small mt-1">@item.noiDung</div></div>
                        <time class="small text-muted text-nowrap">@item.ngayTao.ToString("dd/MM/yyyy HH:mm")</time>
                    </div>
                </a>
            }
        </div>
    }
    @if (Model.tongSoThongBao > Model.kichThuocTrang && Model.kichThuocTrang > 0)
    {
        var totalPages = (int)Math.Ceiling(Model.tongSoThongBao / (double)Model.kichThuocTrang);
        <nav class="mt-3"><ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.trang ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-trang="@pageNumber">@pageNumber</a></li>
            }
        </ul></nav>
    }
</div>
