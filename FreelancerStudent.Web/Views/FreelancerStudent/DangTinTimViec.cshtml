@model FreelancerStudent.Web.ViewModels.DangTinTimViecViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đăng tin tìm việc & Giới thiệu dịch vụ";
}

<div class="container py-4">
    <!-- Nút quay lại & Breadcrumb -->
    <div class="mb-3">
        <a asp-controller="FreelancerStudent" asp-action="QuanLyTimViec" class="text-decoration-none text-muted small fw-medium">
            &larr; Quay lại danh sách bài đăng
        </a>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: FORM ĐĂNG BÀI -->
        <div class="col-lg-8">
            <div class="card border bg-white shadow-sm p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom">
                 
                    <h3 class="fw-bold text-dark mb-1">Đăng tin tìm việc làm</h3>
                   
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <form asp-controller="FreelancerStudent" asp-action="DangTinTimViec" method="post">
                    <input type="hidden" asp-for="maUser" />

                    <!-- Tiêu đề -->
                    <div class="mb-3">
                        <label asp-for="tieude" class="form-label fw-bold small text-dark">Tiêu đề bài đăng dịch vụ <span class="text-danger">*</span></label>
                        <input asp-for="tieude" class="form-control"
                               placeholder="Ví dụ: Nhận thiết kế Web Frontend ReactJS, Banner Canva, Viết Content SEO..."
                               required />
                        <span asp-validation-for="tieude" class="text-danger small"></span>
                    </div>

                    <!-- Kỹ năng chuyên môn -->
                    <div class="mb-3">
                        <label asp-for="kynang" class="form-label fw-bold small text-dark">Kỹ năng chuyên môn <span class="text-danger">*</span></label>
                        <input asp-for="kynang" class="form-control"
                               placeholder="Ví dụ: HTML, CSS, JavaScript, Photoshop, Figma, Python..." required />
                        <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">Các kỹ năng cách nhau bởi dấu phẩy (,) </small>
                        <span asp-validation-for="kynang" class="text-danger small d-block"></span>
                    </div>

                    <!-- Mức thù lao đề xuất tối thiểu -->
                    <div class="mb-3">
                        <label asp-for="mucGiaTu" class="form-label fw-bold small text-dark">Mức thù lao đề xuất tối thiểu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="mucGiaTu" type="number" class="form-control" step="50000" min="10000" placeholder="100000" required />
                            <span class="input-group-text fw-bold bg-light text-muted">VNĐ</span>
                        </div>
                      
                        <span asp-validation-for="mucGiaTu" class="text-danger small d-block"></span>
                    </div>

                    <!-- Mô tả chi tiết năng lực & dịch vụ -->
                    <div class="mb-4">
                        <label asp-for="mota" class="form-label fw-bold small text-dark">Mô tả chi tiết năng lực & cam kết dịch vụ <span class="text-danger">*</span></label>
                        <textarea asp-for="mota" class="form-control" rows="6"
                                  placeholder="Giới thiệu kinh nghiệm học tập, các dự án thực tế đã làm, thời gian rảnh trong tuần có thể nhận việc và cam kết chất lượng..."
                                  required></textarea>
                        <span asp-validation-for="mota" class="text-danger small"></span>
                    </div>

                    <!-- Nút submit -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                        <a asp-controller="FreelancerStudent" asp-action="QuanLyTimViec" class="btn btn-outline-secondary px-4">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                            Đăng tin tìm việc ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- CỘT PHẢI: GỢI Ý ĐĂNG TIN HIỆU QUẢ -->
        <div class="col-lg-4">
            <div class="card border bg-white shadow-sm p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    Mẹo đăng tin hút Nhà tuyển dụng
                </h6>
                <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-3">
                    <li class="d-flex gap-2 align-items-start">
                        <span class="text-success fw-bold">✓</span>
                        <div>
                            <strong class="text-dark d-block">Tiêu đề cụ thể, rõ ràng</strong>
                          
                        </div>
                    </li>
                    <li class="d-flex gap-2 align-items-start">
                        <span class="text-success fw-bold">✓</span>
                        <div>
                            <strong class="text-dark d-block">Liệt kê đúng kỹ năng</strong>
                            
                        </div>
                    </li>
                    <li class="d-flex gap-2 align-items-start">
                        <span class="text-success fw-bold">✓</span>
                        <div>
                            <strong class="text-dark d-block">Mức giá hợp lý</strong>
                          
                        </div>
                    </li>
                    <li class="d-flex gap-2 align-items-start">
                        <span class="text-success fw-bold">✓</span>
                        <div>
                            <strong class="text-dark d-block">Cập nhật Portfolio</strong>
                            
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
