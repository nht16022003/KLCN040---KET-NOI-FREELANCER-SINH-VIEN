@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h5 class="mb-3 fw-bold">Danh sách công việc đã ứng tuyển</h5>

    <!-- Mỗi bài đã nộp là 1 hàng (row) đơn giản -->
    <div class="row align-items-center p-3 mb-2 border rounded bg-white">
        
        <!-- Cột 1: Thông tin Bài đăng & Nhà tuyển dụng -->
        <div class="col-md-5 d-flex align-items-center">
            <!-- Logo Công ty hoặc Avatar của NTD -->
            <img src="https://images.unsplash.com/photo-1572021335469-31706a17aaef?w=100" alt="Avatar"
                 class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />

            <div style="margin-left: 12px;">
                <!-- Tiêu đề công việc -->
                <h6 class="mb-1 fw-bold">
                    <a href="#" class="text-decoration-none text-dark">Thiết kế Website Bán Hàng</a>
                </h6>
                
                <!-- Người đăng: Công ty hoặc Cá nhân -->
                <p class="mb-1 text-muted" style="font-size: 0.85rem;">
                    <i class="bi bi-building"></i> Công ty TNHH ABC
                    <span class="text-secondary">(Đăng bởi: Nguyễn Hoàng Tuấn)</span>
                    
                    <!-- Nếu là cá nhân (không có công ty) thì hiển thị: -->
                    <!-- <i class="bi bi-person"></i> Nguyễn Hoàng Tuấn <small class="text-secondary">(Cá nhân)</small> -->
                </p>

                <!-- Ngân sách của Job -->
                <div class="text-secondary" style="font-size: 0.8rem;">
                    Ngân sách bài đăng: <strong>3,000,000 đ</strong>
                </div>
            </div>
        </div>

        <!-- Cột 2: Đề xuất mà sinh viên đã gửi đi -->
        <div class="col-md-4">
            <div style="font-size: 0.85rem;">
                <strong class="text-dark">Lương đề xuất:</strong>
                <span class="text-success fw-bold">2,500,000 đ</span>
            </div>
            
            <div class="text-muted" style="font-size: 0.85rem; margin-top: 2px;">
                Thời gian cam kết: <strong>2 tuần</strong>
            </div>

            <div class="text-muted" style="font-size: 0.8rem; margin-top: 2px;">
                Ngày nộp đơn: 01/10/2026
            </div>
        </div>

        <!-- Cột 3: Trạng thái duyệt & Xem chi tiết -->
        <div class="col-md-3 text-end">
            <!-- Trạng thái -->
            <div class="mb-2">
                <span class="badge bg-warning text-dark">Chờ NTD duyệt</span>
            </div>

            <!-- Nút bấm -->
            <div>
                <a href="#" class="btn btn-sm btn-outline-success">Xem chi tiết bài</a>
            </div>
        </div>

    </div>
</div>
