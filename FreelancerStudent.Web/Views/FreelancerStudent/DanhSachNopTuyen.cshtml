@model List<FreelancerStudent.Web.Models.UngTuyenViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh sách công việc đã ứng tuyển";
}

<div class="container mt-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 fw-bold text-success">
            Danh sách công việc bạn đã ứng tuyển
        </h5>
        <a asp-controller="JobPost" asp-action="Index" class="btn btn-sm btn-outline-success">
            Tìm thêm Job mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-2 small mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- NẾU CHƯA NỘP ĐƠN NÀO -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5 bg-white rounded-3">
            <p class="text-muted mt-2 mb-3">Bạn chưa nộp đơn ứng tuyển cho công việc nào.</p>
            <div>
                <a asp-controller="JobPost" asp-action="Index" class="btn btn-success">
                    Khám phá danh sách Job ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- NẾU ĐÃ CÓ ĐƠN -> LẶP HIỂN THỊ TỪNG DÒNG -->
        @foreach (var item in Model)
        {
            <div class="row align-items-center p-3 mb-3 border rounded-3 bg-white shadow-sm">
                
                <!-- Cột 1: Thông tin Bài đăng & Nhà tuyển dụng -->
                <div class="col-md-5 d-flex align-items-center">
                    @{
                        var avatarNTD = !string.IsNullOrEmpty(item.avatarNhaTuyenDung)
                            ? item.avatarNhaTuyenDung
                            : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(item.tenCongTy ?? "NTD")}&background=E8F5E9&color=1B5E36";
                    }
                    <img src="@avatarNTD"
                         alt="@item.tenCongTy" class="rounded border" style="width: 55px; height: 55px; object-fit: cover;" />

                    <div style="margin-left: 12px;">
                        <h6 class="mb-1 fw-bold text-dark">
                            @item.tieude
                        </h6>
                        
                        <p class="mb-1 text-muted small">
                            @(string.IsNullOrEmpty(item.tenCongTy) ? "Nhà tuyển dụng cá nhân" : item.tenCongTy)
                        </p>

                        <div class="text-secondary small">
                            Ngân sách Job: <strong class="text-danger">@((item.thulao ?? 0).ToString("#,##0")) VNĐ</strong>
                        </div>
                    </div>
                </div>

                <!-- Cột 2: Đề xuất mà sinh viên đã gửi đi -->
                <div class="col-md-4 my-2 my-md-0">
                    <div class="small">
                        <strong class="text-dark">Lương bạn đề xuất:</strong>
                        <span class="text-success fw-bold">@((item.thulaoDeXuat ?? 0).ToString("#,##0")) VNĐ</span>
                    </div>
                    
                    <div class="text-muted small mt-1">
                        Cam kết hoàn thành: <strong>@(string.IsNullOrEmpty(item.thoiGianHoanThanhDeXuat) ? "Theo yêu cầu" :
                                                                                            item.thoiGianHoanThanhDeXuat)</strong>
                    </div>

                    <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                        Ngày nộp: @item.ngayUngTuyen.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <!-- Cột 3: Trạng thái duyệt của Nhà tuyển dụng -->
                <div class="col-md-3 text-md-end">
                    <div class="mb-2">
                        @if (item.trangThaiUngTuyen == "ChoDuyet")
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2">
                                Chờ NTD duyệt
                            </span>
                        }
                        else if (item.trangThaiUngTuyen == "ChapNhan")
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                Đã được chấp nhận
                            </span>
                        }
                        else if (item.trangThaiUngTuyen == "TuChoi")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                                Bị từ chối
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">@item.trangThaiUngTuyen</span>
                        }
                    </div>
                </div>

            </div>
        }
    }
</div>
