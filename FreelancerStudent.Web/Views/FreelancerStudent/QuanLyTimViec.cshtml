@model List<FreelancerStudent.Web.ViewModels.BaiDangTimViecViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý bài đăng tìm việc của bạn";
}

<div class="container py-4">
    <!-- TIÊU ĐỀ & NÚT ĐĂNG TIN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 pb-3 border-bottom">
        <div>
          
        </div>
        <a asp-controller="FreelancerStudent" asp-action="DangTinTimViec"
           class="btn btn-primary fw-bold px-4 py-2 shadow-sm">
            Đăng bài tìm việc mới
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-3 small mb-4 shadow-sm border border-success-subtle" role="alert">
            <div class="d-flex align-items-center gap-2">
                <strong>Thành công!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- NẾU CHƯA CÓ BÀI NÀO -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border text-center py-5 bg-white shadow-sm">
            <div class="card-body py-4">
                <div class="text-muted mb-3" style="font-size: 2.5rem; line-height: 1;">📝</div>
                <h5 class="fw-bold text-dark mb-2">Bạn chưa có bài đăng tìm việc nào</h5>
               
                <div>
                    <a asp-controller="FreelancerStudent" asp-action="DangTinTimViec"
                       class="btn btn-primary fw-bold px-4 py-2">
                        Tạo bài tìm việc đầu tiên
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- DANH SÁCH BÀI ĐĂNG -->
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border bg-white shadow-sm p-3 p-md-4">
                        <div class="row align-items-center">
                            
                            <!-- Thông tin bài đăng -->
                            <div class="col-lg-8 mb-3 mb-lg-0">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="app-badge app-badge-neutral">#@item.maBaiDang</span>
                                    <span class="text-muted small">
                                        Đăng ngày: @item.thoigiandang.ToString("dd/MM/yyyy")
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2" style="font-size: 1.15rem; line-height: 1.4;">
                                    @item.tieude
                                </h5>

                                <p class="text-secondary small mb-3"
                                   style="white-space: pre-line; max-height: 80px; overflow: hidden; text-overflow: ellipsis; line-height: 1.5;">
                                    @item.mota
                                </p>

                                <div class="d-flex flex-wrap gap-2 align-items-center pt-2 border-top">
                                    @if (!string.IsNullOrEmpty(item.kynang))
                                    {
                                        foreach (var kn in item.kynang.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1 small fw-normal">@kn.Trim()</span>
                                        }
                                    }
                                    <div class="ms-auto text-end">
                                        <span class="text-muted small me-1">Thù lao từ:</span>
                                        <span class="text-success fw-bold fs-6">
                                            @((item.mucGiaTu ?? 0).ToString("#,##0")) VNĐ
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Trạng thái & Thao tác -->
                            <div class="col-lg-4 text-lg-end border-top border-lg-0 pt-3 pt-lg-0 ps-lg-4 border-lg-start">
                                <div class="mb-3 d-flex justify-content-lg-end align-items-center gap-2">
                                    <span class="small text-muted d-lg-none">Trạng thái:</span>
                                    @if (item.trangthai == "DangHienThi")
                                    {
                                        <span class="app-badge app-badge-success px-3 py-1">
                                            Đang hiển thị
                                        </span>
                                    }
                                    else if (item.trangthai == "DaAn")
                                    {
                                        <span class="app-badge app-badge-neutral px-3 py-1">
                                            Đã ẩn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-info px-3 py-1">@item.trangthai</span>
                                    }
                                </div>

                                <div class="d-flex flex-wrap flex-lg-column gap-2 justify-content-end" style="max-width: 200px; margin-left: auto;">
                                    <!-- Nút Sửa tin -->
                                    <a asp-controller="FreelancerStudent" asp-action="SuaTinTimViec"
                                       asp-route-maBaiDang="@item.maBaiDang" class="btn btn-sm btn-outline-primary w-100"
                                       title="Sửa bài đăng">
                                        Sửa tin
                                    </a>

                                    <!-- Nút Ẩn / Hiện tin -->
                                    @if (item.trangthai == "DangHienThi")
                                    {
                                        <form asp-controller="FreelancerStudent" asp-action="DoiTrangThaiBaiDang" method="post" class="w-100 mb-0">
                                            <input type="hidden" name="maBaiDang" value="@item.maBaiDang" />
                                            <input type="hidden" name="trangThai" value="DaAn" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100" title="Ẩn tin">
                                                Tạm ẩn tin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="FreelancerStudent" asp-action="DoiTrangThaiBaiDang" method="post" class="w-100 mb-0">
                                            <input type="hidden" name="maBaiDang" value="@item.maBaiDang" />
                                            <input type="hidden" name="trangThai" value="DangHienThi" />
                                            <button type="submit" class="btn btn-sm btn-outline-success w-100" title="Hiển thị tin">
                                                Hiện tin
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút Xóa tin -->
                                    <form asp-controller="FreelancerStudent" asp-action="XoaBaiDang" method="post" class="w-100 mb-0"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài đăng tìm việc này không?');">
                                        <input type="hidden" name="maBaiDang" value="@item.maBaiDang" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Xóa tin">
                                            Xóa
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
