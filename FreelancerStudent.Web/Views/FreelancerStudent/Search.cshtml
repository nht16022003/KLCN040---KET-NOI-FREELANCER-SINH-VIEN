        <!-- ===============================================================
             KHU VỰC TRA CỨU & DANH SÁCH FREELANCER SINH VIÊN
             (Bảo toàn 100% biến Razor, Model, vòng lặp và bộ lọc gốc)
             =============================================================== -->
        <section class="ntd-directory-section" id="kham-pha-freelancer">

            <div class="ntd-section-heading-box mb-4">
                <div>
                    <span class="ntd-section-badge">Danh sách Freelancer sinh viên</span>
                    <h2 class="page-title">Khám phá Freelancer Sinh viên</h2>
                    <p class="page-subtitle">Lọc hồ sơ theo kỹ năng, chuyên ngành, trường học và thông tin dự án đã thực hiện.</p>
                </div>
            </div>

            <!-- BỐ CỤC 2 CỘT: BỘ LỌC BÊN TRÁI & KẾT QUẢ BÊN PHẢI -->
            <div class="row g-4 align-items-start">

                <!-- CỘT TRÁI: KHU VỰC TÌM KIẾM & BỘ LỌC FREELANCER -->
                <div class="col-12 col-lg-4 col-xl-3">
                    <div class="sidebar-filter-wrapper sticky-lg-top" style="top: 90px; z-index: 10;">
                        <form method="get" class="filter-sidebar-card">
                            
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <h3 class="filter-sidebar-title d-flex align-items-center gap-2">
                                    <i class="bi bi-funnel-fill text-success" style="font-size: 0.95rem;"></i>
                                    <span>Bộ lọc ứng viên</span>
                                </h3>
                                <a href="@Context.Request.Path" class="btn-clear-filter-link text-muted small text-decoration-none" title="Đặt lại bộ lọc">
                                    Xóa lọc
                                </a>
                            </div>

                            <div class="d-flex flex-column gap-3">
                                <!-- 1. Từ khóa tìm kiếm -->
                                <div>
                                    <label class="filter-label">Tìm theo tên hoặc kỹ năng</label>
                                    <input type="text" name="tuKhoa" class="form-control form-control-custom"
                                           value="@Model.TuKhoa"
                                           placeholder="Họ tên sinh viên, trường, kỹ năng..." />
                                </div>

                                <!-- 2. Thứ tự sắp xếp -->
                                <div>
                                    <label class="filter-label">Thứ tự sắp xếp</label>
                                    <select name="sapXep" class="form-select form-select-custom">
                                        <option value="moi-nhat" selected="@(Model.SapXep == "moi-nhat" ? "selected" : null)">Hồ sơ mới nhất (Mặc định)</option>
                                        <option value="sao-cao" selected="@(Model.SapXep == "sao-cao" ? "selected" : null)">Đánh giá cao nhất</option>
                                        <option value="gpa-cao" selected="@(Model.SapXep == "gpa-cao" ? "selected" : null)">Điểm GPA cao nhất</option>
                                    </select>
                                </div>

                                <!-- 3. Chuyên ngành đào tạo -->
                                <div>
                                    <label class="filter-label">Chuyên ngành đào tạo</label>
                                    <select name="chuyenNganh" class="form-select form-select-custom">
                                        <option value="">Tất cả chuyên ngành</option>
                                        @foreach (var cn in Model.DanhSachChuyenNganh)
                                        {
                                            <option value="@cn" selected="@(string.Equals(Model.ChuyenNganh, cn, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @cn
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- 4. Kỹ năng chuyên môn -->
                                <div>
                                    <label class="filter-label">Kỹ năng chuyên môn</label>
                                    <select name="kyNang" class="form-select form-select-custom">
                                        <option value="">Tất cả kỹ năng</option>
                                        @foreach (var kn in Model.DanhSachKyNang)
                                        {
                                            <option value="@kn" selected="@(string.Equals(Model.KyNang, kn, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @kn
                                            </option>
                                        }
                                    </select>
                                </div>

                                <!-- 5. Mức đánh giá sao -->
                                <div>
                                    <label class="filter-label">Mức đánh giá sao</label>
                                    <select name="soSaoMin" class="form-select form-select-custom">
                                        <option value="">Tất cả đánh giá</option>
                                        <option value="3" selected="@(Model.SoSaoMin == 3 ? "selected" : null)">Từ 3.0 sao trở lên</option>
                                        <option value="4" selected="@(Model.SoSaoMin == 4 ? "selected" : null)">Từ 4.0 sao trở lên</option>
                                        <option value="5" selected="@(Model.SoSaoMin == 5 ? "selected" : null)">5.0 sao tuyệt đối</option>
                                    </select>
                                </div>

                                <!-- 6. Điểm học tập (GPA) -->
                                <div>
                                    <label class="filter-label">Điểm học tập (GPA)</label>
                                    <select name="gpaMin" class="form-select form-select-custom">
                                        <option value="">Tất cả mức GPA</option>
                                        <option value="3.0" selected="@(Model.GpaMin == 3.0 ? "selected" : null)">GPA từ 3.0 trở lên</option>
                                        <option value="3.2" selected="@(Model.GpaMin == 3.2 ? "selected" : null)">GPA từ 3.2 trở lên</option>
                                        <option value="3.5" selected="@(Model.GpaMin == 3.5 ? "selected" : null)">GPA từ 3.5 (Giỏi/Xuất sắc)</option>
                                    </select>
                                </div>

                                <!-- 7. Năm thứ -->
                                <div>
                                    <label class="filter-label">Năm thứ</label>
                                    <select name="namThu" class="form-select form-select-custom">
                                        <option value="">Tất cả</option>
                                        <option value="1" selected="@(Model.NamThu == 1 ? "selected" : null)">Năm 1</option>
                                        <option value="2" selected="@(Model.NamThu == 2 ? "selected" : null)">Năm 2</option>
                                        <option value="3" selected="@(Model.NamThu == 3 ? "selected" : null)">Năm 3</option>
                                        <option value="4" selected="@(Model.NamThu == 4 ? "selected" : null)">Năm 4</option>
                                    </select>
                                </div>

                                <!-- 8. Trạng thái nhận việc -->
                                <div>
                                    <label class="filter-label">Trạng thái nhận việc</label>
                                    <select name="trangThaiNhanViec" class="form-select form-select-custom">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="true" selected="@(Model.TrangThaiNhanViec == true ? "selected" : null)">Sẵn sàng nhận việc</option>
                                        <option value="false" selected="@(Model.TrangThaiNhanViec == false ? "selected" : null)">Tạm ngưng nhận việc</option>
                                    </select>
                                </div>

                                <!-- 9. Cụm nút Thao tác -->
                                <div class="pt-2 d-flex flex-column gap-2">
                                    <button type="submit" class="btn-search-main w-100 py-2">
                                        <i class="bi bi-search me-1"></i> Tìm kiếm
                                    </button>
                                    <a href="@Context.Request.Path" class="btn-reset-filter w-100 py-2 text-center">
                                        Xóa bộ lọc
                                    </a>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- CỘT PHẢI: KHU VỰC KẾT QUẢ TÌM KIẾM -->
                <div class="col-12 col-lg-8 col-xl-9">

                    <!-- THANH BÁO SỐ LƯỢNG KẾT QUẢ -->
                    <div class="results-bar">
                        <span class="results-count">
                            Tìm thấy @Model.TongSoFreelancer sinh viên phù hợp
                        </span>
                        <span class="text-muted small">
                            Thứ tự: @(Model.SapXep == "sao-cao" ? "Đánh giá cao nhất" : Model.SapXep == "gpa-cao" ? "Điểm GPA cao nhất" : "Hồ sơ mới nhất trước")
                        </span>
                    </div>

                    <!-- DANH SÁCH CARD FREELANCER -->
                    @if (Model.DanhSachFreelancer != null && Model.DanhSachFreelancer.Any())
                    {
                        <div class="row g-3">
                            @foreach (var item in Model.DanhSachFreelancer)
                            {
                                var tenUser = !string.IsNullOrWhiteSpace(item.tenUser) ? item.tenUser : "Sinh viên";
                                var rawAvt = item.avatar;
                                var avatarUrl = !string.IsNullOrEmpty(rawAvt)
                                    ? (rawAvt.StartsWith("http", StringComparison.OrdinalIgnoreCase) || rawAvt.StartsWith("/") ? rawAvt : "/" + rawAvt)
                                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(tenUser)}&background=E8F5E9&color=1B5E36";

                                <div class="col-12 col-md-6">
                            <div class="freelancer-card">
                                
                                <!-- Phần trên: Header trực quan xanh lá đậm -->
                                <div class="freelancer-card-top-banner">
                                    <div class="card-top-profile">
                                        <img src="@avatarUrl" alt="@tenUser" class="student-avatar"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(tenUser)&background=E8F5E9&color=1B5E36';" />
                                        
                                        <div class="overflow-hidden flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start gap-1">
                                                <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" class="student-name-link text-truncate" title="@tenUser">
                                                    @tenUser
                                                </a>
                                                <span class="status-badge-inline @(item.trangthaiNhanViec ? "status-available" : "status-busy")">
                                                    @(item.trangthaiNhanViec ? "Nhận việc" : "Tạm ngưng")
                                                </span>
                                            </div>

                                            <div class="student-major-sub text-truncate">
                                                @(string.IsNullOrWhiteSpace(item.tenChuyenNganh) ? "Công nghệ thông tin" : item.tenChuyenNganh)
                                            </div>

                                            <div class="student-school-sub text-truncate">
                                                @(string.IsNullOrWhiteSpace(item.tenTruong) ? "Đại học" : item.tenTruong) · Năm @item.namThu
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Phần thân: Chỉ số học tập, đánh giá, giới thiệu & kỹ năng -->
                                <div class="freelancer-card-body">
                                    <div class="metrics-grid-compact">
                                        <div>
                                            <span class="text-muted" style="font-size: 0.72rem;">Điểm đánh giá:</span>
                                            @if (item.soLuotDanhGia > 0)
                                            {
                                                <span class="metric-compact-val rating">
                                                    ★ @item.diemDanhGiaTrungBinh.ToString("0.0")/5.0 (@item.soLuotDanhGia)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="metric-compact-val rating-none">Chưa có đánh giá</span>
                                            }
                                        </div>

                                        <div>
                                            <span class="text-muted" style="font-size: 0.72rem;">Điểm học tập:</span>
                                            <span class="metric-compact-val">
                                                @(item.GPA > 0 ? $"GPA {item.GPA:0.00}/4.0" : "Đang cập nhật")
                                            </span>
                                        </div>
                                    </div>

                                    <p class="student-bio-text">
                                        @(string.IsNullOrWhiteSpace(item.gioithieu) 
                                            ? "Sinh viên chuyên ngành nhiệt tình, chủ động học hỏi và cam kết hoàn thành dự án đúng tiến độ bàn giao." 
                                            : item.gioithieu)
                                    </p>

                                    <div class="mb-1">
                                        @{
                                            var skills = item.danhSachKyNang != null && item.danhSachKyNang.Any()
                                                ? item.danhSachKyNang
                                                : (!string.IsNullOrWhiteSpace(item.kyNangCoBan) 
                                                    ? item.kyNangCoBan.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList() 
                                                    : new List<string>());
                                        }
                                        @if (skills.Any())
                                        {
                                            @foreach (var sk in skills.Take(4))
                                            {
                                                <span class="skill-tag-item">@sk</span>
                                            }
                                            @if (skills.Count > 4)
                                            {
                                                <span class="skill-tag-item text-muted">+@(skills.Count - 4)</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <!-- Footer card: Chi phí & Nút xem hồ sơ -->
                                <div class="card-bottom-actions">
                                    <div>
                                        <span class="fee-refer-text d-block">Thù lao từ:</span>
                                        <span class="fee-refer-amount">
                                            @(item.chiPhiTu.HasValue && item.chiPhiTu > 0 
                                                ? item.chiPhiTu.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ" 
                                                : "Thỏa thuận")
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        @if (User.IsInRole("NhaTuyenDung") || Context.Session.GetString("tenRole") == "NhaTuyenDung")
                                        {
                                            var danhSachMaFLDaLuu = ViewBag.DanhSachMaFreelancerDaLuu as List<int> ?? new List<int>();
                                            bool daLuuFL = danhSachMaFLDaLuu.Contains(item.maFreelancerStudents);
                                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none bookmark-fl-btn @(daLuuFL ? "text-danger" : "text-secondary")"
                                                    onclick="toggleLuuFreelancer(@item.maFreelancerStudents, this)" 
                                                    title="@(daLuuFL ? "Bỏ yêu thích" : "Lưu Freelancer yêu thích")">
                                                <i class="bi @(daLuuFL ? "bi-heart-fill" : "bi-heart") fs-5" style="display:inline-block !important;"></i>
                                            </button>
                                        }

                                        <a href="/FreelancerStudent/Profile?maFreelancerStudents=@item.maFreelancerStudents" class="btn-view-profile">
                                            Xem hồ sơ
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-box">
                    <h3 class="fw-bold mb-2" style="font-size: 1.15rem; color: var(--ink);">
                        Không tìm thấy Freelancer phù hợp
                    </h3>
                    <p class="text-muted small mb-4">
                        Thử điều chỉnh lại từ khóa hoặc xóa bớt tiêu chí lọc để xem thêm nhiều hồ sơ sinh viên khác.
                    </p>
                    <a href="@Context.Request.Path" class="btn-search-main">
                        Xóa bộ lọc để xem tất cả
                    </a>
                </div>
            }

                </div> <!-- Đóng Cột phải col-12 col-lg-8 col-xl-9 -->
            </div> <!-- Đóng Bố cục 2 cột row g-4 -->

        </section>

        <!-- ===============================================================
             KHU VỰC 3: QUY TRÌNH HỢP TÁC (4 BƯỚC THEO VAI TRÒ)
             =============================================================== -->
        @if (User.IsInRole("FreelancerStudent") || Context.Session.GetString("tenRole") == "FreelancerStudent")
        {
            <section class="ntd-workflow-section" aria-label="Quy trình nhận việc chuẩn cho Sinh viên Freelancer">
                <div class="ntd-workflow-header">
                    <div>
                        <span class="ntd-section-badge">Chuẩn hóa Nghề nghiệp</span>
                        <h2 class="ntd-workflow-title">Quy trình nhận việc chuẩn cho Sinh viên Freelancer</h2>
                        <p class="ntd-workflow-sub">Tìm việc, gửi đề xuất, ký hợp đồng và bàn giao sản phẩm theo từng bước.</p>
                    </div>
                    <a asp-controller="FreelancerStudent" asp-action="DangTinTimViec" class="btn-search-main">
                        + Đăng bài tìm việc ngay
                    </a>
                </div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 01</span>
                            <h3 class="ntd-step-heading">1. Hoàn thiện Hồ sơ &amp; Portfolio</h3>
                            <p class="ntd-step-desc">
                                Thêm kỹ năng, GPA, dự án đã thực hiện và minh chứng sinh viên để Nhà tuyển dụng tham khảo.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 02</span>
                            <h3 class="ntd-step-heading">2. Tìm việc &amp; Gửi đề xuất</h3>
                            <p class="ntd-step-desc">
                                Lựa chọn dự án phù hợp chuyên ngành, gửi báo giá thù lao và trao đổi trực tiếp với Nhà tuyển dụng.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 03</span>
                            <h3 class="ntd-step-heading">3. Ký hợp đồng &amp; Triển khai</h3>
                            <p class="ntd-step-desc">
                                Bắt đầu thực hiện dự án khi hợp đồng điện tử đã được ký kết và Nhà tuyển dụng đã ký quỹ 100% thù lao.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 04</span>
                            <h3 class="ntd-step-heading">4. Bàn giao &amp; Nhận thù lao</h3>
                            <p class="ntd-step-desc">
                                Nộp sản phẩm hoàn thiện đúng thời hạn, nghiệm thu trực tuyến và nhận thanh toán ngay về Ví điện tử.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="ntd-workflow-section" aria-label="Quy trình làm việc chuẩn cho Nhà tuyển dụng">
                <div class="ntd-workflow-header">
                    <div>
                        <span class="ntd-section-badge">Chuẩn hóa Hợp tác</span>
                        <h2 class="ntd-workflow-title">Quy trình làm việc chuẩn cho Nhà tuyển dụng</h2>
                        <p class="ntd-workflow-sub">Đăng việc, chọn ứng viên, ký hợp đồng và nghiệm thu sản phẩm theo từng bước.</p>
                    </div>
                    <a asp-controller="JobPost" asp-action="Create" class="btn-search-main">
                        Bắt đầu đăng việc ngay
                    </a>
                </div>

                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 01</span>
                            <h3 class="ntd-step-heading">1. Đăng việc chi tiết</h3>
                            <p class="ntd-step-desc">
                                Nêu rõ yêu cầu dự án, kỹ năng cần thiết, thời hạn và ngân sách dự kiến.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 02</span>
                            <h3 class="ntd-step-heading">2. Chọn ứng viên &amp; Trao đổi</h3>
                            <p class="ntd-step-desc">
                                Xem đề xuất, hồ sơ năng lực của sinh viên và nhắn tin trao đổi chi tiết.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 03</span>
                            <h3 class="ntd-step-heading">3. Ký hợp đồng &amp; Ký quỹ</h3>
                            <p class="ntd-step-desc">
                                Hai bên ký hợp đồng điện tử; Nhà tuyển dụng nộp khoản ký quỹ theo giá trị và điều khoản hợp đồng.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="ntd-step-card">
                            <span class="ntd-step-number-badge">Bước 04</span>
                            <h3 class="ntd-step-heading">4. Nghiệm thu &amp; Giải ngân</h3>
                            <p class="ntd-step-desc">
                                Kiểm tra sản phẩm bàn giao, xác nhận hoàn thành và chấm điểm đánh giá ứng viên.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        }

    </div>
</div>

<script>
    function scrollNtdCards(direction) {
        const track = document.getElementById('ntdFeatureCardsTrack');
        if (!track || track.classList.contains('is-grid-mode')) return;
        const cardWidth = 340;
        track.scrollBy({ left: direction * cardWidth * 2, behavior: 'smooth' });
        setTimeout(updateNtdDotsOnScroll, 350);
    }

    function scrollToNtdGroup(groupIndex) {
        const track = document.getElementById('ntdFeatureCardsTrack');
        if (!track || track.classList.contains('is-grid-mode')) return;
        const maxScroll = track.scrollWidth - track.clientWidth;
        const targetScroll = (maxScroll / 2) * groupIndex;
        track.scrollTo({ left: targetScroll, behavior: 'smooth' });
        setActiveNtdDot(groupIndex);
    }

    function setActiveNtdDot(activeIndex) {
        const dots = document.querySelectorAll('#ntdHeroDotsBar .ntd-hero-dot');
        dots.forEach((dot, idx) => {
            dot.classList.toggle('active', idx === activeIndex);
        });
    }

    function updateNtdDotsOnScroll() {
        const track = document.getElementById('ntdFeatureCardsTrack');
        if (!track) return;
        const maxScroll = Math.max(1, track.scrollWidth - track.clientWidth);
        const ratio = track.scrollLeft / maxScroll;
        const activeIdx = ratio < 0.34 ? 0 : (ratio < 0.75 ? 1 : 2);
        setActiveNtdDot(activeIdx);
    }

    function toggleNtdCardsLayout() {
        const track = document.getElementById('ntdFeatureCardsTrack');
        const btn = document.getElementById('ntdToggleViewBtn');
        const dotsBar = document.getElementById('ntdHeroDotsBar');
        if (!track || !btn) return;
        const isGrid = track.classList.toggle('is-grid-mode');
        btn.textContent = isGrid ? 'Thu gọn dạng trượt ngang' : 'Xem tất cả 8 chức năng';
        if (dotsBar) {
            dotsBar.style.display = isGrid ? 'none' : 'flex';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const track = document.getElementById('ntdFeatureCardsTrack');
        if (track) {
            track.addEventListener('scroll', updateNtdDotsOnScroll, { passive: true });
        }
    });

    async function toggleLuuFreelancer(maFreelancer, btn) {
        try {
            const res = await fetch('/NhaTuyenDung/ToggleLuuFreelancer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maFreelancerStudent: maFreelancer })
            });
            const data = await res.json();
            if (data.success) {
                const icon = btn.querySelector('i');
                if (data.daLuu) {
                    btn.classList.remove('text-secondary');
                    btn.classList.add('text-danger');
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill');
                    btn.title = 'Bỏ yêu thích';
                } else {
                    btn.classList.remove('text-danger');
                    btn.classList.add('text-secondary');
                    icon.classList.remove('bi-heart-fill');
                    icon.classList.add('bi-heart');
                    btn.title = 'Lưu Freelancer yêu thích';
                }
            } else {
                alert(data.message);
            }
        } catch (e) {
            alert('Lỗi: ' + e);
        }
    }
</script>
