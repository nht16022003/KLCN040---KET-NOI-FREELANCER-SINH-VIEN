@model List<FreelancerStudent.Web.ViewModels.BaiDangTimViecViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Khám phá Freelancer Sinh viên";
}

<div class="container py-4">
    <!-- TIÊU ĐỀ & TỔNG SỐ BÀI -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-success fw-bold mb-1">
                Khám phá Freelancer Sinh viên
            </h4>
            <span class="text-muted small">Tìm kiếm các bạn sinh viên tài năng và dịch vụ phù hợp với dự án của
                bạn</span>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                Tổng cộng: @(Model?.Count ?? 0) dịch vụ
            </span>
        </div>

        <!-- DANH SÁCH BÀI ĐĂNG TÌM VIỆC DẠNG GRID CARD -->
        <div class="row g-3">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    var avatarSinhVien = !string.IsNullOrEmpty(item.avatar)
                        ? item.avatar
                        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(item.tenUser ??
          "Student")}&background=E8F5E9&color=2E7D32";

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border rounded-3 p-3 bg-white shadow-sm d-flex flex-column">
                        
                            <!-- Header Card: Avatar + Tên sinh viên + Trường học -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@avatarSinhVien" alt="@item.tenUser" class="rounded-circle border"
                                     style="width: 52px; height: 52px; object-fit: cover; flex-shrink: 0;" />

                                <div class="overflow-hidden">
                                    <h6 class="fw-bold text-dark mb-0 text-truncate" title="@item.tenUser">
                                        @(item.tenUser ?? "Sinh viên")
                                    </h6>
                                    <span class="text-muted small d-block text-truncate" style="font-size: 0.78rem;">
                                        @(item.tenTruong ?? "Đại học") - Năm @item.namThu
                                    </span>
                                    <span class="badge bg-light text-success border border-success-subtle"
                                          style="font-size: 0.72rem;">
                                        @(string.IsNullOrEmpty(item.tenChuyenNganh) ? "Đa ngành" : item.tenChuyenNganh)
                                    </span>
                                </div>
                            </div>

                            <!-- Tiêu đề bài đăng tìm việc -->
                            <h6 class="fw-bold text-dark mb-2" style="min-height: 42px; line-height: 1.4;">
                                @item.tieude
                            </h6>

                            <!-- Mức thù lao đề xuất -->
                            <div class="p-2 mb-2 bg-light rounded border">
                                <span class="text-muted small d-block" style="font-size: 0.72rem;">Thù lao mong muốn từ:</span>
                                <span class="text-danger fw-bold fs-6">
                                    @((item.mucGiaTu ?? 0).ToString("#,##0")) VNĐ
                                </span>
                            </div>

                            <!-- Mô tả dịch vụ / Năng lực -->
                            <p class="text-secondary small mb-2"
                               style="font-size: 0.8rem; line-height: 1.4; max-height: 38px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                @(string.IsNullOrEmpty(item.mota) ? "Chưa có mô tả chi tiết." : item.mota)
                            </p>

                            <!-- Kỹ năng chuyên môn -->
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(item.kynang))
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var kn in item.kynang.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bg-light text-dark border" style="font-size: 0.72rem;">@kn.Trim()</span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Footer Card: Ngày đăng & Nút liên hệ / thuê -->
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small" style="font-size: 0.75rem;">
                                    @item.thoigiandang.ToString("dd/MM/yyyy")
                                </span>

                                <a href="mailto:@(item.tenUser)" class="btn btn-sm btn-success px-3 fw-semibold">
                                    Thuê ngay
                                </a>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-light border text-center py-5 text-muted">
                        Hiện tại chưa có bài đăng tìm việc nào từ sinh viên.
                    </div>
                </div>
            }
        </div>
    </div>
