@model FreelancerStudent.Web.ViewModels.DangTinTimViecViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chỉnh sửa bài đăng tìm việc";
}

<div class="container py-4">
    <!-- Nút quay lại -->
    <div class="mb-3">
        <a asp-action="QuanLyTimViec" class="text-decoration-none text-muted small fw-medium">
            &larr; Quay lại danh sách bài đăng
        </a>
    </div>

    <div class="row g-4">
        <!-- FORM CHỈNH SỬA -->
        <div class="col-lg-8">
            <div class="card border bg-white shadow-sm p-4 p-md-5">
                <div class="mb-4 pb-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="app-badge app-badge-info mb-2">Chỉnh sửa tin</span>
                        <h3 class="fw-bold text-dark mb-1">Cập nhật thông tin bài đăng</h3>
                        <p class="text-muted small mb-0">Cập nhật lại tiêu đề, thù lao hoặc mô tả dịch vụ tìm việc.</p>
                    </div>
                    <span class="app-badge app-badge-neutral fs-6">Mã tin: #@ViewBag.MaBaiDang</span>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <form asp-action="SuaTinTimViec" asp-route-maBaiDang="@ViewBag.MaBaiDang" method="post">
                    <input type="hidden" asp-for="maUser" />

                    <!-- Tiêu đề -->
                    <div class="mb-3">
                        <label asp-for="tieude" class="form-label fw-bold small text-dark">Tiêu đề bài đăng dịch vụ <span class="text-danger">*</span></label>
                        <input asp-for="tieude" class="form-control" required />
                        <span asp-validation-for="tieude" class="text-danger small"></span>
                    </div>

                    <!-- Kỹ năng -->
                    <div class="mb-3">
                        <label asp-for="kynang" class="form-label fw-bold small text-dark">Kỹ năng chuyên môn (cách nhau bởi dấu phẩy) <span class="text-danger">*</span></label>
                        <input asp-for="kynang" class="form-control" required />
                        <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">Các kỹ năng cách nhau bởi dấu phẩy (,) để hệ thống gắn tag nổi bật.</small>
                        <span asp-validation-for="kynang" class="text-danger small d-block"></span>
                    </div>

                    <!-- Mức giá từ -->
                    <div class="mb-3">
                        <label asp-for="mucGiaTu" class="form-label fw-bold small text-dark">Mức thù lao mong muốn tối thiểu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="mucGiaTu" type="number" class="form-control" min="10000" step="50000" required />
                            <span class="input-group-text fw-bold bg-light text-muted">VNĐ</span>
                        </div>
                        <span asp-validation-for="mucGiaTu" class="text-danger small d-block"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="mb-4">
                        <label asp-for="mota" class="form-label fw-bold small text-dark">Mô tả chi tiết năng lực & cam kết <span class="text-danger">*</span></label>
                        <textarea asp-for="mota" class="form-control" rows="6" required></textarea>
                        <span asp-validation-for="mota" class="text-danger small"></span>
                    </div>

                    <!-- Nút bấm -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top">
                        <a asp-action="QuanLyTimViec" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- HỘP THÔNG TIN PHỤ -->
        <div class="col-lg-4">
            <div class="card border bg-white shadow-sm p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    Lưu ý khi cập nhật
                </h6>
                <p class="small text-muted mb-2">
                    Mọi thông tin chỉnh sửa sẽ được cập nhật trực tiếp trên bảng tin tìm việc và hồ sơ công khai của bạn.
                </p>
                <p class="small text-muted mb-0">
                    Nếu bạn đang bận học tập hoặc đã đủ dự án, hãy sử dụng tính năng <strong>Tạm ẩn tin</strong> tại trang Quản lý bài đăng để tránh bị Nhà tuyển dụng liên hệ làm phiền.
                </p>
            </div>
        </div>
    </div>
</div>
