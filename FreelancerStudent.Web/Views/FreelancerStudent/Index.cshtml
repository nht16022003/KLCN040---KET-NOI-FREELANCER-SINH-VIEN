@using FreelancerStudent.Web.ViewModels
@model List<FreelancerStudent.Web.ViewModels.FreelacerStudentViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .card-header {
        background-color: rgba(173, 246, 214, 0.302);
    }

    .btnXemChiTiet {
        background-color: whitesmoke;
    }

    p {
        margin-bottom: 2px;
    }
</style>
<div class="container py-4">
    <h4 class="mb-4 text-success fw-bold">Các bài đăng tuyển dụng</h4>
    <div class="row g-4">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var freelacerStudentViewModel in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body">
                            <div class="card-header mb-3">
                                <h5 class="card-title mb-1 fw-bold">@freelacerStudentViewModel.tenUser</h5>
                            </div>
                            <p class="small">Trường: @freelacerStudentViewModel.tenTruong</p>
                            <p class="fw-bold">Chuyên ngành:
                                <span class="fw-normal">@freelacerStudentViewModel.tenChuyenNganh</span>
                            </p>
                            <p class="fw-bold">GPA:
                                <span class="fw-normal">@freelacerStudentViewModel.GPA.ToString("0.0#")</span>
                            </p>
                            <p>
                                Trạng thái:
                                @(freelacerStudentViewModel.trangthaiNhanViec ? "Đang nhận việc" : "Tạm ngưng")
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center mb-3">
                            <a asp-controller="FreelancerStudent"
                               asp-action="Profile"
                               asp-route-maFreelancerStudents="@freelacerStudentViewModel.maFreelancerStudents"
                               class="btn btn-outline-success">
                                Xem hồ sơ
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Chưa có freelancer nào.</div>
            </div>
        }
    </div>
</div>
