    /* =====================================================================
       FADE UP ANIMATION (IntersectionObserver)
       ===================================================================== */
    .fade-up-element {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 500ms ease-out, transform 500ms ease-out;
        will-change: opacity, transform;
    }
    .fade-up-element.is-visible {
        opacity: 1;
        transform: translateY(0);
