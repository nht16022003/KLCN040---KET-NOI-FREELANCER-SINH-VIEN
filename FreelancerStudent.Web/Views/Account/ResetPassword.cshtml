    <script>
        // Password visibility toggle
        function setupPasswordToggle(buttonId, inputId, iconId) {
            const btn = document.getElementById(buttonId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (btn && input && icon) {
                btn.addEventListener("click", function () {
                    const isPassword = input.type === "password";
                    input.type = isPassword ? "text" : "password";
                    icon.classList.toggle("bi-eye", !isPassword);
                    icon.classList.toggle("bi-eye-slash", isPassword);
                });
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            setupPasswordToggle("toggleNewPasswordBtn", "newPasswordInput", "toggleNewPasswordIcon");
            setupPasswordToggle("toggleConfirmNewPasswordBtn", "confirmNewPasswordInput", "toggleConfirmNewPasswordIcon");

            // Real-time password criteria validation checklist
            const passwordInput = document.getElementById("newPasswordInput");
            
            const ruleLength = document.getElementById("rule-length");
            const iconLength = document.getElementById("icon-length");
            
            const ruleCasing = document.getElementById("rule-casing");
            const iconCasing = document.getElementById("icon-casing");
            
            const ruleNumber = document.getElementById("rule-number");
            const iconNumber = document.getElementById("icon-number");
            
            const ruleSpecial = document.getElementById("rule-special");
            const iconSpecial = document.getElementById("icon-special");

            if (passwordInput) {
                passwordInput.addEventListener("input", function () {
                    const val = passwordInput.value;

                    // 1. Length >= 8
                    const isLengthValid = val.length >= 8;
                    updateRuleState(ruleLength, iconLength, isLengthValid);

                    // 2. Has uppercase and lowercase
                    const isCasingValid = /[a-z]/.test(val) && /[A-Z]/.test(val);
                    updateRuleState(ruleCasing, iconCasing, isCasingValid);

                    // 3. Has number
                    const isNumberValid = /[0-9]/.test(val);
                    updateRuleState(ruleNumber, iconNumber, isNumberValid);

                    // 4. Has special character
                    const isSpecialValid = /[^A-Za-z0-9]/.test(val);
                    updateRuleState(ruleSpecial, iconSpecial, isSpecialValid);
                });
            }

            function updateRuleState(ruleEl, iconEl, isValid) {
                if (isValid) {
                    ruleEl.classList.add("valid");
                    iconEl.classList.remove("bi-check-circle");
                    iconEl.classList.add("bi-check-circle-fill");
                } else {
                    ruleEl.classList.remove("valid");
                    iconEl.classList.remove("bi-check-circle-fill");
                    iconEl.classList.add("bi-check-circle");
                }
            }
        });

        function handleSubscribe(e) {
            e.preventDefault();
            alert('Cảm ơn bạn đã đăng ký nhận bản tin từ Freelancer Students!');
        }
    </script>
