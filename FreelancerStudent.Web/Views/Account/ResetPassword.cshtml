@model FreelancerStudent.Web.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu - Freelancer Students";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Caveat:wght@600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand-green-primary: #51775e;
            --brand-green-hover: #43644f;
            --brand-green-light: #eef5f1;
            --brand-green-subtle: #dbebe0;
            --brand-dark: #1f2923;
            --brand-muted: #5f6c64;
            --brand-border: #e2e8e4;
            --brand-bg: #f9fbf9;
            --card-shadow: 0 16px 40px -12px rgba(31, 58, 42, 0.12);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--brand-dark);
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Top Notification */
        .alert-floating {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1050;
            min-width: 300px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-radius: 12px;
        }

        /* Navbar Header */
        .site-header {
            background: #ffffff;
            border-bottom: 1px solid #eef2ef;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-logo {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.35rem;
            color: #385141;
            line-height: 1.1;
            text-decoration: none;
            display: inline-block;
            letter-spacing: -0.5px;
        }

        .brand-logo span {
            display: block;
            font-size: 1.25rem;
        }

        .nav-link-custom {
            color: #4b5850;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1rem;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .nav-link-custom:hover {
            color: var(--brand-green-primary);
        }

        .lang-selector {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #3d4a42;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 20px;
            transition: background-color 0.2s;
        }

        .lang-selector:hover {
            background-color: var(--brand-green-light);
        }

        .btn-nav-login {
            border: 1px solid #d4ddd7;
            background: #ffffff;
            color: #334038;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.45rem 1.4rem;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-nav-login:hover {
            background: #f4f7f5;
            border-color: #b7c5bc;
            color: #1f2923;
        }

        .btn-nav-register {
            background: var(--brand-green-primary);
            border: 1px solid var(--brand-green-primary);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.45rem 1.4rem;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-nav-register:hover {
            background: var(--brand-green-hover);
            border-color: var(--brand-green-hover);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(81, 119, 94, 0.3);
        }

        /* Main Container */
        .main-content {
            flex: 1 0 auto;
            padding: 2.5rem 0 3.5rem 0;
            background: radial-gradient(circle at 15% 40%, rgba(222, 237, 227, 0.45) 0%, rgba(255, 255, 255, 0) 50%),
                        radial-gradient(circle at 85% 80%, rgba(238, 245, 241, 0.6) 0%, rgba(255, 255, 255, 0) 50%);
        }

        /* Left Column Styles */
        .hero-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            font-size: 2.75rem;
            line-height: 1.05;
            letter-spacing: -1px;
            margin-bottom: 0.5rem;
            color: #3f614b;
        }

        .hero-title .title-top {
            display: block;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .hero-title .title-bottom {
            display: flex;
            align-items: baseline;
            gap: 10px;
            flex-wrap: wrap;
        }

        .hero-title .text-outline {
            color: transparent;
            -webkit-text-stroke: 1.8px #3f614b;
            font-weight: 900;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            font-weight: 600;
            color: #2e3a32;
            margin-bottom: 1.8rem;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 1.25rem;
        }

        .feature-icon-wrapper {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 50%;
            background-color: var(--brand-green-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-green-primary);
            font-size: 1.2rem;
            box-shadow: 0 2px 6px rgba(81, 119, 94, 0.08);
        }

        .feature-title {
            font-weight: 700;
            font-size: 1rem;
            color: #212c24;
            margin-bottom: 2px;
        }

        .feature-desc {
            font-size: 0.875rem;
            color: #647369;
            margin-bottom: 0;
            line-height: 1.4;
        }

        /* Visual Graphic Container */
        .hero-visual-wrapper {
            position: relative;
            margin-top: 1.5rem;
            max-width: 440px;
        }

        .hero-bg-blob {
            position: absolute;
            width: 340px;
            height: 340px;
            background: linear-gradient(135deg, #cde3d4 0%, #e2efe6 100%);
            border-radius: 50% 50% 40% 60% / 60% 40% 60% 40%;
            top: 10px;
            left: 20px;
            z-index: 1;
            opacity: 0.85;
        }

        .hero-img {
            position: relative;
            z-index: 2;
            width: 100%;
            border-radius: 20px;
            object-fit: cover;
            filter: drop-shadow(0 12px 24px rgba(30, 50, 36, 0.12));
        }

        .sticker-badge {
            position: absolute;
            top: 20px;
            left: -15px;
            z-index: 3;
            transform: rotate(-12deg);
            font-family: 'Caveat', cursive;
            font-size: 1.35rem;
            font-weight: 700;
            line-height: 1.15;
            color: #385141;
            text-shadow: 1px 1px 0 #fff;
            pointer-events: none;
        }

        .sticker-badge .line-1 {
            display: block;
        }
        .sticker-badge .line-2 {
            display: block;
            margin-left: 8px;
        }
        .sticker-badge .line-3 {
            display: block;
            margin-left: 16px;
        }

        .crown-sketch {
            position: absolute;
            top: -10px;
            right: 65px;
            z-index: 3;
            color: #51775e;
            font-size: 1.8rem;
            transform: rotate(15deg);
        }

        /* Card Styles */
        .auth-card-container {
            max-width: 460px;
            margin: 0 auto;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e7ede9;
            box-shadow: var(--card-shadow);
            padding: 2.25rem 2.25rem 2rem 2.25rem;
            position: relative;
        }

        .back-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #6a7c71;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            margin-bottom: 1.25rem;
            transition: color 0.2s;
        }

        .back-nav-link:hover {
            color: var(--brand-green-primary);
        }

        .icon-circle-badge {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background-color: var(--brand-green-light);
            border: 2px solid var(--brand-green-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem auto;
            color: var(--brand-green-primary);
            font-size: 2rem;
        }

        .card-header-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.65rem;
            color: #1a241e;
            text-align: center;
            margin-bottom: 0.4rem;
        }

        .card-header-sub {
            text-align: center;
            font-size: 0.9rem;
            color: #637268;
            margin-bottom: 1.6rem;
            line-height: 1.45;
        }

        .form-label-custom {
            font-size: 0.88rem;
            font-weight: 700;
            color: #28362d;
            margin-bottom: 0.4rem;
            display: block;
        }

        .input-group-custom {
            position: relative;
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .input-group-custom .input-icon-left {
            position: absolute;
            left: 14px;
            color: #798b80;
            font-size: 1.05rem;
            pointer-events: none;
            z-index: 5;
        }

        .input-group-custom .form-control {
            border-radius: 12px;
            border: 1px solid #dbe3de;
            padding: 0.65rem 1rem 0.65rem 2.65rem;
            font-size: 0.92rem;
            color: #1f2923;
            background-color: #ffffff;
            transition: all 0.2s ease;
            height: 46px;
        }

        .input-group-custom .form-control:focus {
            border-color: var(--brand-green-primary);
            box-shadow: 0 0 0 3.5px rgba(81, 119, 94, 0.15);
            outline: none;
        }

        .input-group-custom .input-btn-right {
            position: absolute;
            right: 12px;
            background: transparent;
            border: none;
            color: #798b80;
            padding: 4px 6px;
            cursor: pointer;
            z-index: 5;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-group-custom .input-btn-right:hover {
            color: #3b4e42;
        }

        /* Password Rules Checklist */
        .password-rules-list {
            list-style: none;
            padding-left: 0;
            margin: 0.5rem 0 1.25rem 0;
        }

        .password-rules-list li {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            color: #6a7c72;
            margin-bottom: 4px;
            transition: color 0.2s;
        }

        .password-rules-list li i {
            font-size: 0.95rem;
            color: #a4b3aa;
            transition: color 0.2s;
        }

        .password-rules-list li.valid {
            color: #276738;
            font-weight: 600;
        }

        .password-rules-list li.valid i {
            color: #276738;
        }

        .btn-submit-action {
            width: 100%;
            background-color: var(--brand-green-primary);
            color: #ffffff;
            font-weight: 700;
            font-size: 1rem;
            padding: 0.75rem;
            border: none;
            border-radius: 50px;
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(81, 119, 94, 0.35);
            transition: all 0.2s ease;
        }

        .btn-submit-action:hover {
            background-color: var(--brand-green-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(81, 119, 94, 0.45);
        }

        .btn-submit-action:active {
            transform: translateY(0);
        }

        /* Footer */
        .site-footer {
            background-color: #ffffff;
            border-top: 1px solid #e7ede9;
            padding: 3.5rem 0 1.5rem 0;
            font-size: 0.9rem;
            color: #56645b;
        }

        .footer-logo {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 1.35rem;
            color: #385141;
            line-height: 1.1;
            text-decoration: none;
            display: block;
            margin-bottom: 0.75rem;
        }

        .footer-slogan {
            font-size: 0.875rem;
            color: #647369;
            margin-bottom: 1.25rem;
            line-height: 1.45;
        }

        .social-icons-wrapper {
            display: flex;
            gap: 12px;
        }

        .social-icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: #f0f4f1;
            color: #405548;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .social-icon-btn:hover {
            background-color: var(--brand-green-primary);
            color: #ffffff;
            transform: translateY(-2px);
        }

        .footer-heading {
            font-weight: 700;
            font-size: 0.95rem;
            color: #1e2821;
            margin-bottom: 1.1rem;
        }

        .footer-links-list {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .footer-links-list li {
            margin-bottom: 0.65rem;
        }

        .footer-links-list a {
            color: #5b6960;
            text-decoration: none;
            font-size: 0.88rem;
            transition: color 0.2s;
        }

        .footer-links-list a:hover {
            color: var(--brand-green-primary);
        }

        .newsletter-input-group {
            position: relative;
            display: flex;
            align-items: center;
            margin-top: 0.75rem;
        }

        .newsletter-input-group input {
            width: 100%;
            border-radius: 50px;
            border: 1px solid #d4ded8;
            padding: 0.55rem 3rem 0.55rem 1.1rem;
            font-size: 0.85rem;
            background-color: #fafcfb;
        }

        .newsletter-input-group input:focus {
            outline: none;
            border-color: var(--brand-green-primary);
            background-color: #fff;
        }

        .newsletter-btn {
            position: absolute;
            right: 4px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: var(--brand-green-primary);
            color: #ffffff;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .newsletter-btn:hover {
            background-color: var(--brand-green-hover);
        }

        .footer-bottom-bar {
            border-top: 1px solid #edf2ee;
            margin-top: 2.5rem;
            padding-top: 1.25rem;
            font-size: 0.825rem;
            color: #79877e;
        }

        .footer-bottom-links a {
            color: #79877e;
            text-decoration: none;
            margin: 0 4px;
        }

        .footer-bottom-links a:hover {
            color: var(--brand-green-primary);
        }

        /* Responsive tweaks */
        @@media (max-width: 991.98px) {
            .hero-title {
                font-size: 2.3rem;
            }
            .hero-visual-wrapper {
                margin: 2rem auto;
            }
            .auth-card-container {
                margin-top: 2rem;
            }
        }
    </style>
</head>
<body>

    <!-- Notification Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-floating alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-floating alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header / Navbar -->
    <header class="site-header py-3">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Logo -->
                <a href="/" class="brand-logo">
                    Freelancer<br><span>Students</span>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="d-none d-lg-flex align-items-center gap-2">
                    <a href="/Home/Index" class="nav-link-custom">Tìm công việc</a>
                    <a href="/FreelancerStudent" class="nav-link-custom">Tìm Freelancer</a>
                    <a href="/Home/About" class="nav-link-custom">Về chúng tôi</a>
                    <a href="/Home/Support" class="nav-link-custom">Hỗ trợ</a>
                </nav>

                <!-- Actions / Auth buttons -->
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <!-- Language selector -->
                    <div class="lang-selector">
                        <i class="bi bi-globe2"></i>
                        <span>VI</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
                    </div>

                    <!-- Login Button -->
                    <a href="/Account/Login" class="btn-nav-login">Đăng nhập</a>

                    <!-- Register Button -->
                    <a href="/Account/Register" class="btn-nav-register">Đăng ký</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-content d-flex align-items-center">
        <div class="container">
            <div class="row align-items-center justify-content-between g-4 g-xl-5">
                
                <!-- Left Column: Hero & Features & Illustration -->
                <div class="col-lg-6 col-xl-6 pe-lg-4">
                    
                    <!-- Big Heading -->
                    <h1 class="hero-title">
                        <span class="title-top">FREELANCER</span>
                        <span class="title-bottom">
                            <span class="text-outline">FOR</span>
                            <span>STUDENTS</span>
                        </span>
                    </h1>

                    <!-- Slogan -->
                    <p class="hero-subtitle">
                        Kết nối sinh viên tài năng với cơ hội thực tế
                    </p>

                    <!-- Feature 1 -->
                    <div class="feature-item">
                        <div class="feature-icon-wrapper">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="feature-title">Cơ hội thực tế</div>
                            <p class="feature-desc">Tìm công việc phù hợp, phát triển kỹ năng</p>
                        </div>
                    </div>

                    <!-- Feature 2 -->
                    <div class="feature-item">
                        <div class="feature-icon-wrapper">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <div class="feature-title">Thu nhập linh hoạt</div>
                            <p class="feature-desc">Làm chủ thời gian, tăng thu nhập</p>
                        </div>
                    </div>

                    <!-- Feature 3 -->
                    <div class="feature-item">
                        <div class="feature-icon-wrapper">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <div class="feature-title">Xây dựng tương lai</div>
                            <p class="feature-desc">Tạo portfolio, tích lũy kinh nghiệm</p>
                        </div>
                    </div>

                    <!-- Visual Illustration Composition -->
                    <div class="hero-visual-wrapper d-none d-md-block">
                        <div class="hero-bg-blob"></div>
                        
                        <!-- Handwritten sticker badge -->
                        <div class="sticker-badge">
                            <span class="line-1">Small</span>
                            <span class="line-2">Skills</span>
                            <span class="line-3">Big Opportunities</span>
                        </div>

                        <!-- Doodle Crown -->
                        <div class="crown-sketch">
                            <i class="bi bi-award"></i>
                        </div>

                        <!-- Real Generated Hero Photography -->
                        <img src="~/images/students_hero.jpg" alt="Freelancer Students" class="hero-img" />
                    </div>

                </div>

                <!-- Right Column: Reset Password Card -->
                <div class="col-lg-6 col-xl-5">
                    <div class="auth-card-container">
                        <div class="auth-card">
                            
                            <!-- Back Link -->
                            <a href="/Account/Login" class="back-nav-link">
                                <i class="bi bi-chevron-left"></i> Quay lại
                            </a>

                            <!-- Lock Circle Badge -->
                            <div class="icon-circle-badge">
                                <i class="bi bi-lock"></i>
                            </div>

                            <!-- Card Header -->
                            <h2 class="card-header-title">Đặt lại mật khẩu</h2>
                            <p class="card-header-sub">Tạo mật khẩu mới để tiếp tục sử dụng tài khoản của bạn.</p>

                            <!-- Validation Summary -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                            <!-- Reset Password Form -->
                            <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetPasswordForm" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Email" />
                                <input type="hidden" asp-for="Token" />

                                <!-- New Password -->
                                <div class="mb-2">
                                    <label asp-for="NewPassword" class="form-label-custom">Mật khẩu mới</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock input-icon-left"></i>
                                        <input asp-for="NewPassword" 
                                               type="password" 
                                               class="form-control pe-5" 
                                               placeholder="Nhập mật khẩu mới" 
                                               id="newPasswordInput" 
                                               autocomplete="new-password" 
                                               required />
                                        <button class="input-btn-right" type="button" id="toggleNewPasswordBtn" title="Hiện/ẩn mật khẩu">
                                            <i class="bi bi-eye" id="toggleNewPasswordIcon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger small mt-n2 d-block"></span>
                                </div>

                                <!-- Password Checklist -->
                                <ul class="password-rules-list">
                                    <li id="rule-length">
                                        <i class="bi bi-check-circle" id="icon-length"></i>
                                        <span>Tối thiểu 8 ký tự</span>
                                    </li>
                                    <li id="rule-casing">
                                        <i class="bi bi-check-circle" id="icon-casing"></i>
                                        <span>Có chữ hoa, chữ thường</span>
                                    </li>
                                    <li id="rule-number">
                                        <i class="bi bi-check-circle" id="icon-number"></i>
                                        <span>Có số</span>
                                    </li>
                                    <li id="rule-special">
                                        <i class="bi bi-check-circle" id="icon-special"></i>
                                        <span>Có ký tự đặc biệt (!@@#$%...)</span>
                                    </li>
                                </ul>

                                <!-- Confirm New Password -->
                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label-custom">Xác nhận mật khẩu mới</label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock input-icon-left"></i>
                                        <input asp-for="ConfirmPassword" 
                                               type="password" 
                                               class="form-control pe-5" 
                                               placeholder="Nhập lại mật khẩu mới" 
                                               id="confirmNewPasswordInput" 
                                               autocomplete="new-password" 
                                               required />
                                        <button class="input-btn-right" type="button" id="toggleConfirmNewPasswordBtn" title="Hiện/ẩn mật khẩu">
