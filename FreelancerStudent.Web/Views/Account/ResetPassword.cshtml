                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-n2 d-block"></span>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn-submit-action">
                                    Đặt lại mật khẩu
                                </button>

                            </form>

                        </div>
                    </div>
                </div>

            </div>
        </div>
