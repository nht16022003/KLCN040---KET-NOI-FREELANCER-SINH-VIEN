@model FreelancerStudent.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - Freelancer Students";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --primary-green: #3B6E53;
            --primary-green-dark: #2A523E;
            --primary-green-light: #EBF4F0;
            --text-dark: #1E293B;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
            --body-bg: #FAFCFB;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--body-bg);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .forgot-card {
            background: #FFFFFF;
            border: 1px solid #E8EFF2;
            border-radius: 24px;
            padding: 40px 36px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 440px;
        }

        .icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--primary-green-light);
            color: var(--primary-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 20px;
        }

        .btn-submit-auth {
            width: 100%;
            height: 50px;
            border-radius: 30px;
            background: var(--primary-green);
            color: #FFFFFF;
            border: none;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.2s ease;
            box-shadow: 0 6px 18px rgba(59, 110, 83, 0.25);
        }
        .btn-submit-auth:hover {
            background: var(--primary-green-dark);
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="forgot-card text-center">
        <div class="icon-circle">
            <i class="bi bi-key-fill"></i>
        </div>
        <h3 class="fw-bold mb-2">Quên mật khẩu?</h3>
        <p class="text-muted small mb-4">
            Đừng lo lắng! Vui lòng nhập địa chỉ email đã đăng ký của bạn. Chúng tôi sẽ gửi hướng dẫn khôi phục mật khẩu.
        </p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="text-start mb-4">
                <label asp-for="Email" class="form-label fw-semibold small">Địa chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn-submit-auth mb-3">
                Gửi liên kết khôi phục
            </button>

            <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-success fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
            </a>
        </form>
    </div>
</body>
</html>
