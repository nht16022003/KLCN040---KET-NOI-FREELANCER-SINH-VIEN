@model FreelancerStudent.Web.ViewModels.DanhGiaThongKeViewModel

@if (Model.tongLuotDanhGia == 0)
{
    <div class="text-muted">Chưa có đánh giá.</div>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-3">
        <strong>@Model.diemTrungBinh.ToString("0.0") / 5 (@Model.tongLuotDanhGia đánh giá)</strong>
        <span>Chất lượng @Model.trungBinhChatLuong.ToString("0.0")</span>
        <span>Đúng hạn @Model.trungBinhDungHan.ToString("0.0")</span>
        <span>Giao tiếp @Model.trungBinhGiaoTiep.ToString("0.0")</span>
    </div>
    @foreach (var review in Model.danhSach)
    {
        <article class="border-bottom py-3">
            <div class="d-flex justify-content-between"><strong>@review.tenNguoiDanhGia</strong><span class="text-warning">@review.soSaoTongThe ★</span></div>
            <div class="small text-muted">@review.tenCongViec · @review.ngayDanhGia.ToString("dd/MM/yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(review.nhanXet)) { <p class="mb-0 mt-2">@review.nhanXet</p> }
        </article>
    }
    @if (Model.tongSoTrang > 1)
    {
        <nav class="mt-3" aria-label="Phân trang đánh giá"><ul class="pagination pagination-sm mb-0">
            @for (var pageNumber = 1; pageNumber <= Model.tongSoTrang; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.trang ? "active" : "")"><a class="page-link" href="?trang=@pageNumber">@pageNumber</a></li>
            }
        </ul></nav>
    }
}
