@model FreelancerStudent.Web.ViewModels.CongViecDaHoanThanhViewModel
@{
    ViewData["Title"] = "Công việc đã hoàn thành";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div><h2 class="mb-1">Công việc đã hoàn thành</h2><p class="text-muted mb-0">Theo dõi hợp đồng đã đóng và trạng thái đánh giá đối tác.</p></div>
        <a asp-controller="HopDong" asp-action="Index" class="btn btn-outline-secondary">Quản lý hợp đồng</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Loi))
    {
        <div class="alert alert-warning">@Model.Loi</div>
    }
    @if (Model.DanhSach.Count == 0)
    {
        <div class="alert alert-light border">Chưa có hợp đồng đã thanh toán để hiển thị.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model.DanhSach)
            {
                <div class="list-group-item py-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h5 class="mb-1">@item.tenCongViec</h5>
                            <div class="text-muted small">Hợp đồng @item.maHD · Đối tác: @item.tenDoiTac</div>
                            @if (item.hanDanhGia.HasValue) { <div class="text-muted small">Hạn đánh giá: @item.hanDanhGia.Value.ToString("dd/MM/yyyy")</div> }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (item.trangThaiDanhGia == "DaDanhGia")
                            {
                                <span class="badge text-bg-success">Đã đánh giá</span>
                                @if (item.coTheChinhSuaDanhGia && item.maDanhGia.HasValue)
                                {
                                    <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@item.maHD" class="btn btn-sm btn-outline-primary">Chỉnh sửa</a>
                                }
                            }
                            else if (item.coTheDanhGia)
                            {
                                <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@item.maHD" class="btn btn-sm btn-primary">Đánh giá</a>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Hết hạn đánh giá</span>
                            }
                            <a asp-controller="HopDong" asp-action="ChiTiet" asp-route-maHD="@item.maHD" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
